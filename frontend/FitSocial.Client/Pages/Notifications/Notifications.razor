@page "/notifications"
@namespace FitSocial.Client.Pages
@implements IDisposable
@attribute [Authorize(Roles = "TRAINEE,COACH")]
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject AppShellContext Shell
@using FitSocial.Client.Models.Notifications
@using FitSocial.Client.Models.Auth
@using System.Security.Claims

<PageTitle>Notifications - FitConnect</PageTitle>

<!-- Toast Notification -->
@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-emerald-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-emerald-500/50 backdrop-blur transition-all duration-300 animate-in fade-in slide-in-from-top-4">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        <span>@_toastMessage</span>
    </div>
}

<div class="flex flex-col gap-4 w-full">
    <!-- Header Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 sm:p-6 transition">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-[#FF5500] to-[#FF8C00] text-white flex items-center justify-center shadow-md flex-shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                        </path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-gray-900 leading-tight">Notifications</h1>
                    <p class="text-xs text-gray-500 mt-0.5">
                        @if (_unreadCount > 0)
                        {
                            <span>You have <strong class="text-[#FF5500]">@_unreadCount</strong> unread notification@(_unreadCount > 1 ? "s" : "")</span>
                        }
                        else
                        {
                            <span>You are all caught up!</span>
                        }
                    </p>
                </div>
            </div>

            <!-- Header Actions -->
            <div class="flex items-center gap-2 self-start sm:self-auto">
                <button type="button"
                        @onclick="HandleRefreshAsync"
                        disabled="@_isLoading"
                        class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-gray-600 hover:text-gray-900 bg-gray-50 hover:bg-gray-100 rounded-xl transition cursor-pointer disabled:opacity-50"
                        title="Refresh notifications">
                    <svg class="w-4 h-4 @(_isLoading ? "animate-spin text-[#FF5500]" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                        </path>
                    </svg>
                    <span>Refresh</span>
                </button>

                @if (_unreadCount > 0)
                {
                    <button type="button"
                            @onclick="HandleMarkAllAsReadAsync"
                            disabled="@_isMarkingAllRead"
                            class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold text-white bg-[#FF5500] hover:bg-[#e04c00] rounded-xl shadow-xs transition cursor-pointer disabled:opacity-50">
                        @if (_isMarkingAllRead)
                        {
                            <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                            <span>Marking...</span>
                        }
                        else
                        {
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span>Mark all as read</span>
                        }
                    </button>
                }
            </div>
        </div>

        <!-- Filter Tabs -->
        <div class="flex items-center gap-2 mt-5 pt-4 border-t border-gray-100">
            <button type="button"
                    @onclick='() => _activeFilter = "all"'
                    class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer @(_activeFilter == "all" ? "bg-orange-50 text-[#FF5500]" : "text-gray-600 hover:bg-gray-50")">
                <span>All</span>
                <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] font-bold @(_activeFilter == "all" ? "bg-[#FF5500] text-white" : "bg-gray-100 text-gray-500")">
                    @_notifications.Count
                </span>
            </button>

            <button type="button"
                    @onclick='() => _activeFilter = "unread"'
                    class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer @(_activeFilter == "unread" ? "bg-orange-50 text-[#FF5500]" : "text-gray-600 hover:bg-gray-50")">
                <span>Unread</span>
                <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] font-bold @(_activeFilter == "unread" ? "bg-[#FF5500] text-white" : "bg-gray-100 text-gray-500")">
                    @_unreadCount
                </span>
            </button>
        </div>
    </div>

    <!-- Notification List Section -->
    @if (_isLoading)
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-12 text-center">
            <div class="w-8 h-8 border-3 border-[#FF5500] border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
            <p class="text-sm font-medium text-gray-600">Loading notifications...</p>
            <p class="text-xs text-gray-400 mt-1">Please wait a moment while we retrieve your updates.</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="bg-red-50 border border-red-200 rounded-2xl p-6 text-center">
            <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
                    </path>
                </svg>
            </div>
            <h3 class="text-sm font-bold text-red-800">Unable to load notifications</h3>
            <p class="text-xs text-red-600 mt-1 max-w-md mx-auto">@_errorMessage</p>
            <button type="button"
                    @onclick="HandleRefreshAsync"
                    class="mt-4 px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-xl transition cursor-pointer">
                Try Again
            </button>
        </div>
    }
    else if (!FilteredNotifications.Any())
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-12 text-center">
            <div class="w-16 h-16 rounded-full bg-orange-50 text-[#FF5500] flex items-center justify-center mx-auto mb-4">
                @if (_activeFilter == "unread")
                {
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                }
                else
                {
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                        </path>
                    </svg>
                }
            </div>
            <h3 class="text-base font-bold text-gray-900">
                @(_activeFilter == "unread" ? "No unread notifications" : "No notifications yet")
            </h3>
            <p class="text-xs text-gray-500 mt-1.5 max-w-sm mx-auto">
                @(_activeFilter == "unread"
                    ? "Great job! You have read all your notifications."
                    : "You do not have any notifications at this time. Updates regarding messages, workouts, and bookings will appear here.")
            </p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden divide-y divide-gray-100">
            @foreach (var item in FilteredNotifications)
            {
                <div class="p-4 sm:p-5 flex items-start gap-4 transition hover:bg-gray-50/70 cursor-pointer @(!item.IsRead ? "bg-orange-50/30 border-l-4 border-l-[#FF5500]" : "border-l-4 border-l-transparent")"
                     @onclick="() => HandleNotificationClick(item)">
                    <!-- Avatar or Type Icon -->
                    <div class="relative flex-shrink-0">
                        @if (!string.IsNullOrEmpty(item.SenderAvatar))
                        {
                            <img src="@item.SenderAvatar" alt="@item.SenderName" class="w-11 h-11 rounded-full object-cover border border-gray-100 shadow-xs" />
                        }
                        else
                        {
                            <div class="w-11 h-11 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold text-sm shadow-xs">
                                @GetInitials(item.SenderName)
                            </div>
                        }

                        <!-- Unread Dot Badge -->
                        @if (!item.IsRead)
                        {
                            <span class="absolute -top-0.5 -right-0.5 w-3 h-3 bg-[#FF5500] border-2 border-white rounded-full"></span>
                        }
                    </div>

                    <!-- Content -->
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-2 mb-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="text-sm font-bold text-gray-900 truncate">
                                    @(item.SenderName ?? (item.Type == "NewMessage" ? "New Message" : "FitConnect Notification"))
                                </span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold @GetTypeBadgeClass(item.Type)">
                                    @FormatType(item.Type)
                                </span>
                            </div>
                            <span class="text-[11px] text-gray-400 flex-shrink-0">
                                @FormatTime(item.CreatedAt)
                            </span>
                        </div>

                        <!-- Preview -->
                        <p class="text-xs text-gray-600 line-clamp-2 @(!item.IsRead ? "font-medium text-gray-800" : "")">
                            @(item.MessagePreview ?? "Notification details")
                        </p>

                        <!-- Actions Row -->
                        <div class="mt-3 flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2">
                                @if (item.ConversationId != Guid.Empty)
                                {
                                    <button type="button"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => HandleOpenConversation(item)"
                                            class="inline-flex items-center gap-1 text-xs font-semibold text-[#FF5500] hover:text-[#e04c00] transition">
                                        <span>Open Chat</span>
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                        </svg>
                                    </button>
                                }

                                @if (IsViolationOrReportNotification(item))
                                {
                                    <button type="button"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => HandleAppealClick(item)"
                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-[#FF5500] hover:bg-[#e04c00] rounded-xl shadow-xs transition cursor-pointer"
                                            title="Appeal this report/violation">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                                        </svg>
                                        <span>Appeal</span>
                                    </button>
                                }
                            </div>

                            @if (!item.IsRead)
                            {
                                <button type="button"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => HandleMarkSingleAsReadAsync(item)"
                                        class="text-xs text-gray-400 hover:text-gray-700 font-medium transition cursor-pointer"
                                        title="Mark as read">
                                    Mark as read
                                </button>
                            }
                            else
                            {
                                <span class="text-[11px] text-gray-400 font-normal">Read</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _isMarkingAllRead = false;
    private string? _errorMessage;
    private string? _toastMessage;
    private string _activeFilter = "all";
    private List<NotificationDto> _notifications = new();

    private int _unreadCount => _notifications.Count(n => !n.IsRead);

    private IEnumerable<NotificationDto> FilteredNotifications =>
        _activeFilter == "unread"
            ? _notifications.Where(n => !n.IsRead)
            : _notifications;

    protected override async Task OnInitializedAsync()
    {
        // Trang này dùng bộ lọc riêng, không dùng ô tìm kiếm của topbar
        Shell.ShowSearch = false;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("login");
            return;
        }

        var isTraineeOrCoach = user.IsInRole(AppRoles.Trainee) ||
                               user.IsInRole(AppRoles.Coach) ||
                               user.IsInRole("TRAINEE") ||
                               user.IsInRole("COACH") ||
                               string.Equals(user.FindFirst(ClaimTypes.Role)?.Value, AppRoles.Trainee, StringComparison.OrdinalIgnoreCase) ||
                               string.Equals(user.FindFirst(ClaimTypes.Role)?.Value, AppRoles.Coach, StringComparison.OrdinalIgnoreCase);

        if (!isTraineeOrCoach)
        {
            if (user.IsInRole(AppRoles.Admin) || user.IsInRole("ADMIN") || user.IsInRole(AppRoles.Staff) || user.IsInRole("STAFF"))
            {
                Navigation.NavigateTo("admin");
            }
            else
            {
                Navigation.NavigateTo("home");
            }
            return;
        }

        await LoadNotificationsAsync();
    }

    private async Task LoadNotificationsAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await NotificationService.GetNotificationsAsync();
            if (response.Success && response.Data != null)
            {
                // Sort by CreatedAt newest first
                _notifications = response.Data
                    .OrderByDescending(n => n.CreatedAt ?? DateTime.MinValue)
                    .ToList();
            }
            else
            {
                _errorMessage = response.Message ?? "Failed to retrieve notifications.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "A network or system error occurred while retrieving notifications: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleRefreshAsync()
    {
        await LoadNotificationsAsync();
        ShowToast("Notifications refreshed");
    }

    private async Task HandleMarkAllAsReadAsync()
    {
        if (_unreadCount == 0 || _isMarkingAllRead) return;

        _isMarkingAllRead = true;
        try
        {
            var response = await NotificationService.MarkAllAsReadAsync();
            if (response.Success)
            {
                foreach (var n in _notifications)
                {
                    n.IsRead = true;
                }
                ShowToast("All notifications marked as read");
            }
            else
            {
                _errorMessage = response.Message ?? "Failed to mark all notifications as read.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "An error occurred while marking all notifications as read: " + ex.Message;
        }
        finally
        {
            _isMarkingAllRead = false;
            StateHasChanged();
        }
    }

    private async Task HandleMarkSingleAsReadAsync(NotificationDto item)
    {
        if (item.IsRead) return;

        item.IsRead = true;
        StateHasChanged();

        try
        {
            await NotificationService.MarkAsReadAsync(item.NotificationId);
        }
        catch
        {
            // Non-fatal
        }
    }

    private bool IsViolationOrReportNotification(NotificationDto item)
    {
        var type = item.Type ?? string.Empty;
        if (type.Contains("Violation", StringComparison.OrdinalIgnoreCase) ||
            type.Contains("Report", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var preview = item.MessagePreview ?? string.Empty;
        if (item.ReferenceId.HasValue && item.ReferenceId.Value != Guid.Empty)
        {
            if (preview.Contains("violation", StringComparison.OrdinalIgnoreCase) ||
                preview.Contains("tố cáo", StringComparison.OrdinalIgnoreCase) ||
                preview.Contains("báo cáo", StringComparison.OrdinalIgnoreCase) ||
                preview.Contains("locked", StringComparison.OrdinalIgnoreCase) ||
                preview.Contains("warning", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private async Task HandleAppealClick(NotificationDto item)
    {
        if (!item.IsRead)
        {
            await HandleMarkSingleAsReadAsync(item);
        }

        if (item.ReferenceId.HasValue && item.ReferenceId.Value != Guid.Empty)
        {
            Navigation.NavigateTo($"appeal?reportId={item.ReferenceId.Value}");
        }
        else
        {
            Navigation.NavigateTo("appeal");
        }
    }

    private async Task HandleNotificationClick(NotificationDto item)
    {
        if (!item.IsRead)
        {
            await HandleMarkSingleAsReadAsync(item);
        }

        if (IsViolationOrReportNotification(item) ||
            (item.ReferenceId.HasValue && 
            (item.Type?.Contains("Violation", StringComparison.OrdinalIgnoreCase) == true || 
             item.Type?.Contains("Appeal", StringComparison.OrdinalIgnoreCase) == true || 
             item.Type?.Contains("Report", StringComparison.OrdinalIgnoreCase) == true)))
        {
            if (item.ReferenceId.HasValue && item.ReferenceId.Value != Guid.Empty)
            {
                Navigation.NavigateTo($"appeal?reportId={item.ReferenceId.Value}");
            }
            else
            {
                Navigation.NavigateTo("appeal");
            }
            return;
        }

        if (item.ConversationId != Guid.Empty)
        {
            Navigation.NavigateTo($"messages/{item.ConversationId}");
        }
    }

    private async Task HandleOpenConversation(NotificationDto item)
    {
        if (!item.IsRead)
        {
            await HandleMarkSingleAsReadAsync(item);
        }

        Navigation.NavigateTo($"messages/{item.ConversationId}");
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(3500);
            _toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private string FormatTime(DateTime? dt)
    {
        if (!dt.HasValue) return "";
        var utcTime = dt.Value.Kind switch
        {
            DateTimeKind.Utc => dt.Value,
            DateTimeKind.Local => dt.Value.ToUniversalTime(),
            _ => DateTime.SpecifyKind(dt.Value, DateTimeKind.Utc)
        };
        var span = DateTime.UtcNow - utcTime;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return utcTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }

    private string FormatType(string? type)
    {
        if (string.IsNullOrWhiteSpace(type)) return "Notification";
        return type switch
        {
            "NewMessage" or "NEW_MESSAGE" => "Message",
            "RefundApproved" => "Refund Approved",
            "RefundRejected" => "Refund Rejected",
            "RefundRequested" => "Refund",
            "ViolationWarning" => "Policy Warning",
            "ViolationLock" => "Account Locked",
            "ViolationBlock" => "Profile Blocked",
            "ViolationPostDeleted" => "Post Deleted",
            "Violation" => "Policy Warning",
            "ProcessAppeal" => "Appeal Decision",
            "System" => "System",
            _ when type.Contains("Violation", StringComparison.OrdinalIgnoreCase) => "Policy Violation",
            _ when type.Contains("Report", StringComparison.OrdinalIgnoreCase) => "Report",
            _ => type
        };
    }

    private string GetTypeBadgeClass(string? type)
    {
        return type switch
        {
            "NewMessage" or "NEW_MESSAGE" => "bg-blue-50 text-blue-600",
            "RefundApproved" => "bg-emerald-50 text-emerald-600",
            "RefundRejected" => "bg-red-50 text-red-600",
            "ProcessAppeal" => "bg-indigo-50 text-indigo-600",
            _ when type?.Contains("Violation", StringComparison.OrdinalIgnoreCase) == true => "bg-red-50 text-red-600",
            _ when type?.Contains("Report", StringComparison.OrdinalIgnoreCase) == true => "bg-red-50 text-red-600",
            _ => "bg-orange-50 text-[#FF5500]"
        };
    }

    public void Dispose()
    {
        Shell.Reset();
    }
}

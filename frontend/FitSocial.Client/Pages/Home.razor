                                    <!-- Create Post Modal Dialog (Balanced & Responsive Layout) -->
                                    @if (showCreatePostModal)
                                    {
                                        <div class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/65 backdrop-blur-sm transition-all duration-200"
                                             @onclick="CloseCreatePostModal">
                                            <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full flex flex-col max-h-[92vh] overflow-hidden border border-gray-100 animate-in fade-in zoom-in-95 duration-150"
                                                 @onclick:stopPropagation="true">

                                                <!-- Modal Header -->
                                                <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-white">
                                                    <div class="flex items-center gap-3">
                                                        <div
                                                            class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center shadow-sm">
                                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                                                </path>
                                                            </svg>
                                                        </div>
                                                        <div>
                                                            <h3 class="font-bold text-gray-900 text-lg leading-tight">Create Post</h3>
                                                            <p class="text-xs text-gray-400 mt-0.5">Share workouts, connect with coaches or trainees</p>
                                                        </div>
                                                    </div>
                                                    <button type="button" @onclick="CloseCreatePostModal"
                                                            class="w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-400 hover:text-gray-700 flex items-center justify-center text-xl font-bold transition">
                                                        &times;
                                                    </button>
                                                </div>

                                                <!-- Modal Body -->
                                                <div class="px-6 py-5 overflow-y-auto space-y-5 flex-1 bg-white">

                                                    <!-- Author & Info Row -->
                                                    <div class="flex items-center justify-between">
                                                        <div class="flex items-center gap-3.5">
                                                            <div
                                                                class="w-11 h-11 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold text-base shadow-sm">
                                                                @userInitials
                                                            </div>
                                                            <div>
                                                                <h4 class="font-bold text-gray-900 text-sm">@userName</h4>
                                                                <div class="flex items-center gap-2 mt-0.5">
                                                                    <span
                                                                        class="inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full @(isCoach ? "bg-amber-100 text-amber-800" : "bg-blue-100 text-blue-800")">
                                                                        @(isCoach ? "Coach" : "Trainee")
                                                                    </span>
                                                                    <span class="text-xs text-gray-400">• Public Feed</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Post Type Selector (Role-based: Trainee: Normal | Find Coach, Coach: Normal | Find Coach | Find Trainee) -->
                                                    <div
                                                        class="space-y-2 p-3 rounded-2xl @(hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostType) ? "border-2 border-red-400 bg-red-50/20" : "")">
                                                        <div class="flex items-center justify-between">
                                                            <label
                                                                class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostType) ? "text-red-700" : "text-gray-600")">
                                                                Post Type <span class="text-red-500">*</span>
                                                            </label>
                                                            <span class="text-[11px] text-gray-400">
                                                                @(isCoach ? "Coach: 3 types available" : "Trainee: 2 types available")
                                                            </span>
                                                        </div>

                                                        <div class="grid grid-cols-2 @(isCoach ? "sm:grid-cols-3" : "sm:grid-cols-2") gap-2.5">
                                                            <!-- Normal -->
                                                            <button type="button" @onclick='() => SelectPostType("Normal")'
                                                                    class="flex items-center gap-3 p-3 rounded-xl border text-left transition-all duration-150 @(createPostType == "Normal" ? "border-[#FF5500] bg-orange-50/70 text-[#FF5500] ring-2 ring-[#FF5500]/25 font-semibold shadow-xs" : "border-gray-200 hover:border-gray-300 bg-white text-gray-700")">
                                                                <div
                                                                    class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 @(createPostType == "Normal" ? "bg-[#FF5500] text-white" : "bg-gray-100 text-gray-600")">
                                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z">
                                                                        </path>
                                                                    </svg>
                                                                </div>
                                                                <div class="min-w-0 flex-1">
                                                                    <p class="text-xs font-bold truncate">Normal</p>
                                                                    <p class="text-[11px] text-gray-500 truncate">Workout & tips</p>
                                                                </div>
                                                            </button>

                                                            <!-- Find Coach -->
                                                            <button type="button" @onclick='() => SelectPostType("Find Coach")'
                                                                    class="flex items-center gap-3 p-3 rounded-xl border text-left transition-all duration-150 @(createPostType == "Find Coach" ? "border-amber-500 bg-amber-50/70 text-amber-800 ring-2 ring-amber-500/25 font-semibold shadow-xs" : "border-gray-200 hover:border-gray-300 bg-white text-gray-700")">
                                                                <div
                                                                    class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 @(createPostType == "Find Coach" ? "bg-amber-500 text-white" : "bg-gray-100 text-gray-600")">
                                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                                                    </svg>
                                                                </div>
                                                                <div class="min-w-0 flex-1">
                                                                    <p class="text-xs font-bold truncate">Find Coach</p>
                                                                    <p class="text-[11px] text-gray-500 truncate">Look for trainer</p>
                                                                </div>
                                                            </button>

                                                            <!-- Find Trainee (Visible if Coach) -->
                                                            @if (isCoach)
                                                            {
                                                                <button type="button" @onclick='() => SelectPostType("Find Trainee")'
                                                                        class="flex items-center gap-3 p-3 rounded-xl border text-left transition-all duration-150 @(createPostType == "Find Trainee" ? "border-emerald-500 bg-emerald-50/70 text-emerald-800 ring-2 ring-emerald-500/25 font-semibold shadow-xs" : "border-gray-200 hover:border-gray-300 bg-white text-gray-700")">
                                                                    <div
                                                                        class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 @(createPostType == "Find Trainee" ? "bg-emerald-500 text-white" : "bg-gray-100 text-gray-600")">
                                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                                                                            </path>
                                                                        </svg>
                                                                    </div>
                                                                    <div class="min-w-0 flex-1">
                                                                        <p class="text-xs font-bold truncate">Find Trainee</p>
                                                                        <p class="text-[11px] text-gray-500 truncate">Recruit students</p>
                                                                    </div>
                                                                </button>
                                                            }
                                                        </div>
                                                        @if (hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostType))
                                                        {
                                                            <p class="text-xs text-red-600 font-semibold mt-1.5 flex items-center gap-1 animate-in fade-in">
                                                                <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                    <path fill-rule="evenodd"
                                                                          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                                                          clip-rule="evenodd"></path>
                                                                </svg>
                                                                Please select a Post Type before publishing.
                                                            </p>
                                                        }
                                                        else if (hasAttemptedSubmit && createPostType == "Find Trainee" && !isCoach)
                                                        {
                                                            <p class="text-xs text-red-600 font-semibold mt-1.5 flex items-center gap-1 animate-in fade-in">
                                                                <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                    <path fill-rule="evenodd"
                                                                          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                                                          clip-rule="evenodd"></path>
                                                                </svg>
                                                                Trainees are not permitted to create 'Find Trainee' posts.
                                                            </p>
                                                        }
                                                    </div>

                                                    <!-- Post Text Area (Required) -->
                                                    <div class="space-y-1">
                                                        <div class="flex items-center justify-between">
                                                            <label class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostContent?.Trim()) ? "text-red-700" : "text-gray-600")">
                                                                Content / Description <span class="text-red-500">*</span>
                                                            </label>
                                                            <span class="text-[11px] text-gray-400">@(createPostContent?.Trim().Length ?? 0)/5000</span>
                                                        </div>
                                                        <textarea @bind="createPostContent" placeholder="@GetPostPlaceholder()" rows="4"
                                                                  class="w-full text-sm text-gray-800 placeholder-gray-400 border @(hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostContent?.Trim()) ? "border-red-500 ring-2 ring-red-200 bg-red-50/20" : "border-gray-200 bg-gray-50/40") rounded-xl p-3.5 focus:bg-white focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] resize-none outline-none transition duration-150 leading-relaxed min-h-[110px]"></textarea>
                                                        @if (hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostContent?.Trim()))
                                                        {
                                                            <p class="text-xs text-red-600 font-semibold flex items-center gap-1 animate-in fade-in">
                                                                <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                    <path fill-rule="evenodd"
                                                                          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                                                          clip-rule="evenodd"></path>
                                                                </svg>
                                                                Content is required. Please write something for your post.
                                                            </p>
                                                        }
                                                    </div>

                                                    <!-- Sport & Location Required Dropdowns (2 Columns) -->
                                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                        <div>
                                                            <label
                                                                class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedSubmit && selectedSportId == Guid.Empty ? "text-red-700" : "text-gray-600") mb-1.5 flex items-center gap-1.5">
                                                                <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                          d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                                                </svg>
                                                                Sport / Discipline <span class="text-red-500">*</span>
                                                            </label>
                                                            <select @bind="selectedSportId"
                                                                    class="w-full text-sm bg-gray-50 border @(hasAttemptedSubmit && selectedSportId == Guid.Empty ? "border-red-500 ring-2 ring-red-200 bg-red-50/20 text-red-900" : "border-gray-200 text-gray-800") rounded-xl p-2.5 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] transition">
                                                                <option value="@Guid.Empty">-- Select Sport --</option>
                                                                @foreach (var s in availableSports)
                                                                {
                                                                    <option value="@s.SportId">@s.SportName</option>
                                                                }
                                                            </select>
                                                            @if (hasAttemptedSubmit && selectedSportId == Guid.Empty)
                                                            {
                                                                <p
                                                                    class="text-[11px] text-red-600 font-semibold mt-1 flex items-center gap-1 animate-in fade-in">
                                                                    <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                        <path fill-rule="evenodd"
                                                                              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                                                              clip-rule="evenodd"></path>
                                                                    </svg>
                                                                    Sport is required. Please select one.
                                                                </p>
                                                            }
                                                        </div>

                                                        <div>
                                                            <label
                                                                class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedSubmit && selectedLocationId == Guid.Empty ? "text-red-700" : "text-gray-600") mb-1.5 flex items-center gap-1.5">
                                                                <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                                                    </path>
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                                </svg>
                                                                Gym / Location <span class="text-red-500">*</span>
                                                            </label>
                                                            <select @bind="selectedLocationId"
                                                                    class="w-full text-sm bg-gray-50 border @(hasAttemptedSubmit && selectedLocationId == Guid.Empty ? "border-red-500 ring-2 ring-red-200 bg-red-50/20 text-red-900" : "border-gray-200 text-gray-800") rounded-xl p-2.5 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] transition">
                                                                <option value="@Guid.Empty">-- Select Location --</option>
                                                                @foreach (var l in availableLocations)
                                                                {
                                                                    <option value="@l.LocationId">@l.LocationName</option>
                                                                }
                                                            </select>
                                                            @if (hasAttemptedSubmit && selectedLocationId == Guid.Empty)
                                                            {
                                                                <p
                                                                    class="text-[11px] text-red-600 font-semibold mt-1 flex items-center gap-1 animate-in fade-in">
                                                                    <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                        <path fill-rule="evenodd"
                                                                              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                                                              clip-rule="evenodd"></path>
                                                                    </svg>
                                                                    Location is required. Please select one.
                                                                </p>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- Media Upload Section (Optional, Max 10) -->
                                                    <div
                                                        class="border border-dashed border-gray-300 hover:border-orange-300 rounded-2xl p-4 bg-gray-50/50 transition">
                                                        <div class="flex items-center justify-between mb-2">
                                                            <div class="flex items-center gap-2">
                                                                <span
                                                                    class="text-xs font-bold uppercase tracking-wider text-gray-700 flex items-center gap-1.5">
                                                                    <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                                                        </path>
                                                                    </svg>
                                                                    Attach Media <span class="text-gray-400 font-normal normal-case">(Optional)</span>
                                                                </span>
                                                                <span class="text-xs font-semibold px-2 py-0.5 rounded-full @(selectedMedia.Count >= 10 ? "bg-red-100 text-red-700" : "bg-gray-100 text-gray-600")">
                                                                    Selected Media: @selectedMedia.Count/10
                                                                </span>
                                                            </div>
                                                            @if (selectedMedia.Count < 10)
                                                            {
                                                                <label for="createPostFileInput"
                                                                       class="text-xs text-[#FF5500] font-bold hover:underline cursor-pointer flex items-center gap-1">
                                                                    <span>+ Choose Files</span>
                                                                </label>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-xs text-gray-400 font-semibold cursor-not-allowed">
                                                                    Max reached (10/10)
                                                                </span>
                                                            }
                                                        </div>

                                                        <InputFile id="createPostFileInput" OnChange="HandleFileSelected" multiple accept="image/*,video/*"
                                                                   disabled="@(selectedMedia.Count >= 10 || isSubmittingPost || isUploadingMedia)"
                                                                   class="hidden" />

                                                        @if (selectedMedia.Any())
                                                        {
                                                            <div class="grid grid-cols-3 sm:grid-cols-4 gap-2.5 mt-2">
                                                                @for (int i = 0; i < selectedMedia.Count; i++)
                                                                {
                                                                    var index = i;
                                                                    var media = selectedMedia[index];
                                                                    <div
                                                                        class="relative group rounded-xl overflow-hidden border border-gray-200 bg-gray-100 aspect-square flex items-center justify-center shadow-xs">
                                                                        @if (!string.IsNullOrWhiteSpace(media.PreviewUrl))
                                                                        {
                                                                            <img src="@media.PreviewUrl" alt="Preview" class="w-full h-full object-cover" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="p-2 text-center text-xs text-gray-600 truncate">
                                                                                <span class="text-2xl">🎬</span>
                                                                                <p class="truncate text-[10px] mt-1 font-medium">@media.FileName</p>
                                                                            </div>
                                                                        }
                                                                        <button type="button" @onclick="() => RemoveSelectedFile(index)"
                                                                                disabled="@(isSubmittingPost || isUploadingMedia)"
                                                                                title="Remove media"
                                                                                class="absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-black/75 hover:bg-red-600 text-white flex items-center justify-center text-xs font-bold transition shadow-sm cursor-pointer disabled:opacity-50">
                                                                            &times;
                                                                        </button>
                                                                    </div>
                                                                }
                                                                @if (selectedMedia.Count < 10)
                                                                {
                                                                    <label for="createPostFileInput"
                                                                           class="rounded-xl border-2 border-dashed border-gray-300 hover:border-[#FF5500] bg-gray-50 hover:bg-orange-50/30 aspect-square flex flex-col items-center justify-center cursor-pointer transition text-gray-400 hover:text-[#FF5500]">
                                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                                        </svg>
                                                                        <span class="text-[10px] font-bold mt-1">Add more</span>
                                                                    </label>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <label for="createPostFileInput"
                                                                   class="cursor-pointer py-5 flex flex-col items-center justify-center text-gray-400 hover:text-gray-600 transition rounded-xl hover:bg-orange-50/30">
                                                                <div
                                                                    class="w-10 h-10 rounded-full bg-orange-50 text-[#FF5500] flex items-center justify-center mb-1.5">
                                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                                                        </path>
                                                                    </svg>
                                                                </div>
                                                                <span class="text-xs font-semibold text-gray-700">Click to upload photos or videos (optional)</span>
                                                                <span class="text-[11px] text-gray-400 mt-0.5">PNG, JPG, MP4 (max 10 files)</span>
                                                            </label>
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(mediaErrorMessage))
                                                        {
                                                            <p class="text-xs text-red-600 font-semibold mt-2 flex items-center gap-1 animate-in fade-in">
                                                                <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                    <path fill-rule="evenodd"
                                                                          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                                                          clip-rule="evenodd"></path>
                                                                </svg>
                                                                <span>@mediaErrorMessage</span>
                                                            </p>
                                                        }
                                                    </div>

                                                    <!-- Backend API Error Message (if API returns error) -->
                                                    @if (!string.IsNullOrWhiteSpace(createPostErrorMessage))
                                                    {
                                                        <div class="p-3.5 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700 flex items-center gap-2.5 animate-in fade-in shadow-xs"
                                                             role="alert">
                                                            <svg class="w-4 h-4 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                <path fill-rule="evenodd"
                                                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                                                      clip-rule="evenodd"></path>
                                                            </svg>
                                                            <span>@createPostErrorMessage</span>
                                                        </div>
                                                    }

                                                </div>

                                                <!-- Modal Footer -->
                                                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-100 bg-gray-50/80">
                                                    <button type="button" @onclick="CloseCreatePostModal"
                                                            class="px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-gray-600 hover:bg-gray-200/60 rounded-xl transition">
                                                        Cancel
                                                    </button>
                                                    <button type="button" @onclick="HandleSubmitCreatePost"
                                                            disabled="@(isSubmittingPost || isUploadingMedia)"
                                                            class="px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#FF8C00] via-[#FF5500] to-[#FF3B00] rounded-xl shadow-md hover:shadow-lg hover:opacity-95 disabled:opacity-50 transition flex items-center gap-2 cursor-pointer">
                                                        @if (isUploadingMedia)
                                                        {
                                                            <span
                                                            class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                                            <span>Uploading media...</span>
                                                        }
                                                        else if (isSubmittingPost)
                                                        {
                                                            <span
                                                            class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                                            <span>Publishing...</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Post</span>
                                                        }
                                                    </button>
                                                </div>

                                            </div>
                                        </div>
                                    }

                                    <!-- Edit Post Modal Dialog -->
                                    @if (showEditPostModal && editingPost != null)
                                    {
                                        <div class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/65 backdrop-blur-sm transition-all duration-200"
                                             @onclick="CloseEditPostModal">
                                            <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full flex flex-col max-h-[92vh] overflow-hidden border border-gray-100 animate-in fade-in zoom-in-95 duration-150"
                                                 @onclick:stopPropagation="true">

                                                <!-- Modal Header -->
                                                <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-white">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-[#FF5500] text-white flex items-center justify-center shadow-sm">
                                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                            </svg>
                                                        </div>
                                                        <div>
                                                            <h3 class="font-bold text-gray-900 text-lg leading-tight">Edit Post</h3>
                                                            <p class="text-xs text-gray-400 mt-0.5">Modify content, sport discipline, gym location, or attached media</p>
                                                        </div>
                                                    </div>
                                                    <button type="button" @onclick="CloseEditPostModal" disabled="@(isSubmittingEditPost || isUploadingEditMedia)"
                                                            class="w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-400 hover:text-gray-700 flex items-center justify-center text-xl font-bold transition disabled:opacity-50 cursor-pointer">
                                                        &times;
                                                    </button>
                                                </div>

                                                <!-- Modal Body -->
                                                <div class="px-6 py-5 overflow-y-auto space-y-5 flex-1 bg-white">

                                                    <!-- Post Type Selector (Role-based: Trainee: Normal | Find Coach, Coach: Normal | Find Coach | Find Trainee) -->
                                                    <div class="space-y-2 p-3 rounded-2xl @(hasAttemptedEditSubmit && string.IsNullOrWhiteSpace(editPostType) ? "border-2 border-red-400 bg-red-50/20" : "")">
                                                        <div class="flex items-center justify-between">
                                                            <label class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedEditSubmit && string.IsNullOrWhiteSpace(editPostType) ? "text-red-700" : "text-gray-600")">
                                                                Post Type <span class="text-red-500">*</span>
                                                            </label>
                                                            <span class="text-[11px] text-gray-400">
                                                                @(isCoach ? "Coach: 3 types available" : "Trainee: 2 types available")
                                                            </span>
                                                        </div>

                                                        <div class="grid grid-cols-2 @(isCoach ? "sm:grid-cols-3" : "sm:grid-cols-2") gap-2.5">
                                                            <!-- Normal -->
                                                            <button type="button" @onclick='() => SelectEditPostType("Normal")'
                                                                    class="flex items-center gap-3 p-3 rounded-xl border text-left transition-all duration-150 cursor-pointer @(editPostType == "Normal" ? "border-[#FF5500] bg-orange-50/70 text-[#FF5500] ring-2 ring-[#FF5500]/25 font-semibold shadow-xs" : "border-gray-200 hover:border-gray-300 bg-white text-gray-700")">
                                                                <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 @(editPostType == "Normal" ? "bg-[#FF5500] text-white" : "bg-gray-100 text-gray-600")">
                                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                                                                    </svg>
                                                                </div>
                                                                <div class="min-w-0 flex-1">
                                                                    <p class="text-xs font-bold truncate">Normal</p>
                                                                    <p class="text-[11px] text-gray-500 truncate">Workout & tips</p>
                                                                </div>
                                                            </button>

                                                            <!-- Find Coach -->
                                                            <button type="button" @onclick='() => SelectEditPostType("FindCoach")'
                                                                    class="flex items-center gap-3 p-3 rounded-xl border text-left transition-all duration-150 cursor-pointer @(editPostType == "FindCoach" ? "border-amber-500 bg-amber-50/70 text-amber-800 ring-2 ring-amber-500/25 font-semibold shadow-xs" : "border-gray-200 hover:border-gray-300 bg-white text-gray-700")">
                                                                <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 @(editPostType == "FindCoach" ? "bg-amber-500 text-white" : "bg-gray-100 text-gray-600")">
                                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                                                    </svg>
                                                                </div>
                                                                <div class="min-w-0 flex-1">
                                                                    <p class="text-xs font-bold truncate">Find Coach</p>
                                                                    <p class="text-[11px] text-gray-500 truncate">Look for trainer</p>
                                                                </div>
                                                            </button>

                                                            <!-- Find Trainee (Visible if Coach) -->
                                                            @if (isCoach)
                                                            {
                                                                <button type="button" @onclick='() => SelectEditPostType("FindTrainee")'
                                                                        class="flex items-center gap-3 p-3 rounded-xl border text-left transition-all duration-150 cursor-pointer @(editPostType == "FindTrainee" ? "border-emerald-500 bg-emerald-50/70 text-emerald-800 ring-2 ring-emerald-500/25 font-semibold shadow-xs" : "border-gray-200 hover:border-gray-300 bg-white text-gray-700")">
                                                                    <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 @(editPostType == "FindTrainee" ? "bg-emerald-500 text-white" : "bg-gray-100 text-gray-600")">
                                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                                                        </svg>
                                                                    </div>
                                                                    <div class="min-w-0 flex-1">
                                                                        <p class="text-xs font-bold truncate">Find Trainee</p>
                                                                        <p class="text-[11px] text-gray-500 truncate">Recruit students</p>
                                                                    </div>
                                                                </button>
                                                            }
                                                        </div>
                                                        @if (hasAttemptedEditSubmit && string.IsNullOrWhiteSpace(editPostType))
                                                        {
                                                            <p class="text-xs text-red-600 font-semibold mt-1.5 flex items-center gap-1 animate-in fade-in">
                                                                <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                                                </svg>
                                                                Please select a Post Type before saving.
                                                            </p>
                                                        }
                                                    </div>

                                                    <!-- Post Text Area (Required) -->
                                                    <div class="space-y-1">
                                                        <div class="flex items-center justify-between">
                                                            <label class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedEditSubmit && string.IsNullOrWhiteSpace(editPostContent?.Trim()) ? "text-red-700" : "text-gray-600")">
                                                                Content / Description <span class="text-red-500">*</span>
                                                            </label>
                                                            <span class="text-[11px] text-gray-400">@(editPostContent?.Trim().Length ?? 0)/5000</span>
                                                        </div>
                                                        <textarea @bind="editPostContent" rows="4"
                                                                  class="w-full text-sm text-gray-800 placeholder-gray-400 border @(hasAttemptedEditSubmit && string.IsNullOrWhiteSpace(editPostContent?.Trim()) ? "border-red-500 ring-2 ring-red-200 bg-red-50/20" : "border-gray-200 bg-gray-50/40") rounded-xl p-3.5 focus:bg-white focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] resize-none outline-none transition duration-150 leading-relaxed min-h-[110px]"></textarea>
                                                        @if (hasAttemptedEditSubmit && string.IsNullOrWhiteSpace(editPostContent?.Trim()))
                                                        {
                                                            <p class="text-xs text-red-600 font-semibold flex items-center gap-1 animate-in fade-in">
                                                                <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                                                </svg>
                                                                Content is required. Please write something for your post.
                                                            </p>
                                                        }
                                                    </div>

                                                    <!-- Sport & Location Dropdowns (2 Columns) -->
                                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                        <div>
                                                            <label class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedEditSubmit && editSportId == Guid.Empty ? "text-red-700" : "text-gray-600") mb-1.5 flex items-center gap-1.5">
                                                                <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                                                </svg>
                                                                Sport / Discipline <span class="text-red-500">*</span>
                                                            </label>
                                                            <select @bind="editSportId"
                                                                    class="w-full text-sm bg-gray-50 border @(hasAttemptedEditSubmit && editSportId == Guid.Empty ? "border-red-500 ring-2 ring-red-200 bg-red-50/20 text-red-900" : "border-gray-200 text-gray-800") rounded-xl p-2.5 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] transition">
                                                                <option value="@Guid.Empty">-- Select Sport --</option>
                                                                @foreach (var s in availableSports)
                                                                {
                                                                    <option value="@s.SportId">@s.SportName</option>
                                                                }
                                                            </select>
                                                            @if (hasAttemptedEditSubmit && editSportId == Guid.Empty)
                                                            {
                                                                <p class="text-[11px] text-red-600 font-semibold mt-1 flex items-center gap-1 animate-in fade-in">
                                                                    <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                                                    </svg>
                                                                    Sport is required. Please select one.
                                                                </p>
                                                            }
                                                        </div>

                                                        <div>
                                                            <label class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedEditSubmit && editLocationId == Guid.Empty ? "text-red-700" : "text-gray-600") mb-1.5 flex items-center gap-1.5">
                                                                <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                                </svg>
                                                                Gym / Location <span class="text-red-500">*</span>
                                                            </label>
                                                            <select @bind="editLocationId"
                                                                    class="w-full text-sm bg-gray-50 border @(hasAttemptedEditSubmit && editLocationId == Guid.Empty ? "border-red-500 ring-2 ring-red-200 bg-red-50/20 text-red-900" : "border-gray-200 text-gray-800") rounded-xl p-2.5 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] transition">
                                                                <option value="@Guid.Empty">-- Select Location --</option>
                                                                @foreach (var l in availableLocations)
                                                                {
                                                                    <option value="@l.LocationId">@l.LocationName</option>
                                                                }
                                                            </select>
                                                            @if (hasAttemptedEditSubmit && editLocationId == Guid.Empty)
                                                            {
                                                                <p class="text-[11px] text-red-600 font-semibold mt-1 flex items-center gap-1 animate-in fade-in">
                                                                    <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                                                    </svg>
                                                                    Location is required. Please select one.
                                                                </p>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- Media Section (Existing + New Additions, Max 10) -->
                                                    <div class="border border-dashed border-gray-300 hover:border-orange-300 rounded-2xl p-4 bg-gray-50/50 transition">
                                                        <div class="flex items-center justify-between mb-2">
                                                            <div class="flex items-center gap-2">
                                                                <span class="text-xs font-bold uppercase tracking-wider text-gray-700 flex items-center gap-1.5">
                                                                    <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                                    </svg>
                                                                    Attached Media
                                                                </span>
                                                                <span class="text-xs font-semibold px-2 py-0.5 rounded-full @(TotalEditMediaCount >= 10 ? "bg-red-100 text-red-700" : "bg-gray-100 text-gray-600")">
                                                                    Total Media: @TotalEditMediaCount/10
                                                                </span>
                                                            </div>
                                                            @if (TotalEditMediaCount < 10)
                                                            {
                                                                <label for="editPostFileInput"
                                                                       class="text-xs text-[#FF5500] font-bold hover:underline cursor-pointer flex items-center gap-1">
                                                                    <span>+ Add More Files</span>
                                                                </label>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-xs text-gray-400 font-semibold cursor-not-allowed">
                                                                    Max reached (10/10)
                                                                </span>
                                                            }
                                                        </div>

                                                        <InputFile @key="editFileInputKey" id="editPostFileInput" OnChange="HandleEditFileSelected" multiple accept="image/*,video/*"
                                                                   disabled="@(TotalEditMediaCount >= 10 || isSubmittingEditPost || isUploadingEditMedia)"
                                                                   class="hidden" />

                                                        @if (TotalEditMediaCount > 0)
                                                        {
                                                            <div class="grid grid-cols-3 sm:grid-cols-4 gap-2.5 mt-2">
                                                                <!-- 1. Existing media not removed -->
                                                                @foreach (var media in editExistingMedia.Where(m => !editRemovedMediaIds.Contains(m.Id)))
                                                                {
                                                                    var currentId = media.Id;
                                                                    <div class="relative group rounded-xl overflow-hidden border border-gray-200 bg-gray-100 aspect-square flex items-center justify-center shadow-xs">
                                                                        @if (string.Equals(media.MediaType, "VIDEO", StringComparison.OrdinalIgnoreCase))
                                                                        {
                                                                            <div class="p-2 text-center text-xs text-gray-600 truncate">
                                                                                <span class="text-2xl">🎬</span>
                                                                                <p class="truncate text-[10px] mt-1 font-medium text-gray-500">Video</p>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <img src="@media.MediaUrl" alt="Media" class="w-full h-full object-cover" />
                                                                        }
                                                                        <span class="absolute bottom-1.5 left-1.5 bg-black/60 text-white text-[9px] font-semibold px-1.5 py-0.5 rounded-md backdrop-blur-xs">
                                                                            Saved
                                                                        </span>
                                                                        <button type="button" @onclick="() => RemoveExistingMedia(currentId)"
                                                                                disabled="@(isSubmittingEditPost || isUploadingEditMedia)"
                                                                                title="Remove media"
                                                                                class="absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-black/75 hover:bg-red-600 text-white flex items-center justify-center text-xs font-bold transition shadow-sm cursor-pointer disabled:opacity-50">
                                                                            &times;
                                                                        </button>
                                                                    </div>
                                                                }

                                                                <!-- 2. Newly selected media -->
                                                                @for (int i = 0; i < editNewSelectedMedia.Count; i++)
                                                                {
                                                                    var index = i;
                                                                    var media = editNewSelectedMedia[index];
                                                                    <div class="relative group rounded-xl overflow-hidden border-2 border-orange-400 bg-orange-50/30 aspect-square flex items-center justify-center shadow-xs">
                                                                        @if (!string.IsNullOrWhiteSpace(media.PreviewUrl))
                                                                        {
                                                                            <img src="@media.PreviewUrl" alt="Preview" class="w-full h-full object-cover" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="p-2 text-center text-xs text-gray-600 truncate">
                                                                                <span class="text-2xl">🎬</span>
                                                                                <p class="truncate text-[10px] mt-1 font-medium">@media.FileName</p>
                                                                            </div>
                                                                        }
                                                                        <span class="absolute bottom-1.5 left-1.5 bg-[#FF5500] text-white text-[9px] font-semibold px-1.5 py-0.5 rounded-md shadow-xs">
                                                                            New
                                                                        </span>
                                                                        <button type="button" @onclick="() => RemoveNewSelectedMedia(media.Id)"
                                                                                disabled="@(isSubmittingEditPost || isUploadingEditMedia)"
                                                                                title="Remove new media"
                                                                                class="absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-black/75 hover:bg-red-600 text-white flex items-center justify-center text-xs font-bold transition shadow-sm cursor-pointer disabled:opacity-50">
                                                                            &times;
                                                                        </button>
                                                                    </div>
                                                                }

                                                                <!-- 3. Add more button if slots remaining -->
                                                                @if (TotalEditMediaCount < 10)
                                                                {
                                                                    <label for="editPostFileInput"
                                                                           class="rounded-xl border-2 border-dashed border-gray-300 hover:border-[#FF5500] bg-gray-50 hover:bg-orange-50/30 aspect-square flex flex-col items-center justify-center cursor-pointer transition text-gray-400 hover:text-[#FF5500]">
                                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                                        </svg>
                                                                        <span class="text-[10px] font-bold mt-1">Add more</span>
                                                                    </label>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <label for="editPostFileInput"
                                                                   class="cursor-pointer py-5 flex flex-col items-center justify-center text-gray-400 hover:text-gray-600 transition rounded-xl hover:bg-orange-50/30">
                                                                <div class="w-10 h-10 rounded-full bg-orange-50 text-[#FF5500] flex items-center justify-center mb-1.5">
                                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                                    </svg>
                                                                </div>
                                                                <span class="text-xs font-semibold text-gray-700">Click to upload photos or videos (optional)</span>
                                                                <span class="text-[11px] text-gray-400 mt-0.5">PNG, JPG, MP4 (max 10 files)</span>
                                                            </label>
                                                        }

                                                        @if (!string.IsNullOrWhiteSpace(editMediaErrorMessage))
                                                        {
                                                            <p class="text-xs text-red-600 font-semibold mt-2 flex items-center gap-1 animate-in fade-in">
                                                                <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                                                </svg>
                                                                <span>@editMediaErrorMessage</span>
                                                            </p>
                                                        }
                                                    </div>

                                                    <!-- Backend API Error Message (if API returns error) -->
                                                    @if (!string.IsNullOrWhiteSpace(editPostErrorMessage))
                                                    {
                                                        <div class="p-3.5 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700 flex items-center gap-2.5 animate-in fade-in shadow-xs" role="alert">
                                                            <svg class="w-4 h-4 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                                            </svg>
                                                            <span>@editPostErrorMessage</span>
                                                        </div>
                                                    }

                                                </div>

                                                <!-- Modal Footer -->

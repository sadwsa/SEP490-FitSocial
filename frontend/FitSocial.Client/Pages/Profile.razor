@page "/profile"
@namespace FitSocial.Client.Pages
@layout EmptyLayout
@attribute [Authorize]

<PageTitle>@(isEditing ? "Edit Profile - FitSocial" : "My Profile - FitSocial")</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <!-- Header / Navigation Bar -->
    <AppHeader SearchTerm="@headerSearchTerm" OnSearchInput="HandleHeaderSearchInput"
               OnSearchKeyUp="HandleHeaderSearchKeyUp" OnSearch="ExecuteHeaderSearch" OnClearSearch="ClearHeaderSearch"
               UserName="@headerUserName" UserInitials="@headerUserInitials" UserRole="@headerUserRole"
               UserAvatarUrl="@headerUserAvatarUrl" OnLogout="HandleLogout" />

    <style>
        @@media (min-width: 1024px) {
            .home-3col-layout {
                display: grid !important;
                grid-template-columns: minmax(18rem, 1fr) minmax(0, 42rem) minmax(18rem, 1fr) !important;
                align-items: start !important;
            }

            .home-left-sidebar {
                justify-self: start !important;
            }

            .home-center-feed {
                justify-self: end !important;
                width: 100% !important;
                max-width: 42rem !important;
                min-width: 0 !important;
            }

            .home-right-sidebar {
                justify-self: center !important;
            }
        }
    </style>

    <!-- Main Content Layout -->
    <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">
        <!-- Left Sidebar -->
        <AppSidebar ActiveItem="profile" />

        <!-- Center Column -->
        <section class="home-center-feed w-full max-w-2xl flex flex-col gap-6 min-w-0 pb-12">

            @if (isLoading)
            {
                <!-- Loading Skeleton -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden animate-pulse">
                    <div class="h-28 bg-gradient-to-r from-orange-200 to-amber-200"></div>
                    <div class="px-6 pb-6 pt-0 relative flex flex-row items-end gap-4 sm:gap-6">
                        <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-gray-200 border-4 border-white shadow-md flex-shrink-0 -mt-14 sm:-mt-16"></div>
                        <div class="flex-1 space-y-2 pt-3 sm:pt-4 pb-1" style="text-align: left !important;">
                            <div class="h-6 sm:h-8 bg-gray-200 rounded w-48 mb-2"></div>
                            <div class="flex gap-2">
                                <div class="h-6 bg-gray-200 rounded-full w-20"></div>
                                <div class="h-6 bg-gray-200 rounded-full w-28"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-4 animate-pulse">
                    <div class="h-5 bg-gray-200 rounded w-40"></div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <!-- Error State -->
                <div class="bg-white rounded-2xl shadow-sm border border-red-100 p-8 text-center flex flex-col items-center">
                    <div class="w-16 h-16 rounded-full bg-red-50 text-red-500 flex items-center justify-center mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-900 mb-2">Unable to Load Profile</h2>
                    <p class="text-gray-600 text-sm max-w-md mb-6">@errorMessage</p>

                    @if (isUnauthorized)
                    {
                        <button type="button" @onclick="GoToLogin"
                                class="px-6 py-2.5 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white font-semibold text-sm rounded-xl shadow-md hover:shadow-lg transition cursor-pointer">
                            Sign In Again
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="LoadProfileAsync"
                                class="px-6 py-2.5 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white font-semibold text-sm rounded-xl shadow-md hover:shadow-lg transition cursor-pointer">
                            Try Again
                        </button>
                    }
                </div>
            }
            else if (profile != null)
            {
                <!-- Profile Notifications -->
                @if (!string.IsNullOrEmpty(saveSuccessMessage))
                {
                    <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between gap-3 shadow-xs animate-fade-in">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            <span class="font-medium truncate">@saveSuccessMessage</span>
                        </div>
                        <button type="button" @onclick="() => saveSuccessMessage = null" class="text-emerald-600 hover:text-emerald-800 text-xs font-bold px-2 py-1 cursor-pointer">✕</button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(saveErrorMessage))
                {
                    <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-800 text-sm flex items-center justify-between gap-3 shadow-xs animate-fade-in">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                            <span class="font-medium">@saveErrorMessage</span>
                        </div>
                        <button type="button" @onclick="() => saveErrorMessage = null" class="text-red-600 hover:text-red-800 text-xs font-bold px-2 py-1 cursor-pointer">✕</button>
                    </div>
                }

                <!-- Profile Header Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <!-- Banner -->
                    <div class="h-28 sm:h-32 bg-gradient-to-r from-[#FF8C00] via-[#FF5500] to-[#FF3B00] relative">
                        <div class="absolute inset-0 bg-black/10"></div>
                    </div>

                    <!-- Avatar + Name + Role Header + Actions -->
                    <div class="px-6 pb-6 pt-0 relative flex flex-col sm:flex-row sm:items-end justify-between gap-4 sm:gap-6">
                        <div class="flex flex-row items-end gap-4 sm:gap-6 min-w-0">
                            <!-- Avatar -->
                            <div class="relative -mt-14 sm:-mt-16 flex-shrink-0">
                                <InputFile id="profileAvatarFileInput" OnChange="HandleAvatarSelected" accept=".jpg,.jpeg,.png,.webp" style="display:none;" />
                                @{
                                    var currentAvatar = isEditing ? editModel.AvatarUrl : profile.AvatarUrl;
                                }
                                @if (AvatarHelper.HasValidAvatarUrl(currentAvatar))
                                {
                                    <img @key="@($"avatar-{currentAvatar}")"
                                         src="@currentAvatar" alt="@(isEditing ? editModel.FullName : profile.FullName)"
                                         class="w-24 h-24 sm:w-32 sm:h-32 rounded-full object-cover border-4 border-white shadow-lg bg-white"
                                         referrerpolicy="no-referrer"
                                         onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                    <div @key="@($"avatar-fallback-{currentAvatar}")"
                                         class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white items-center justify-center font-bold text-2xl sm:text-4xl border-4 border-white shadow-lg"
                                         style="display: none;">
                                        @AvatarHelper.GetInitials(isEditing ? editModel.FullName : profile.FullName)
                                    </div>
                                }
                                else
                                {
                                    <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold text-2xl sm:text-4xl border-4 border-white shadow-lg">
                                        @AvatarHelper.GetInitials(isEditing ? editModel.FullName : profile.FullName)
                                    </div>
                                }

                                @if (!isEditing)
                                {
                                    <button type="button" @onclick="EnterEditMode"
                                            class="absolute bottom-0 right-0 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white text-gray-700 hover:text-[#FF5500] border-2 border-white shadow-md flex items-center justify-center transition cursor-pointer"
                                            title="Change profile picture">
                                        <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                    </button>
                                }
                                else
                                {
                                    <label for="profileAvatarFileInput"
                                           class="absolute inset-0 rounded-full bg-black/45 hover:bg-black/60 text-white flex flex-col items-center justify-center cursor-pointer transition select-none"
                                           title="Upload a new profile picture">
                                        @if (isUploadingAvatar)
                                        {
                                            <span class="w-6 h-6 border-2 border-white border-t-transparent rounded-full animate-spin mb-1"></span>
                                            <span class="text-[10px] font-semibold">Uploading...</span>
                                        }
                                        else
                                        {
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                            </svg>
                                            <span class="text-[11px] font-semibold mt-0.5">Change</span>
                                        }
                                    </label>
                                }
                            </div>

                            <!-- Name and Role Title -->
                            <div class="flex-1 min-w-0 pt-3 sm:pt-4 pb-1" style="text-align: left !important;">
                                <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold text-gray-900 truncate"
                                    style="text-align: left !important; margin: 0 0 0.5rem 0; line-height: 1.25;">
                                    @(isEditing ? (string.IsNullOrWhiteSpace(editModel.FullName) ? "Your Name" : editModel.FullName) : (string.IsNullOrWhiteSpace(profile.FullName) ? "Athlete" : profile.FullName))
                                </h1>

                                <div class="flex flex-wrap items-center gap-2 sm:gap-2.5"
                                     style="justify-content: flex-start !important; text-align: left !important;">
                                    @if (profile.IsCoach)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-orange-50 text-[#FF5500] border border-orange-200 shadow-2xs">
                                            <svg class="w-3.5 h-3.5 text-[#FF5500]" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                            </svg>
                                            Coach
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-2xs">
                                            <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                                            </svg>
                                            Trainee
                                        </span>
                                    }

                                    @if (profile.CreatedAt.HasValue)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-gray-50 text-gray-600 border border-gray-200 shadow-2xs">
                                            <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                            Joined @profile.CreatedAt.Value.ToString("MMM yyyy")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Top Action Buttons (Edit Profile / Save / Cancel) -->
                        <div class="flex items-center gap-2 self-start sm:self-end pt-2 sm:pt-0">
                            @if (!isEditing)
                            {
                                <button type="button" @onclick="EnterEditMode"
                                        class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] hover:from-[#e07b00] hover:to-[#e04b00] text-white text-xs sm:text-sm font-semibold rounded-xl shadow-sm hover:shadow-md transition cursor-pointer">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                    </svg>
                                    Edit Profile
                                </button>
                            }
                            else
                            {
                                <button type="button" @onclick="CancelEdit" disabled="@isSaving"
                                        class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs sm:text-sm font-semibold rounded-xl transition cursor-pointer disabled:opacity-50">
                                    Cancel
                                </button>
                                <button type="button" @onclick="SaveProfileAsync" disabled="@(isSaving || isUploadingAvatar)"
                                        class="inline-flex items-center gap-1.5 px-5 py-2 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] hover:from-[#e07b00] hover:to-[#e04b00] text-white text-xs sm:text-sm font-semibold rounded-xl shadow-sm hover:shadow-md transition cursor-pointer disabled:opacity-50">
                                    @if (isSaving)
                                    {
                                        <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>
                                        <span>Save</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>

                    @if (isEditing && !string.IsNullOrEmpty(avatarUploadError))
                    {
                        <div class="px-6 pb-4">
                            <p class="text-xs text-red-500 font-medium">@avatarUploadError</p>
                        </div>
                    }
                </div>

                <!-- Personal Information Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-7">
                    <div class="flex items-center justify-between mb-5 pb-3 border-b border-gray-100">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-orange-50 text-[#FF5500] flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-bold text-gray-900">Personal Information</h2>
                                <p class="text-xs text-gray-500">@(isEditing ? "Update your personal and contact details" : "Account and contact details")</p>
                            </div>
                        </div>

                        @if (isEditing)
                        {
                            <span class="text-xs font-semibold text-orange-600 bg-orange-50 px-2.5 py-1 rounded-lg">Editing Mode</span>
                        }
                    </div>

                    @if (!isEditing)
                    {
                        <!-- View Mode Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Email -->
                            <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                                <div class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-medium text-gray-400">Email Address</p>
                                    <p class="text-sm font-semibold text-gray-800 truncate mt-0.5" title="@profile.Email">@profile.Email</p>
                                </div>
                            </div>

                            <!-- Phone Number -->
                            <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                                <div class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-medium text-gray-400">Phone Number</p>
                                    <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                        @(string.IsNullOrWhiteSpace(profile.PhoneNumber) ? "Not provided" : profile.PhoneNumber)
                                    </p>
                                </div>
                            </div>

                            <!-- Date of Birth -->
                            <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                                <div class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-medium text-gray-400">Date of Birth</p>
                                    <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                        @(profile.DateOfBirth.HasValue ? profile.DateOfBirth.Value.ToString("dd/MM/yyyy") : "Not specified")
                                    </p>
                                </div>
                            </div>

                            <!-- Gender -->
                            <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                                <div class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-medium text-gray-400">Gender</p>
                                    <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                        @(string.IsNullOrWhiteSpace(profile.Gender) ? "Not specified" : profile.Gender)
                                    </p>
                                </div>
                            </div>

                            <!-- Joined Date -->
                            <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3 sm:col-span-2">
                                <div class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-medium text-gray-400">Member Since</p>
                                    <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                        @(profile.CreatedAt.HasValue ? profile.CreatedAt.Value.ToString("MMMM dd, yyyy") : "N/A")
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Edit Mode Inputs -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Avatar Management -->
                            <div class="sm:col-span-2 p-4 bg-orange-50/40 rounded-2xl border border-orange-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                <div class="flex items-center gap-3.5">
                                    <div class="relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 border-2 border-white shadow-sm bg-gray-100">
                                        @if (AvatarHelper.HasValidAvatarUrl(editModel.AvatarUrl))
                                        {
                                            <img @key="@($"edit-preview-{editModel.AvatarUrl}")" src="@editModel.AvatarUrl" alt="Avatar preview" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold text-lg">
                                                @AvatarHelper.GetInitials(editModel.FullName)
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-gray-900">Profile Photo</p>
                                        <p class="text-xs text-gray-500">Supports JPG, PNG or WEBP (Max 10MB). Automatically cropped to 500x500.</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 self-stretch sm:self-auto justify-end">
                                    <label for="profileAvatarFileInput"
                                           class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-orange-50 text-[#FF5500] border border-orange-200 text-xs font-semibold rounded-xl shadow-2xs transition cursor-pointer @(isUploadingAvatar ? "opacity-50 pointer-events-none" : "")">
                                        @if (isUploadingAvatar)
                                        {
                                            <span class="w-3.5 h-3.5 border-2 border-[#FF5500] border-t-transparent rounded-full animate-spin"></span>
                                            <span>Uploading...</span>
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                                            </svg>
                                            <span>Upload Photo</span>
                                        }
                                    </label>
                                    @if (AvatarHelper.HasValidAvatarUrl(editModel.AvatarUrl))
                                    {
                                        <button type="button" @onclick="RemoveAvatar" disabled="@isUploadingAvatar"
                                                class="px-3 py-2 bg-white hover:bg-red-50 text-red-600 border border-red-200 text-xs font-semibold rounded-xl shadow-2xs transition cursor-pointer disabled:opacity-50">
                                            Remove
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(avatarUploadError))
                            {
                                <div class="sm:col-span-2 -mt-2">
                                    <p class="text-xs text-red-500 font-medium">@avatarUploadError</p>
                                </div>
                            }

                            <!-- Full Name -->
                            <div class="flex flex-col gap-1.5 sm:col-span-2">
                                <label class="text-xs font-semibold text-gray-700">Full Name <span class="text-[11px] text-gray-400 font-normal ml-1">(Leave blank to keep current)</span></label>
                                <input type="text" @bind="editModel.FullName" @bind:event="oninput" @onblur="OnFullNameBlur"
                                       maxlength="100" placeholder="@(string.IsNullOrWhiteSpace(profile.FullName) ? "e.g. Nguyen Hoang" : profile.FullName)"
                                       class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border @(string.IsNullOrEmpty(fullNameError) ? "border-gray-200 focus:border-orange-500" : "border-red-400 focus:border-red-500") rounded-xl outline-none transition" />
                                @if (!string.IsNullOrEmpty(fullNameError))
                                {
                                    <p class="text-xs text-red-500 font-medium">@fullNameError</p>
                                }
                            </div>

                            <!-- Phone Number -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-semibold text-gray-700">Phone Number <span class="text-[11px] text-gray-400 font-normal ml-1">(Leave blank to keep current)</span></label>
                                <input type="tel" @bind="editModel.PhoneNumber" @bind:event="oninput" @onblur="OnPhoneBlur"
                                       maxlength="10" placeholder="@(string.IsNullOrWhiteSpace(profile.PhoneNumber) ? "0xxxxxxxxx" : profile.PhoneNumber)"
                                       class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border @(string.IsNullOrEmpty(phoneError) ? "border-gray-200 focus:border-orange-500" : "border-red-400 focus:border-red-500") rounded-xl outline-none transition" />
                                @if (!string.IsNullOrEmpty(phoneError))
                                {
                                    <p class="text-xs text-red-500 font-medium">@phoneError</p>
                                }
                            </div>

                            <!-- Date of Birth -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-semibold text-gray-700">Date of Birth <span class="text-[11px] text-gray-400 font-normal ml-1">(Leave blank to keep current)</span></label>
                                <input type="date" value="@editDobString" @onchange="OnDobChanged"
                                       max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" min="1900-01-01"
                                       class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border @(string.IsNullOrEmpty(dobError) ? "border-gray-200 focus:border-orange-500" : "border-red-400 focus:border-red-500") rounded-xl outline-none transition" />
                                @if (!string.IsNullOrEmpty(dobError))
                                {
                                    <p class="text-xs text-red-500 font-medium">@dobError</p>
                                }
                            </div>

                            <!-- Gender -->
                            <div class="flex flex-col gap-1.5">
                                <label class="text-xs font-semibold text-gray-700">Gender <span class="text-[11px] text-gray-400 font-normal ml-1">(Leave blank to keep current)</span></label>
                                <select @bind="editModel.Gender"
                                        class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border border-gray-200 focus:border-orange-500 rounded-xl outline-none transition">
                                    <option value="">@(string.IsNullOrWhiteSpace(profile.Gender) ? "Not specified" : $"Keep current ({profile.Gender})")</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>

                            <!-- Email Address (Read-only Account Identifier) -->
                            <div class="flex flex-col gap-1.5">
                                <div class="flex items-center justify-between">
                                    <label class="text-xs font-semibold text-gray-700">Email Address</label>
                                    <span class="text-[11px] text-gray-400">Read-only</span>
                                </div>
                                <input type="email" value="@profile.Email" disabled
                                       class="w-full px-3.5 py-2.5 text-sm bg-gray-100 border border-gray-200 rounded-xl text-gray-500 cursor-not-allowed" />
                            </div>
                        </div>
                    }
                </div>

                @if (profile.IsCoach)
                {
                    <!-- Coach-Specific Information Card -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-7">
                        <div class="flex items-center gap-3 mb-5 pb-3 border-b border-gray-100">
                            <div class="w-9 h-9 rounded-xl bg-orange-50 text-[#FF5500] flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-bold text-gray-900">Coach Information</h2>
                                <p class="text-xs text-gray-500">Coaching credentials and biography</p>
                            </div>
                        </div>

                        @if (!isEditing)
                        {
                            <!-- View Mode Highlights Row -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                                <!-- Experience Years -->
                                <div class="p-4 bg-orange-50/60 rounded-xl border border-orange-100/80 flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-xl bg-white text-[#FF5500] flex items-center justify-center font-extrabold text-xl shadow-xs">
                                        @(profile.ExperienceYears ?? 0)
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-gray-900">Years of Experience</p>
                                        <p class="text-xs text-gray-500">Professional fitness coaching</p>
                                    </div>
                                </div>

                                <!-- Verification Approval Status -->
                                <div class="p-4 bg-gray-50 rounded-xl border border-gray-100 flex items-center justify-between">
                                    <div>
                                        <p class="text-sm font-bold text-gray-900">Verification Status</p>
                                        <p class="text-xs text-gray-500">Platform coach credentials</p>
                                    </div>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold @GetApprovalBadgeClass(profile.ApprovalStatus)">
                                        @GetApprovalStatusLabel(profile.ApprovalStatus)
                                    </span>
                                </div>
                            </div>

                            <!-- Biography -->
                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Biography</label>
                                @if (!string.IsNullOrWhiteSpace(profile.Bio))
                                {
                                    <div class="p-4 bg-gray-50/70 rounded-xl border border-gray-100 text-sm text-gray-700 leading-relaxed whitespace-pre-line">
                                        @profile.Bio
                                    </div>
                                }
                                else
                                {
                                    <div class="p-4 bg-gray-50/70 rounded-xl border border-gray-100 text-sm text-gray-400 italic">
                                        No biography provided yet.
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Edit Mode Coach Inputs -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                                <!-- Experience Years -->
                                <div class="flex flex-col gap-1.5">
                                    <label class="text-xs font-semibold text-gray-700">Years of Experience (0 - 60) <span class="text-[11px] text-gray-400 font-normal ml-1">(Leave blank to keep current)</span></label>
                                    <input type="number" min="0" max="60" @bind="editModel.ExperienceYears" @bind:event="oninput" @onblur="OnExperienceBlur"
                                           placeholder="@(profile.ExperienceYears?.ToString() ?? "e.g. 5")"
                                           class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border @(string.IsNullOrEmpty(experienceError) ? "border-gray-200 focus:border-orange-500" : "border-red-400 focus:border-red-500") rounded-xl outline-none transition" />
                                    @if (!string.IsNullOrEmpty(experienceError))
                                    {
                                        <p class="text-xs text-red-500 font-medium">@experienceError</p>
                                    }
                                </div>

                                <!-- Verification Status (Platform Status - Read-only) -->
                                <div class="p-3.5 bg-gray-50 rounded-xl border border-gray-100 flex items-center justify-between">
                                    <div>
                                        <p class="text-xs font-semibold text-gray-700">Verification Status</p>
                                        <p class="text-[11px] text-gray-400">Platform credential status</p>
                                    </div>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold @GetApprovalBadgeClass(profile.ApprovalStatus)">
                                        @GetApprovalStatusLabel(profile.ApprovalStatus)
                                    </span>
                                </div>
                            </div>

                            <!-- Biography -->
                            <div class="flex flex-col gap-1.5">
                                <div class="flex items-center justify-between">
                                    <label class="text-xs font-semibold text-gray-700">Biography <span class="text-[11px] text-gray-400 font-normal ml-1">(Leave blank to keep current)</span></label>
                                    <span class="text-[11px] text-gray-400">@((editModel.Bio?.Length ?? 0))/2000</span>
                                </div>
                                <textarea rows="4" maxlength="2000" @bind="editModel.Bio" @bind:event="oninput" @onblur="OnBioBlur"
                                          placeholder="@(string.IsNullOrWhiteSpace(profile.Bio) ? "Describe your training philosophy, specialties, and experience..." : "Leave blank to keep current biography...")"
                                          class="w-full px-3.5 py-2.5 text-sm bg-gray-50 border @(string.IsNullOrEmpty(bioError) ? "border-gray-200 focus:border-orange-500" : "border-red-400 focus:border-red-500") rounded-xl outline-none transition resize-none"></textarea>
                                @if (!string.IsNullOrEmpty(bioError))
                                {
                                    <p class="text-xs text-red-500 font-medium">@bioError</p>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- Bottom Action Controls when Editing -->
                @if (isEditing)
                {
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 sm:p-5 flex items-center justify-end gap-3">
                        <button type="button" @onclick="CancelEdit" disabled="@isSaving"
                                class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm rounded-xl transition cursor-pointer disabled:opacity-50">
                            Cancel
                        </button>
                        <button type="button" @onclick="SaveProfileAsync" disabled="@(isSaving || isUploadingAvatar)"
                                class="px-6 py-2.5 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] hover:from-[#e07b00] hover:to-[#e04b00] text-white font-semibold text-sm rounded-xl shadow-md hover:shadow-lg transition cursor-pointer disabled:opacity-50 flex items-center gap-2">
                            @if (isSaving)
                            {
                                <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                <span>Save Changes</span>
                            }
                        </button>
                    </div>
                }
            }

        </section>

        <!-- Right Spacer (Empty to maintain 3-column balance on desktop) -->
        <div class="home-right-sidebar hidden lg:block w-72 flex-shrink-0"></div>
    </div>
</div>

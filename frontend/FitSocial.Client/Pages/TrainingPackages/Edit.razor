@page "/training-packages/edit/{Id:guid}"
@layout EmptyLayout
@inject ITrainingPackageService PackageService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject FitSocial.Client.Services.Auth.IAuthService AuthService
@inject FitSocial.Client.Services.Cart.ICartService CartService
@inject IJSRuntime JS
@using FitSocial.Client.Layout
@using FitSocial.Client.Models.TrainingPackages
@using System.Security.Claims

<PageTitle>Edit Training Package - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <!-- Floating Success Toast Notification -->
    @if (!string.IsNullOrWhiteSpace(toastSuccessMessage))
    {
        <div class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-emerald-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-emerald-500/50 backdrop-blur transition-all duration-300 animate-in fade-in slide-in-from-top-4">
            <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <span>@toastSuccessMessage</span>
            <button type="button" @onclick="() => toastSuccessMessage = null"
                    class="ml-2 text-white/80 hover:text-white text-lg font-bold transition cursor-pointer">
                &times;
            </button>
        </div>
    }

    <AppHeader SearchTerm="@headerSearchTerm"
               OnSearchInput="HandleHeaderSearchInput"
               OnSearchKeyUp="HandleHeaderSearchKeyUp"
               OnSearch="ExecuteHeaderSearch"
               OnClearSearch="ClearHeaderSearch"
               UserName="@userName"
               UserInitials="@userInitials"
               UserRole="@userRole"
               CartCount="@headerCartCount"
               OnLogout="HandleLogout" />

    <style>
        @@media (min-width: 1024px) {
            .home-3col-layout {
                display: grid !important;
                grid-template-columns: minmax(18rem, 1fr) minmax(0, 46rem) minmax(18rem, 1fr) !important;
                align-items: start !important;
            }

            .home-left-sidebar { justify-self: start !important; }
            .home-center-feed { justify-self: end !important; width: 100% !important; max-width: 46rem !important; min-width: 0 !important; }
            .home-right-sidebar { justify-self: center !important; }
        }
    </style>

    <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">
        <!-- Left Sidebar -->
        <AppSidebar ActiveItem="packages" />

        <!-- Center Column -->
        <section class="home-center-feed w-full max-w-3xl flex flex-col gap-4 min-w-0 pb-12">
            <!-- Header Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <button type="button" @onclick="GoBack" class="p-2 text-gray-500 hover:text-gray-800 hover:bg-gray-100 rounded-xl transition cursor-pointer" title="Go back">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </button>
                    <div>
                        <h1 class="text-xl font-bold text-gray-800">Edit Training Package</h1>
                        <p class="text-xs text-gray-500 mt-0.5">Update package details, curriculum, and photo album</p>
                    </div>
                </div>

                <a href="/training-packages/@Id" target="_blank" class="text-xs font-semibold text-[#FF5500] hover:underline flex items-center gap-1">
                    <span>Preview page</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
            </div>

            @if (isLoading)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-12 flex flex-col items-center justify-center">
                    <div class="w-10 h-10 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-3"></div>
                    <p class="text-sm text-gray-500 font-medium">Loading package details...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(loadErrorMessage))
            {
                <div class="bg-red-50 border border-red-200 rounded-2xl p-6 text-center text-red-600 font-medium">
                    <p class="mb-3">@loadErrorMessage</p>
                    <button type="button" @onclick="GoBack" class="px-4 py-2 bg-gray-800 text-white rounded-xl text-sm font-semibold hover:bg-black transition cursor-pointer">
                        Back to Packages
                    </button>
                </div>
            }
            else
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
                    @if (!string.IsNullOrEmpty(saveErrorMessage))
                    {
                        <div class="bg-red-50 border border-red-200 text-red-600 p-4 rounded-xl text-sm font-medium mb-6 flex items-start gap-3">
                            <svg class="w-5 h-5 flex-shrink-0 text-red-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>@saveErrorMessage</span>
                        </div>
                    }

                    <EditForm Model="@editModel" OnValidSubmit="HandleSaveSubmit">
                        <DataAnnotationsValidator />

                        <!-- Section 1: General Info -->
                        <div class="mb-8">
                            <h2 class="text-base font-bold text-gray-900 border-b border-gray-100 pb-2 mb-4 flex items-center gap-2">
                                <span class="w-6 h-6 rounded-lg bg-orange-100 text-[#FF5500] flex items-center justify-center text-xs font-black">1</span>
                                <span>Package Information</span>
                            </h2>

                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                                        Package Title <span class="text-red-500">*</span>
                                    </label>
                                    <InputText @bind-Value="editModel.Title"
                                               class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm font-medium"
                                               placeholder="e.g. 30 Days Weight Loss & Lean Muscle Transformation" />
                                    <ValidationMessage For="@(() => editModel.Title)" class="text-red-500 text-xs mt-1" />
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                                        Detailed Description <span class="text-xs font-normal text-gray-400">(Max 500 characters)</span>
                                    </label>
                                    <InputTextArea @bind-Value="editModel.Description" rows="4"
                                                   class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm leading-relaxed"
                                                   placeholder="Describe program goals, syllabus, nutrition support, coach contact frequency..." />
                                    <ValidationMessage For="@(() => editModel.Description)" class="text-red-500 text-xs mt-1" />
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Pricing & Session Settings -->
                        <div class="mb-8">
                            <h2 class="text-base font-bold text-gray-900 border-b border-gray-100 pb-2 mb-4 flex items-center gap-2">
                                <span class="w-6 h-6 rounded-lg bg-orange-100 text-[#FF5500] flex items-center justify-center text-xs font-black">2</span>
                                <span>Pricing & Session Settings</span>
                            </h2>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                                        Price (VND) <span class="text-red-500">*</span>
                                    </label>
                                    <div class="relative">
                                        <InputNumber @bind-Value="editModel.Price"
                                                     class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm font-semibold text-gray-800"
                                                     placeholder="500000" />
                                        <span class="absolute right-3.5 top-2.5 text-xs font-bold text-gray-400 uppercase">VND</span>
                                    </div>
                                    <ValidationMessage For="@(() => editModel.Price)" class="text-red-500 text-xs mt-1" />
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                                        Duration (Days) <span class="text-red-500">*</span>
                                    </label>
                                    <InputNumber @bind-Value="editModel.DurationDays"
                                                 class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm"
                                                 placeholder="30" />
                                    <ValidationMessage For="@(() => editModel.DurationDays)" class="text-red-500 text-xs mt-1" />
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                                        Session Count
                                    </label>
                                    <InputNumber @bind-Value="editModel.SessionCount"
                                                 class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm"
                                                 placeholder="e.g. 12 or 24" />
                                    <ValidationMessage For="@(() => editModel.SessionCount)" class="text-red-500 text-xs mt-1" />
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                                        Minimum Age (Years)
                                    </label>
                                    <InputNumber @bind-Value="editModel.MinAge"
                                                 class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm"
                                                 placeholder="e.g. 16" />
                                    <ValidationMessage For="@(() => editModel.MinAge)" class="text-red-500 text-xs mt-1" />
                                </div>

                                <div class="md:col-span-2">
                                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                                        Target Audience
                                    </label>
                                    <InputText @bind-Value="editModel.TargetAudience"
                                               class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm"
                                               placeholder="e.g. Beginners, Office workers, Athletes, Muscle gain..." />
                                    <ValidationMessage For="@(() => editModel.TargetAudience)" class="text-red-500 text-xs mt-1" />
                                </div>

                                <div class="md:col-span-2 flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-100">
                                    <div>
                                        <p class="text-sm font-bold text-gray-800">Public Marketplace Status</p>
                                        <p class="text-xs text-gray-500">The package will be publicly listed on the marketplace when activated</p>
                                    </div>
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" checked="@(editModel.IsActive ?? true)" @onchange="ToggleActiveStatus" class="sr-only peer" />
                                        <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Section 3: Photo Album -->
                        <div class="mb-8">
                            <h2 class="text-base font-bold text-gray-900 border-b border-gray-100 pb-2 mb-4 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-lg bg-orange-100 text-[#FF5500] flex items-center justify-center text-xs font-black">3</span>
                                    <span>Photo Album (@imageUrls.Count/10)</span>
                                </div>
                                <span class="text-xs text-gray-400 font-normal">The first photo is used as the cover photo</span>
                            </h2>

                            <!-- Image List / Grid -->
                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mb-4">
                                @for (int i = 0; i < imageUrls.Count; i++)
                                {
                                    var index = i;
                                    var url = imageUrls[i];
                                    <div class="group relative aspect-video sm:aspect-square rounded-2xl overflow-hidden border-2 border-gray-200 bg-gray-100 shadow-sm">
                                        <img src="@url" alt="Package Photo @(index + 1)" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                                        
                                        @if (index == 0)
                                        {
                                            <span class="absolute top-2 left-2 px-2.5 py-1 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white text-[11px] font-bold rounded-lg shadow-md pointer-events-none">
                                                Cover Photo
                                            </span>
                                        }

                                        <!-- Prominent, Always Visible Delete Button -->
                                        <button type="button" @onclick="() => RemoveImage(index)"
                                                class="absolute top-2 right-2 w-8 h-8 bg-red-600 hover:bg-red-700 active:scale-95 text-white rounded-full flex items-center justify-center shadow-lg border-2 border-white transition-all cursor-pointer z-20"
                                                title="Delete this photo">
                                            <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>

                                        <!-- Photo Index Badge at Bottom -->
                                        <span class="absolute bottom-2 right-2 px-2 py-0.5 bg-black/60 text-white text-[10px] font-semibold rounded-md backdrop-blur-xs pointer-events-none">
                                            #@(index + 1)
                                        </span>
                                    </div>
                                }

                                <!-- Upload Button Card -->
                                @if (imageUrls.Count < 10)
                                {
                                    <label class="relative aspect-video sm:aspect-square rounded-2xl border-2 border-dashed border-gray-300 hover:border-[#FF5500] bg-gray-50/70 hover:bg-orange-50/40 flex flex-col items-center justify-center cursor-pointer transition p-4 text-center group">
                                        @if (isUploadingImages)
                                        {
                                            <div class="w-7 h-7 border-3 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-2"></div>
                                            <span class="text-xs text-[#FF5500] font-bold">Uploading...</span>
                                        }
                                        else
                                        {
                                            <div class="w-10 h-10 rounded-full bg-orange-100 group-hover:bg-[#FF5500] group-hover:text-white text-[#FF5500] flex items-center justify-center mb-2 transition-colors">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                </svg>
                                            </div>
                                            <span class="text-xs font-bold text-gray-700 group-hover:text-[#FF5500] transition-colors">Add Photos</span>
                                            <span class="text-[10px] text-gray-400 mt-0.5">JPG, PNG, WEBP</span>
                                        }
                                        <InputFile OnChange="HandleFilesSelected" multiple accept=".jpg,.jpeg,.png,.webp,.gif" class="hidden" disabled="@isUploadingImages" />
                                    </label>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(uploadErrorMessage))
                            {
                                <p class="text-xs text-red-500 font-medium">@uploadErrorMessage</p>
                            }
                        </div>

                        <!-- Action Buttons -->
                        <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                            <button type="button" @onclick="GoBack"
                                    class="px-6 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-100 text-sm font-semibold transition cursor-pointer">
                                Cancel
                            </button>

                            <button type="submit" disabled="@(isSaving || isUploadingImages)"
                                    class="px-7 py-2.5 rounded-xl bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white text-sm font-bold shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center gap-2 cursor-pointer disabled:opacity-60">
                                @if (isSaving)
                                {
                                    <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                    <span>Save Changes</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            }
        </section>

        <!-- Right Sidebar (Empty) -->
        <aside class="home-right-sidebar hidden lg:flex w-72 flex-shrink-0 flex-col gap-4 sticky top-24"></aside>
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isUploadingImages = false;
    private string? loadErrorMessage;
    private string? saveErrorMessage;
    private string? uploadErrorMessage;
    private string? toastSuccessMessage;

    private UpdateTrainingPackageDto editModel = new();
    private List<string> imageUrls = new();

    // Header & User state
    private string? headerSearchTerm = "";
    private string userName = "Coach";
    private string userInitials = "C";
    private string userRole = "Coach";
    private int headerCartCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfoAsync();
        await LoadPackageDataAsync();
        await LoadCartCountAsync();
    }

    private async Task LoadPackageDataAsync()
    {
        isLoading = true;
        loadErrorMessage = null;
        try
        {
            var res = await PackageService.GetPackageByIdAsync(Id);
            if (res.Success && res.Data != null)
            {
                var pkg = res.Data;
                editModel = new UpdateTrainingPackageDto
                {
                    Title = pkg.Title,
                    Description = pkg.Description,
                    Price = pkg.Price,
                    DurationDays = pkg.DurationDays,
                    SessionCount = pkg.SessionCount,
                    MinAge = pkg.MinAge,
                    TargetAudience = pkg.TargetAudience,
                    IsActive = pkg.IsActive
                };
                imageUrls = pkg.ImageUrls != null ? new List<string>(pkg.ImageUrls) : new List<string>();
            }
            else
            {
                loadErrorMessage = res.Message ?? "Failed to find training package.";
            }
        }
        catch (Exception ex)
        {
            loadErrorMessage = $"Error loading package: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleActiveStatus(ChangeEventArgs e)
    {
        if (e.Value is bool val)
        {
            editModel.IsActive = val;
        }
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        uploadErrorMessage = null;
        var selectedFiles = e.GetMultipleFiles(10 - imageUrls.Count);
        if (!selectedFiles.Any()) return;

        isUploadingImages = true;
        try
        {
            var res = await PackageService.UploadPackageImagesAsync(selectedFiles);
            if (res.Success && res.Data != null)
            {
                imageUrls.AddRange(res.Data);
            }
            else
            {
                uploadErrorMessage = res.Message ?? "Failed to upload one or more photos.";
            }
        }
        catch (Exception ex)
        {
            uploadErrorMessage = $"Upload error: {ex.Message}";
        }
        finally
        {
            isUploadingImages = false;
        }
    }

    private void RemoveImage(int index)
    {
        if (index >= 0 && index < imageUrls.Count)
        {
            imageUrls.RemoveAt(index);
        }
    }

    private async Task HandleSaveSubmit()
    {
        isSaving = true;
        saveErrorMessage = null;
        try
        {
            editModel.ImageUrls = imageUrls;
            var res = await PackageService.UpdatePackageAsync(Id, editModel);
            if (res.Success)
            {
                toastSuccessMessage = "Training package updated successfully!";
                await Task.Delay(1000);
                Navigation.NavigateTo("/training-packages");
            }
            else
            {
                saveErrorMessage = res.Message ?? "Failed to update training package.";
            }
        }
        catch (Exception ex)
        {
            saveErrorMessage = $"Error updating package: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/training-packages");
    }

    private async Task LoadUserInfoAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.FindFirst(ClaimTypes.Name)?.Value ?? "Coach";
            userRole = user.FindFirst(ClaimTypes.Role)?.Value ?? "Coach";
            userInitials = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "C";
        }
    }

    private async Task LoadCartCountAsync()
    {
        try
        {
            var res = await CartService.GetCartCountAsync();
            if (res.Success)
            {
                headerCartCount = res.Data;
            }
        }
        catch { }
    }

    private void HandleHeaderSearchInput(ChangeEventArgs e) => headerSearchTerm = e.Value?.ToString();
    private void HandleHeaderSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") ExecuteHeaderSearch(); }
    private void ExecuteHeaderSearch() { if (!string.IsNullOrWhiteSpace(headerSearchTerm)) Navigation.NavigateTo($"/training-packages?searchKeyword={Uri.EscapeDataString(headerSearchTerm)}"); }
    private void ClearHeaderSearch() => headerSearchTerm = "";
    private async Task HandleLogout() { await AuthService.LogoutAsync(); Navigation.NavigateTo("/login", true); }
}

@page "/coaches"
@inject ICoachService CoachService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject FitSocial.Client.Services.Auth.IAuthService AuthService
@inject AppShellContext Shell
@attribute [Authorize]
@implements IDisposable
@using FitSocial.Client.Layout
@using System.Security.Claims

<PageTitle>Discover Coaches - FitConnect</PageTitle>

<div class="flex flex-col gap-4 min-w-0">
    <!-- Header Section -->
    <div class="bg-white rounded-xl shadow-sm p-5 flex flex-col sm:flex-row justify-between items-center gap-4 border border-gray-100">
        <h1 class="text-xl font-bold text-gray-800">Discover Coaches</h1>
    </div>

    <!-- Filter Section -->
    <div class="bg-white rounded-xl shadow-sm p-4 border border-gray-100">
        <form @onsubmit="SearchCoaches" class="flex flex-col sm:flex-row gap-3">
            <input type="text" class="flex-1 bg-gray-100 rounded-lg py-2 px-4 focus:outline-none focus:ring-2 focus:ring-[#FF5500] text-sm text-gray-700" placeholder="Search by name or bio..." @bind="searchKeyword">
            <input type="number" class="w-full sm:w-28 bg-gray-100 rounded-lg py-2 px-4 focus:outline-none focus:ring-2 focus:ring-[#FF5500] text-sm text-gray-700" placeholder="Min Exp" min="0" @bind="minExperience">
            <select class="w-full sm:w-36 bg-gray-100 rounded-lg py-2 px-3 focus:outline-none focus:ring-2 focus:ring-[#FF5500] text-sm text-gray-700" @bind="sortBy">
                <option value="">Sort: Default</option>
                <option value="exp_desc">Exp: High-Low</option>
                <option value="exp_asc">Exp: Low-High</option>
                <option value="name_asc">Name: A-Z</option>
            </select>
            <button type="submit" class="bg-[#FF5500] hover:bg-[#E64A00] text-white px-5 py-2 rounded-lg font-semibold text-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center justify-center cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </button>
        </form>
    </div>

    <!-- Content -->
    @if (isLoading)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            @for (int i = 0; i < 4; i++)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 animate-pulse">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-16 h-16 rounded-full bg-gray-200"></div>
                        <div class="flex-1 space-y-2">
                            <div class="h-4 bg-gray-200 rounded w-2/3"></div>
                            <div class="h-3 bg-gray-200 rounded w-1/2"></div>
                        </div>
                    </div>
                    <div class="h-3 bg-gray-200 rounded w-full mb-2"></div>
                    <div class="h-3 bg-gray-200 rounded w-4/5 mb-4"></div>
                    <div class="h-9 bg-gray-100 rounded-xl"></div>
                </div>
            }
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="bg-red-50 text-red-600 p-4 rounded-xl text-center text-sm font-medium">@errorMessage</div>
    }
    else if (!coaches.Any())
    {
        <div class="bg-white rounded-xl shadow-sm p-10 text-center text-gray-500">
            <div class="w-16 h-16 mx-auto mb-3 text-gray-300 flex justify-center items-center">
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
            <h3 class="text-base font-bold text-gray-800 mb-1">No coaches found</h3>
            <p class="text-xs text-gray-400">Try adjusting your search filters.</p>
        </div>
    }
    else
    {
        <!-- Lưới ô vuông bo tròn, giống trang Packages List -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            @foreach (var coach in coaches)
            {
                <div class="bg-white rounded-2xl shadow-sm hover:shadow-md border border-gray-100 hover:border-orange-200 transition-all duration-300 flex flex-col overflow-hidden group">
                    <div class="p-5 flex flex-col flex-1">

                        <!-- Avatar + tên -->
                        <div class="flex items-center gap-4 mb-3">
                            <div class="flex-shrink-0">
                                @if (!string.IsNullOrEmpty(coach.AvatarUrl))
                                {
                                    <img src="@coach.AvatarUrl" class="w-16 h-16 rounded-full border-[3px] border-[#FF5500] p-0.5 object-cover bg-white" alt="@coach.FullName" referrerpolicy="no-referrer" loading="lazy" />
                                }
                                else
                                {
                                    <div class="w-16 h-16 rounded-full border-[3px] border-[#FF5500] p-0.5 bg-gray-100 flex items-center justify-center text-gray-400 bg-clip-content">
                                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path></svg>
                                    </div>
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <h5 class="font-bold text-gray-900 text-base leading-tight truncate">@coach.FullName</h5>
                                <p class="text-gray-500 text-xs font-medium truncate mt-0.5">@("@coach_" + coach.CoachId.ToString().Substring(0, 6))</p>
                            </div>
                        </div>

                        <!-- Bio -->
                        <p class="text-gray-700 text-sm mb-4 line-clamp-2 flex-1">
                            @(string.IsNullOrEmpty(coach.Bio) ? "Fitness enthusiast & professional coach. Let's build your dream body together!" : coach.Bio)
                        </p>

                        <!-- Thống kê -->
                        <div class="flex items-center gap-4 pt-3 mb-4 border-t border-gray-100">
                            <div class="flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                <span class="font-semibold text-gray-800 text-sm">@coach.ExperienceYears <span class="text-gray-500 font-normal">yrs</span></span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-yellow-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                <span class="font-semibold text-gray-800 text-sm">5.0</span>
                            </div>
                            <span class="font-bold text-[#FF5500] text-xs px-2 py-0.5 bg-orange-50 rounded-md">PRO</span>
                        </div>

                        <!-- Nút -->
                        <button @onclick="@(() => Navigation.NavigateTo($"/profile/{coach.CoachId}"))"
                                class="w-full block px-4 py-2 bg-[#FF5500] hover:bg-[#E64A00] text-white rounded-xl text-sm font-bold hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer">
                            View Profile
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<CoachListDto> coaches = new List<CoachListDto>();
    private bool isLoading = true;
    private string? errorMessage;

    // Filters
    private string? searchKeyword = "";
    private int? minExperience;
    private string? sortBy = "";

    // Header state
    private string? headerSearchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        // Topbar do AppShellLayout render: đăng ký hành vi tìm kiếm cho trang này
        Shell.SearchTerm = headerSearchTerm ?? string.Empty;
        Shell.SearchInputHandler = e =>
        {
            HandleHeaderSearchInput(e);
            return Task.CompletedTask;
        };
        Shell.SearchKeyUpHandler = HandleHeaderSearchKeyUp;
        Shell.SearchExecuteHandler = ExecuteHeaderSearch;
        Shell.SearchClearHandler = ClearHeaderSearch;

        await LoadCoaches();
    }

    private void HandleHeaderSearchInput(ChangeEventArgs e)
    {
        headerSearchTerm = e.Value?.ToString();
    }

    private async Task HandleHeaderSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteHeaderSearch();
        }
    }

    private async Task ExecuteHeaderSearch()
    {
        searchKeyword = headerSearchTerm;
        await LoadCoaches();
    }

    private async Task ClearHeaderSearch()
    {
        headerSearchTerm = string.Empty;
        searchKeyword = string.Empty;
        await LoadCoaches();
    }

    private async Task SearchCoaches()
    {
        await LoadCoaches();
    }

    private async Task LoadCoaches()
    {
        isLoading = true;
        errorMessage = null;

        var response = await CoachService.GetAllCoachesAsync(searchKeyword, minExperience, sortBy);
        if (response.Success && response.Data != null)
        {
            coaches = response.Data;
        }
        else
        {
            errorMessage = response.Message ?? "Failed to load coaches.";
        }

        isLoading = false;
    }

    public void Dispose()
    {
        Shell.Reset();
    }
}

@page "/coach-renewal"
@layout AppShellLayout
@inject IPaymentService PaymentService
@inject FitSocial.Client.Services.SystemOperations.ISystemOperationsService SystemOps
@inject NavigationManager Navigation
@using FitSocial.Client.Models.Payments

<PageTitle>Coach Subscription - FitConnect</PageTitle>

<div class="flex flex-col gap-4 min-w-0">
    <div class="bg-white rounded-xl shadow-sm p-5 flex justify-between items-center gap-4 border border-gray-100">
        <div>
            <h1 class="text-xl font-bold text-gray-800">Coach Subscription</h1>
            <p class="text-xs text-gray-500 mt-0.5">Renew or upgrade your coach plan. Your account stays active while you pay.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center py-16">
            <div class="w-10 h-10 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-4"></div>
            <p class="text-gray-500 font-medium text-sm">Loading plans...</p>
        </div>
    }
    else
    {
        @if (currentSubscription != null)
        {
            var currentPlan = availablePlans.FirstOrDefault(p => p.PlanId == currentSubscription.PlanId);
            var currentDaysLeft = currentSubscription.EndDay.HasValue ? (currentSubscription.EndDay.Value - DateTime.UtcNow).Days : 0;
            var isExpired = currentSubscription.Status == "EXPIRED" || (currentSubscription.EndDay.HasValue && currentSubscription.EndDay.Value < DateTime.UtcNow);

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 mb-4">
                <div class="flex flex-row gap-4">
                    <div class="relative w-32 h-32 flex-shrink-0 overflow-hidden rounded-xl border border-gray-100">
                        @if (!string.IsNullOrWhiteSpace(currentPlan?.ImageUrl))
                        {
                            <img src="@currentPlan.ImageUrl" alt="@currentSubscription.PlanDescription" class="w-full h-full object-cover aspect-square" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center bg-gray-50 text-gray-300">
                                <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                            </div>
                        }
                        <div class="absolute top-1 left-1 flex flex-col gap-1 items-start">
                            <span class="px-2 py-0.5 rounded-full text-[9px] font-bold @(isExpired ? "bg-red-100 text-red-700" : "bg-emerald-100 text-emerald-700") whitespace-nowrap">
                                @(isExpired ? "EXPIRED" : currentSubscription.Status)
                            </span>
                            <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-gray-100 text-gray-700 whitespace-nowrap">
                                @currentDaysLeft d left
                            </span>
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="font-black text-base text-gray-900 mb-1">@currentSubscription.PlanDescription</h3>
                        <p class="text-sm font-bold text-[#FF5500] mb-1 whitespace-nowrap">@((currentPlan?.Amount ?? 0).ToString("N0")) @(currentPlan?.Currency ?? "VND")</p>
                        <p class="text-xs text-gray-500 mb-1">@(currentPlan?.SubscriptionDuration ?? 0) months • @(currentPlan?.TrainingPackageDuration ?? 0) days training</p>
                        <p class="text-xs text-gray-400">Expires @currentSubscription.EndDay?.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 mb-4">
                <div class="flex flex-row items-center gap-3">
                    <div class="w-24 h-24 flex-shrink-0 rounded-xl bg-gray-100 flex items-center justify-center">
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="font-bold text-base text-gray-900 mb-1">No Active Subscription</h3>
                        <p class="text-sm text-gray-500">You don't have an active subscription yet. Select a plan below to get started.</p>
                    </div>
                </div>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            @foreach (var plan in availablePlans)
            {
                var coverImg = plan.ImageUrl;
                var daysLeft = currentSubscription?.EndDay.HasValue == true ? (currentSubscription.EndDay.Value - DateTime.UtcNow).Days : 0;
                var isCurrent = currentSubscription?.PlanId == plan.PlanId;
                var canPay = currentSubscription == null || currentSubscription.Status == "EXPIRED" || daysLeft < 7;
                var btnText = isCurrent ? "Renew" : (currentSubscription == null || currentSubscription.Status == "EXPIRED" ? "Buy Now" : (daysLeft < 7 ? "Upgrade" : "Pay"));

                <div class="bg-white rounded-2xl shadow-sm hover:shadow-md border border-gray-100 transition-all duration-300 flex flex-col overflow-hidden group">
                    <div class="relative w-full h-40 bg-gradient-to-tr from-gray-900 to-gray-800 overflow-hidden">
                        @if (!string.IsNullOrWhiteSpace(coverImg))
                        {
                            <img src="@coverImg" alt="@plan.Description" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center bg-gradient-to-tr from-orange-600/80 to-amber-500/80 text-white/40">
                                <svg class="w-16 h-16" fill="currentColor" viewBox="0 0 24 24"><path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                            </div>
                        }
                    </div>
                    <div class="p-4">
                        <p class="font-semibold text-gray-900">@plan.Description</p>
                        <p class="text-xs text-gray-500 mt-1">@(plan.SubscriptionDuration) months • @(plan.TrainingPackageDuration) days training</p>
                        <p class="text-sm font-bold text-[#FF5500] mt-2 whitespace-nowrap">@((plan.Amount ?? 0).ToString("N0")) @(plan.Currency ?? "VND")</p>
                        <button type="button" class="mt-3 w-full py-2 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white text-xs font-bold rounded-lg @(!canPay ? "opacity-50 cursor-not-allowed" : "")" @onclick="() => GoToPay(plan.PlanId)" disabled="@(!canPay)">
                            @btnText
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (currentSubscription == null)
        {
            @if (!string.IsNullOrEmpty(subErrorMessage))
            {
                <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl text-sm text-center mb-4">@subErrorMessage</div>
            }
            else
            {
                <p class="text-sm text-gray-500 text-center mt-4">You don't have an active subscription yet. Select a plan above to get started.</p>
            }
        }
    }
</div>

@code {
    private List<FitSocial.Client.Models.SystemOperations.CoachSubscriptionPlanDto> availablePlans = new();
    private CoachSubscriptionStatus? currentSubscription;
    private Guid? selectedPlanId;
    private string? subErrorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var subRes = await PaymentService.GetCurrentCoachSubscriptionAsync();
            if (subRes.Success && subRes.Data != null)
                currentSubscription = subRes.Data;
            else
                subErrorMessage = subRes.Message ?? "Could not load your subscription.";

            var res = await SystemOps.GetActivePlansAsync();
            if (res.Success && res.Data != null) availablePlans = res.Data;
        }
        catch (Exception ex)
        {
            subErrorMessage = $"Connection error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandlePayAsync()
    {
        if (selectedPlanId == null) { errorMessage = "Please select a plan."; return; }
        isProcessing = true;
        errorMessage = null;
        try
        {
            var res = await PaymentService.RenewCoachSubscriptionAsync(selectedPlanId.Value);
            if (res.Success && res.Data != null)
                Navigation.NavigateTo($"/coach-renewal/pay?planId={selectedPlanId.Value}");
            else
                errorMessage = res.Message ?? "Could not create payment link.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isProcessing = false; }
    }

    private string? errorMessage;
    private bool isProcessing = false;

    private void GoToPay(Guid planId)
    {
        Navigation.NavigateTo($"/coach-renewal/pay?planId={planId}");
    }
}
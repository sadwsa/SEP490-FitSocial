@namespace FitSocial.Client.Components.Posts

<div class="relative flex-shrink-0">
    <!-- Filter Dropdown Trigger Button -->
    <button type="button" @onclick="ToggleFilterDropdown"
            class="h-9 px-3 sm:px-3.5 rounded-full text-xs font-semibold border flex items-center gap-1.5 transition cursor-pointer @(HasActiveFilters ? "bg-orange-50 border-[#FF5500] text-[#FF5500] shadow-xs" : "bg-gray-100 hover:bg-gray-200/80 border-gray-200 text-gray-700")"
            title="Filter options">
        <svg class="w-3.5 h-3.5 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4">
            </path>
        </svg>
        <span class="hidden sm:inline">Filter</span>
        @if (ActiveFilterCount > 0)
        {
            <span class="px-1.5 py-0.2 bg-[#FF5500] text-white rounded-full text-[10px] font-bold">@ActiveFilterCount</span>
        }
        <svg class="w-3.5 h-3.5 text-gray-400 transition-transform duration-200 @(showFilterDropdown ? "rotate-180 text-[#FF5500]" : "")"
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
    </button>

    @if (showFilterDropdown)
    {
        <!-- Backdrop to close dropdown when clicking outside -->
        <div class="fixed inset-0 z-40" @onclick="CloseFilterDropdown"></div>

        <div class="absolute right-0 mt-2 w-80 sm:w-96 bg-white rounded-2xl shadow-2xl border border-gray-100 p-4 z-50 text-xs animate-in fade-in"
             @onclick:stopPropagation="true">
            <div class="flex items-center justify-between pb-3 border-b border-gray-100">
                <div class="flex items-center gap-2 font-bold text-gray-900 text-sm">
                    <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4">
                        </path>
                    </svg>
                    <span>Filter Posts</span>
                </div>
                <button type="button" @onclick="CloseFilterDropdown"
                        class="text-gray-400 hover:text-gray-600 text-base leading-none font-bold cursor-pointer"
                        title="Close">&times;</button>
            </div>

            <div class="py-3 space-y-3.5 max-h-[70vh] overflow-y-auto">
                <!-- Post Type Filter -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="font-semibold text-gray-700">Post Type</label>
                        @if (!string.IsNullOrEmpty(draftPostType))
                        {
                            <button type="button"
                                    class="text-[10px] text-[#FF5500] font-normal hover:underline cursor-pointer"
                                    @onclick="() => SelectDraftPostType(null)">Reset</button>
                        }
                    </div>
                    <div class="grid grid-cols-2 gap-1.5">
                        <button type="button"
                                @onclick="() => SelectDraftPostType(null)"
                                class="px-2.5 py-1.5 rounded-lg border text-center transition font-medium cursor-pointer @(string.IsNullOrEmpty(draftPostType) ? "border-[#FF5500] bg-orange-50 text-[#FF5500] font-bold" : "border-gray-200 bg-white text-gray-700 hover:bg-gray-50")">
                            All
                        </button>
                        <button type="button"
                                @onclick='() => SelectDraftPostType("Normal")'
                                class="px-2.5 py-1.5 rounded-lg border text-center transition font-medium cursor-pointer @(IsSamePostType(draftPostType, "Normal") ? "border-[#FF5500] bg-orange-50 text-[#FF5500] font-bold" : "border-gray-200 bg-white text-gray-700 hover:bg-gray-50")">
                            Normal
                        </button>
                        <button type="button"
                                @onclick='() => SelectDraftPostType("Find Coach")'
                                class="px-2.5 py-1.5 rounded-lg border text-center transition font-medium cursor-pointer @(IsSamePostType(draftPostType, "Find Coach") ? "border-amber-500 bg-amber-50 text-amber-800 font-bold" : "border-gray-200 bg-white text-gray-700 hover:bg-gray-50")">
                            Find Coach
                        </button>
                        <button type="button"
                                @onclick='() => SelectDraftPostType("Find Trainee")'
                                class="px-2.5 py-1.5 rounded-lg border text-center transition font-medium cursor-pointer @(IsSamePostType(draftPostType, "Find Trainee") ? "border-emerald-500 bg-emerald-50 text-emerald-800 font-bold" : "border-gray-200 bg-white text-gray-700 hover:bg-gray-50")">
                            Find Trainee
                        </button>
                    </div>
                </div>

                <!-- Location Filter -->
                <div class="relative">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="font-semibold text-gray-700">Gym / Location</label>
                        @if (draftLocationId.HasValue && draftLocationId != Guid.Empty)
                        {
                            <button type="button"
                                    class="text-[10px] text-[#FF5500] font-normal hover:underline cursor-pointer"
                                    @onclick="() => SelectDraftLocation(null)">Reset</button>
                        }
                    </div>
                    <button type="button" @onclick="ToggleLocationDropdown"
                            class="w-full flex items-center justify-between text-xs bg-gray-50 border border-gray-200 rounded-xl p-2.5 text-gray-800 hover:bg-gray-100/70 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] transition cursor-pointer">
                        <span class="truncate font-medium @(draftLocationId.HasValue && draftLocationId != Guid.Empty ? "text-gray-900 font-semibold" : "text-gray-600")">
                            @GetDraftLocationName()
                        </span>
                        <svg class="w-4 h-4 text-gray-400 transition-transform duration-200 @(isLocationDropdownOpen ? "rotate-180 text-[#FF5500]" : "")"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>

                    @if (isLocationDropdownOpen)
                    {
                        <div class="mt-1.5 w-full bg-white border border-gray-100 rounded-xl shadow-lg max-h-44 overflow-y-auto p-1 z-30 text-xs space-y-0.5 animate-in fade-in zoom-in-95 duration-100">
                            <button type="button" @onclick="() => SelectDraftLocation(null)"
                                    class="w-full text-left px-3 py-2 rounded-lg flex items-center justify-between transition cursor-pointer @(!draftLocationId.HasValue || draftLocationId == Guid.Empty ? "bg-orange-50 text-[#FF5500] font-bold" : "text-gray-700 hover:bg-gray-50")">
                                <span>All Locations</span>
                                @if (!draftLocationId.HasValue || draftLocationId == Guid.Empty)
                                {
                                    <svg class="w-3.5 h-3.5 text-[#FF5500]" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd"
                                              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                              clip-rule="evenodd"></path>
                                    </svg>
                                }
                            </button>
                            @foreach (var l in AvailableLocations)
                            {
                                var isSelected = draftLocationId == l.LocationId;
                                <button type="button" @onclick="() => SelectDraftLocation(l.LocationId)"
                                        class="w-full text-left px-3 py-2 rounded-lg flex items-center justify-between transition cursor-pointer @(isSelected ? "bg-orange-50 text-[#FF5500] font-bold" : "text-gray-700 hover:bg-gray-50")">
                                    <span>@l.LocationName</span>
                                    @if (isSelected)
                                    {
                                        <svg class="w-3.5 h-3.5 text-[#FF5500]" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd"
                                                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                                  clip-rule="evenodd"></path>
                                        </svg>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="flex items-center justify-between pt-3 border-t border-gray-100 gap-2">
                <button type="button" @onclick="ClearFilters"
                        class="px-3 py-1.5 text-gray-600 hover:bg-gray-100 rounded-lg font-medium transition cursor-pointer">
                    Clear
                </button>
                <button type="button" @onclick="ApplyFilters"
                        disabled="@(!HasDraftFilter)"
                        class="px-4 py-1.5 rounded-lg font-semibold shadow-xs transition @(!HasDraftFilter ? "bg-gray-200 text-gray-400 cursor-not-allowed" : "bg-gradient-to-r from-[#FF8C00] via-[#FF5500] to-[#FF3B00] hover:opacity-95 text-white cursor-pointer")">
                    Apply Filter
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? SelectedPostType { get; set; }

    [Parameter]
    public Guid? SelectedLocationId { get; set; }

    [Parameter]
    public List<LocationDto> AvailableLocations { get; set; } = new();

    [Parameter]
    public EventCallback<(string? postType, Guid? locationId)> OnDraftFilterChanged { get; set; }

    [Parameter]
    public EventCallback<(string? postType, Guid? locationId)> OnApplyFilters { get; set; }

    private bool showFilterDropdown = false;
    private bool isLocationDropdownOpen = false;
    private string? draftPostType;
    private Guid? draftLocationId;

    private string GetDraftLocationName()
    {
        if (!draftLocationId.HasValue || draftLocationId.Value == Guid.Empty)
            return "All Locations";
        return AvailableLocations.FirstOrDefault(l => l.LocationId == draftLocationId.Value)?.LocationName ?? "All Locations";
    }

    private void ToggleLocationDropdown()
    {
        isLocationDropdownOpen = !isLocationDropdownOpen;
    }

    private async Task SelectDraftPostType(string? type)
    {
        draftPostType = type;
        isLocationDropdownOpen = false;
        if (OnDraftFilterChanged.HasDelegate)
        {
            await OnDraftFilterChanged.InvokeAsync((FormatPostType(draftPostType), draftLocationId));
        }
    }

    private async Task SelectDraftLocation(Guid? locationId)
    {
        draftLocationId = (locationId == Guid.Empty) ? null : locationId;
        isLocationDropdownOpen = false;
        if (OnDraftFilterChanged.HasDelegate)
        {
            await OnDraftFilterChanged.InvokeAsync((FormatPostType(draftPostType), draftLocationId));
        }
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SelectedPostType) ||
        (SelectedLocationId.HasValue && SelectedLocationId != Guid.Empty);

    private bool HasDraftFilter =>
        !string.IsNullOrWhiteSpace(draftPostType) ||
        (draftLocationId.HasValue && draftLocationId != Guid.Empty);

    private int ActiveFilterCount
    {
        get
        {
            int count = 0;
            if (!string.IsNullOrWhiteSpace(SelectedPostType)) count++;
            if (SelectedLocationId.HasValue && SelectedLocationId != Guid.Empty) count++;
            return count;
        }
    }

    private async Task ToggleFilterDropdown()
    {
        showFilterDropdown = !showFilterDropdown;
        if (showFilterDropdown)
        {
            draftPostType = FormatPostType(SelectedPostType);
            draftLocationId = SelectedLocationId;
            isLocationDropdownOpen = false;
            if (OnDraftFilterChanged.HasDelegate)
            {
                await OnDraftFilterChanged.InvokeAsync((draftPostType, draftLocationId));
            }
        }
    }

    private void CloseFilterDropdown()
    {
        showFilterDropdown = false;
        isLocationDropdownOpen = false;
    }

    private static string? FormatPostType(string? postType)
    {
        if (string.IsNullOrWhiteSpace(postType)) return null;
        var clean = postType.Trim().Replace(" ", "").ToLowerInvariant();
        return clean switch
        {
            "findcoach" => "Find Coach",
            "findtrainee" => "Find Trainee",
            "normal" => "Normal",
            _ => postType.Trim()
        };
    }

    private static bool IsSamePostType(string? a, string? b)
    {
        if (string.IsNullOrWhiteSpace(a) && string.IsNullOrWhiteSpace(b)) return true;
        if (string.IsNullOrWhiteSpace(a) || string.IsNullOrWhiteSpace(b)) return false;
        return string.Equals(a.Trim().Replace(" ", ""), b.Trim().Replace(" ", ""), StringComparison.OrdinalIgnoreCase);
    }

    private async Task ApplyFilters()
    {
        showFilterDropdown = false;
        isLocationDropdownOpen = false;
        var postType = string.IsNullOrWhiteSpace(draftPostType) ? null : FormatPostType(draftPostType);
        var locationId = draftLocationId.HasValue && draftLocationId.Value != Guid.Empty ? draftLocationId : null;
        if (OnApplyFilters.HasDelegate)
        {
            await OnApplyFilters.InvokeAsync((postType, locationId));
        }
    }

    private async Task ClearFilters()
    {
        draftPostType = null;
        draftLocationId = null;
        isLocationDropdownOpen = false;
        showFilterDropdown = false;
        if (OnDraftFilterChanged.HasDelegate)
        {
            await OnDraftFilterChanged.InvokeAsync((null, null));
        }
        if (OnApplyFilters.HasDelegate)
        {
            await OnApplyFilters.InvokeAsync((null, null));
        }
    }
}

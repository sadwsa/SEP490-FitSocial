@page "/admin/staff"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN")]
@implements IDisposable
@using FitSocial.Client.Models.Common
@using FitSocial.Client.Models.Users
@using FitSocial.Client.Services.Users
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Staff Accounts - FitSocial Admin Console</PageTitle>

<AuthorizeView Roles="ADMIN">
    <Authorized>
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="auth-alert info" role="alert"><AppIcon Name="info" /><span>@toastMessage</span></div>
        }

        <h2 class="view-title">Staff Accounts</h2>
        <p class="view-sub">Directory of all staff accounts across the FitSocial platform.</p>

        <div class="cat-tabs mb-3">
            <button type="button" class="cat-tab @(staffStatusFilter == "active" ? "active" : "")" @onclick='() => SetStaffStatusFilterAsync("active")'>
                <span class="status-dot dot-active"></span> Active Accounts
            </button>
            <button type="button" class="cat-tab @(staffStatusFilter == "locked" ? "active" : "")" @onclick='() => SetStaffStatusFilterAsync("locked")'>
                <span class="status-dot dot-locked"></span> Locked Accounts
            </button>
            <button type="button" class="cat-tab @(staffStatusFilter == "all" ? "active" : "")" @onclick='() => SetStaffStatusFilterAsync("all")'>
                All Accounts
            </button>
        </div>

        <div class="toolbar">
            <div class="search-wrap">
                <span class="search-icon"><AppIcon Name="search" /></span>
                <input value="@staffSearch" @oninput="OnStaffSearchInput" @onkeydown="HandleStaffSearchKeyDown" class="toolbar-input" placeholder="Search staff name or email..." />
            </div>
            <button type="button" class="row-btn" @onclick="LoadStaffAsync" disabled="@isLoadingStaff">
                <span class="btn-ic"><AppIcon Name="refresh" /></span> Refresh
            </button>
            <button type="button" class="row-btn add" @onclick="OpenCreateStaffModal" id="btn-create-staff">
                + Create Staff Account
            </button>
        </div>

        @if (isLoadingStaff)
        {
            <div class="py-3 text-center muted">
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Loading staff accounts from database...</span>
            </div>
        }

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in pagedStaff.Items)
                    {
                        <tr>
                            <td><strong>@u.FullName</strong><br /><small class="muted">@(u.PhoneNumber ?? "No phone")</small></td>
                            <td>@u.Email</td>
                            <td><span class="role-badge staff">@u.RoleCode</span></td>
                            <td>
                                @if (u.IsLocked)
                                {
                                    <span class="status-badge locked">Locked</span>
                                }
                                else
                                {
                                    <span class="status-badge active">Active</span>
                                }
                            </td>
                            <td>
                                @(u.CreatedAt?.ToString("MMM dd, yyyy") ?? "-")
                            </td>
                        </tr>
                    }
                    @if (!isLoadingStaff && !pagedStaff.Items.Any())
                    {
                        <tr><td colspan="5" class="text-center muted py-4">No staff accounts match.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-container">
            <div class="pagination-info">
                @if (pagedStaff.TotalCount > 0)
                {
                    var start = (staffCurrentPage - 1) * staffPageSize + 1;
                    var end = Math.Min(staffCurrentPage * staffPageSize, pagedStaff.TotalCount);
                    <span>Showing <strong>@start–@end</strong> of <strong>@pagedStaff.TotalCount</strong> staff accounts</span>
                }
                else
                {
                    <span>0 staff accounts</span>
                }
            </div>
            @if (pagedStaff.TotalPages > 1)
            {
                <div class="pagination-controls">
                    <button type="button" class="page-btn" disabled="@(!pagedStaff.HasPreviousPage)" @onclick="() => GoToStaffPageAsync(staffCurrentPage - 1)">‹ Previous</button>
                    @foreach (var p in GetVisibleStaffPageNumbers())
                    {
                        if (p == -1) { <span class="page-dots">…</span> }
                        else { var pageNum = p; <button type="button" class="page-btn @(pageNum == staffCurrentPage ? "active" : "")" @onclick="() => GoToStaffPageAsync(pageNum)">@pageNum</button> }
                    }
                    <button type="button" class="page-btn" disabled="@(!pagedStaff.HasNextPage)" @onclick="() => GoToStaffPageAsync(staffCurrentPage + 1)">Next ›</button>
                </div>
            }
            <div class="page-size-selector">
                <span>Per page:</span>
                <select value="@staffPageSize" @onchange="OnStaffPageSizeChangedAsync" class="page-size-select">
                    <option value="10">10 / page</option>
                    <option value="20">20 / page</option>
                    <option value="50">50 / page</option>
                </select>
            </div>
        </div>

        @if (showCreateStaffModal)
        {
            <div class="modal-overlay" @onclick="CloseCreateStaffModal">
                <div class="modal-card" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <div>
                            <h3>Create Staff Account</h3>
                            <small>Provision a new account with STAFF permissions</small>
                        </div>
                        <button type="button" class="modal-close-btn" @onclick="CloseCreateStaffModal" title="Close" disabled="@isSubmitting">✕</button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(createErrorMessage))
                        {
                            <div class="auth-alert error" role="alert">
                                <AppIcon Name="warning" />
                                <span>@createErrorMessage</span>
                            </div>
                        }

                        <div class="form-group">
                            <label class="form-label" for="staff-fullname">Full Name <span class="text-danger">*</span></label>
                            <input id="staff-fullname" @bind="newStaffModel.FullName" class="toolbar-input" placeholder="e.g. John Doe" disabled="@isSubmitting" />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="staff-email">Email Address <span class="text-danger">*</span></label>
                            <input id="staff-email" type="email" @bind="newStaffModel.Email" class="toolbar-input" placeholder="e.g. staff@fitsocial.com" disabled="@isSubmitting" />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="staff-phone">Phone Number <small class="text-muted">(Optional)</small></label>
                            <input id="staff-phone" type="tel" @bind="newStaffModel.PhoneNumber" class="toolbar-input" placeholder="e.g. 0901234567" disabled="@isSubmitting" />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="staff-password">Password <span class="text-danger">*</span></label>
                            <input id="staff-password" type="password" @bind="newStaffModel.Password" class="toolbar-input" placeholder="At least 6 characters" disabled="@isSubmitting" />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="staff-confirm-password">Confirm Password <span class="text-danger">*</span></label>
                            <input id="staff-confirm-password" type="password" @bind="newStaffModel.ConfirmPassword" class="toolbar-input" placeholder="Re-enter password" disabled="@isSubmitting" />
                        </div>

                        <div class="role-notice">
                            <span class="role-badge staff">Role: STAFF</span>
                            <small class="text-muted ms-2">Role is automatically assigned to STAFF by the system</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="row-btn" @onclick="CloseCreateStaffModal" disabled="@isSubmitting">Cancel</button>
                        <button type="button" class="row-btn add" @onclick="HandleCreateStaffAsync" disabled="@isSubmitting" id="btn-submit-create-staff">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Creating...</span>
                            }
                            else
                            {
                                <span>Create Staff</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="auth-alert error" role="alert"><AppIcon Name="warning" /><span>You do not have access to this page.</span></div>
        <button type="button" class="btn-back" @onclick='() => Navigation.NavigateTo("/admin/login")'>Go to portal sign in</button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? toastMessage;
    private string staffSearch = "";
    private string staffStatusFilter = "active";
    private int staffCurrentPage = 1;
    private int staffPageSize = 10;
    private PagedResult<AdminUserDto> pagedStaff = new();
    private System.Timers.Timer? searchDebounceTimer;
    private bool isLoadingStaff = false;
    private bool showCreateStaffModal = false;
    private bool isSubmitting = false;
    private string? createErrorMessage;
    private CreateStaffAccountRequest newStaffModel = new();

    protected override async Task OnInitializedAsync() => await LoadStaffAsync();

    private void OpenCreateStaffModal()
    {
        newStaffModel = new();
        createErrorMessage = null;
        showCreateStaffModal = true;
    }

    private void CloseCreateStaffModal()
    {
        if (isSubmitting) return;
        showCreateStaffModal = false;
        createErrorMessage = null;
    }

    private async Task HandleCreateStaffAsync()
    {
        createErrorMessage = null;

        if (string.IsNullOrWhiteSpace(newStaffModel.FullName) || newStaffModel.FullName.Trim().Length < 2)
        {
            createErrorMessage = "Please enter a valid full name (at least 2 characters).";
            return;
        }

        if (string.IsNullOrWhiteSpace(newStaffModel.Email))
        {
            createErrorMessage = "Email address is required.";
            return;
        }

        if (!newStaffModel.Email.Contains('@') || !newStaffModel.Email.Contains('.'))
        {
            createErrorMessage = "Please enter a valid email address.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newStaffModel.Password) || newStaffModel.Password.Length < 6)
        {
            createErrorMessage = "Password must be at least 6 characters long.";
            return;
        }

        if (newStaffModel.Password != newStaffModel.ConfirmPassword)
        {
            createErrorMessage = "Passwords do not match.";
            return;
        }

        isSubmitting = true;
        try
        {
            var res = await UserService.CreateStaffAccountAsync(newStaffModel);
            if (res.Success)
            {
                showCreateStaffModal = false;
                newStaffModel = new();
                toastMessage = res.Message ?? "Staff account created successfully!";
                staffCurrentPage = 1;
                await LoadStaffAsync();
            }
            else
            {
                createErrorMessage = res.Message ?? "Failed to create staff account.";
            }
        }
        catch (Exception ex)
        {
            createErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LoadStaffAsync()
    {
        isLoadingStaff = true;
        try
        {
            bool? isLocked = staffStatusFilter switch { "active" => false, "locked" => true, _ => null };
            var res = await UserService.GetStaffUsersAsync(staffSearch, isLocked, staffCurrentPage, staffPageSize);
            if (res.Success && res.Data != null)
            {
                pagedStaff = res.Data;
                if (pagedStaff.TotalPages > 0 && staffCurrentPage > pagedStaff.TotalPages)
                {
                    staffCurrentPage = pagedStaff.TotalPages;
                    await LoadStaffAsync();
                    return;
                }
            }
            else if (!string.IsNullOrEmpty(res.Message)) toastMessage = res.Message;
        }
        catch (Exception ex) { toastMessage = $"Failed to load staff accounts: {ex.Message}"; }
        finally { isLoadingStaff = false; }
    }

    private async Task SetStaffStatusFilterAsync(string status)
    {
        if (staffStatusFilter == status) return;
        staffStatusFilter = status;
        staffCurrentPage = 1;
        await LoadStaffAsync();
    }

    private void OnStaffSearchInput(ChangeEventArgs e)
    {
        staffSearch = e.Value?.ToString() ?? "";
        searchDebounceTimer?.Stop(); searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Timers.Timer(400) { AutoReset = false };
        searchDebounceTimer.Elapsed += async (_, _) => { staffCurrentPage = 1; await InvokeAsync(LoadStaffAsync); await InvokeAsync(StateHasChanged); };
        searchDebounceTimer.Start();
    }

    private async Task HandleStaffSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { searchDebounceTimer?.Stop(); staffCurrentPage = 1; await LoadStaffAsync(); }
    }

    private async Task GoToStaffPageAsync(int page)
    {
        if (page < 1 || (pagedStaff.TotalPages > 0 && page > pagedStaff.TotalPages) || page == staffCurrentPage) return;
        staffCurrentPage = page;
        await LoadStaffAsync();
    }

    private async Task OnStaffPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0) { staffPageSize = newSize; staffCurrentPage = 1; await LoadStaffAsync(); }
    }

    private IEnumerable<int> GetVisibleStaffPageNumbers()
    {
        var total = pagedStaff.TotalPages;
        if (total <= 1) yield break;
        var current = staffCurrentPage; var delta = 2;
        var left = Math.Max(1, current - delta); var right = Math.Min(total, current + delta);
        if (left > 1) { yield return 1; if (left > 2) yield return -1; }
        for (var i = left; i <= right; i++) yield return i;
        if (right < total) { if (right < total - 1) yield return -1; yield return total; }
    }

    public void Dispose() { searchDebounceTimer?.Stop(); searchDebounceTimer?.Dispose(); }
}

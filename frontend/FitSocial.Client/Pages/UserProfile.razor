@page "/profile/{UserId}"
@page "/users/{UserId}"
@namespace FitSocial.Client.Pages
@layout EmptyLayout
@attribute [Authorize]

<PageTitle>@(profile?.FullName != null ? $"{profile.FullName} - FitSocial" : "User Profile - FitSocial")</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <!-- Header / Navigation Bar -->
    <AppHeader SearchTerm="@headerSearchTerm" OnSearchInput="HandleHeaderSearchInput"
               OnSearchKeyUp="HandleHeaderSearchKeyUp" OnSearch="ExecuteHeaderSearch" OnClearSearch="ClearHeaderSearch"
               UserName="@headerUserName" UserInitials="@headerUserInitials" UserRole="@headerUserRole"
               UserAvatarUrl="@headerUserAvatarUrl" OnLogout="HandleLogout" />

    <style>
        @@media (min-width: 1024px) {
            .home-3col-layout {
                display: grid !important;
                grid-template-columns: minmax(18rem, 1fr) minmax(0, 42rem) minmax(18rem, 1fr) !important;
                align-items: start !important;
            }

            .home-left-sidebar {
                justify-self: start !important;
            }

            .home-center-feed {
                justify-self: end !important;
                width: 100% !important;
                max-width: 42rem !important;
                min-width: 0 !important;
            }

            .home-right-sidebar {
                justify-self: center !important;
            }
        }
    </style>

    <!-- Main Content Layout -->
    <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">
        <!-- Left Sidebar -->
        <AppSidebar ActiveItem="" />

        <!-- Center Column -->
        <section class="home-center-feed w-full max-w-2xl flex flex-col gap-6 min-w-0 pb-12">

            @if (isLoading)
            {
                <!-- Loading Skeleton -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden animate-pulse">
                    <div class="h-28 bg-gradient-to-r from-orange-200 to-amber-200"></div>
                    <div class="px-6 pb-6 pt-0 relative flex flex-row items-end gap-4 sm:gap-6">
                        <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-gray-200 border-4 border-white shadow-md flex-shrink-0 -mt-14 sm:-mt-16">
                        </div>
                        <div class="flex-1 space-y-2 pt-3 sm:pt-4 pb-1">
                            <div class="h-6 sm:h-8 bg-gray-200 rounded w-48 mb-2"></div>
                            <div class="flex gap-2">
                                <div class="h-6 bg-gray-200 rounded-full w-20"></div>
                                <div class="h-6 bg-gray-200 rounded-full w-28"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-4 animate-pulse">
                    <div class="h-5 bg-gray-200 rounded w-40"></div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <!-- Error State -->
                <div class="bg-white rounded-2xl shadow-sm border border-red-100 p-8 text-center flex flex-col items-center">
                    <div class="w-16 h-16 rounded-full bg-red-50 text-red-500 flex items-center justify-center mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-900 mb-2">Unable to Load Profile</h2>
                    <p class="text-gray-600 text-sm max-w-md mb-6">@errorMessage</p>

                    <div class="flex items-center gap-3">
                        <button type="button" @onclick="GoToHome"
                                class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm rounded-xl transition cursor-pointer">
                            Back to Feed
                        </button>
                        @if (!isUnauthorized)
                        {
                            <button type="button" @onclick="LoadProfileAsync"
                                    class="px-5 py-2.5 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white font-semibold text-sm rounded-xl shadow-md hover:shadow-lg transition cursor-pointer">
                                Try Again
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="GoToLogin"
                                    class="px-5 py-2.5 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white font-semibold text-sm rounded-xl shadow-md hover:shadow-lg transition cursor-pointer">
                                Sign In
                            </button>
                        }
                    </div>
                </div>
            }
            else if (profile != null)
            {
                <!-- Profile Header Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <!-- Banner -->
                    <div class="h-28 sm:h-32 bg-gradient-to-r from-[#FF8C00] via-[#FF5500] to-[#FF3B00] relative">
                        <div class="absolute inset-0 bg-black/10"></div>
                    </div>

                    <!-- Avatar + Header Details + Message Action -->
                    <div class="px-6 pb-6 pt-0 relative flex flex-col sm:flex-row sm:items-end justify-between gap-4">
                        <div class="flex flex-row items-end gap-4 sm:gap-6 min-w-0">
                            <!-- Avatar -->
                            <div class="relative -mt-14 sm:-mt-16 flex-shrink-0">
                                @if (AvatarHelper.HasValidAvatarUrl(profile.AvatarUrl))
                                {
                                    <img src="@profile.AvatarUrl" alt="@profile.FullName"
                                         class="w-24 h-24 sm:w-32 sm:h-32 rounded-full object-cover border-4 border-white shadow-lg bg-white"
                                         referrerpolicy="no-referrer"
                                         onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                    <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white items-center justify-center font-bold text-2xl sm:text-4xl border-4 border-white shadow-lg"
                                         style="display: none;">
                                        @AvatarHelper.GetInitials(profile.FullName)
                                    </div>
                                }
                                else
                                {
                                    <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold text-2xl sm:text-4xl border-4 border-white shadow-lg">
                                        @AvatarHelper.GetInitials(profile.FullName)
                                    </div>
                                }
                            </div>

                            <!-- Name, Role & Joined Badges -->
                            <div class="flex-1 min-w-0 pt-3 sm:pt-4 pb-1" style="text-align: left !important;">
                                <h1 class="text-xl sm:text-2xl font-bold text-gray-900 truncate mb-1">
                                    @(string.IsNullOrWhiteSpace(profile.FullName) ? "Athlete" : profile.FullName)
                                </h1>

                                <div class="flex flex-wrap items-center gap-2">
                                    @if (profile.IsCoach)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-orange-50 text-[#FF5500] border border-orange-200">
                                            <svg class="w-3.5 h-3.5 text-[#FF5500]" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                            </svg>
                                            Coach
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                                            </svg>
                                            Trainee
                                        </span>
                                    }

                                    @if (profile.CreatedAt.HasValue)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-50 text-gray-500 border border-gray-200">
                                            Joined @profile.CreatedAt.Value.ToString("MMM yyyy")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Message Button (Rendered unless Trainee is viewing Trainee) -->
                        @if (ShouldShowMessageButton)
                        {
                            <div class="sm:self-end pt-2 sm:pt-0">
                                <button type="button" @onclick="HandleMessageClick"
                                        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] hover:from-[#e07b00] hover:to-[#e04b00] text-white font-semibold text-sm rounded-xl shadow-sm hover:shadow-md transition-all duration-200 cursor-pointer">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                    </svg>
                                    Message
                                </button>
                            </div>
                        }
                    </div>
                </div>

                @if (profile.IsCoach)
                {
                    <!-- Coach Overview Highlights (Experience & Rating) -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                        <div class="flex items-center gap-3 mb-4 pb-3 border-b border-gray-100">
                            <div class="w-9 h-9 rounded-xl bg-orange-50 text-[#FF5500] flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-bold text-gray-900">Coach Credentials</h2>
                                <p class="text-xs text-gray-500">Professional coaching record</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Experience -->
                            <div class="p-4 bg-orange-50/60 rounded-xl border border-orange-100/80 flex items-center gap-4">
                                <div class="w-12 h-12 rounded-xl bg-white text-[#FF5500] flex items-center justify-center font-extrabold text-xl shadow-xs">
                                    @(profile.ExperienceYears ?? 0)
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-gray-900">Years of Experience</p>
                                    <p class="text-xs text-gray-500">Fitness training experience</p>
                                </div>
                            </div>

                            <!-- Rating -->
                            <div class="p-4 bg-amber-50/60 rounded-xl border border-amber-100/80 flex items-center gap-4">
                                <div class="w-12 h-12 rounded-xl bg-white text-amber-500 flex items-center justify-center font-extrabold text-xl shadow-xs">
                                    <svg class="w-6 h-6 fill-current text-yellow-400" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-bold text-gray-900">
                                            @(profile.Rating.HasValue && profile.Rating > 0 ? profile.Rating.Value.ToString("0.0") : "New Coach")
                                        </span>
                                        <span class="text-xs text-gray-500">(@(profile.TotalReviews ?? 0) reviews)</span>
                                    </div>
                                    <p class="text-xs text-gray-500">Average trainee satisfaction</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Personal Information Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-7">
                    <div class="flex items-center gap-3 mb-5 pb-3 border-b border-gray-100">
                        <div class="w-9 h-9 rounded-xl bg-orange-50 text-[#FF5500] flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-lg font-bold text-gray-900">Personal Information</h2>
                            <p class="text-xs text-gray-500">Public profile details</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Date of Birth -->
                        <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-medium text-gray-400">Date of Birth</p>
                                <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                    @(profile.DateOfBirth.HasValue ? profile.DateOfBirth.Value.ToString("dd/MM/yyyy") : "Not specified")
                                </p>
                            </div>
                        </div>

                        <!-- Gender -->
                        <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-medium text-gray-400">Gender</p>
                                <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                    @(string.IsNullOrWhiteSpace(profile.Gender) ? "Not specified" : profile.Gender)
                                </p>
                            </div>
                        </div>

                        <!-- Location / Address -->
                        <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-medium text-gray-400">Location / Address</p>
                                <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                    @(string.IsNullOrWhiteSpace(profile.Location) ? "Not specified" : profile.Location)
                                </p>
                            </div>
                        </div>

                        <!-- Member Since -->
                        <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-medium text-gray-400">Member Since</p>
                                <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                    @(profile.CreatedAt.HasValue ? profile.CreatedAt.Value.ToString("MMMM dd, yyyy") : "N/A")
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Biography (if available) -->
                    @if (!string.IsNullOrWhiteSpace(profile.Bio))
                    {
                        <div class="mt-5 pt-4 border-t border-gray-100">
                            <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Biography</label>
                            <div class="p-4 bg-gray-50/70 rounded-xl border border-gray-100 text-sm text-gray-700 leading-relaxed whitespace-pre-line">
                                @profile.Bio
                            </div>
                        </div>
                    }
                </div>

                @if (profile.IsCoach)
                {
                    <!-- Available Packages Section (COACH ONLY - UI Placeholder) -->
                    <!-- NOTE: Package API integration, purchasing, and selection are not yet implemented. This is a design placeholder. -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-7">
                        <div class="flex items-center justify-between mb-5 pb-3 border-b border-gray-100">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-orange-50 text-[#FF5500] flex items-center justify-center flex-shrink-0">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                    </svg>
                                </div>
                                <div>
                                    <h2 class="text-lg font-bold text-gray-900">Available Packages</h2>
                                    <p class="text-xs text-gray-500">Training packages offered by this coach</p>
                                </div>
                            </div>
                            <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-orange-50 text-[#FF5500] border border-orange-200">
                                3 Packages
                            </span>
                        </div>

                        <!-- Placeholder Package Cards Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <!-- Package Card 1 -->
                            <div class="rounded-xl border border-gray-100 bg-gray-50/50 p-4 flex flex-col justify-between hover:shadow-md hover:border-orange-200 transition-all duration-200">
                                <div>
                                    <div class="flex items-center justify-between gap-2 mb-2">
                                        <span class="text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md bg-orange-100/70 text-[#FF5500]">
                                            3 Months
                                        </span>
                                    </div>
                                    <h3 class="font-bold text-gray-900 text-sm mb-1 line-clamp-1">1-on-1 Personalized Coaching</h3>
                                    <p class="text-xs text-gray-500 leading-relaxed line-clamp-2 mb-3">
                                        Tailored workout plan, nutritional guidance, and weekly progress check-ins with your coach.
                                    </p>
                                </div>
                                <div class="pt-3 border-t border-gray-100 flex items-center justify-between gap-2">
                                    <div>
                                        <p class="text-[11px] text-gray-400">Price</p>
                                        <p class="text-sm font-extrabold text-[#FF5500]">2,500,000 ₫</p>
                                    </div>
                                    <button type="button" @onclick="HandlePackageClick"
                                            class="px-3 py-1.5 bg-white hover:bg-orange-50 text-gray-700 hover:text-[#FF5500] border border-gray-200 hover:border-orange-200 rounded-lg text-xs font-semibold transition cursor-pointer">
                                        View
                                    </button>
                                </div>
                            </div>

                            <!-- Package Card 2 -->
                            <div class="rounded-xl border border-gray-100 bg-gray-50/50 p-4 flex flex-col justify-between hover:shadow-md hover:border-orange-200 transition-all duration-200">
                                <div>
                                    <div class="flex items-center justify-between gap-2 mb-2">
                                        <span class="text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-md bg-blue-100/70 text-blue-600">
                                            1 Month
                                        </span>
                                    </div>
                                    <h3 class="font-bold text-gray-900 text-sm mb-1 line-clamp-1">Hypertrophy & Strength</h3>
                                    <p class="text-xs text-gray-500 leading-relaxed line-clamp-2 mb-3">
                                        Intensive strength building routine with exercise video demonstrations and form feedback.
                                    </p>
                                </div>
                                <div class="pt-3 border-t border-gray-100 flex items-center justify-between gap-2">
                                    <div>
                                        <p class="text-[11px] text-gray-400">Price</p>
                                        <p class="text-sm font-extrabold text-[#FF5500]">950,000 ₫</p>
                                    </div>
                                    <button type="button" @onclick="HandlePackageClick"
                                            class="px-3 py-1.5 bg-white hover:bg-orange-50 text-gray-700 hover:text-[#FF5500] border border-gray-200 hover:border-orange-200 rounded-lg text-xs font-semibold transition cursor-pointer">
                                        View
                                    </button>
                                </div>
                            </div>

                            <!-- Package Card 3 -->

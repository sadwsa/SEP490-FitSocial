@page "/admin/locations"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN,STAFF")]
@implements IDisposable
@using FitSocial.Client.Models.Common
@using FitSocial.Client.Models.Locations
@using FitSocial.Client.Services.Locations
@inject ILocationService LocationService
@inject NavigationManager Navigation

<PageTitle>Location List Management - FitSocial Admin Portal</PageTitle>

<AuthorizeView Roles="ADMIN,STAFF">
    <Authorized>
        <div class="locations-page">
            <!-- Header section matching reference image -->
            <div class="page-top-bar">
                <div class="breadcrumb-trail">
                    <span class="bc-admin">ADMIN PORTAL</span>
                    <span class="bc-sep">&gt;</span>
                    <span class="bc-dest">LOCATIONS &amp; FACILITIES</span>
                </div>
                <h1 class="page-heading">Location List Management</h1>
            </div>

            <!-- Main card container -->
            <div class="locations-card">
                <!-- Search and Stats toolbar -->
                <div class="search-and-stats-bar">
                    <div class="search-input-box">
                        <span class="search-icon"><AppIcon Name="search" /></span>
                        <input type="text"
                               value="@searchTerm"
                               @oninput="OnSearchInput"
                               @onkeydown="OnSearchKeyDown"
                               placeholder="Search by ID, location name, district..."
                               class="search-input" />
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <button type="button" class="btn-clear-search" @onclick="ClearSearchAsync" title="Clear search">✕</button>
                        }
                    </div>

                    <div class="stats-and-actions">
                        <div class="count-badge" title="Total locations">
                            All (@(pagedResult.TotalCount))
                        </div>
                        <button type="button" class="btn-refresh" @onclick="() => LoadLocationsAsync(currentPage)" disabled="@isLoading" title="Refresh">
                            <AppIcon Name="refresh" Class="@(isLoading ? "icon-spin" : "")" />
                        </button>
                    </div>
                </div>

                <!-- Error State -->
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="state-card error-state">
                        <div class="state-content">
                            <span class="state-icon"><AppIcon Name="warning" /></span>
                            <span class="state-message">@errorMessage</span>
                            <button type="button" class="btn-retry" @onclick="() => LoadLocationsAsync(currentPage)">
                                <AppIcon Name="refresh" /> Retry
                            </button>
                        </div>
                    </div>
                }

                <!-- Loading State overlay / indicator -->
                @if (isLoading)
                {
                    <div class="loading-state">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Loading locations...</span>
                    </div>
                }

                <!-- Table -->
                <div class="table-responsive">
                    <table class="locations-table">
                        <thead>
                            <tr>
                                <th class="col-check">
                                    <span class="table-checkbox" aria-hidden="true"></span>
                                </th>
                                <th class="col-id">LOCATION ID</th>
                                <th class="col-name">LOCATION NAME (LOCATIONNAME)</th>
                                <th class="col-address">ADDRESS (ADDRESS)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!isLoading && string.IsNullOrWhiteSpace(errorMessage) && !pagedResult.Items.Any())
                            {
                                <tr>
                                    <td colspan="4" class="empty-state-cell">
                                        <div class="empty-state">
                                            <span class="empty-icon"><AppIcon Name="location" /></span>
                                            <p class="empty-title">
                                                @(string.IsNullOrWhiteSpace(searchTerm) ? "No locations found." : "No locations match your search.")
                                            </p>
                                            @if (!string.IsNullOrWhiteSpace(searchTerm))
                                            {
                                                <button type="button" class="btn-clear-filter" @onclick="ClearSearchAsync">Clear search filter</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in pagedResult.Items)
                                {
                                    <tr class="location-row">
                                        <td class="col-check">
                                            <span class="table-checkbox" aria-hidden="true"></span>
                                        </td>
                                        <td class="col-id">
                                            <span class="loc-id" title="@item.LocationId">#@FormatLocationId(item.LocationId)</span>
                                        </td>
                                        <td class="col-name">
                                            <div class="loc-name-wrap">
                                                <div class="loc-icon-badge">
                                                    <svg class="facility-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                        <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                                                        <path d="M9 22v-4h6v4"></path>
                                                        <path d="M8 6h.01"></path>
                                                        <path d="M16 6h.01"></path>
                                                        <path d="M12 6h.01"></path>
                                                        <path d="M12 10h.01"></path>
                                                        <path d="M12 14h.01"></path>
                                                        <path d="M16 10h.01"></path>
                                                        <path d="M16 14h.01"></path>
                                                        <path d="M8 10h.01"></path>
                                                        <path d="M8 14h.01"></path>
                                                    </svg>
                                                </div>
                                                <span class="loc-name">@item.LocationName</span>
                                            </div>
                                        </td>
                                        <td class="col-address">
                                            <div class="loc-address-wrap">
                                                <span class="loc-pin-icon">
                                                    <AppIcon Name="location" />
                                                </span>
                                                <span class="loc-address">@(string.IsNullOrWhiteSpace(item.Address) ? "No address specified" : item.Address)</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination footer matching reference image -->
                <div class="pagination-footer">
                    <div class="pagination-info">
                        @if (pagedResult.TotalCount > 0)
                        {
                            var start = (currentPage - 1) * pageSize + 1;
                            var end = Math.Min(currentPage * pageSize, pagedResult.TotalCount);
                            <span>Showing <strong>@start - @end</strong> of <strong>@pagedResult.TotalCount</strong> locations</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> locations</span>
                        }
                    </div>

                    @if (pagedResult.TotalPages > 1)
                    {
                        <div class="pagination-controls">
                            <button type="button"
                                    class="page-nav-btn prev-btn"
                                    disabled="@(!pagedResult.HasPreviousPage)"
                                    @onclick="() => GoToPageAsync(currentPage - 1)"
                                    title="Previous page">
                                &lt;
                            </button>

                            @foreach (var p in GetVisiblePageNumbers())
                            {
                                if (p == -1)
                                {
                                    <span class="page-ellipsis">...</span>
                                }
                                else
                                {
                                    var pageNumber = p;
                                    <button type="button"
                                            class="page-num-btn @(pageNumber == currentPage ? "active" : "")"
                                            @onclick="() => GoToPageAsync(pageNumber)">
                                        @pageNumber
                                    </button>
                                }
                            }

                            <button type="button"
                                    class="page-nav-btn next-btn"
                                    disabled="@(!pagedResult.HasNextPage)"
                                    @onclick="() => GoToPageAsync(currentPage + 1)"
                                    title="Next page">
                                &gt;
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="auth-denied-container">
            <div class="auth-alert error" role="alert">
                <AppIcon Name="warning" />
                <span>You do not have permission to access the Location List Management console. Staff or Admin authorization is required.</span>
            </div>
            <button type="button" class="btn-back" @onclick='() => Navigation.NavigateTo("/admin/login")'>
                Go to portal sign in
            </button>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string searchTerm = "";
    private int currentPage = 1;
    private int pageSize = 6; // Matching screenshot 6 rows per page
    private PagedResult<LocationDto> pagedResult = new();
    private bool isLoading = true;
    private string? errorMessage;
    private System.Timers.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadLocationsAsync(1);
    }

    private async Task LoadLocationsAsync(int page)
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            currentPage = page;

            var res = await LocationService.GetPagedLocationsAsync(searchTerm, currentPage, pageSize);
            if (res.Success && res.Data != null)
            {
                pagedResult = res.Data;
            }
            else
            {
                errorMessage = !string.IsNullOrWhiteSpace(res.Message)
                    ? res.Message
                    : "Unable to load locations.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load locations: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        debounceTimer?.Stop();
        debounceTimer?.Dispose();
        debounceTimer = new System.Timers.Timer(350);
        debounceTimer.AutoReset = false;
        debounceTimer.Elapsed += async (_, _) =>
        {
            await InvokeAsync(async () =>
            {
                currentPage = 1;
                await LoadLocationsAsync(1);
            });
        };
        debounceTimer.Start();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            debounceTimer?.Stop();
            currentPage = 1;
            await LoadLocationsAsync(1);
        }
    }

    private async Task ClearSearchAsync()
    {
        searchTerm = "";
        debounceTimer?.Stop();
        currentPage = 1;
        await LoadLocationsAsync(1);
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || (pagedResult.TotalPages > 0 && page > pagedResult.TotalPages) || page == currentPage)
        {
            return;
        }

        await LoadLocationsAsync(page);
    }

    private string FormatLocationId(Guid id)
    {
        var str = id.ToString("N");
        return str.Length >= 8 ? str[..8].ToUpperInvariant() : str.ToUpperInvariant();
    }

    private List<int> GetVisiblePageNumbers()
    {
        var list = new List<int>();
        var total = pagedResult.TotalPages;
        if (total <= 1) return list;

        if (total <= 7)
        {
            for (var i = 1; i <= total; i++) list.Add(i);
            return list;
        }

        list.Add(1);

        if (currentPage <= 4)
        {
            for (var i = 2; i <= Math.Min(5, total - 1); i++) list.Add(i);
            if (total > 6) list.Add(-1); // ellipsis
            list.Add(total);
        }
        else if (currentPage >= total - 3)
        {
            list.Add(-1); // ellipsis
            for (var i = total - 4; i <= total; i++) list.Add(i);
        }
        else
        {
            list.Add(-1);
            list.Add(currentPage - 1);
            list.Add(currentPage);
            list.Add(currentPage + 1);
            list.Add(-1);
            list.Add(total);
        }

        return list;
    }

    public void Dispose()
    {
        debounceTimer?.Stop();
        debounceTimer?.Dispose();
    }
}

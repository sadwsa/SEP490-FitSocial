@page "/admin"
@page "/admin/users"
@page "/admin/sports"
@layout AuthLayout
@attribute [Authorize(Roles = "ADMIN,STAFF")]
@implements IDisposable
@using FitSocial.Client.Models.Common
@using FitSocial.Client.Models.Sports
@using FitSocial.Client.Models.Users
@using FitSocial.Client.Services.Sports
@using FitSocial.Client.Services.Users
@inject IAuthService AuthService
@inject ISportService SportService
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>@(view == "users" ? "User Accounts" : view == "sports" ? "Sport Categories" : "Dashboard") - FitSocial Admin Console</PageTitle>

<div class="console">
    <!-- Sidebar -->
    <aside class="console-side">
        <div class="side-brand">
            <img src="Logo_FitSocial.jpg" alt="FitSocial" />
            <div>
                <strong>FitSocial</strong>
                <small>Admin Console</small>
            </div>
        </div>

        <nav class="side-nav">
            <button type="button" class="side-item @(view == "overview" ? "active" : "")" @onclick='() => SwitchView("overview")'>
                <AppIcon Name="chart" /><span>Dashboard</span>
            </button>
            <button type="button" class="side-item @(view == "users" ? "active" : "")" @onclick='() => SwitchView("users")'>
                <AppIcon Name="person" /><span>User Accounts</span>
            </button>
            <button type="button" class="side-item @(view == "sports" ? "active" : "")" @onclick='() => SwitchView("sports")'>
                <AppIcon Name="dumbbell" /><span>Sport Categories</span>
            </button>
            <button type="button" class="side-item" @onclick='() => DemoSoon("Content Moderation")'>
                <AppIcon Name="shield" /><span>Content Moderation</span>
            </button>
            <button type="button" class="side-item" @onclick='() => DemoSoon("Activity Logs")'>
                <AppIcon Name="doc" /><span>Activity Logs</span>
            </button>
            <button type="button" class="side-item" @onclick='() => DemoSoon("System Settings")'>
                <AppIcon Name="gear" /><span>System Settings</span>
            </button>
        </nav>

        <div class="side-foot">
            <AuthorizeView Roles="ADMIN,STAFF">
                <Authorized>
                    <div class="side-user">
                        <strong>@context.User.Identity?.Name</strong>
                        <small>@string.Join(", ", AppRoles.All.Where(r => context.User.IsInRole(r)))</small>
                    </div>
                </Authorized>
            </AuthorizeView>
            <button type="button" class="side-logout" @onclick="HandleLogout">Sign out</button>
        </div>
    </aside>

    <!-- Main -->
    <main class="console-main">
        <AuthorizeView Roles="ADMIN,STAFF">
            <Authorized>
                @if (!string.IsNullOrEmpty(toastMessage))
                {
                    <div class="auth-alert info" role="alert"><AppIcon Name="info" /><span>@toastMessage</span></div>
                }

                @if (view == "overview")
                {
                    <h2 class="view-title">Overview</h2>
                    <p class="view-sub">Platform metrics loaded directly from database.</p>
                    <WidgetsRow ActiveCount="@sports.Count(s => s.Visible)" TotalLogs="@sports.Sum(s => s.PostCount)" />
                    <div class="shortcuts">
                        <button type="button" class="shortcut" @onclick='() => SwitchView("users")'>
                            <AppIcon Name="person" />
                            <div><strong>Manage user accounts</strong><small>View, lock, unlock</small></div>
                            <span>→</span>
                        </button>
                        <button type="button" class="shortcut" @onclick='() => SwitchView("sports")'>
                            <AppIcon Name="dumbbell" />
                            <div><strong>Manage sport categories</strong><small>View, create, edit, delete</small></div>
                            <span>→</span>
                        </button>
                    </div>
                }
                else if (view == "users")
                {
                    <h2 class="view-title">User Accounts</h2>
                    <p class="view-sub">Manage and monitor user accounts across the FitSocial platform.</p>

                    <div class="cat-tabs mb-3">
                        <button type="button" class="cat-tab @(userStatusFilter == "active" ? "active" : "")" @onclick='() => SetUserStatusFilterAsync("active")'>
                            <span class="status-dot dot-active"></span> Active Accounts
                        </button>
                        <button type="button" class="cat-tab @(userStatusFilter == "locked" ? "active" : "")" @onclick='() => SetUserStatusFilterAsync("locked")'>
                            <span class="status-dot dot-locked"></span> Locked Accounts
                        </button>
                        <button type="button" class="cat-tab @(userStatusFilter == "all" ? "active" : "")" @onclick='() => SetUserStatusFilterAsync("all")'>
                            All Accounts
                        </button>
                    </div>

                    <div class="toolbar">
                        <div class="search-wrap">
                            <span class="search-icon"><AppIcon Name="search" /></span>
                            <input value="@userSearch" @oninput="OnUserSearchInput" @onkeydown="HandleUserSearchKeyDown" class="toolbar-input" placeholder="Search name or email..." />
                        </div>
                        <select value="@roleFilter" @onchange="OnRoleFilterChangedAsync" class="toolbar-select">
                            <option value="">All roles</option>
                            <option value="TRAINEE">Trainee</option>
                            <option value="COACH">Coach</option>
                            <option value="STAFF">Staff</option>
                            <option value="ADMIN">Admin</option>
                        </select>
                        <button type="button" class="row-btn" @onclick="LoadUsersAsync" disabled="@isLoadingUsers">
                            <span class="btn-ic"><AppIcon Name="refresh" /></span> Refresh
                        </button>
                    </div>

                    @if (isLoadingUsers)
                    {
                        <div class="py-3 text-center muted">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Loading user accounts from database...</span>
                        </div>
                    }

                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in pagedUsers.Items)
                                {
                                    <tr>
                                        <td><strong>@u.FullName</strong><br /><small class="muted">@(u.PhoneNumber ?? "No phone")</small></td>
                                        <td>@u.Email</td>
                                        <td><span class="role-badge @u.RoleCode.ToLower()">@u.RoleCode</span></td>
                                        <td>
                                            @if (u.IsLocked)
                                            {
                                                <span class="status-badge locked">Locked</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge active">Active</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (u.IsLocked)
                                            {
                                                <button type="button" class="row-btn unlock" disabled="@isLockingUser" @onclick="() => SetLockedAsync(u, false)">Unlock</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="row-btn lock" disabled="@isLockingUser" @onclick="() => SetLockedAsync(u, true)">Lock</button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!isLoadingUsers && !pagedUsers.Items.Any())
                                {
                                    <tr><td colspan="5" class="text-center muted py-4">No accounts match.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination-container">
                        <div class="pagination-info">
                            @if (pagedUsers.TotalCount > 0)
                            {
                                var start = (userCurrentPage - 1) * userPageSize + 1;
                                var end = Math.Min(userCurrentPage * userPageSize, pagedUsers.TotalCount);
                                <span>Showing <strong>@start–@end</strong> of <strong>@pagedUsers.TotalCount</strong> accounts</span>
                            }
                            else
                            {
                                <span>0 accounts</span>
                            }
                        </div>
                        @if (pagedUsers.TotalPages > 1)
                        {
                            <div class="pagination-controls">
                                <button type="button" class="page-btn" disabled="@(!pagedUsers.HasPreviousPage)" @onclick="() => GoToUserPageAsync(userCurrentPage - 1)">
                                    ‹ Previous
                                </button>
                                @foreach (var p in GetVisibleUserPageNumbers())
                                {
                                    if (p == -1)
                                    {
                                        <span class="page-dots">…</span>
                                    }
                                    else
                                    {
                                        var pageNum = p;
                                        <button type="button" class="page-btn @(pageNum == userCurrentPage ? "active" : "")" @onclick="() => GoToUserPageAsync(pageNum)">
                                            @pageNum
                                        </button>
                                    }
                                }
                                <button type="button" class="page-btn" disabled="@(!pagedUsers.HasNextPage)" @onclick="() => GoToUserPageAsync(userCurrentPage + 1)">
                                    Next ›
                                </button>
                            </div>
                        }
                        <div class="page-size-selector">
                            <span>Per page:</span>
                            <select value="@userPageSize" @onchange="OnUserPageSizeChangedAsync" class="page-size-select">
                                <option value="10">10 / page</option>
                                <option value="20">20 / page</option>
                                <option value="50">50 / page</option>
                            </select>
                        </div>
                    </div>
                }
                else if (view == "sports")
                {
                    <h2 class="view-title">Sport Categories</h2>

                    <WidgetsRow ActiveCount="@sports.Count(s => s.Visible)" TotalLogs="@sports.Sum(s => s.PostCount)" />

                    <div class="toolbar wrap">
                        <div class="search-wrap grow">
                            <span class="search-icon"><AppIcon Name="search" /></span>
                            <input @bind="sportSearch" @bind:event="oninput" class="toolbar-input" placeholder="Search by name or code (e.g. SPORT_01)..." />
                        </div>
                        <select @bind="sportStatus" class="toolbar-select">
                            <option value="">All statuses</option>
                            <option value="visible">Visible</option>
                            <option value="hidden">Hidden</option>
                        </select>
                        <button type="button" class="row-btn" @onclick="LoadSportsAsync" disabled="@isLoadingSports">
                            <span class="btn-ic"><AppIcon Name="refresh" /></span> Refresh
                        </button>
                        <button type="button" class="row-btn add" @onclick="ToggleSportForm">+ Add New Sport</button>
                    </div>

                    <div class="cat-tabs">
                        @foreach (var c in categories)
                        {
                            <button type="button" class="cat-tab @(sportCategory == c ? "active" : "")" @onclick="() => sportCategory = c">@c</button>
                        }
                    </div>

                    @if (showSportForm)
                    {
                        <div class="sport-form">
                            <strong>@(editingSportId == null ? "Add new sport" : "Edit sport")</strong>
                            <div class="form-grid">
                                <input @bind="sportFormName" class="toolbar-input" placeholder="Sport name *" />
                                <select @bind="sportFormCategory" class="toolbar-select">
                                    @foreach (var c in categories.Where(x => x != "All"))
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                            </div>
                            <div class="form-actions">
                                <button type="button" class="row-btn" @onclick="CancelSportForm" disabled="@isSavingSport">Cancel</button>
                                <button type="button" class="row-btn add" @onclick="SaveSportFormAsync" disabled="@isSavingSport">
                                    @(isSavingSport ? "Saving..." : "Save")
                                </button>
                            </div>
                        </div>
                    }

                    @if (isLoadingSports)
                    {
                        <div class="py-3 text-center muted">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Loading sport categories from database...</span>
                        </div>
                    }

                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Sport / Icon</th>
                                    <th>Code</th>
                                    <th>Coaches &amp; Posts</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in FilteredSports)
                                {
                                    <tr>
                                        <td>
                                            <div class="sport-cell">
                                                <span class="sport-ic"><AppIcon Name="@s.Icon" /></span>
                                                <div><strong>@s.SportName</strong><br /><small class="muted">@s.Description</small></div>
                                            </div>
                                        </td>
                                        <td><code>@s.Code</code></td>
                                        <td><small>@s.CoachCount.ToString("N0") coaches<br />@s.PostCount.ToString("N0") posts</small></td>
                                        <td>
                                            @if (s.Visible)
                                            {
                                                <span class="status-badge active">Visible</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge locked">Hidden</span>
                                            }
                                        </td>
                                        <td class="text-end whitespace-nowrap">
                                            @if (confirmDeleteId == s.SportId)
                                            {
                                                <button type="button" class="row-btn lock" @onclick="() => DeleteSportAsync(s)">Confirm?</button>
                                                <button type="button" class="row-btn" @onclick="() => confirmDeleteId = null">No</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="icon-btn" title="Edit" @onclick="() => StartSportEdit(s)"><AppIcon Name="pencil" /></button>
                                                <button type="button" class="icon-btn danger" title="Delete" @onclick="() => confirmDeleteId = s.SportId"><AppIcon Name="trash" /></button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!isLoadingSports && !FilteredSports.Any())
                                {
                                    <tr><td colspan="5" class="text-center muted">No sports match.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="paging">Showing 1–@FilteredSports.Count() of @FilteredSports.Count() sports</p>
                }
            </Authorized>
            <NotAuthorized>
                <div class="auth-alert error" role="alert">
                    <AppIcon Name="warning" /><span>You do not have access to this page.</span>
                </div>
                <button type="button" class="btn-back" @onclick='() => Navigation.NavigateTo("/admin/login")'>
                    Go to portal sign in
                </button>
            </NotAuthorized>
        </AuthorizeView>
    </main>
</div>

@code {
    private string view = "sports";
    private string? toastMessage;

    private string userSearch = "";
    private string roleFilter = "";
    private string userStatusFilter = "active";
    private int userCurrentPage = 1;
    private int userPageSize = 10;
    private PagedResult<AdminUserDto> pagedUsers = new();
    private System.Timers.Timer? searchDebounceTimer;

    private string sportSearch = "";
    private string sportCategory = "All";
    private string sportStatus = "";
    private bool showSportForm = false;
    private Guid? editingSportId;
    private string sportFormName = "";
    private string sportFormCategory = "Gym & Strength";
    private Guid? confirmDeleteId;

    private bool isLoadingSports = false;
    private bool isLoadingUsers = false;
    private bool isSavingSport = false;
    private bool isLockingUser = false;

    private readonly List<string> categories = new()
    {
        "All", "Gym & Strength", "Cardio & Athletics", "Combat Sports", "Team Sports"
    };

    private List<SportDto> sports = new();

    protected override async Task OnInitializedAsync()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
        if (relative.StartsWith("admin/users"))
        {
            view = "users";
        }
        else if (relative.StartsWith("admin/sports"))
        {
            view = "sports";
        }

        await Task.WhenAll(LoadSportsAsync(), LoadUsersAsync());
    }

    private async Task LoadSportsAsync()
    {
        isLoadingSports = true;
        try
        {
            var res = await SportService.GetSportsAsync();
            if (res.Success && res.Data != null)
            {
                sports = res.Data;
            }
            else if (!string.IsNullOrEmpty(res.Message))
            {
                toastMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            toastMessage = $"Failed to load sports: {ex.Message}";
        }
        finally
        {
            isLoadingSports = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        isLoadingUsers = true;
        try
        {
            bool? isLocked = userStatusFilter switch
            {
                "active" => false,
                "locked" => true,
                _ => null
            };

            var res = await UserService.GetUsersAsync(
                userSearch,
                roleFilter,
                isLocked,
                userCurrentPage,
                userPageSize);

            if (res.Success && res.Data != null)
            {
                pagedUsers = res.Data;
                if (pagedUsers.TotalPages > 0 && userCurrentPage > pagedUsers.TotalPages)
                {
                    userCurrentPage = pagedUsers.TotalPages;
                    await LoadUsersAsync();
                    return;
                }
            }
            else if (!string.IsNullOrEmpty(res.Message))
            {
                toastMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            toastMessage = $"Failed to load users: {ex.Message}";
        }
        finally
        {
            isLoadingUsers = false;
        }
    }

    private async Task SetUserStatusFilterAsync(string status)
    {
        if (userStatusFilter == status) return;
        userStatusFilter = status;
        userCurrentPage = 1;
        await LoadUsersAsync();
    }

    private async Task OnRoleFilterChangedAsync(ChangeEventArgs e)
    {
        roleFilter = e.Value?.ToString() ?? "";
        userCurrentPage = 1;
        await LoadUsersAsync();
    }

    private void OnUserSearchInput(ChangeEventArgs e)
    {
        userSearch = e.Value?.ToString() ?? "";
        searchDebounceTimer?.Stop();
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Timers.Timer(400);
        searchDebounceTimer.AutoReset = false;
        searchDebounceTimer.Elapsed += async (_, _) =>
        {
            userCurrentPage = 1;
            await InvokeAsync(LoadUsersAsync);
            await InvokeAsync(StateHasChanged);
        };
        searchDebounceTimer.Start();
    }

    private async Task HandleUserSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            searchDebounceTimer?.Stop();
            userCurrentPage = 1;
            await LoadUsersAsync();
        }
    }

    private async Task GoToUserPageAsync(int page)
    {
        if (page < 1 || (pagedUsers.TotalPages > 0 && page > pagedUsers.TotalPages) || page == userCurrentPage)
            return;

        userCurrentPage = page;
        await LoadUsersAsync();
    }

    private async Task OnUserPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            userPageSize = newSize;
            userCurrentPage = 1;
            await LoadUsersAsync();
        }
    }

    private IEnumerable<int> GetVisibleUserPageNumbers()
    {
        var total = pagedUsers.TotalPages;
        if (total <= 1) yield break;

        var current = userCurrentPage;
        var delta = 2;

        var left = Math.Max(1, current - delta);
        var right = Math.Min(total, current + delta);

        if (left > 1)
        {
            yield return 1;
            if (left > 2) yield return -1;
        }

        for (var i = left; i <= right; i++)
        {
            yield return i;
        }

        if (right < total)
        {
            if (right < total - 1) yield return -1;
            yield return total;
        }
    }

    private void SwitchView(string next)
    {
        view = next;
        toastMessage = null;
    }

    private void DemoSoon(string module)
    {
        toastMessage = $"[Demo] {module} is not part of this preview.";
    }

    private IEnumerable<SportDto> FilteredSports =>
        sports.Where(s =>
            (string.IsNullOrWhiteSpace(sportSearch) ||
             s.SportName.Contains(sportSearch, StringComparison.OrdinalIgnoreCase) ||
             s.Code.Contains(sportSearch, StringComparison.OrdinalIgnoreCase)) &&
            (sportCategory == "All" || s.Category == sportCategory) &&
            (string.IsNullOrWhiteSpace(sportStatus) ||
             (sportStatus == "visible" && s.Visible) ||
             (sportStatus == "hidden" && !s.Visible)));

    private async Task SetLockedAsync(AdminUserDto user, bool locked)
    {
        isLockingUser = true;
        try
        {
            var res = await UserService.SetUserLockStatusAsync(user.UserId, locked);
            if (res.Success)
            {
                toastMessage = res.Message ?? (locked
                    ? $"{user.FullName} has been locked."
                    : $"{user.FullName} has been unlocked.");
                await LoadUsersAsync();
            }
            else
            {
                toastMessage = res.Message ?? "Failed to update user lock status.";
            }
        }
        catch (Exception ex)
        {
            toastMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLockingUser = false;
        }
    }

    private void ToggleSportForm()
    {
        showSportForm = !showSportForm;
        editingSportId = null;
        sportFormName = "";
        sportFormCategory = "Gym & Strength";
    }

    private void StartSportEdit(SportDto sport)
    {
        showSportForm = true;
        editingSportId = sport.SportId;
        sportFormName = sport.SportName;
        sportFormCategory = sport.Category;
        confirmDeleteId = null;
    }

    private void CancelSportForm()
    {
        showSportForm = false;
        editingSportId = null;
    }

    private async Task SaveSportFormAsync()
    {
        if (string.IsNullOrWhiteSpace(sportFormName))
        {
            toastMessage = "Enter a sport name first.";
            return;
        }

        isSavingSport = true;
        try
        {
            if (editingSportId == null)
            {
                var res = await SportService.CreateSportAsync(new CreateSportDto { SportName = sportFormName.Trim() });
                if (res.Success)
                {
                    toastMessage = res.Message ?? $"Sport '{sportFormName.Trim()}' created successfully.";
                    CancelSportForm();
                    await LoadSportsAsync();
                }
                else
                {
                    toastMessage = res.Message ?? "Failed to create sport.";
                }
            }
            else
            {
                var res = await SportService.UpdateSportAsync(editingSportId.Value, new UpdateSportDto { SportName = sportFormName.Trim() });
                if (res.Success)
                {
                    toastMessage = res.Message ?? "Sport updated successfully.";
                    CancelSportForm();
                    await LoadSportsAsync();
                }
                else
                {
                    toastMessage = res.Message ?? "Failed to update sport.";
                }
            }
        }
        catch (Exception ex)
        {
            toastMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSavingSport = false;
        }
    }

    private async Task DeleteSportAsync(SportDto sport)
    {
        confirmDeleteId = null;
        try
        {
            var res = await SportService.DeleteSportAsync(sport.SportId);
            if (res.Success)
            {
                toastMessage = res.Message ?? $"Sport '{sport.SportName}' deleted successfully.";
                await LoadSportsAsync();
            }
            else
            {
                toastMessage = res.Message ?? "Failed to delete sport.";
            }
        }
        catch (Exception ex)
        {
            toastMessage = $"Error: {ex.Message}";
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/admin/login");
    }

    public void Dispose()
    {
        searchDebounceTimer?.Stop();
        searchDebounceTimer?.Dispose();
    }
}

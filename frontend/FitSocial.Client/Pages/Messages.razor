@page "/messages"
@page "/messages/{conversationId:guid}"
@layout EmptyLayout
@attribute [Authorize]
@inject IConversationService ConversationService
@inject IChatHubClient ChatHubClient
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@using System.Security.Claims
@using FitSocial.Client.Layout
@using FitSocial.Client.Models.Conversations
@using FitSocial.Client.Models.Auth
@using FitSocial.Client.Services.Notifications
@implements IAsyncDisposable

<PageTitle>Messages - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800 flex flex-col">
    <!-- Header matching Home -->
    <AppHeader SearchTerm="@headerSearchTerm"
               OnSearchInput="HandleHeaderSearchInput"
               OnSearchKeyUp="HandleHeaderSearchKeyUp"
               OnSearch="ExecuteHeaderSearch"
               OnClearSearch="ClearHeaderSearch"
               UserName="@userName"
               UserInitials="@userInitials"
               UserRole="@userRole"
               OnLogout="HandleLogout" />

    <!-- Main Content Layout (Sidebar + Messages Container) matching Home -->
    <div class="w-full pt-4 lg:pt-6 px-3 sm:px-4 lg:px-6 flex items-start gap-6 max-w-[1600px] mx-auto flex-1 pb-4">
        <!-- Left Sidebar: Menu Navigation -->
        <AppSidebar ActiveItem="messages" />

        <!-- Messages Workspace Card -->
        <div class="flex-1 min-w-0 bg-white rounded-2xl shadow-sm border border-gray-200/80 overflow-hidden flex flex-col md:flex-row h-[calc(100vh-5.5rem)]">

            <!-- 1. Left Column: Conversation List -->
            <div class="w-full md:w-80 lg:w-96 flex-shrink-0 border-r border-gray-100 flex flex-col bg-white h-full @(ConversationId.HasValue ? "hidden md:flex" : "flex")">
                
                <!-- Conversation List Header -->
                <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <h1 class="text-xl font-bold text-gray-900 tracking-tight">Messages</h1>
                        @if (_conversations != null && _conversations.Any(c => c.UnreadCount > 0))
                        {
                            var totalUnread = _conversations.Sum(c => c.UnreadCount);
                            <span class="bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white text-xs font-bold px-2 py-0.5 rounded-full shadow-xs">
                                @totalUnread
                            </span>
                        }
                    </div>
                    <button type="button"
                            class="p-2 text-gray-400 hover:text-[#FF5500] hover:bg-orange-50 rounded-xl transition cursor-pointer"
                            title="Reload list"
                            @onclick="() => LoadConversationsAsync(true)">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                    </button>
                </div>

                <!-- Search Bar -->
                <div class="p-3 border-b border-gray-100">
                    <div class="relative">
                        <input type="text"
                               class="w-full bg-gray-100 rounded-xl py-2 pl-9 pr-4 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:bg-white text-sm text-gray-800 placeholder-gray-400 transition"
                               placeholder="Search conversations..."
                               @bind="_searchTerm"
                               @bind:event="oninput" />
                        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                </div>

                <!-- Conversation Items List Area -->
                <div class="flex-1 overflow-y-auto divide-y divide-gray-50">
                    @if (_isLoading)
                    {
                        <!-- Loading Skeletons -->
                        @for (int i = 0; i < 5; i++)
                        {
                            <div class="p-4 flex items-center gap-3 animate-pulse">
                                <div class="w-12 h-12 rounded-full bg-gray-200 flex-shrink-0"></div>
                                <div class="flex-1 space-y-2">
                                    <div class="h-3.5 bg-gray-200 rounded w-1/3"></div>
                                    <div class="h-2.5 bg-gray-100 rounded w-3/4"></div>
                                </div>
                            </div>
                        }
                    }
                    else if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <!-- Error State -->
                        <div class="p-8 text-center flex flex-col items-center justify-center h-full">
                            <div class="w-12 h-12 rounded-full bg-red-50 text-red-500 flex items-center justify-center mb-3">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                </svg>
                            </div>
                            <p class="text-sm font-medium text-red-600 mb-3">@_errorMessage</p>
                            <button class="px-4 py-2 bg-orange-50 text-[#FF5500] hover:bg-orange-100 rounded-xl text-xs font-semibold transition cursor-pointer"
                                    @onclick="() => LoadConversationsAsync(true)">
                                Retry
                            </button>
                        </div>
                    }
                    else if (FilteredConversations == null || !FilteredConversations.Any())
                    {
                        <!-- Empty State -->
                        <div class="p-8 text-center flex flex-col items-center justify-center h-full text-gray-400">
                            <div class="w-14 h-14 rounded-2xl bg-orange-50 text-orange-400 flex items-center justify-center mb-3">
                                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                          d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                </svg>
                            </div>
                            <p class="text-sm font-semibold text-gray-700 mb-1">
                                @(string.IsNullOrWhiteSpace(_searchTerm) ? "No conversations yet" : "No matching conversations")
                            </p>
                            <p class="text-xs text-gray-400 max-w-xs">
                                @(string.IsNullOrWhiteSpace(_searchTerm) 
                                    ? "When you connect with coaches or friends, your messages will appear here." 
                                    : "Try searching with a different keyword.")
                            </p>
                        </div>
                    }
                    else
                    {
                        <!-- Conversations List -->
                        @foreach (var item in FilteredConversations)
                        {
                            var isSelected = _selectedConversationId == item.ConversationId;
                            var isUnread = item.UnreadCount > 0;
                            <div class="group relative flex items-center gap-3 px-4 py-3.5 cursor-pointer transition @(isSelected ? "bg-orange-50/80 border-l-4 border-[#FF5500]" : "hover:bg-gray-50/80")"
                                 @onclick="() => SelectConversation(item.ConversationId)">
                                <!-- Avatar -->
                                <div class="relative flex-shrink-0">
                                    @if (!string.IsNullOrWhiteSpace(item.DisplayAvatar))
                                    {
                                        <img src="@item.DisplayAvatar" alt="@item.Title" class="w-12 h-12 rounded-full object-cover ring-2 ring-gray-100" />
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold text-sm shadow-xs">
                                            @GetInitials(item.Title)
                                        </div>
                                    }
                                    @if (isUnread)
                                    {
                                        <span class="absolute bottom-0 right-0 w-3 h-3 bg-[#FF5500] border-2 border-white rounded-full"></span>
                                    }
                                </div>

                                <!-- Info -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between gap-1 mb-1">
                                        <span class="font-semibold text-sm truncate @(isUnread ? "text-gray-900" : "text-gray-800")">@item.Title</span>
                                        @if (item.LastMessageAt.HasValue)
                                        {
                                            <span class="text-[11px] text-gray-400 flex-shrink-0">@FormatTime(item.LastMessageAt.Value)</span>
                                        }
                                    </div>
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="text-xs truncate @(isUnread ? "font-semibold text-gray-900" : "text-gray-500")">
                                            @(string.IsNullOrWhiteSpace(item.LastMessage) ? "Started a conversation" : item.LastMessage)
                                        </p>
                                        @if (item.UnreadCount > 0)
                                        {
                                            <span class="bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white text-[11px] font-bold px-1.5 py-0.5 rounded-full shadow-xs flex-shrink-0">
                                                @item.UnreadCount
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- Delete Conversation Action -->
                                <button type="button"
                                        class="opacity-0 group-hover:opacity-100 p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition ml-1 cursor-pointer flex-shrink-0"
                                        title="Delete conversation"
                                        @onclick="() => PromptDeleteConversation(item.ConversationId, item.Title)"
                                        @onclick:stopPropagation="true">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- 2. Right Column: Conversation Detail or Empty State -->
            <div class="flex-1 flex flex-col bg-white h-full min-w-0 @(ConversationId.HasValue ? "flex" : "hidden md:flex")">
                @if (!ConversationId.HasValue)
                {
                    <!-- Placeholder when no conversation is selected -->
                    <div class="flex-1 flex flex-col items-center justify-center p-8 text-center bg-gray-50/30">
                        <div class="w-20 h-20 rounded-2xl bg-orange-50 text-[#FF5500] flex items-center justify-center mb-4 shadow-xs">
                            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                            </svg>
                        </div>
                        <h2 class="text-xl font-bold text-gray-900 mb-2">Your Messages</h2>
                        <p class="text-sm text-gray-500 max-w-sm mb-6">
                            Send private messages, schedule workouts, or ask questions to your sports coach.
                        </p>
                        <a href="coaches"
                           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white font-semibold text-sm shadow-sm hover:shadow hover:opacity-95 transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                            <span>Find Coaches</span>
                        </a>
                    </div>
                }
                else
                {
                    <!-- Conversation Detail View -->
                    @if (_isDetailLoading)
                    {
                        <!-- Detail Loading Skeleton -->
                        <div class="px-5 py-4 border-b border-gray-100 flex items-center gap-3 animate-pulse">
                            <div class="w-10 h-10 rounded-full bg-gray-200"></div>
                            <div class="space-y-1.5 flex-1">
                                <div class="h-4 bg-gray-200 rounded w-1/4"></div>
                                <div class="h-3 bg-gray-100 rounded w-1/6"></div>
                            </div>
                        </div>
                        <div class="flex-1 flex flex-col items-center justify-center p-8 text-center text-gray-400">
                            <div class="w-8 h-8 border-3 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-3"></div>
                            <p class="text-sm font-medium text-gray-600">Loading conversation...</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_detailErrorMessage))
                    {
                        <!-- Detail Error State -->
                        <div class="flex-1 flex flex-col items-center justify-center p-8 text-center">
                            <div class="w-12 h-12 rounded-full bg-red-50 text-red-500 flex items-center justify-center mb-3">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                </svg>
                            </div>
                            <h3 class="text-base font-bold text-gray-900 mb-1">Cannot load conversation</h3>
                            <p class="text-xs text-red-500 mb-4">@_detailErrorMessage</p>
                            <button class="px-4 py-2 bg-orange-50 text-[#FF5500] hover:bg-orange-100 rounded-xl text-xs font-semibold transition cursor-pointer"
                                    @onclick="() => LoadConversationDetailAsync(ConversationId.Value)">
                                Try again
                            </button>
                        </div>
                    }
                    else if (_conversationDetail != null)
                    {
                        <!-- Detail Header -->
                        <div class="px-5 py-3.5 border-b border-gray-100 flex items-center justify-between bg-white z-10">
                            <div class="flex items-center gap-3">
                                <button class="md:hidden p-2 -ml-2 text-gray-500 hover:text-gray-800 hover:bg-gray-100 rounded-xl transition cursor-pointer"
                                        title="Back to conversations"
                                        @onclick="BackToConversationList">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                                    </svg>
                                </button>
                                <div class="relative flex-shrink-0">
                                    @if (!string.IsNullOrWhiteSpace(_conversationDetail.DisplayAvatar))
                                    {
                                        <img src="@_conversationDetail.DisplayAvatar" alt="@_conversationDetail.Title" class="w-10 h-10 rounded-full object-cover ring-2 ring-gray-100" />
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold text-xs shadow-xs">
                                            @GetInitials(_conversationDetail.Title)
                                        </div>
                                    }
                                </div>
                                <div>
                                    <h2 class="font-bold text-gray-900 text-base leading-tight">@_conversationDetail.Title</h2>
                                    @if (_conversationDetail.IsBlockedByMe)
                                    {
                                        <span class="text-xs text-red-500 flex items-center gap-1 font-medium">
                                            <span class="w-2 h-2 rounded-full bg-red-500 inline-block"></span>
                                            Blocked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-emerald-600 flex items-center gap-1 font-medium">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                                            @(string.Equals(_conversationDetail.Type, "GROUP", StringComparison.OrdinalIgnoreCase) ? "Group conversation" : "Active conversation")
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="flex items-center gap-1.5">
                                @if (!string.Equals(_conversationDetail.Type, "GROUP", StringComparison.OrdinalIgnoreCase))
                                {
                                    @if (_conversationDetail.IsBlockedByMe)
                                    {
                                        <button type="button"
                                                class="px-3 py-1.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer disabled:opacity-50"
                                                title="Unblock this user"
                                                disabled="@_isBlockingAction"
                                                @onclick="UnblockUserAsync">
                                            <svg class="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path>
                                            </svg>
                                            <span>Unblock</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="px-3 py-1.5 rounded-xl border border-red-200 text-red-600 hover:bg-red-50 text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer"
                                                title="Block this user"
                                                @onclick="PromptBlockUser">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                                            </svg>
                                            <span>Block</span>
                                        </button>
                                    }
                                }

                                <button type="button"
                                        class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition cursor-pointer"
                                        title="Delete conversation"
                                        @onclick="() => PromptDeleteConversation(_conversationDetail.ConversationId, _conversationDetail.Title)">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Blocked Status Warning Banner -->
                        @if (_conversationDetail.IsBlockedByMe)
                        {
                            <div class="px-5 py-2.5 bg-red-50/90 border-b border-red-100 flex items-center justify-between text-xs text-red-700">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                                    </svg>
                                    <span>You have blocked this user. You will not receive messages or notifications from them.</span>
                                </div>
                                <button type="button"
                                        class="font-semibold text-red-800 hover:underline cursor-pointer flex-shrink-0 ml-2"
                                        disabled="@_isBlockingAction"
                                        @onclick="UnblockUserAsync">
                                    Unblock
                                </button>
                            </div>
                        }

                        <!-- Message History Area -->
                        <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-3 bg-gray-50/40 messages-history-scroll">
                            @if (_conversationDetail.Messages == null || !_conversationDetail.Messages.Any())
                            {
                                <div class="h-full flex flex-col items-center justify-center text-center text-gray-400 my-auto">
                                    <div class="w-12 h-12 rounded-full bg-orange-50 text-orange-400 flex items-center justify-center mb-2">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                                  d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                        </svg>
                                    </div>
                                    <p class="text-sm font-medium text-gray-600">No messages yet</p>
                                    <p class="text-xs text-gray-400">Say hello to begin your conversation!</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var msg in _conversationDetail.Messages)
                                {
                                    <div class="flex @(msg.IsMine ? "justify-end" : "justify-start items-end gap-2")">
                                        @if (!msg.IsMine)
                                        {
                                            <div class="w-7 h-7 rounded-full flex-shrink-0 mb-1 overflow-hidden">
                                                @if (!string.IsNullOrWhiteSpace(msg.SenderAvatar))
                                                {
                                                    <img src="@msg.SenderAvatar" alt="@msg.SenderName" class="w-full h-full object-cover" />
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold text-[10px]">
                                                        @GetInitials(msg.SenderName)
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="flex flex-col @(msg.IsMine ? "items-end" : "items-start") max-w-[80%] sm:max-w-md">
                                            @if (!msg.IsMine && string.Equals(_conversationDetail.Type, "GROUP", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="text-[11px] font-medium text-gray-500 mb-1 px-1">@msg.SenderName</span>
                                            }
                                            @if (string.Equals(msg.MessageType, "AUTO", StringComparison.OrdinalIgnoreCase) || string.Equals(msg.MessageType, "AUTO_REPLY", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="text-[10px] font-semibold text-amber-700 bg-amber-50 border border-amber-200/80 px-2 py-0.5 rounded-full flex items-center gap-1 mb-1 shadow-2xs">
                                                    <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                                    </svg>
                                                    Automated Reply
                                                </span>
                                            }
                                            <div class="px-4 py-2.5 rounded-2xl text-sm leading-relaxed break-words shadow-xs @(msg.IsMine
                                                    ? "bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white rounded-tr-xs"
                                                    : (string.Equals(msg.MessageType, "AUTO", StringComparison.OrdinalIgnoreCase) || string.Equals(msg.MessageType, "AUTO_REPLY", StringComparison.OrdinalIgnoreCase)
                                                        ? "bg-amber-50/70 text-gray-800 border border-amber-200 rounded-tl-xs"
                                                        : "bg-white text-gray-800 border border-gray-100 rounded-tl-xs"))">
                                                @msg.Content
                                            </div>
                                            @if (msg.CreatedAt.HasValue)
                                            {
                                                <span class="text-[10px] text-gray-400 mt-1 px-1">
                                                    @FormatMessageTime(msg.CreatedAt.Value)
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Message Composer Area -->
                        <div class="p-4 bg-white border-t border-gray-100">
                            @if (_conversationDetail.IsBlockedByMe)
                            {
                                <div class="flex items-center justify-between bg-gray-50 rounded-xl p-3 text-xs text-gray-600 border border-gray-200">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0H10m11-3.5a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        <span>You have blocked this user. Unblock them to send a message.</span>
                                    </div>
                                    <button type="button"
                                            class="px-3 py-1.5 bg-[#FF5500] hover:bg-[#e04c00] text-white font-semibold rounded-lg text-xs transition cursor-pointer"
                                            disabled="@_isBlockingAction"
                                            @onclick="UnblockUserAsync">
                                        Unblock
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-2">
                                    <textarea class="flex-1 bg-gray-100 rounded-xl px-4 py-2.5 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:bg-white transition resize-none leading-relaxed"
                                              placeholder="Type a message..."
                                              rows="1"
                                              maxlength="300"
                                              @bind="_messageText"
                                              @bind:event="oninput"
                                              @onkeydown="HandleKeyDown"
                                              disabled="@_isSending"></textarea>
                                    <button type="button"
                                            class="p-2.5 rounded-xl bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white hover:opacity-95 shadow-xs disabled:opacity-40 transition flex items-center justify-center flex-shrink-0 cursor-pointer"
                                            disabled="@(_isSending || string.IsNullOrWhiteSpace(_messageText))"
                                            title="Send message"
                                            @onclick="SendMessageAsync">
                                        @if (_isSending)
                                        {
                                            <div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                        }
                                        else
                                        {
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                      d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                                            </svg>
                                        }
                                    </button>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_sendErrorMessage))
                            {
                                <p class="text-xs text-red-500 mt-2">@_sendErrorMessage</p>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Delete Conversation Modal Dialog -->
@if (_showDeleteModal)
{
    <div class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 animate-in fade-in"
         @onclick="CancelDelete">
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 max-w-sm w-full p-6 text-center animate-in zoom-in-95"
             @onclick:stopPropagation="true">
            <div class="w-12 h-12 rounded-full bg-red-50 text-red-500 flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Delete conversation?</h3>
            <p class="text-xs text-gray-500 mb-6">
                Are you sure you want to delete this conversation with <strong class="text-gray-700">@_conversationTitleToDelete</strong>? You can no longer see previous messages in this chat.
            </p>
            @if (!string.IsNullOrEmpty(_deleteErrorMessage))
            {
                <p class="text-xs text-red-500 mb-4 font-medium">@_deleteErrorMessage</p>
            }
            <div class="flex items-center gap-3">
                <button type="button"
                        class="flex-1 py-2.5 rounded-xl border border-gray-200 text-gray-700 font-semibold text-xs hover:bg-gray-50 transition cursor-pointer"
                        disabled="@_isDeleting"
                        @onclick="CancelDelete">
                    Cancel
                </button>
                <button type="button"
                        class="flex-1 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-xs shadow-xs transition flex items-center justify-center gap-1 cursor-pointer disabled:opacity-50"
                        disabled="@_isDeleting"
                        @onclick="ConfirmDeleteConversationAsync">
                    @if (_isDeleting)
                    {
                        <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span>Delete</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Block User Modal Dialog -->

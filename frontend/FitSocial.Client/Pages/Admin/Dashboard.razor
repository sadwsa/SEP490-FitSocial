@page "/admin"
@page "/admin/sports"
@layout AuthLayout
@attribute [Authorize(Roles = "ADMIN,STAFF")]
@using FitSocial.Client.Models.Sports
@using FitSocial.Client.Services.Sports
@inject IAuthService AuthService
@inject ISportService SportService
@inject NavigationManager Navigation

<PageTitle>Quản lý Môn Thể Thao - FitSocial Admin Console</PageTitle>

<div class="console">
    <!-- Sidebar -->
    <aside class="console-side">
        <div class="side-brand">
            <img src="Logo_FitSocial.jpg" alt="FitSocial" />
            <div>
                <strong>FitSocial</strong>
                <small>Admin Console</small>
            </div>
        </div>

        <nav class="side-nav">
            <button type="button" class="side-item @(view == "overview" ? "active" : "")" @onclick='() => SwitchView("overview")'>
                <AppIcon Name="chart" /><span>Dashboard</span>
            </button>
            <button type="button" class="side-item @(view == "users" ? "active" : "")" @onclick='() => SwitchView("users")'>
                <AppIcon Name="person" /><span>Tài khoản người dùng</span>
                <small class="uc-tag">UC_34</small>
            </button>
            <button type="button" class="side-item @(view == "sports" ? "active" : "")" @onclick='() => SwitchView("sports")'>
                <AppIcon Name="dumbbell" /><span>Quản lý Môn Thể Thao</span>
                <small class="uc-tag">UC_35</small>
            </button>
            <button type="button" class="side-item" @onclick='() => DemoSoon("Content Moderation")'>
                <AppIcon Name="shield" /><span>Kiểm duyệt nội dung</span>
            </button>
            <button type="button" class="side-item" @onclick='() => DemoSoon("Activity Logs")'>
                <AppIcon Name="doc" /><span>Nhật ký hoạt động</span>
            </button>
            <button type="button" class="side-item" @onclick='() => DemoSoon("System Settings")'>
                <AppIcon Name="gear" /><span>Cấu hình hệ thống</span>
            </button>
        </nav>

        <div class="side-foot">
            <AuthorizeView Roles="ADMIN,STAFF">
                <Authorized>
                    <div class="side-user">
                        <strong>@context.User.Identity?.Name</strong>
                        <small>@string.Join(", ", AppRoles.All.Where(r => context.User.IsInRole(r)))</small>
                    </div>
                </Authorized>
            </AuthorizeView>
            <button type="button" class="side-logout" @onclick="HandleLogout">Đăng xuất</button>
        </div>
    </aside>

    <!-- Main -->
    <main class="console-main">
        <AuthorizeView Roles="ADMIN,STAFF">
            <Authorized>
                @if (!string.IsNullOrEmpty(toastMessage))
                {
                    <div class="auth-alert @(isToastError ? "error" : "info")" role="alert">
                        <AppIcon Name="@(isToastError ? "warning" : "info")" />
                        <span>@toastMessage</span>
                    </div>
                }

                @if (view == "overview")
                {
                    <h2 class="view-title">Tổng quan hệ thống</h2>
                    <p class="view-sub">Số liệu tổng quan môn thể thao và nhật ký hoạt động.</p>
                    <WidgetsRow ActiveCount="@sports.Count" TotalLogs="@sports.Sum(s => s.CoachCount + s.UserCount + s.OpenClassCount)" />
                    <div class="shortcuts">
                        <button type="button" class="shortcut" @onclick='() => SwitchView("users")'>
                            <AppIcon Name="person" />
                            <div><strong>Quản lý tài khoản</strong><small>Xem, khóa, mở khóa (UC_34)</small></div>
                            <span>→</span>
                        </button>
                        <button type="button" class="shortcut" @onclick='() => SwitchView("sports")'>
                            <AppIcon Name="dumbbell" />
                            <div><strong>Quản lý môn thể thao</strong><small>Xem (UC_35) · Thêm (UC_35.1) · Sửa (UC_35.2) · Xóa (UC_35.3)</small></div>
                            <span>→</span>
                        </button>
                    </div>
                }
                else if (view == "users")
                {
                    <h2 class="view-title">Tài khoản người dùng <small class="uc-inline">UC_34 · Danh sách (UC_34) · Khóa (UC_34.1) · Mở (UC_34.2)</small></h2>
                    <div class="toolbar">
                        <div class="search-wrap">
                            <span class="search-icon"><AppIcon Name="search" /></span>
                            <input @bind="userSearch" @bind:event="oninput" class="toolbar-input" placeholder="Tìm theo tên hoặc email..." />
                        </div>
                        <select @bind="roleFilter" class="toolbar-select">
                            <option value="">Tất cả vai trò</option>
                            <option value="TRAINEE">Học viên</option>
                            <option value="COACH">HLV</option>
                            <option value="STAFF">Nhân viên</option>
                            <option value="ADMIN">Admin</option>
                        </select>
                    </div>

                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Họ tên</th>
                                    <th>Email</th>
                                    <th>Vai trò</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in FilteredUsers)
                                {
                                    <tr>
                                        <td><strong>@u.FullName</strong><br /><small class="muted">@u.Phone</small></td>
                                        <td>@u.Email</td>
                                        <td><span class="role-badge @u.Role.ToLower()">@u.Role</span></td>
                                        <td>
                                            @if (u.IsLocked)
                                            {
                                                <span class="status-badge locked">Đã khóa</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge active">Hoạt động</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (u.IsLocked)
                                            {
                                                <button type="button" class="row-btn unlock" @onclick="() => SetLocked(u, false)">Mở khóa</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="row-btn lock" @onclick="() => SetLocked(u, true)">Khóa</button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!FilteredUsers.Any())
                                {
                                    <tr><td colspan="5" class="text-center muted">Không tìm thấy tài khoản phù hợp.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (view == "sports")
                {
                    <h2 class="view-title">Quản lý Môn Thể Thao <small class="uc-inline">UC_35 · Xem danh sách (UC_35) · Thêm (UC_35.1) · Sửa (UC_35.2) · Xóa (UC_35.3)</small></h2>

                    <WidgetsRow ActiveCount="@sports.Count" TotalLogs="@sports.Sum(s => s.CoachCount + s.UserCount + s.OpenClassCount)" />

                    <div class="toolbar wrap">
                        <div class="search-wrap grow">
                            <span class="search-icon"><AppIcon Name="search" /></span>
                            <input @bind="sportSearch" @bind:event="oninput" class="toolbar-input" placeholder="Tìm theo tên môn thể thao..." />
                        </div>
                        <button type="button" class="row-btn" @onclick="LoadSportsAsync">
                            <span class="btn-ic"><AppIcon Name="refresh" /></span> Tải lại
                        </button>
                        <button type="button" class="row-btn add" @onclick="ToggleSportForm">+ Thêm môn thể thao</button>
                    </div>

                    <div class="cat-tabs">
                        @foreach (var c in categories)
                        {
                            <button type="button" class="cat-tab @(sportCategory == c ? "active" : "")" @onclick="() => sportCategory = c">@c</button>
                        }
                    </div>

                    @if (showSportForm)
                    {
                        <div class="sport-form">
                            <strong>@(editingSportId == null ? "Thêm mới môn thể thao (UC_35.1)" : "Chỉnh sửa môn thể thao (UC_35.2)")</strong>
                            <div class="form-grid">
                                <input @bind="sportFormName" class="toolbar-input" placeholder="Tên môn thể thao *" />
                            </div>
                            <div class="form-actions mt-2">
                                <button type="button" class="row-btn" @onclick="CancelSportForm" disabled="@isSubmitting">Hủy</button>
                                <button type="button" class="row-btn add" @onclick="SaveSportFormAsync" disabled="@isSubmitting">
                                    @(isSubmitting ? "Đang lưu..." : "Lưu môn thể thao")
                                </button>
                            </div>
                        </div>
                    }

                    <div class="table-wrap">
                        @if (isLoadingSports)
                        {
                            <div class="p-4 text-center muted">Đang tải danh sách môn thể thao...</div>
                        }
                        else
                        {
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Môn thể thao</th>
                                        <th>Phân loại</th>
                                        <th>HLV liên kết</th>
                                        <th>Người dùng quan tâm</th>
                                        <th>Lớp / Bài viết</th>
                                        <th>Trạng thái</th>
                                        <th class="text-end">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in FilteredSports)
                                    {
                                        <tr>
                                            <td>
                                                <div class="sport-cell">
                                                    <span class="sport-ic"><AppIcon Name="dumbbell" /></span>
                                                    <div><strong>@s.SportName</strong><br /><small class="muted">@s.Description</small></div>
                                                </div>
                                            </td>
                                            <td><code>@s.Category</code></td>
                                            <td><small>@s.CoachCount HLV</small></td>
                                            <td><small>@s.UserCount người dùng</small></td>
                                            <td><small>@s.OpenClassCount bài viết</small></td>
                                            <td>
                                                <span class="status-badge active">@s.Status</span>
                                            </td>
                                            <td class="text-end whitespace-nowrap">
                                                @if (confirmDeleteId == s.SportId)
                                                {
                                                    <button type="button" class="row-btn lock" @onclick="() => DeleteSportAsync(s)" disabled="@isDeleting">
                                                        @(isDeleting ? "Đang xóa..." : "Xác nhận xóa")
                                                    </button>
                                                    <button type="button" class="row-btn" @onclick="() => confirmDeleteId = null" disabled="@isDeleting">Hủy</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="icon-btn" title="Chỉnh sửa (UC_35.2)" @onclick="() => StartSportEdit(s)"><AppIcon Name="pencil" /></button>
                                                    <button type="button" class="icon-btn danger" title="Xóa môn thể thao (UC_35.3)" @onclick="() => confirmDeleteId = s.SportId"><AppIcon Name="trash" /></button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    @if (!FilteredSports.Any())
                                    {
                                        <tr><td colspan="7" class="text-center muted">Không có môn thể thao nào phù hợp.</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <p class="paging">Hiển thị @FilteredSports.Count() / @sports.Count môn thể thao</p>
                }
            </Authorized>
            <NotAuthorized>
                <div class="auth-alert error" role="alert">
                    <AppIcon Name="warning" /><span>Bạn không có quyền truy cập trang này.</span>
                </div>
                <button type="button" class="btn-back" @onclick='() => Navigation.NavigateTo("/admin/login")'>
                    Quay lại trang đăng nhập portal
                </button>
            </NotAuthorized>
        </AuthorizeView>
    </main>
</div>

@code {
    private record MockUser(Guid Id, string FullName, string Email, string Phone, string Role, bool IsLocked);

    private string view = "sports";
    private string? toastMessage;
    private bool isToastError = false;

    private string userSearch = "";
    private string roleFilter = "";

    private string sportSearch = "";
    private string sportCategory = "Tất cả";
    private bool showSportForm = false;
    private Guid? editingSportId;
    private string sportFormName = "";
    private Guid? confirmDeleteId;

    private bool isLoadingSports = false;
    private bool isSubmitting = false;
    private bool isDeleting = false;

    private List<SportDto> sports = new();

    private readonly List<string> categories = new()
    {
        "Tất cả", "Cardio & Sức bền", "Thể lực & Gym", "Đối kháng & Võ thuật", "Thư giãn & Dưỡng sinh", "Sức bền & Kỹ thuật", "Tập trung & Chính xác", "Thể thao tổng hợp"
    };

    private List<MockUser> users = new()
    {
        new(Guid.NewGuid(), "Lê Học Viên A", "trainee1@gmail.com", "0904000004", "TRAINEE", false),
        new(Guid.NewGuid(), "Trần HLV Hai", "coach2@fitness.com", "0903000003", "COACH", false),
        new(Guid.NewGuid(), "Nguyễn HLV Một", "coach1@fitness.com", "0902000002", "COACH", true),
        new(Guid.NewGuid(), "Phạm Nhân Viên", "staff@fitsocial.vn", "0905000006", "STAFF", false),
        new(Guid.NewGuid(), "System Admin", "admin@system.com", "0901000001", "ADMIN", false),
        new(Guid.NewGuid(), "Phạm Học Viên B", "trainee2@gmail.com", "0905000005", "TRAINEE", true),
    };

    protected override async Task OnInitializedAsync()
    {
        if (Navigation.Uri.Contains("/admin/sports"))
        {
            view = "sports";
        }
        await LoadSportsAsync();
    }

    private async Task LoadSportsAsync()
    {
        isLoadingSports = true;
        try
        {
            var res = await SportService.GetSportsAsync();
            if (res.Success && res.Data != null)
            {
                sports = res.Data;
            }
            else if (!string.IsNullOrEmpty(res.Message))
            {
                toastMessage = res.Message;
                isToastError = true;
            }
        }
        catch (Exception ex)
        {
            toastMessage = $"Lỗi khi tải danh sách môn thể thao: {ex.Message}";
            isToastError = true;
        }
        finally
        {
            isLoadingSports = false;
        }
    }

    private void SwitchView(string next)
    {
        view = next;
        toastMessage = null;
        isToastError = false;
    }

    private void DemoSoon(string module)
    {
        toastMessage = $"Chức năng [{module}] sẽ được cập nhật trong phiên bản tiếp theo.";
        isToastError = false;
    }

    private IEnumerable<MockUser> FilteredUsers =>
        users.Where(u =>
            (string.IsNullOrWhiteSpace(userSearch) ||
             u.FullName.Contains(userSearch, StringComparison.OrdinalIgnoreCase) ||
             u.Email.Contains(userSearch, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(roleFilter) || u.Role == roleFilter));

    private IEnumerable<SportDto> FilteredSports =>
        sports.Where(s =>
            (string.IsNullOrWhiteSpace(sportSearch) ||
             s.SportName.Contains(sportSearch, StringComparison.OrdinalIgnoreCase) ||
             s.Category.Contains(sportSearch, StringComparison.OrdinalIgnoreCase) ||
             s.Description.Contains(sportSearch, StringComparison.OrdinalIgnoreCase)) &&
            (sportCategory == "Tất cả" || s.Category == sportCategory));

    private void SetLocked(MockUser user, bool locked)
    {
        var index = users.FindIndex(u => u.Id == user.Id);
        if (index < 0)
        {
            return;
        }
        users[index] = users[index] with { IsLocked = locked };
        toastMessage = locked
            ? $"Đã khóa tài khoản {user.FullName} (UC_34.1)."
            : $"Đã mở khóa tài khoản {user.FullName} (UC_34.2).";
        isToastError = false;
    }

    private void ToggleSportForm()
    {
        showSportForm = !showSportForm;
        editingSportId = null;
        sportFormName = "";
        confirmDeleteId = null;
    }

    private void StartSportEdit(SportDto sport)
    {
        showSportForm = true;
        editingSportId = sport.SportId;
        sportFormName = sport.SportName;
        confirmDeleteId = null;
    }

    private void CancelSportForm()
    {
        showSportForm = false;
        editingSportId = null;
        sportFormName = "";
    }

    private async Task SaveSportFormAsync()
    {
        if (string.IsNullOrWhiteSpace(sportFormName))
        {
            toastMessage = "Tên môn thể thao không được để trống.";
            isToastError = true;
            return;
        }

        isSubmitting = true;
        try
        {
            if (editingSportId == null)
            {
                // Create Sport UC_35.1
                var res = await SportService.CreateSportAsync(new CreateSportDto { SportName = sportFormName.Trim() });
                if (res.Success)
                {
                    toastMessage = res.Message ?? $"Tạo môn thể thao \"{sportFormName.Trim()}\" thành công.";
                    isToastError = false;
                    CancelSportForm();
                    await LoadSportsAsync();
                }
                else
                {
                    toastMessage = res.Message ?? "Tạo môn thể thao thất bại.";
                    isToastError = true;
                }
            }
            else
            {
                // Edit Sport UC_35.2
                var res = await SportService.UpdateSportAsync(editingSportId.Value, new UpdateSportDto { SportName = sportFormName.Trim() });
                if (res.Success)
                {
                    toastMessage = res.Message ?? "Cập nhật môn thể thao thành công.";
                    isToastError = false;
                    CancelSportForm();
                    await LoadSportsAsync();
                }
                else
                {
                    toastMessage = res.Message ?? "Cập nhật môn thể thao thất bại.";
                    isToastError = true;
                }
            }
        }
        catch (Exception ex)
        {
            toastMessage = $"Lỗi xử lý: {ex.Message}";
            isToastError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteSportAsync(SportDto sport)
    {
        isDeleting = true;
        try
        {
            var res = await SportService.DeleteSportAsync(sport.SportId);
            confirmDeleteId = null;
            if (res.Success)
            {
                toastMessage = res.Message ?? $"Xóa môn thể thao \"{sport.SportName}\" thành công.";
                isToastError = false;
                await LoadSportsAsync();
            }
            else
            {
                toastMessage = res.Message ?? "Không thể xóa môn thể thao vì môn thể thao này đang được sử dụng.";
                isToastError = true;
            }
        }
        catch (Exception ex)
        {
            toastMessage = $"Lỗi khi xóa môn thể thao: {ex.Message}";
            isToastError = true;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/admin/login");
    }
}

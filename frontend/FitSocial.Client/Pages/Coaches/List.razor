@page "/coaches"
@inject ICoachService CoachService
@inject NavigationManager Navigation
@attribute [Authorize]

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-dark mb-3">Our Expert Coaches</h1>
        <p class="lead text-muted mx-auto" style="max-width: 600px;">
            Find the perfect coach to guide you on your fitness journey.
        </p>
    </div>

    <!-- Thanh Search, Filter & Sort -->
    <div class="card border-0 shadow-sm rounded-4 mb-5 p-4">
        <form @onsubmit="SearchCoaches" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold text-muted small">Search by Name or Bio</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-light border-0" placeholder="John Doe..." @bind="searchKeyword">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold text-muted small">Min Experience (Years)</label>
                <input type="number" class="form-control bg-light border-0" placeholder="0" min="0" @bind="minExperience">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold text-muted small">Sort By</label>
                <select class="form-select bg-light border-0" @bind="sortBy">
                    <option value="">Default (Exp: High - Low)</option>
                    <option value="exp_desc">Experience: High - Low</option>
                    <option value="exp_asc">Experience: Low - High</option>
                    <option value="name_asc">Name: A - Z</option>
                    <option value="name_desc">Name: Z - A</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3 fw-semibold">
                    <i class="bi bi-funnel-fill me-2"></i> Apply
                </button>
            </div>
        </form>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
            <p class="mt-3 text-muted">Loading amazing coaches...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger rounded-3 shadow-sm text-center">@errorMessage</div>
    }
    else if (!coaches.Any())
    {
        <div class="alert alert-info rounded-3 shadow-sm text-center">
            <i class="bi bi-emoji-frown fs-4 d-block mb-2"></i>
            No coaches found matching your criteria. Try adjusting the filters!
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var coach in coaches)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 text-center hover-lift transition-all" style="transition: transform 0.2s, box-shadow 0.2s;">
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Avatar -->
                            <div class="mb-4 mt-2">
                                @if (!string.IsNullOrEmpty(coach.AvatarUrl))
                                {
                                    <img src="@coach.AvatarUrl" class="rounded-circle shadow-sm object-fit-cover" width="120" height="120" alt="@coach.FullName" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 120px; height: 120px;">
                                        <i class="bi bi-person-fill text-secondary" style="font-size: 4rem;"></i>
                                    </div>
                                }
                            </div>

                            <!-- Info -->
                            <h4 class="card-title fw-bold text-dark mb-1">@coach.FullName</h4>
                            <div class="mb-3">
                                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                                    <i class="bi bi-star-fill me-1 text-warning"></i> @coach.ExperienceYears Years Exp
                                </span>
                            </div>

                            <p class="text-muted small mb-4 flex-grow-1">
                                @(string.IsNullOrEmpty(coach.Bio) ? "No bio available." : (coach.Bio.Length > 100 ? coach.Bio.Substring(0, 100) + "..." : coach.Bio))
                            </p>

                            <!-- Action -->
                            <button class="btn btn-outline-primary w-100 rounded-pill fw-semibold mt-auto">
                                View Profile
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<CoachListDto> coaches = new List<CoachListDto>();
    private bool isLoading = true;
    private string? errorMessage;

    // Biến cho form filter & sort
    private string? searchKeyword = "";
    private int? minExperience;
    private string? sortBy = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCoaches();
    }

    private async Task SearchCoaches()
    {
        await LoadCoaches();
    }

    private async Task LoadCoaches()
    {
        isLoading = true;
        errorMessage = null;

        var response = await CoachService.GetAllCoachesAsync(searchKeyword, minExperience, sortBy);
        if (response.Success && response.Data != null)
        {
            coaches = response.Data;
        }
        else
        {
            errorMessage = response.Message ?? "Failed to load coaches.";
        }

        isLoading = false;
    }
}

@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="app-header">
            <div class="search-box d-none d-sm-block">
                <span class="search-icon">🔍</span>
                <input type="text" placeholder="Tìm kiếm bài tập, hội nhóm, bạn bè..." />
            </div>

            <div class="d-flex align-items-center gap-3 ms-auto">
                <AuthorizeView>
                    <Authorized>
                        <NotificationBell />
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center gap-2">
                            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop" 
                                 alt="Avatar" class="fit-avatar fit-avatar-sm" />
                            <span class="fw-semibold d-none d-md-inline text-dark">@context.User.Identity?.Name</span>
                            <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="HandleLogout">Đăng xuất</button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-flex align-items-center gap-2">
                            <a href="login" class="btn btn-sm btn-outline-secondary">Đăng nhập</a>
                            <a href="register" class="btn btn-sm btn-fit-primary">Đăng ký</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="content-container">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}

@page "/admin/change-password"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN,STAFF")]
@using FitSocial.Client.Models.Auth
@using FitSocial.Client.Services.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Change Password - FitSocial Admin Console</PageTitle>

<AuthorizeView Roles="ADMIN,STAFF">
    <Authorized Context="authCtx">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-emerald-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-emerald-500/50 backdrop-blur transition-all duration-300">
                <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <span>@successMessage</span>
            </div>
        }

        <h2 class="view-title">Change Password</h2>
        <p class="view-sub">Update your staff/admin sign-in password. All other sessions will be signed out.</p>

        <div class="bg-white rounded-2xl border border-gray-200 p-6" style="max-width: 36rem;">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="p-3.5 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700 flex items-center gap-2.5 mb-4" role="alert">
                    <svg class="w-4 h-4 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                    </svg>
                    <span>@errorMessage</span>
                </div>
            }

            <EditForm Model="@changeModel" OnValidSubmit="HandleChange">
                <DataAnnotationsValidator />

                <div class="space-y-1 mb-4">
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600">Current password <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <InputText type="@(showCurrent ? "text" : "password")" @bind-Value="changeModel.CurrentPassword" class="w-full text-sm text-gray-800 placeholder-gray-400 border border-gray-200 bg-gray-50/40 rounded-xl p-3 pr-11 focus:bg-white focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] outline-none transition" placeholder="Enter your current password" />
                        <button type="button" @onclick="() => showCurrent = !showCurrent" title="Show/hide password" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition cursor-pointer">
                            <AppIcon Name="@(showCurrent ? "eye-slash" : "eye")" />
                        </button>
                    </div>
                    <ValidationMessage For="@(() => changeModel.CurrentPassword)" class="text-xs text-red-600 font-semibold" />
                </div>

                <div class="space-y-1 mb-4">
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600">New password <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <InputText type="@(showNew ? "text" : "password")" @bind-Value="changeModel.NewPassword" class="w-full text-sm text-gray-800 placeholder-gray-400 border border-gray-200 bg-gray-50/40 rounded-xl p-3 pr-11 focus:bg-white focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] outline-none transition" placeholder="Minimum 8 characters, different from current" />
                        <button type="button" @onclick="() => showNew = !showNew" title="Show/hide password" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition cursor-pointer">
                            <AppIcon Name="@(showNew ? "eye-slash" : "eye")" />
                        </button>
                    </div>
                    <ValidationMessage For="@(() => changeModel.NewPassword)" class="text-xs text-red-600 font-semibold" />
                </div>

                <div class="space-y-1 mb-5">
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600">Confirm new password <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <InputText type="@(showConfirm ? "text" : "password")" @bind-Value="changeModel.ConfirmPassword" class="w-full text-sm text-gray-800 placeholder-gray-400 border border-gray-200 bg-gray-50/40 rounded-xl p-3 pr-11 focus:bg-white focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] outline-none transition" placeholder="Re-enter the new password" />
                        <button type="button" @onclick="() => showConfirm = !showConfirm" title="Show/hide password" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition cursor-pointer">
                            <AppIcon Name="@(showConfirm ? "eye-slash" : "eye")" />
                        </button>
                    </div>
                    <ValidationMessage For="@(() => changeModel.ConfirmPassword)" class="text-xs text-red-600 font-semibold" />
                </div>

                <button type="submit" disabled="@isLoading" class="w-full px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#FF8C00] via-[#FF5500] to-[#FF3B00] rounded-xl shadow-md hover:shadow-lg hover:opacity-95 disabled:opacity-50 transition flex items-center justify-center gap-2 cursor-pointer">
                    @if (isLoading)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Updating...</span>
                    }
                    else
                    {
                        <span>Update Password</span>
                    }
                </button>
            </EditForm>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private ChangePasswordRequest changeModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = false;
    private bool showCurrent = false;
    private bool showNew = false;
    private bool showConfirm = false;

    private async Task HandleChange()
    {
        isLoading = true;
        errorMessage = null;

        if (changeModel.NewPassword == changeModel.CurrentPassword)
        {
            errorMessage = "New password must be different from the current password.";
            isLoading = false;
            return;
        }

        var result = await AuthService.ChangePasswordAsync(changeModel);
        if (result.Success)
        {
            successMessage = (result.Message ?? "Password changed successfully.") + " Signing you out...";
            StateHasChanged();
            await Task.Delay(1500);
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/admin/login");
        }
        else
        {
            errorMessage = result.Message ?? "Could not change the password. Please try again.";
        }

        isLoading = false;
    }
}

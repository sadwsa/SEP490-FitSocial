@namespace FitSocial.Client.Components.Posts
@inject IPostService PostService
@inject IFileUploadService FileUploadService
@inject IJSRuntime JS

@if (IsVisible)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/65 backdrop-blur-sm transition-all duration-200"
         @onclick="Close">
        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full flex flex-col max-h-[92vh] overflow-hidden border border-gray-100 animate-in fade-in zoom-in-95 duration-150"
             @onclick:stopPropagation="true">

            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 bg-white">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center shadow-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                            </path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-900 text-lg leading-tight">Create Post</h3>
                        <p class="text-xs text-gray-400 mt-0.5">Share workouts, connect with coaches or trainees</p>
                    </div>
                </div>
                <button type="button" @onclick="Close"
                        class="w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-400 hover:text-gray-700 flex items-center justify-center text-xl font-bold transition cursor-pointer">
                    &times;
                </button>
            </div>

            <!-- Modal Body -->
            <div class="px-6 py-5 overflow-y-auto space-y-5 flex-1 bg-white">

                <!-- Author & Info Row -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3.5">
                        <div class="w-11 h-11 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold text-base shadow-sm">
                            @UserInitials
                        </div>
                        <div>
                            <h4 class="font-bold text-gray-900 text-sm">@UserName</h4>
                            <div class="flex items-center gap-2 mt-0.5">
                                <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full @(IsCoach ? "bg-amber-100 text-amber-800" : "bg-blue-100 text-blue-800")">
                                    @(IsCoach ? "Coach" : "Trainee")
                                </span>
                                <span class="text-xs text-gray-400">&bull; Public Feed</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Post Type Selector (Role-based: Trainee: Normal | Find Coach, Coach: Normal | Find Coach | Find Trainee) -->
                <div class="space-y-2 p-3 rounded-2xl @(hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostType) ? "border-2 border-red-400 bg-red-50/20" : "")">
                    <div class="flex items-center justify-between">
                        <label class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostType) ? "text-red-700" : "text-gray-600")">
                            Post Type <span class="text-red-500">*</span>
                        </label>
                        <span class="text-[11px] text-gray-400">
                            @(IsCoach ? "Coach: 3 types available" : "Trainee: 2 types available")
                        </span>
                    </div>

                    <div class="grid grid-cols-2 @(IsCoach ? "sm:grid-cols-3" : "sm:grid-cols-2") gap-2.5">
                        <!-- Normal -->
                        <button type="button" @onclick='() => SelectPostType("Normal")'
                                class="flex items-center gap-3 p-3 rounded-xl border text-left transition-all duration-150 cursor-pointer @(createPostType == "Normal" ? "border-[#FF5500] bg-orange-50/70 text-[#FF5500] ring-2 ring-[#FF5500]/25 font-semibold shadow-xs" : "border-gray-200 hover:border-gray-300 bg-white text-gray-700")">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 @(createPostType == "Normal" ? "bg-[#FF5500] text-white" : "bg-gray-100 text-gray-600")">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z">
                                    </path>
                                </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold truncate">Normal</p>
                                <p class="text-[11px] text-gray-500 truncate">Workout & tips</p>
                            </div>
                        </button>

                        <!-- Find Coach -->
                        <button type="button" @onclick='() => SelectPostType("Find Coach")'
                                class="flex items-center gap-3 p-3 rounded-xl border text-left transition-all duration-150 cursor-pointer @(createPostType == "Find Coach" ? "border-amber-500 bg-amber-50/70 text-amber-800 ring-2 ring-amber-500/25 font-semibold shadow-xs" : "border-gray-200 hover:border-gray-300 bg-white text-gray-700")">
                            <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 @(createPostType == "Find Coach" ? "bg-amber-500 text-white" : "bg-gray-100 text-gray-600")">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold truncate">Find Coach</p>
                                <p class="text-[11px] text-gray-500 truncate">Look for trainer</p>
                            </div>
                        </button>

                        <!-- Find Trainee (Visible if Coach) -->
                        @if (IsCoach)
                        {
                            <button type="button" @onclick='() => SelectPostType("Find Trainee")'
                                    class="flex items-center gap-3 p-3 rounded-xl border text-left transition-all duration-150 cursor-pointer @(createPostType == "Find Trainee" ? "border-emerald-500 bg-emerald-50/70 text-emerald-800 ring-2 ring-emerald-500/25 font-semibold shadow-xs" : "border-gray-200 hover:border-gray-300 bg-white text-gray-700")">
                                <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 @(createPostType == "Find Trainee" ? "bg-emerald-500 text-white" : "bg-gray-100 text-gray-600")">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                                        </path>
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-bold truncate">Find Trainee</p>
                                    <p class="text-[11px] text-gray-500 truncate">Recruit students</p>
                                </div>
                            </button>
                        }
                    </div>
                    @if (hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostType))
                    {
                        <p class="text-xs text-red-600 font-semibold mt-1.5 flex items-center gap-1 animate-in fade-in">
                            <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                      clip-rule="evenodd"></path>
                            </svg>
                            Please select a Post Type before publishing.
                        </p>
                    }
                    else if (hasAttemptedSubmit && createPostType == "Find Trainee" && !IsCoach)
                    {
                        <p class="text-xs text-red-600 font-semibold mt-1.5 flex items-center gap-1 animate-in fade-in">
                            <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                      clip-rule="evenodd"></path>
                            </svg>
                            Trainees are not permitted to create 'Find Trainee' posts.
                        </p>
                    }
                </div>

                <!-- Post Text Area (Required) -->
                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <label class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostContent?.Trim()) ? "text-red-700" : "text-gray-600")">
                            Content / Description <span class="text-red-500">*</span>
                        </label>
                        <span class="text-[11px] text-gray-400">@(createPostContent?.Trim().Length ?? 0)/5000</span>
                    </div>
                    <textarea @bind="createPostContent" placeholder="@GetPostPlaceholder()" rows="4"
                              class="w-full text-sm text-gray-800 placeholder-gray-400 border @(hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostContent?.Trim()) ? "border-red-500 ring-2 ring-red-200 bg-red-50/20" : "border-gray-200 bg-gray-50/40") rounded-xl p-3.5 focus:bg-white focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] resize-none outline-none transition duration-150 leading-relaxed min-h-[110px]"></textarea>
                    @if (hasAttemptedSubmit && string.IsNullOrWhiteSpace(createPostContent?.Trim()))
                    {
                        <p class="text-xs text-red-600 font-semibold flex items-center gap-1 animate-in fade-in">
                            <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                      clip-rule="evenodd"></path>
                            </svg>
                            Content is required. Please write something for your post.
                        </p>
                    }
                </div>

                <!-- Gym / Location Dropdown (Required) -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedSubmit && selectedLocationId == Guid.Empty ? "text-red-700" : "text-gray-600") mb-1.5 flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                            </path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        Gym / Location <span class="text-red-500">*</span>
                    </label>
                    <select @bind="selectedLocationId"
                            class="w-full text-sm bg-gray-50 border @(hasAttemptedSubmit && selectedLocationId == Guid.Empty ? "border-red-500 ring-2 ring-red-200 bg-red-50/20 text-red-900" : "border-gray-200 text-gray-800") rounded-xl p-2.5 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] transition">
                        <option value="@Guid.Empty">-- Select Location --</option>
                        @foreach (var l in AvailableLocations)
                        {
                            <option value="@l.LocationId">@l.LocationName</option>
                        }
                    </select>
                    @if (hasAttemptedSubmit && selectedLocationId == Guid.Empty)
                    {
                        <p class="text-[11px] text-red-600 font-semibold mt-1 flex items-center gap-1 animate-in fade-in">
                            <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                      clip-rule="evenodd"></path>
                            </svg>
                            Location is required. Please select one.
                        </p>
                    }
                </div>
                <!-- Media Upload Section (Optional, Max 10) -->
                <div class="border border-dashed border-gray-300 hover:border-orange-300 rounded-2xl p-4 bg-gray-50/50 transition">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold uppercase tracking-wider text-gray-700 flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                    </path>
                                </svg>
                                Attach Media <span class="text-gray-400 font-normal normal-case">(Optional)</span>
                            </span>
                            <span class="text-xs font-semibold px-2 py-0.5 rounded-full @(selectedMedia.Count >= 10 ? "bg-red-100 text-red-700" : "bg-gray-100 text-gray-600")">
                                Selected Media: @selectedMedia.Count/10
                            </span>
                        </div>
                        @if (selectedMedia.Count < 10)
                        {
                            <label for="createPostFileInput"
                                   class="text-xs text-[#FF5500] font-bold hover:underline cursor-pointer flex items-center gap-1">
                                <span>+ Choose Files</span>
                            </label>
                        }
                        else
                        {
                            <span class="text-xs text-gray-400 font-semibold cursor-not-allowed">
                                Max reached (10/10)
                            </span>
                        }
                    </div>

                    <InputFile id="createPostFileInput" OnChange="HandleFileSelected" multiple accept="image/*,video/*"
                               disabled="@(selectedMedia.Count >= 10 || isSubmittingPost || isUploadingMedia)"
                               class="hidden" />

                    @if (selectedMedia.Any())
                    {
                        <div class="grid grid-cols-3 sm:grid-cols-4 gap-2.5 mt-2">
                            @for (int i = 0; i < selectedMedia.Count; i++)
                            {
                                var index = i;
                                var media = selectedMedia[index];
                                <div class="relative group rounded-xl overflow-hidden border border-gray-200 bg-gray-100 aspect-square flex items-center justify-center shadow-xs">
                                    @if (!string.IsNullOrWhiteSpace(media.PreviewUrl))
                                    {
                                        <img src="@media.PreviewUrl" alt="Preview" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <div class="p-2 text-center text-xs text-gray-600 truncate">
                                            <svg class="w-8 h-8 text-orange-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                            <p class="truncate text-[10px] mt-1 font-medium">@media.FileName</p>
                                        </div>
                                    }
                                    <button type="button" @onclick="() => RemoveSelectedFile(index)"
                                            disabled="@(isSubmittingPost || isUploadingMedia)"
                                            title="Remove media"
                                            class="absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-black/75 hover:bg-red-600 text-white flex items-center justify-center text-xs font-bold transition shadow-sm cursor-pointer disabled:opacity-50">
                                        &times;
                                    </button>
                                </div>
                            }
                            @if (selectedMedia.Count < 10)
                            {
                                <label for="createPostFileInput"
                                       class="rounded-xl border-2 border-dashed border-gray-300 hover:border-[#FF5500] bg-gray-50 hover:bg-orange-50/30 aspect-square flex flex-col items-center justify-center cursor-pointer transition text-gray-400 hover:text-[#FF5500]">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                    <span class="text-[10px] font-bold mt-1">Add more</span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <label for="createPostFileInput"
                               class="cursor-pointer py-5 flex flex-col items-center justify-center text-gray-400 hover:text-gray-600 transition rounded-xl hover:bg-orange-50/30">
                            <div class="w-10 h-10 rounded-full bg-orange-50 text-[#FF5500] flex items-center justify-center mb-1.5">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                    </path>
                                </svg>
                            </div>
                            <span class="text-xs font-semibold text-gray-700">Click to upload photos or videos (optional)</span>
                            <span class="text-[11px] text-gray-400 mt-0.5">PNG, JPG, MP4 (max 10 files)</span>
                        </label>
                    }

                    @if (!string.IsNullOrWhiteSpace(mediaErrorMessage))
                    {
                        <p class="text-xs text-red-600 font-semibold mt-2 flex items-center gap-1 animate-in fade-in">
                            <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd"
                                      d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                      clip-rule="evenodd"></path>
                            </svg>
                            <span>@mediaErrorMessage</span>
                        </p>
                    }
                </div>

                <!-- Backend API Error Message (if API returns error) -->
                @if (!string.IsNullOrWhiteSpace(createPostErrorMessage))
                {
                    <div class="p-3.5 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700 flex items-center gap-2.5 animate-in fade-in shadow-xs"
                         role="alert">
                        <svg class="w-4 h-4 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                  clip-rule="evenodd"></path>
                        </svg>
                        <span>@createPostErrorMessage</span>
                    </div>
                }

            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-100 bg-gray-50/80">
                <button type="button" @onclick="Close"
                        class="px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-gray-600 hover:bg-gray-200/60 rounded-xl transition cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="HandleSubmitCreatePost"
                        disabled="@(isSubmittingPost || isUploadingMedia)"
                        class="px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#FF8C00] via-[#FF5500] to-[#FF3B00] rounded-xl shadow-md hover:shadow-lg hover:opacity-95 disabled:opacity-50 transition flex items-center gap-2 cursor-pointer">
                    @if (isUploadingMedia)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Uploading media...</span>
                    }
                    else if (isSubmittingPost)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Publishing...</span>
                    }
                    else
                    {
                        <span>Post</span>
                    }
                </button>
            </div>

        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public string? InitialPostType { get; set; }

    [Parameter]
    public bool IsCoach { get; set; }

    [Parameter]
    public string UserName { get; set; } = "Athlete";

    [Parameter]
    public string UserInitials { get; set; } = "Me";


    [Parameter]
    public List<LocationDto> AvailableLocations { get; set; } = new();

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<PostDto> OnPostCreated { get; set; }

    private string createPostContent = string.Empty;
    private string createPostType = string.Empty;
    private Guid selectedLocationId = Guid.Empty;
    private bool hasAttemptedSubmit = false;
    private List<SelectedMediaItem> selectedMedia = new();
    private string? createPostErrorMessage;
    private string? mediaErrorMessage;
    private bool isSubmittingPost = false;
    private bool isUploadingMedia = false;

    private bool _wasVisible = false;

    protected override void OnParametersSet()
    {
        if (IsVisible && !_wasVisible)
        {
            ResetForm();
            if (!string.IsNullOrWhiteSpace(InitialPostType))
            {
                createPostType = (InitialPostType == "Find Trainee" && !IsCoach) ? "Normal" : InitialPostType;
            }
        }
        _wasVisible = IsVisible;
    }

    private void ResetForm()
    {
        createPostContent = string.Empty;
        createPostType = string.Empty;
        selectedLocationId = Guid.Empty;
        selectedMedia.Clear();
        createPostErrorMessage = null;
        mediaErrorMessage = null;
        hasAttemptedSubmit = false;
        isSubmittingPost = false;
        isUploadingMedia = false;
    }

    private async Task Close()
    {
        ResetForm();
        _ = ResetFileInputAsync();
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private void SelectPostType(string type)
    {
        if (type == "Find Trainee" && !IsCoach) return;
        createPostType = type;
    }

    private string GetPostPlaceholder() => createPostType switch
    {
        "Find Coach" => "Describe your fitness goals, routine, budget, or schedule to find the ideal coach...",
        "Find Trainee" => "Describe your coaching programs, specialties, open slots, or fitness plans for prospective students...",
        _ => "What's on your mind about today's workout? Share your achievements, tips, or routine..."
    };

    private async Task ResetFileInputAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "var el = document.getElementById('createPostFileInput'); if (el) el.value = '';");
        }
        catch { }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (isSubmittingPost || isUploadingMedia) return;

        mediaErrorMessage = null;

        IReadOnlyList<IBrowserFile> incomingFiles;
        try
        {
            incomingFiles = e.GetMultipleFiles(25);
        }
        catch (InvalidOperationException)
        {
            mediaErrorMessage = "You can select a maximum of 10 media files.";
            await ResetFileInputAsync();
            return;
        }
        catch (Exception ex)
        {
            mediaErrorMessage = $"Error reading selected files: {ex.Message}";
            await ResetFileInputAsync();
            return;
        }

        if (incomingFiles == null || incomingFiles.Count == 0)
        {
            return;
        }

        int duplicateCount = 0;
        bool limitExceeded = false;

        foreach (var file in incomingFiles)
        {
            bool isDuplicate = selectedMedia.Any(f =>
                string.Equals(f.FileName, file.Name, StringComparison.OrdinalIgnoreCase) &&
                f.Size == file.Size);

            if (isDuplicate)
            {
                duplicateCount++;
                continue;
            }

            if (selectedMedia.Count >= 10)
            {
                limitExceeded = true;
                break;
            }

            try
            {
                if (file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                {
                    var isGif = file.ContentType.Equals("image/gif", StringComparison.OrdinalIgnoreCase);

                    if (isGif)
                    {
                        using var ms = new MemoryStream();
                        await using var stream = file.OpenReadStream(20 * 1024 * 1024);
                        await stream.CopyToAsync(ms);
                        var data = ms.ToArray();

                        selectedMedia.Add(new SelectedMediaItem
                        {
                            FileName = file.Name,
                            ContentType = file.ContentType,
                            Data = data,
                            PreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(data)}",
                            IsVideo = false
                        });
                    }
                    else
                    {
                        var optimizedFile = await file.RequestImageFileAsync("image/jpeg", 1280, 1280);
                        using var ms = new MemoryStream();
                        await using var stream = optimizedFile.OpenReadStream(20 * 1024 * 1024);
                        await stream.CopyToAsync(ms);
                        var data = ms.ToArray();

                        selectedMedia.Add(new SelectedMediaItem
                        {
                            FileName = Path.ChangeExtension(file.Name, ".jpg"),
                            ContentType = "image/jpeg",
                            Data = data,
                            PreviewUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(data)}",
                            IsVideo = false
                        });
                    }
                }
                else
                {
                    using var ms = new MemoryStream();
                    await using var stream = file.OpenReadStream(100 * 1024 * 1024);
                    await stream.CopyToAsync(ms);
                    var data = ms.ToArray();

                    selectedMedia.Add(new SelectedMediaItem
                    {
                        FileName = file.Name,
                        ContentType = file.ContentType,
                        Data = data,
                        PreviewUrl = string.Empty,
                        IsVideo = true
                    });
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[FE][Processing] Error reading '{file.Name}': {ex.Message}");
                mediaErrorMessage = $"Failed to process '{file.Name}'.";
            }
        }

        if (limitExceeded)
        {
            mediaErrorMessage = "You can select a maximum of 10 media files.";
        }
        else if (duplicateCount > 0)
        {
            mediaErrorMessage = duplicateCount == 1
                ? "1 duplicate file was skipped."
                : $"{duplicateCount} duplicate files were skipped.";
        }

        await ResetFileInputAsync();
    }

    private async Task RemoveSelectedFile(int index)
    {
        if (isSubmittingPost || isUploadingMedia) return;

        if (index >= 0 && index < selectedMedia.Count)
        {
            selectedMedia.RemoveAt(index);
            mediaErrorMessage = null;
            await ResetFileInputAsync();
        }
    }

    private async Task HandleSubmitCreatePost()
    {
        if (isSubmittingPost || isUploadingMedia)
        {
            return;
        }

        hasAttemptedSubmit = true;
        createPostErrorMessage = null;

        var contentTrimmed = createPostContent?.Trim() ?? string.Empty;

        bool isPostTypeMissing = string.IsNullOrWhiteSpace(createPostType);
        bool isPostTypeUnauthorized = createPostType == "Find Trainee" && !IsCoach;
        bool isContentMissing = string.IsNullOrWhiteSpace(contentTrimmed);
        bool isLocationMissing = selectedLocationId == Guid.Empty;
        bool isMediaExceeded = selectedMedia.Count > 10;
        bool isContentTooLong = contentTrimmed.Length > 5000;

        if (isPostTypeMissing || isPostTypeUnauthorized || isContentMissing || isLocationMissing || isMediaExceeded || isContentTooLong)
        {
            if (isPostTypeUnauthorized)
            {
                createPostErrorMessage = "Trainees are not permitted to create 'Find Trainee' posts.";
            }
            else if (isMediaExceeded)
            {
                mediaErrorMessage = "You can select a maximum of 10 media files.";
            }
            else if (isContentTooLong)
            {
                createPostErrorMessage = "Content must not exceed 5000 characters.";
            }
            return;
        }

        var totalSubmitSw = System.Diagnostics.Stopwatch.StartNew();
        isSubmittingPost = true;
        try
        {
            var uploadedMedia = new List<CreatePostMediaItemDto>();

            if (selectedMedia.Any())
            {
                isUploadingMedia = true;
                StateHasChanged();

                var uploadSw = System.Diagnostics.Stopwatch.StartNew();
                var payloads = selectedMedia.Select(m => new UploadMediaPayload
                {
                    FileName = m.FileName,
                    ContentType = m.ContentType,
                    Data = m.Data
                });

                var uploadRes = await FileUploadService.UploadPostMediaAsync(payloads);
                uploadSw.Stop();

                isUploadingMedia = false;

                if (!uploadRes.Success || uploadRes.Data == null)
                {
                    createPostErrorMessage = uploadRes.Message ?? "Failed to upload attachments.";
                    isSubmittingPost = false;
                    return;
                }

                uploadedMedia = uploadRes.Data;
            }

            var request = new CreatePostRequest
            {
                Content = contentTrimmed,
                PostType = createPostType,
                LocationId = selectedLocationId,
                Media = uploadedMedia
            };

            var postSw = System.Diagnostics.Stopwatch.StartNew();
            var postRes = await PostService.CreatePostAsync(request);
            postSw.Stop();

            if (postRes.Success && postRes.Data != null)
            {
                totalSubmitSw.Stop();
                ResetForm();
                _ = ResetFileInputAsync();
                if (OnPostCreated.HasDelegate)
                {
                    await OnPostCreated.InvokeAsync(postRes.Data);
                }
            }
            else
            {
                createPostErrorMessage = postRes.Message ?? "Failed to create post. Please try again.";
            }
        }
        catch (Exception ex)
        {
            createPostErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmittingPost = false;
            isUploadingMedia = false;
        }
    }
}

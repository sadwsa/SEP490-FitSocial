@page "/login"
@layout AuthLayout
@inject IAuthService AuthService
@inject GoogleSignInService GoogleSignIn
@inject ITokenStorage TokenStorage
@inject NavigationManager Navigation

<PageTitle>Sign In - FitSocial</PageTitle>

<div class="login-hero">
    <img src="Logo_FitSocial.jpg" alt="FitSocial" class="hero-logo" />
    <div class="hero-text">
        <h1 class="hero-title">Sign In to <span>FitSocial</span></h1>
        <p class="hero-sub">Access your training log, connect with coaches and continue your breakthrough sports journey.</p>
    </div>
</div>

<div class="reg-card">
    <!-- Google (redirect flow, works in Guest/Incognito) -->
    <button type="button" class="btn-google" @onclick="HandleGoogleButtonAsync">
        <AppIcon Name="google" /><span>Sign in with Google</span>
    </button>

    <div class="divider"><span>OR SIGN IN WITH ACCOUNT</span></div>

    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <div class="auth-alert info" role="alert"><AppIcon Name="info" /><span>@infoMessage</span></div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="auth-alert error" role="alert"><AppIcon Name="warning" /><span>@errorMessage</span></div>
    }

    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        <div class="field">
            <label>Email address <span class="req">*</span></label>
            <div class="input-wrap">
                <span class="input-icon"><AppIcon Name="envelope" /></span>
                <InputText @bind-Value="loginModel.Email" class="form-control has-icon" placeholder="E.g.: athlete@fitsocial.vn" />
            </div>
            <ValidationMessage For="@(() => loginModel.Email)" class="field-error" />
        </div>

        <div class="field">
            <label>Password <span class="req">*</span></label>
            <div class="input-wrap">
                <span class="input-icon"><AppIcon Name="lock" /></span>
                <InputText type="@(showPassword ? "text" : "password")" @bind-Value="loginModel.Password" class="form-control has-icon has-eye" placeholder="Enter your account password" />
                <button type="button" class="eye-btn" @onclick="() => showPassword = !showPassword" title="Show/hide password">
                    <AppIcon Name="@(showPassword ? "eye-slash" : "eye")" />
                </button>
            </div>
            <ValidationMessage For="@(() => loginModel.Password)" class="field-error" />
        </div>

        <div class="login-options">
            <label class="remember">
                <input type="checkbox" @bind="rememberMe" />
                <span>Remember me on this device</span>
            </label>
            <button type="button" class="link-button" @onclick="HandleForgotPassword">Forgot password?</button>
        </div>

        <button type="submit" class="btn-auth-primary" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Signing in...</span>
            }
            else
            {
                <span>Sign In Now →</span>
            }
        </button>
    </EditForm>

    <div class="reg-footer">
        New to FitSocial? <a href="register">Create an account now →</a>
    </div>
</div>

@code {
    private LoginRequest loginModel = new();
    private bool showPassword = false;
    private bool rememberMe = true;
    private string? infoMessage;
    private string? errorMessage;
    private bool isLoading = false;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "authError")]
    public string? AuthError { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        rememberMe = await TokenStorage.GetRememberMeAsync();

        // Error forwarded from /login-callback (Google round-trip loses in-memory state)
        if (!string.IsNullOrWhiteSpace(AuthError))
        {
            errorMessage = AuthError;
        }

        // Already signed in -> skip the login page, routing by CURRENT role
        // (an admin revisiting /login must go back to /admin, never to home)
        if (await AuthService.IsAuthenticatedAsync())
        {
            NavigateAfterLogin(await GetCurrentRoleAsync());
        }
    }

    private async Task<string?> GetCurrentRoleAsync()
    {
        if (AuthState == null)
        {
            return null;
        }

        var user = (await AuthState).User;
        if (user.IsInRole(AppRoles.Admin))
        {
            return AppRoles.Admin;
        }
        if (user.IsInRole(AppRoles.Staff))
        {
            return AppRoles.Staff;
        }
        if (user.IsInRole(AppRoles.Coach))
        {
            return AppRoles.Coach;
        }
        if (user.IsInRole(AppRoles.Trainee))
        {
            return AppRoles.Trainee;
        }
        return null;
    }

    private void NavigateAfterLogin(string? roleCode = null)
    {
        bool isBackOffice = string.Equals(roleCode?.Trim(), AppRoles.Admin, StringComparison.OrdinalIgnoreCase)
            || string.Equals(roleCode?.Trim(), AppRoles.Staff, StringComparison.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(ReturnUrl) &&
            !ReturnUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            bool wantsAdminArea = ReturnUrl.TrimStart('/').StartsWith("admin", StringComparison.OrdinalIgnoreCase);
            if (wantsAdminArea == isBackOffice)
            {
                Navigation.NavigateTo(ReturnUrl);
                return;
            }
        }

        Navigation.NavigateTo(isBackOffice ? "/admin" : "home");
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;
        infoMessage = null;

        await TokenStorage.SetRememberMeAsync(rememberMe);

        // Shared login for all roles: no RoleCode sent, backend skips the role check
        loginModel.RoleCode = null;
        var result = await AuthService.LoginAsync(loginModel);
        if (result.Success)
        {
            NavigateAfterLogin(result.Data?.User?.RoleCode);
        }
        else
        {
            errorMessage = result.Message ?? "Sign-in failed. Please check your information and try again.";
        }

        isLoading = false;
    }

    private async Task HandleGoogleButtonAsync()
    {
        errorMessage = null;
        infoMessage = null;

        if (!GoogleSignIn.IsConfigured)
        {
            infoMessage = "Google sign-in is not configured.";
            return;
        }

        await TokenStorage.SetRememberMeAsync(rememberMe);
        await GoogleSignIn.BeginRedirectSignInAsync(null);
    }

    private void HandleForgotPassword()
    {
        infoMessage = "Password reset is not available yet. Please contact FitSocial support for help.";
    }
}

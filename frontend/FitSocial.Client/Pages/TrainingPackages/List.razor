@page "/training-packages"
@inject ITrainingPackageService PackageService
@inject NavigationManager Navigation

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">My Training Packages</h2>
        <AuthorizeView Roles="COACH">
            <Authorized>
                <a href="/training-packages/create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm fw-semibold">
                    <i class="bi bi-plus-lg me-2"></i> Create New
                </a>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
            <p class="mt-3 text-muted">Loading amazing packages...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger rounded-3 shadow-sm">@errorMessage</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var pkg in packages)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift transition-all" style="transition: transform 0.2s, box-shadow 0.2s;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                    <i class="bi bi-calendar-event me-1"></i> @pkg.DurationDays Days
                                </span>
                                @if (pkg.IsActive)
                                {
                                    <span class="badge bg-primary rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">Inactive</span>
                                }
                            </div>

                            <h4 class="card-title fw-bold text-dark mb-1">@pkg.Title</h4>
                            <p class="text-muted small mb-3">By <span class="fw-semibold text-primary">@pkg.CoachName</span></p>

                            <h3 class="fw-bolder text-dark mb-4">@pkg.Price.ToString("N0") VNĐ</h3>

                            <button @onclick="() => ViewDetails(pkg.PackageId)" class="btn btn-outline-primary w-100 rounded-pill fw-semibold">
                                View Details
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<TrainingPackageResponseDto> packages = new List<TrainingPackageResponseDto>();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var response = await PackageService.GetMyPackagesAsync();
        if (response.Success && response.Data != null)
        {
            packages = response.Data;
        }
        else
        {
            errorMessage = response.Message ?? "Failed to load packages.";
        }
        isLoading = false;
    }

    private void ViewDetails(Guid id)
    {
        Navigation.NavigateTo($"/training-packages/{id}");
    }
}

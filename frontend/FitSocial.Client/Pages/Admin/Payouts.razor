@page "/admin/payouts"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN,STAFF")]
@using FitSocial.Client.Models.Common
@using FitSocial.Client.Models.Payouts
@using FitSocial.Client.Services.Payouts
@inject IPayoutService PayoutService
@inject NavigationManager Navigation

<PageTitle>Payout History - FitConnect Admin Console</PageTitle>

<AuthorizeView Roles="ADMIN,STAFF">
    <Authorized>
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="auth-alert @toastType" role="alert">
                <span class="flex-1">@toastMessage</span>
                <button type="button" class="ml-2 font-bold cursor-pointer opacity-70 hover:opacity-100" @onclick="() => toastMessage = null">✕</button>
            </div>
        }

        <h2 class="view-title">Coach Payout History</h2>
        <p class="view-sub">Monthly earnings disbursement to coaches (UC-23.1)</p>

        <!-- Status Filter Tabs -->
        <div class="cat-tabs">
            <button type="button" class="cat-tab @(statusFilter == "" ? "active" : "")" @onclick='() => SetStatusFilterAsync("")'>All</button>
            <button type="button" class="cat-tab @(statusFilter == "PENDING" ? "active" : "")" @onclick='() => SetStatusFilterAsync("PENDING")'>
                <span class="status-dot" style="background:#f59e0b;"></span> Pending
            </button>
            <button type="button" class="cat-tab @(statusFilter == "PROCESSED" ? "active" : "")" @onclick='() => SetStatusFilterAsync("PROCESSED")'>
                <span class="status-dot" style="background:#16a34a;"></span> Processed
            </button>
        </div>

        <!-- Toolbar: cycle + generate -->
        <div class="toolbar">
            <select value="@filterMonth" @onchange="OnMonthChanged" class="toolbar-select">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m">Month @m</option>
                }
            </select>
            <select value="@filterYear" @onchange="OnYearChanged" class="toolbar-select">
                @foreach (var y in yearOptions)
                {
                    <option value="@y">@y</option>
                }
            </select>
            <button type="button" class="row-btn" @onclick="LoadHistoryAsync" disabled="@isLoading">
                ↻ Refresh
            </button>
            <span class="grow"></span>
            <button type="button" class="btn-primary" @onclick="HandleGenerateAsync" disabled="@isGenerating">
                @(isGenerating ? "Generating..." : $"Generate {filterMonth:D2}/{filterYear}")
            </button>
        </div>

        @if (isLoading)
        {
            <div class="py-4 text-center muted">Loading payout history...</div>
        }
        else if (payouts.Count == 0)
        {
            <div class="empty-box">
                <p class="font-bold">No payout records for @(filterMonth.ToString("D2"))/@filterYear</p>
                <p class="text-sm">Click "Generate" to build payout snapshots from completed package sales.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Coach</th>
                            <th>Cycle</th>
                            <th class="text-end">Gross Sales</th>
                            <th class="text-end">Refunds</th>
                            <th class="text-end">Net Payout</th>
                            <th>Flags</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in PagedPayouts)
                        {
                            <tr>
                                <td>
                                    <div class="font-semibold">@p.CoachName</div>
                                    <div class="muted-sm">@p.CoachEmail</div>
                                </td>
                                <td><span class="cycle-badge">@p.CycleLabel</span></td>
                                <td class="text-end">@p.TotalGrossAmount.ToString("N0") VND</td>
                                <td class="text-end">@p.RefundAdjustmentTotal.ToString("N0") VND</td>
                                <td class="text-end font-bold text-orange">@p.NetPayoutAmount.ToString("N0") VND</td>
                                <td>
                                    @if (p.HasBlockingReports)
                                    {
                                        <span class="flag flag-report" title="@p.BlockingReportCount unresolved report(s)">⚠ @p.BlockingReportCount report(s)</span>
                                    }
                                    @if (!p.HasBankAccount)
                                    {
                                        <span class="flag flag-bank" title="No bank account">⚠ No bank</span>
                                    }
                                    @if (!p.HasBlockingReports && p.HasBankAccount)
                                    {
                                        <span class="flag flag-ok">✓ Clear</span>
                                    }
                                </td>
                                <td>
                                    <span class="status-pill @(p.Status == "PROCESSED" ? "done" : "pending")">@p.Status</span>
                                    @if (p.Status == "PENDING" && p.TotalItemCount > 0)
                                    {
                                        <div class="muted-sm">Paid @p.PaidItemCount/@p.TotalItemCount lines</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.TransactionRef))
                                    {
                                        <div class="muted-sm">Ref: @p.TransactionRef</div>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (p.Status == "PENDING")
                                    {
                                        <button type="button" class="row-btn primary" @onclick="() => OpenProcessModal(p.PayoutId)"
                                                disabled="@(!p.CanProcess)" title="@(p.CanProcess ? "Process payout" : p.BlockReason)">
                                            Process Payout
                                        </button>
                                        @if (!p.CanProcess && !string.IsNullOrEmpty(p.BlockReason))
                                        {
                                            <div class="block-note" title="@p.BlockReason">@p.BlockReason</div>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="row-btn" @onclick="() => OpenProcessModal(p.PayoutId)">View</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <CommonPagination CurrentPage="@pageIndex"
                              PageSize="@pageSize"
                              TotalCount="@payouts.Count"
                              PageChanged="GoToPage"
                              ItemName="payouts" />
        }

        <!-- Processing Modal -->
        @if (showModal)
        {
            <div class="modal-backdrop" @onclick="CloseModal">
                <div class="modal-card" @onclick:stopPropagation="true">
                    <div class="modal-head">
                        <div>
                            <h3>Process Coach Payout</h3>
                            @if (detail != null)
                            {
                                <p class="muted-sm">@detail.CoachName • Cycle @detail.CycleLabel • Status: @detail.Status</p>
                            }
                        </div>
                        <button type="button" class="modal-x" @onclick="CloseModal">✕</button>
                    </div>

                    @if (isLoadingDetail)
                    {
                        <div class="py-4 text-center muted">Loading payout statement...</div>
                    }
                    else if (detail != null)
                    {
                        <!-- Calculation breakdown -->
                        <p class="muted-sm" style="margin-bottom:8px;">Doanh thu ghi nhận theo kỳ tháng: gói N tháng thì mỗi tháng nhận 1/N giá trị gói.</p>
                        <div class="breakdown">
                            <div class="bd-row"><span>Gross Package Sales (@detail.Items.Count(i => i.GrossAmount > 0) orders)</span><strong>@detail.TotalGrossAmount.ToString("N0") VND</strong></div>
                            <div class="bd-row"><span>Platform Commission (@((detail.CommissionRate * 100).ToString("0"))%)</span><span>-@detail.SystemCommissionAmount.ToString("N0") VND</span></div>
                            <div class="bd-row"><span>Refund Adjustments</span><span>-@detail.RefundAdjustmentTotal.ToString("N0") VND</span></div>
                            <div class="bd-row total"><span>Final Net Payout Amount</span><strong>@detail.NetPayoutAmount.ToString("N0") VND</strong></div>
                        </div>

                        <!-- Bank account -->
                        <h4 class="sec-title">Coach Bank Account</h4>
                        @if (detail.BankAccount == null)
                        {
                            <div class="auth-alert error">Coach has not added or activated a valid bank account. Payout cannot be executed (E1).</div>
                        }
                        else
                        {
                            <div class="bank-box">
                                <div><span class="muted-sm">Bank</span><strong> @detail.BankAccount.BankName (@detail.BankAccount.BankCode)</strong></div>
                                <div><span class="muted-sm">Account</span><strong> @detail.BankAccount.MaskedAccountNumber</strong></div>
                                <div><span class="muted-sm">Name</span><strong> @detail.BankAccount.AccountName</strong></div>
                                @if (!string.IsNullOrWhiteSpace(detail.BankAccount.Branch))
                                {
                                    <div><span class="muted-sm">Branch</span><strong> @detail.BankAccount.Branch</strong></div>
                                }
                            </div>
                        }

                        <!-- Report guard -->
                        @if (detail.HasBlockingReports)
                        {
                            <div class="auth-alert error">Coach has @detail.BlockingReportCount unresolved report(s). Payout is blocked until reports are resolved (TH1).</div>
                        }

                        @if (!string.IsNullOrEmpty(detail.BlockReason) && !detail.CanProcess && detail.Status == "PENDING")
                        {
                            <div class="auth-alert error">@detail.BlockReason</div>
                        }

                        <!-- Packages in this cycle: pay per package or pay all -->
                        @if (detail.PackageGroups.Count > 0)
                        {
                            <h4 class="sec-title">Packages in this cycle (@detail.PackageGroups.Count)</h4>
                            <div class="pkg-list">
                                @foreach (var g in detail.PackageGroups)
                                {
                                    <div class="pkg-card">
                                        <div class="pkg-head">
                                            <div class="flex-1">
                                                <div class="font-bold text-sm">@(!string.IsNullOrWhiteSpace(g.PackageTitle) ? g.PackageTitle : "Training Package")</div>
                                                <div class="muted-sm">@g.MonthsTotal tháng • Đã trả @g.CyclePaidAmount.ToString("N0") / @g.CycleAmount.ToString("N0") VND</div>
                                            </div>
                                            @if (g.IsFullyPaid)
                                            {
                                                <span class="status-pill done">Paid ✓</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="row-btn primary small"
                                                        @onclick="() => HandlePayPackageAsync(g)"
                                                        disabled="@(!CanPayGroup(g) || isProcessing)"
                                                        title="Pay only this package's unpaid lines">
                                                    @(isProcessing ? "..." : $"Pay {g.CycleUnpaidAmount:N0} →")
                                                </button>
                                            }
                                        </div>
                                        @foreach (var it in g.Items)
                                        {
                                            <div class="item-row">
                                                <div class="flex-1">
                                                    <div class="font-semibold text-sm">
                                                        @(!string.IsNullOrWhiteSpace(it.PackageTitle) ? it.PackageTitle : "Training Package")
                                                        @if (it.IsPaid)
                                                        {
                                                            <span class="status-pill done" style="margin-left:6px;">Paid ✓</span>
                                                        }
                                                    </div>
                                                    <div class="muted-sm">@it.BuyerName • @it.OrderCreatedAt?.ToLocalTime().ToString("dd/MM/yyyy")@(string.IsNullOrWhiteSpace(it.VestingInfo) ? "" : $" • {it.VestingInfo}")</div>
                                                    @if (it.Timeline.Count > 0)
                                                    {
                                                        <div class="chips">
                                                            @foreach (var m in it.Timeline)
                                                            {
                                                                @if (m.CanPay && m.PayoutId.HasValue && m.PayoutItemId.HasValue)
                                                                {
                                                                    <button type="button" class="chip payable clickable"
                                                                            title="Pay @m.Amount.ToString("N0") VND for @m.Label"
                                                                            disabled="@isProcessing"
                                                                            @onclick="() => HandlePayMonthAsync(m)">
                                                                        @m.Label ! →
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <span class="chip @m.State.ToLower()" title="@m.Amount.ToString("N0") VND">@m.Label @(m.State == "PAID" ? "✓" : m.State == "PAYABLE" ? "!" : "·")</span>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                <div class="text-end text-sm">
                                                    <div><strong>@it.NetAmount.ToString("N0")</strong></div>
                                                    @if (it.IsPaid && !string.IsNullOrWhiteSpace(it.TransactionRef))
                                                    {
                                                        <div class="muted-sm">Ref: @it.TransactionRef</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (PendingRefunds().Count > 0)
                        {
                            <div class="muted-sm" style="margin:6px 0;">
                                Refund adjustments (@PendingRefunds().Count): −@PendingRefunds().Sum(i => i.RefundAdjustment).ToString("N0") VND (deducted on pay)
                            </div>
                        }

                        <div class="bd-row total" style="margin-top:8px;">
                            <span>Còn lại cần trả:</span>
                            <strong>@RemainingAmount().ToString("N0") VND</strong>
                        </div>

                        @if (!string.IsNullOrEmpty(modalError))
                        {
                            <div class="auth-alert error">@modalError</div>
                        }

                        <div class="modal-actions">
                            <button type="button" class="btn-ghost" @onclick="CloseModal" disabled="@isProcessing">Cancel</button>
                            @if (detail.Status == "PENDING")
                            {
                                <button type="button" class="btn-primary" @onclick="HandleConfirmPayoutAsync"
                                        disabled="@(!detail.CanProcess || isProcessing || RemainingAmount() <= 0)"
                                        title="@(detail.CanProcess ? "Pay all remaining lines" : detail.BlockReason)">
                                    @(isProcessing ? "Executing..." : $"Pay All Remaining →")
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private List<PayoutHistoryItem> payouts = new();
    private int pageIndex = 1;
    private int pageSize = 10;

    private List<PayoutHistoryItem> PagedPayouts =>
        payouts.Skip((pageIndex - 1) * pageSize).Take(pageSize).ToList();

    private void GoToPage(int page)
    {
        var totalPages = Math.Max(1, (int)Math.Ceiling(payouts.Count / (double)pageSize));
        pageIndex = Math.Clamp(page, 1, totalPages);
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            pageSize = size;
        }
        pageIndex = 1;
    }
    private bool isLoading = true;
    private bool isGenerating = false;
    private string statusFilter = "";
    private int filterMonth = DateTime.UtcNow.Month;
    private int filterYear = DateTime.UtcNow.Year;
    private List<int> yearOptions = new();
    private string? toastMessage;
    private string toastType = "info";

    private bool showModal = false;
    private bool isLoadingDetail = false;
    private bool isProcessing = false;
    private PayoutDetail? detail;
    private string? modalError;

    protected override async Task OnInitializedAsync()
    {
        var y = DateTime.UtcNow.Year;
        yearOptions = new List<int> { y - 1, y, y + 1 };
        await LoadHistoryAsync();
    }

    private async Task SetStatusFilterAsync(string status)
    {
        statusFilter = status;
        pageIndex = 1;
        await LoadHistoryAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m)) filterMonth = m;
        pageIndex = 1;
        await LoadHistoryAsync();
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y)) filterYear = y;
        pageIndex = 1;
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        isLoading = true;
        LoadingService.Show("Loading payouts...");
        try
        {
            var res = await PayoutService.GetHistoryAsync(filterMonth, filterYear,
                string.IsNullOrEmpty(statusFilter) ? null : statusFilter);
            if (res.Success && res.Data != null)
            {
                payouts = res.Data;
            }
            else
            {
                ShowToast(res.Message ?? "Failed to load payout history.", "error");
            }
            var maxPage = Math.Max(1, (int)Math.Ceiling(payouts.Count / (double)pageSize));
            if (pageIndex > maxPage) pageIndex = maxPage;
        }
        catch (Exception ex)
        {
            ShowToast($"Error: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
            LoadingService.Hide();
        }
    }

    private async Task HandleGenerateAsync()
    {
        isGenerating = true;
        LoadingService.Show("Generating payouts...");
        try
        {
            var res = await PayoutService.GenerateAsync(filterMonth, filterYear);
            if (res.Success && res.Data != null)
            {
                ShowToast($"Cycle {res.Data.Month:D2}/{res.Data.Year}: {res.Data.Created} created, {res.Data.Updated} updated.", "info");
            }
            else
            {
                ShowToast(res.Message ?? "Failed to generate payouts.", "error");
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Error generating payouts: {ex.Message}", "error");
        }
        finally
        {
            isGenerating = false;
            LoadingService.Hide();
            await LoadHistoryAsync();
        }
    }

    private async Task OpenProcessModal(Guid payoutId)
    {
        showModal = true;
        isLoadingDetail = true;
        modalError = null;
        detail = null;
        LoadingService.Show("Loading payout details...");

        try
        {
            var res = await PayoutService.GetDetailAsync(payoutId);
            if (res.Success && res.Data != null)
            {
                detail = res.Data;
            }
            else
            {
                modalError = res.Message ?? "Failed to load payout detail.";
            }
        }
        catch (Exception ex)
        {
            modalError = $"Error: {ex.Message}";
        }
        finally
        {
            isLoadingDetail = false;
            LoadingService.Hide();
        }
    }

    private void CloseModal()
    {
        if (isProcessing) return;
        showModal = false;
        detail = null;
        modalError = null;
    }

    private bool CanPayGroup(PayoutPackageGroup g)
    {
        return detail != null
            && detail.Status == "PENDING"
            && detail.CanProcess
            && !g.IsFullyPaid
            && g.CycleUnpaidAmount > 0;
    }

    private decimal RemainingAmount()
    {
        if (detail == null) return 0;
        var grossUnpaid = detail.PackageGroups.SelectMany(g => g.Items)
            .Where(i => !i.IsPaid && i.GrossAmount > 0).Sum(i => i.NetAmount);
        var refunds = detail.Items
            .Where(i => !i.IsPaid && i.GrossAmount <= 0).Sum(i => i.RefundAdjustment);
        return grossUnpaid - refunds;
    }

    private List<PayoutItem> PendingRefunds()
    {
        if (detail == null) return new();
        return detail.Items.Where(i => !i.IsPaid && i.GrossAmount <= 0 && i.RefundAdjustment > 0).ToList();
    }

    private async Task RefreshDetailAsync()
    {
        if (detail == null) return;
        var res = await PayoutService.GetDetailAsync(detail.PayoutId);
        if (res.Success && res.Data != null)
        {
            detail = res.Data;
        }
        await LoadHistoryAsync();
    }

    private async Task HandlePayPackageAsync(PayoutPackageGroup g)
    {
        if (detail == null || isProcessing) return;
        isProcessing = true;
        modalError = null;
        LoadingService.Show("Processing package payout...");

        try
        {
            var ids = g.Items.Where(i => !i.IsPaid && i.GrossAmount > 0)
                .Select(i => i.PayoutItemId).ToList();
            var res = await PayoutService.ProcessItemsAsync(detail.PayoutId, ids);
            if (res.Success && res.Data != null)
            {
                ShowToast($"Package paid: {res.Data.NetPayoutAmount:N0} VND (Ref: {res.Data.TransactionRef}).", "info");
                await RefreshDetailAsync();
            }
            else
            {
                modalError = res.Message ?? "Package payment failed. Kept as PENDING — please retry.";
                await LoadHistoryAsync();
            }
        }
        catch (Exception ex)
        {
            modalError = $"Error processing package: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            LoadingService.Hide();
        }
    }

    private async Task HandlePayMonthAsync(VestingMonth m)
    {
        if (detail == null || isProcessing) return;
        if (!m.CanPay || !m.PayoutId.HasValue || !m.PayoutItemId.HasValue) return;
        isProcessing = true;
        modalError = null;
        LoadingService.Show("Processing month payout...");

        try
        {
            var res = await PayoutService.ProcessItemsAsync(m.PayoutId.Value, new List<Guid> { m.PayoutItemId.Value });
            if (res.Success && res.Data != null)
            {
                ShowToast($"Month {m.Label} paid: {res.Data.NetPayoutAmount:N0} VND (Ref: {res.Data.TransactionRef}).", "info");
                await RefreshDetailAsync();
            }
            else
            {
                modalError = res.Message ?? "Month payment failed. Kept as PENDING — please retry.";
                await LoadHistoryAsync();
            }
        }
        catch (Exception ex)
        {
            modalError = $"Error processing month: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            LoadingService.Hide();
        }
    }

    private async Task HandleConfirmPayoutAsync()
    {
        if (detail == null || isProcessing) return;
        isProcessing = true;
        modalError = null;
        LoadingService.Show("Processing coach payout...");

        try
        {
            var res = await PayoutService.ProcessAsync(detail.PayoutId);
            if (res.Success && res.Data != null)
            {
                ShowToast($"Payout processed: {res.Data.NetPayoutAmount:N0} VND (Ref: {res.Data.TransactionRef}).", "info");
                showModal = false;
                detail = null;
                await LoadHistoryAsync();
            }
            else
            {
                modalError = res.Message ?? "Payout failed. Kept as PENDING — please retry.";
            }
        }
        catch (Exception ex)
        {
            modalError = $"Error processing payout: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            LoadingService.Hide();
        }
    }

    private void ShowToast(string message, string type)
    {
        toastMessage = message;
        toastType = type;
    }
}

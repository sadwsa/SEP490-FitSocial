@page "/training-packages"
@layout EmptyLayout
@inject ITrainingPackageService PackageService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject FitSocial.Client.Services.Auth.IAuthService AuthService
@inject FitSocial.Client.Services.Cart.ICartService CartService
@inject IJSRuntime JS
@using FitSocial.Client.Layout
@using FitSocial.Client.Models.TrainingPackages
@using System.Security.Claims

<PageTitle>My Training Packages - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <!-- Floating Success Toast Notification -->
    @if (!string.IsNullOrWhiteSpace(toastSuccessMessage))
    {
        <div class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-emerald-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-emerald-500/50 backdrop-blur transition-all duration-300 animate-in fade-in slide-in-from-top-4">
            <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <span>@toastSuccessMessage</span>
            <button type="button" @onclick="() => toastSuccessMessage = null"
                    class="ml-2 text-white/80 hover:text-white text-lg font-bold transition cursor-pointer">
                &times;
            </button>
        </div>
    }

    <!-- Floating Error Toast Notification -->
    @if (!string.IsNullOrWhiteSpace(toastErrorMessage))
    {
        <div class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-red-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-red-500/50 backdrop-blur transition-all duration-300 animate-in fade-in slide-in-from-top-4">
            <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <span>@toastErrorMessage</span>
            <button type="button" @onclick="() => toastErrorMessage = null"
                    class="ml-2 text-white/80 hover:text-white text-lg font-bold transition cursor-pointer">
                &times;
            </button>
        </div>
    }

    <AppHeader SearchTerm="@headerSearchTerm"
               OnSearchInput="HandleHeaderSearchInput"
               OnSearchKeyUp="HandleHeaderSearchKeyUp"
               OnSearch="ExecuteHeaderSearch"
               OnClearSearch="ClearHeaderSearch"
               UserName="@userName"
               UserInitials="@userInitials"
               UserRole="@userRole"
               CartCount="@headerCartCount"
               OnLogout="HandleLogout" />

    <style>
        @@media (min-width: 1024px) {
            .home-3col-layout {
                display: grid !important;
                grid-template-columns: minmax(18rem, 1fr) minmax(0, 46rem) minmax(18rem, 1fr) !important;
                align-items: start !important;
            }

            .home-left-sidebar { justify-self: start !important; }
            .home-center-feed { justify-self: end !important; width: 100% !important; max-width: 46rem !important; min-width: 0 !important; }
            .home-right-sidebar { justify-self: center !important; }
        }
    </style>

    <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">
        <!-- Left Sidebar -->
        <AppSidebar ActiveItem="my-packages" />

        <!-- Center Column -->
        <section class="home-center-feed w-full max-w-3xl flex flex-col gap-4 min-w-0 pb-10">
            <!-- Header Section -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex justify-between items-center gap-4">
                <div>
                    <h1 class="text-xl font-bold text-gray-800">My Training Packages</h1>
                    <p class="text-xs text-gray-500 mt-0.5">Create and manage personal coaching programs for your trainees</p>
                </div>
                <AuthorizeView Roles="COACH">
                    <Authorized>
                        <button @onclick="ToggleCreateForm" class="bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white px-4 py-2.5 rounded-xl font-semibold text-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center gap-2 cursor-pointer">
                            @if (showCreateForm)
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                <span>Close Form</span>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                <span>Create Package</span>
                            }
                        </button>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="TRAINEE">
                    <Authorized>
                        <a href="packages" class="bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white px-4 py-2.5 rounded-xl font-semibold text-sm hover:shadow-md transition-all flex items-center gap-2">
                            <span>Browse All Packages</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>

            <!-- Create Package Form -->
            @if (showCreateForm)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 animate-in fade-in duration-300">
                    <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                        <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                            <span class="w-7 h-7 rounded-lg bg-orange-100 text-[#FF5500] flex items-center justify-center text-sm font-black">+</span>
                            <span>Create New Training Package</span>
                        </h2>
                        <span class="text-xs text-gray-400">Complete curriculum & marketplace settings</span>
                    </div>

                    @if (!string.IsNullOrEmpty(createErrorMessage))
                    {
                        <div class="bg-red-50 border border-red-200 text-red-600 p-3.5 rounded-xl text-sm font-medium mb-5 flex items-start gap-2.5">
                            <svg class="w-5 h-5 flex-shrink-0 text-red-500 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>@createErrorMessage</span>
                        </div>
                    }

                    <EditForm Model="@createDto" OnValidSubmit="HandleCreateSubmit">
                        <DataAnnotationsValidator />

                        <!-- Title -->
                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">
                                Package Title <span class="text-red-500">*</span>
                            </label>
                            <InputText @bind-Value="createDto.Title"
                                       class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm font-medium"
                                       placeholder="e.g. 30 Days Body Recomposition & Hypertrophy" />
                            <ValidationMessage For="@(() => createDto.Title)" class="text-red-500 text-xs mt-1" />
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">
                                Detailed Description <span class="text-xs font-normal text-gray-400">(Max 500 characters)</span>
                            </label>
                            <InputTextArea @bind-Value="createDto.Description" rows="3"
                                           class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm leading-relaxed"
                                           placeholder="Detailed curriculum roadmap, workout breakdown, meal plans, 1-on-1 coaching..." />
                            <ValidationMessage For="@(() => createDto.Description)" class="text-red-500 text-xs mt-1" />
                        </div>

                        <!-- Price & Duration -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-1">
                                    Price (VND) <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <InputNumber @bind-Value="createDto.Price"
                                                 class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm font-semibold text-gray-800"
                                                 placeholder="500000" />
                                    <span class="absolute right-3.5 top-2.5 text-xs font-bold text-gray-400 uppercase">VND</span>
                                </div>
                                <ValidationMessage For="@(() => createDto.Price)" class="text-red-500 text-xs mt-1" />
                            </div>

                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-1">
                                    Duration (Days) <span class="text-red-500">*</span>
                                </label>
                                <InputNumber @bind-Value="createDto.DurationDays"
                                             class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm"
                                             placeholder="30" />
                                <ValidationMessage For="@(() => createDto.DurationDays)" class="text-red-500 text-xs mt-1" />
                            </div>
                        </div>

                        <!-- SessionCount & MinAge -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-1">
                                    Session Count
                                </label>
                                <InputNumber @bind-Value="createDto.SessionCount"
                                             class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm"
                                             placeholder="e.g. 12" />
                                <ValidationMessage For="@(() => createDto.SessionCount)" class="text-red-500 text-xs mt-1" />
                            </div>

                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-1">
                                    Minimum Age (Years)
                                </label>
                                <InputNumber @bind-Value="createDto.MinAge"
                                             class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm"
                                             placeholder="e.g. 16" />
                                <ValidationMessage For="@(() => createDto.MinAge)" class="text-red-500 text-xs mt-1" />
                            </div>
                        </div>

                        <!-- TargetAudience -->
                        <div class="mb-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">
                                Target Audience
                            </label>
                            <InputText @bind-Value="createDto.TargetAudience"
                                       class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition text-sm"
                                       placeholder="e.g. Men aiming for muscle hypertrophy, Women seeking fat loss, Beginners..." />
                            <ValidationMessage For="@(() => createDto.TargetAudience)" class="text-red-500 text-xs mt-1" />
                        </div>

                        <!-- IsActive Switch -->
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-100 mb-5">
                            <div>
                                <p class="text-sm font-bold text-gray-800">Publish to Marketplace</p>
                                <p class="text-xs text-gray-500">The package will be listed on the marketplace for trainees to purchase immediately</p>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" checked="@createDto.IsActive" @onchange="ToggleCreateActive" class="sr-only peer" />
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                            </label>
                        </div>

                        <!-- Image Upload Section -->
                        <div class="mb-6">
                            <div class="flex items-center justify-between mb-2">
                                <label class="text-sm font-semibold text-gray-700 flex items-center gap-1.5">
                                    <span>Photo Album</span>
                                    <span class="text-xs text-gray-400 font-normal">(@createImages.Count/10)</span>
                                </label>
                                <span class="text-[11px] text-gray-400">The first photo will be used as the cover photo</span>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-2">
                                @for (int i = 0; i < createImages.Count; i++)
                                {
                                    var idx = i;
                                    var imgUrl = createImages[i];
                                    <div class="group relative aspect-video sm:aspect-square rounded-2xl overflow-hidden border-2 border-gray-200 bg-gray-100 shadow-sm">
                                        <img src="@imgUrl" alt="Package Media" class="w-full h-full object-cover" />
                                        
                                        @if (idx == 0)
                                        {
                                            <span class="absolute top-2 left-2 px-2 py-0.5 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white text-[10px] font-bold rounded-md shadow-sm pointer-events-none">
                                                Cover Photo
                                            </span>
                                        }

                                        <!-- Prominent, Always Visible Delete Button -->
                                        <button type="button" @onclick="() => RemoveCreateImage(idx)"
                                                class="absolute top-2 right-2 w-7 h-7 bg-red-600 hover:bg-red-700 active:scale-95 text-white rounded-full flex items-center justify-center shadow-md border-2 border-white transition-all cursor-pointer z-20"
                                                title="Delete photo">
                                            <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    </div>
                                }

                                @if (createImages.Count < 10)
                                {
                                    <label class="relative aspect-video sm:aspect-square rounded-2xl border-2 border-dashed border-gray-300 hover:border-[#FF5500] bg-gray-50 hover:bg-orange-50/40 flex flex-col items-center justify-center cursor-pointer transition p-2 text-center group">
                                        @if (isUploadingCreateImages)
                                        {
                                            <div class="w-6 h-6 border-2 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-1"></div>
                                            <span class="text-[11px] text-[#FF5500] font-bold">Uploading...</span>
                                        }
                                        else
                                        {
                                            <div class="w-8 h-8 rounded-full bg-orange-100 group-hover:bg-[#FF5500] group-hover:text-white text-[#FF5500] flex items-center justify-center mb-1 transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                </svg>
                                            </div>
                                            <span class="text-xs font-semibold text-gray-700 group-hover:text-[#FF5500]">Add Photos</span>
                                        }
                                        <InputFile OnChange="HandleCreateFilesSelected" multiple accept=".jpg,.jpeg,.png,.webp,.gif" class="hidden" disabled="@isUploadingCreateImages" />
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                            <button type="button" @onclick="ToggleCreateForm"
                                    class="px-5 py-2.5 text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-xl transition cursor-pointer">
                                Cancel
                            </button>
                            <button type="submit" disabled="@(isSubmitting || isUploadingCreateImages)"
                                    class="px-6 py-2.5 text-sm font-bold text-white bg-gradient-to-r from-[#FF8C00] to-[#FF5500] rounded-xl hover:shadow-md transition flex items-center gap-2 cursor-pointer disabled:opacity-70">
                                @if (isSubmitting)
                                {
                                    <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                    <span>Creating...</span>
                                }
                                else
                                {
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                    <span>Create Package</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            }
            else if (isLoading)
            {
                <div class="flex flex-col items-center justify-center py-16 bg-white rounded-2xl shadow-sm border border-gray-100">
                    <div class="w-9 h-9 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-3"></div>
                    <p class="text-sm text-gray-500 font-medium">Loading your packages...</p>
                </div>
            }
            else if (errorMessage != null)
            {
                <div class="bg-red-50 text-red-600 p-6 rounded-2xl border border-red-200 text-center text-sm font-medium">@errorMessage</div>
            }
            else if (!packages.Any())
            {
                <div class="bg-white rounded-2xl shadow-sm p-12 text-center flex flex-col items-center border border-gray-100">
                    <div class="w-16 h-16 mb-4 text-orange-200">
                        <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                    </div>
                    <h4 class="font-bold text-gray-800 text-lg mb-1">No packages yet</h4>
                    <p class="text-sm text-gray-500 mb-6">Create your first training package to start offering coaching programs to clients.</p>
                    <AuthorizeView Roles="COACH">
                        <Authorized>
                            <button @onclick="ToggleCreateForm" class="bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white px-6 py-2.5 rounded-xl font-bold text-sm shadow-md hover:shadow-lg transition cursor-pointer">
                                Create Package
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            }
            else
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-100 text-gray-600 text-xs uppercase tracking-wider">
                                    <th class="p-4 font-bold">Package</th>
                                    <th class="p-4 font-bold">Duration / Sessions</th>
                                    <th class="p-4 font-bold">Price</th>
                                    <th class="p-4 font-bold text-center">Status</th>
                                    <th class="p-4 font-bold text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @foreach (var pkg in packages)
                                {
                                    <tr class="hover:bg-gray-50/80 transition-colors">
                                        <!-- Title & Image preview -->
                                        <td class="p-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-12 h-12 rounded-xl bg-orange-50 border border-orange-100 overflow-hidden flex-shrink-0 flex items-center justify-center">
                                                    @if (!string.IsNullOrWhiteSpace(pkg.ThumbnailUrl))
                                                    {
                                                        <img src="@pkg.ThumbnailUrl" alt="@pkg.Title" class="w-full h-full object-cover" />
                                                    }
                                                    else
                                                    {
                                                        <svg class="w-6 h-6 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                                                        </svg>
                                                    }
                                                </div>
                                                <div class="min-w-0">
                                                    <a href="/training-packages/@pkg.PackageId" class="text-sm font-bold text-gray-800 hover:text-[#FF5500] transition line-clamp-1">
                                                        @pkg.Title
                                                    </a>
                                                    @if (!string.IsNullOrWhiteSpace(pkg.TargetAudience))
                                                    {
                                                        <p class="text-xs text-gray-400 line-clamp-1 mt-0.5">Target: @pkg.TargetAudience</p>
                                                    }
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Duration & Session Count -->
                                        <td class="p-4 text-sm text-gray-600">
                                            <p class="font-medium text-gray-800">@(pkg.DurationDays >= 7 && pkg.DurationDays % 7 == 0 ? $"{pkg.DurationDays / 7} Weeks" : $"{pkg.DurationDays} Days")</p>
                                            @if (pkg.SessionCount.HasValue && pkg.SessionCount.Value > 0)
                                            {
                                                <p class="text-xs text-gray-400">@pkg.SessionCount sessions</p>
                                            }
                                        </td>

                                        <!-- Price -->
                                        <td class="p-4 text-sm font-bold text-[#FF5500] whitespace-nowrap">
                                            @($"{pkg.Price:N0} VND")
                                        </td>

                                        <!-- Status -->
                                        <td class="p-4 text-sm text-center">
                                            @if (pkg.IsActive)
                                            {
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600 text-xs font-bold border border-emerald-100">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-gray-100 text-gray-500 text-xs font-bold border border-gray-200">
                                                    Inactive
                                                </span>
                                            }
                                        </td>

                                        <!-- Actions (CRUD only: View, Edit, Delete) -->
                                        <td class="p-4 text-sm text-center whitespace-nowrap">
                                            <div class="inline-flex items-center gap-1.5">
                                                <a href="/training-packages/@pkg.PackageId" class="p-1.5 text-gray-500 hover:text-[#FF5500] hover:bg-gray-100 rounded-lg transition" title="View details">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                                </a>

                                                <AuthorizeView Roles="COACH">
                                                    <Authorized>
                                                        <a href="/training-packages/edit/@pkg.PackageId" class="p-1.5 text-[#FF8C00] hover:text-[#FF5500] hover:bg-orange-50 rounded-lg transition" title="Edit package">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                        </a>

                                                        <button type="button" @onclick="() => PromptDelete(pkg.PackageId)" class="p-1.5 text-red-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition cursor-pointer" title="Delete package">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                        </button>
                                                    </Authorized>
                                                </AuthorizeView>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>

        <!-- Right Sidebar (Empty) -->
        <aside class="home-right-sidebar hidden lg:flex w-72 flex-shrink-0 flex-col gap-4 sticky top-24"></aside>
    </div>

    <!-- Custom Delete Modal -->
    @if (showDeleteModal)
    {
        <div class="fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center z-50 p-4">
            <div class="bg-white rounded-2xl shadow-xl p-6 max-w-sm w-full mx-4 border border-gray-100 animate-in fade-in zoom-in-95 duration-200">
                <div class="w-12 h-12 rounded-full bg-red-100 text-red-500 flex items-center justify-center mb-4 mx-auto">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-gray-800 mb-1 text-center">Confirm Deletion</h3>
                <p class="text-sm text-gray-500 mb-6 text-center">Are you sure you want to delete this package? It will be archived and hidden from the marketplace.</p>
                <div class="flex justify-end gap-3">
                    <button @onclick="CancelDelete" class="flex-1 py-2.5 text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-xl transition cursor-pointer">Cancel</button>
                    <button @onclick="ConfirmDelete" class="flex-1 py-2.5 text-sm font-semibold text-white bg-red-600 hover:bg-red-700 rounded-xl transition cursor-pointer shadow-sm">Delete</button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private IEnumerable<TrainingPackageResponseDto> packages = new List<TrainingPackageResponseDto>();
    private bool isLoading = true;
    private string? errorMessage;
    
    // Custom Delete Modal state
    private bool showDeleteModal = false;
    private Guid? packageToDelete = null;

    // Create form state
    private bool showCreateForm = false;
    private CreateTrainingPackageDto createDto = new();
    private List<string> createImages = new();
    private bool isUploadingCreateImages = false;
    private bool isSubmitting = false;
    private string? createErrorMessage;

    // Header & Cart state
    private string? headerSearchTerm = "";
    private string userName = "User";
    private string userInitials = "U";
    private string userRole = "Trainee";
    private int headerCartCount = 0;
    private string? toastSuccessMessage;
    private string? toastErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfoAsync();
        await LoadPackages();
        await LoadCartCountAsync();
    }

    private async Task LoadPackages()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var res = await PackageService.GetMyPackagesAsync();
            if (res.Success && res.Data != null)
            {
                packages = res.Data;
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load packages.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        if (showCreateForm)
        {
            createDto = new CreateTrainingPackageDto();
            createImages = new List<string>();
            createErrorMessage = null;
        }
    }

    private void ToggleCreateActive(ChangeEventArgs e)
    {
        if (e.Value is bool val)
        {
            createDto.IsActive = val;
        }
    }

    private async Task HandleCreateFilesSelected(InputFileChangeEventArgs e)
    {
        var selectedFiles = e.GetMultipleFiles(10 - createImages.Count);
        if (!selectedFiles.Any()) return;

        isUploadingCreateImages = true;
        try
        {
            var res = await PackageService.UploadPackageImagesAsync(selectedFiles);
            if (res.Success && res.Data != null)
            {
                createImages.AddRange(res.Data);
            }
            else
            {
                createErrorMessage = res.Message ?? "Failed to upload photos.";
            }
        }
        catch (Exception ex)
        {
            createErrorMessage = $"Upload error: {ex.Message}";
        }
        finally
        {
            isUploadingCreateImages = false;
        }
    }

    private void RemoveCreateImage(int idx)
    {
        if (idx >= 0 && idx < createImages.Count)
        {
            createImages.RemoveAt(idx);
        }
    }

    private async Task HandleCreateSubmit()
    {
        isSubmitting = true;
        createErrorMessage = null;

        createDto.ImageUrls = createImages;
        var response = await PackageService.CreatePackageAsync(createDto);

        if (response.Success)
        {
            showCreateForm = false;
            toastSuccessMessage = "Training package created successfully!";
            await LoadPackages();
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                toastSuccessMessage = null;
                InvokeAsync(StateHasChanged);
            });
        }
        else
        {
            createErrorMessage = response.Message ?? "An error occurred while creating the package.";
        }
        isSubmitting = false;
    }

    private void PromptDelete(Guid id)
    {
        packageToDelete = id;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        packageToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (packageToDelete.HasValue)
        {
            var res = await PackageService.DeletePackageAsync(packageToDelete.Value);
            if (res.Success)
            {
                toastSuccessMessage = "Training package deleted successfully.";
                await LoadPackages();
            }
            else
            {
                errorMessage = res.Message ?? "Failed to delete package.";
            }
        }
        showDeleteModal = false;
        packageToDelete = null;
    }

    private async Task LoadCartCountAsync()
    {
        try
        {
            var res = await CartService.GetCartCountAsync();
            if (res.Success)
            {
                headerCartCount = res.Data;
            }
        }
        catch { }
    }

    private async Task LoadUserInfoAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.FindFirst(ClaimTypes.Name)?.Value ?? "User";
            userRole = user.FindFirst(ClaimTypes.Role)?.Value ?? "Trainee";
            userInitials = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U";
        }
    }

    private void HandleHeaderSearchInput(ChangeEventArgs e) => headerSearchTerm = e.Value?.ToString();
    private void HandleHeaderSearchKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") ExecuteHeaderSearch(); }
    private void ExecuteHeaderSearch() { if (!string.IsNullOrWhiteSpace(headerSearchTerm)) Navigation.NavigateTo($"/training-packages?searchKeyword={Uri.EscapeDataString(headerSearchTerm)}"); }
    private void ClearHeaderSearch() => headerSearchTerm = "";
    private async Task HandleLogout() { await AuthService.LogoutAsync(); Navigation.NavigateTo("/login", true); }
}

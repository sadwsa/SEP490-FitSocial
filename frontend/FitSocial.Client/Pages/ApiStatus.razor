@page "/api-status"
@using System.Text
@using System.Text.Json
@inject ApiClient ApiClient
@inject INotificationHubClient NotificationHub
@inject IConfiguration Configuration
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Kiểm tra kết nối API & Phân quyền Roles - FitSocial</PageTitle>

<div class="mb-4">
    <h3 class="fw-bold mb-1">⚡ Kiểm tra kết nối Backend & 4 Roles</h3>
    <p class="text-muted">Kiểm tra đường truyền API, WebSocket SignalR và mô phỏng phân quyền 4 Roles trong FitSocial</p>
</div>

<!-- Role Switcher & Authorization Demo Card -->
<div class="fit-card mb-4 border-primary">
    <h5 class="fw-bold mb-2 d-flex align-items-center gap-2 text-primary">
        <span>🎭</span> Thử nghiệm phân quyền 4 Roles trong Blazor
    </h5>
    <p class="small text-muted mb-3">
        Bấm vào từng Role dưới đây để giả lập đăng nhập với Role tương ứng. Giao diện Sidebar và các thẻ nội dung sẽ tự động thích ứng theo quyền hạn!
    </p>

    <div class="d-flex flex-wrap gap-2 mb-3">
        <button class="btn btn-sm btn-outline-danger" @onclick="() => SimulateRole(AppRoles.Admin)">
            🛡️ Admin (@AppRoles.Admin)
        </button>
        <button class="btn btn-sm btn-outline-warning text-dark" @onclick="() => SimulateRole(AppRoles.Coach)">
            💪 HLV (@AppRoles.Coach)
        </button>
        <button class="btn btn-sm btn-outline-info" @onclick="() => SimulateRole(AppRoles.Staff)">
            🏢 Nhân viên (@AppRoles.Staff)
        </button>
        <button class="btn btn-sm btn-outline-success" @onclick="() => SimulateRole(AppRoles.Trainee)">
            🏃 Hội viên (@AppRoles.Trainee)
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="SimulateLogout">
            🔒 Đăng xuất (Chưa đăng nhập)
        </button>
    </div>

    <!-- Active Role Indicator -->
    <AuthorizeView>
        <Authorized>
            <div class="alert alert-info py-2 small mb-0 d-flex align-items-center justify-content-between">
                <div>
                    <strong>Tài khoản hiện tại:</strong> @context.User.Identity?.Name | 
                    <strong>Quyền (Roles):</strong> 
                    @foreach (var role in AppRoles.All.Where(r => context.User.IsInRole(r)))
                    {
                        <span class="badge bg-primary ms-1">@AppRoles.GetDisplayName(role)</span>
                    }
                </div>
                <span class="badge bg-success">Authenticated</span>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-secondary py-2 small mb-0">
                <span>Chưa đăng nhập (Khách vãng lai). Chỉ xem được trang công khai.</span>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="fit-card h-100">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <span>🌐</span> REST API Test
            </h5>

            <p class="small text-muted">
                <strong>Base URL:</strong> <code>@Configuration["ApiBaseUrl"]</code><br />
                <strong>Endpoint:</strong> <code>weatherforecast</code>
            </p>

            <button class="btn-fit-primary btn-sm mb-3" @onclick="TestApiConnection" disabled="@isTestingApi">
                @if (isTestingApi)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Đang gọi API...</span>
                }
                else
                {
                    <span>Gửi yêu cầu kiểm tra</span>
                }
            </button>

            @if (apiResult != null)
            {
                <div class="alert @(apiSuccess ? "alert-success" : "alert-danger") py-2 small">
                    <strong>@(apiSuccess ? "Thành công!" : "Thất bại:")</strong> @apiResult
                </div>
            }
        </div>
    </div>

    <div class="col-md-6">
        <div class="fit-card h-100">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <span>📡</span> SignalR Realtime Test
            </h5>

            <p class="small text-muted">
                <strong>Hub URL:</strong> <code>@Configuration["SignalR:NotificationHubUrl"]</code><br />
                <strong>Trạng thái:</strong> 
                <span class="badge @(NotificationHub.IsConnected ? "bg-success" : "bg-secondary")">
                    @(NotificationHub.IsConnected ? "Đã kết nối" : "Chưa kết nối")
                </span>
            </p>

            <button class="btn btn-sm btn-fit-outline mb-3" @onclick="TestSignalRConnection" disabled="@isTestingSignalR">
                @if (isTestingSignalR)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Đang kết nối...</span>
                }
                else
                {
                    <span>Kết nối thử Hub</span>
                }
            </button>

            @if (signalRResult != null)
            {
                <div class="alert @(signalRSuccess ? "alert-success" : "alert-warning") py-2 small">
                    @signalRResult
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isTestingApi = false;
    private bool apiSuccess = false;
    private string? apiResult;

    private bool isTestingSignalR = false;
    private bool signalRSuccess = false;
    private string? signalRResult;

    private async Task SimulateRole(string role)
    {
        // Tạo JWT payload giả lập để test Claims và Roles
        var header = Convert.ToBase64String(Encoding.UTF8.GetBytes("{\"alg\":\"HS256\",\"typ\":\"JWT\"}")).TrimEnd('=');
        var payloadObj = new Dictionary<string, object>
        {
            { "name", $"User ({AppRoles.GetDisplayName(role)})" },
            { "email", $"{role.ToLower()}@fitsocial.vn" },
            { "role", role },
            { "sub", Guid.NewGuid().ToString() },
            { "exp", DateTimeOffset.UtcNow.AddHours(8).ToUnixTimeSeconds() }
        };
        var payloadJson = JsonSerializer.Serialize(payloadObj);
        var payload = Convert.ToBase64String(Encoding.UTF8.GetBytes(payloadJson)).TrimEnd('=');
        var dummyToken = $"{header}.{payload}.demo_signature";

        await LocalStorage.SetItemAsync("authToken", dummyToken);
        ((CustomAuthenticationStateProvider)AuthStateProvider).NotifyUserAuthentication(dummyToken);
    }

    private async Task SimulateLogout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        ((CustomAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
    }

    private async Task TestApiConnection()
    {
        isTestingApi = true;
        apiResult = null;

        try
        {
            var response = await ApiClient.GetAsync<object>("weatherforecast");
            if (response.Success)
            {
                apiSuccess = true;
                apiResult = "Kết nối thành công đến FitSocial.API! Dữ liệu phản hồi hợp lệ.";
            }
            else
            {
                apiSuccess = false;
                apiResult = $"Không thể kết nối hoặc API trả về lỗi: {response.Message}. Hãy kiểm tra Backend đã bật và cấu hình CORS.";
            }
        }
        catch (Exception ex)
        {
            apiSuccess = false;
            apiResult = $"Lỗi ngoại lệ: {ex.Message}";
        }
        finally
        {
            isTestingApi = false;
        }
    }

    private async Task TestSignalRConnection()
    {
        isTestingSignalR = true;
        signalRResult = null;

        try
        {
            await NotificationHub.StartAsync();
            if (NotificationHub.IsConnected)
            {
                signalRSuccess = true;
                signalRResult = "Kết nối SignalR NotificationHub thành công!";
            }
            else
            {
                signalRSuccess = false;
                signalRResult = "Không thể kết nối đến Hub. Backend có thể chưa khởi động Hub.";
            }
        }
        catch (Exception ex)
        {
            signalRSuccess = false;
            signalRResult = $"Lỗi kết nối Hub: {ex.Message}";
        }
        finally
        {
            isTestingSignalR = false;
        }
    }
}

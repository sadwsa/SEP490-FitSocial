                </div>

                <div class="p-4 bg-gray-50 border-t border-gray-100 flex items-center justify-end gap-2">
                    <button type="button" @onclick="CloseSubmitProofModal" disabled="@isSubmittingProof" class="px-4 py-2 bg-gray-200 text-gray-700 font-bold rounded-xl text-xs hover:bg-gray-300 transition cursor-pointer">
                        Cancel

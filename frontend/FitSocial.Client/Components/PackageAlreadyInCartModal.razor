@inject NavigationManager Navigation

@if (IsOpen)
{
    <div class="fixed inset-0 z-[200] flex items-center justify-center p-4 overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black/60 backdrop-blur-xs transition-opacity animate-in fade-in duration-200"
             @onclick="HandleClose" aria-hidden="true"></div>

        <!-- Modal Dialog Card -->
        <div class="relative bg-white rounded-3xl shadow-2xl max-w-md w-full p-6 sm:p-8 text-center border border-gray-100 transform transition-all animate-in fade-in zoom-in-95 duration-200 z-10">
            <!-- Close Button (X) -->
            <button type="button"
                    @onclick="HandleClose"
                    class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 hover:bg-gray-100 p-2 rounded-full transition cursor-pointer"
                    aria-label="Close modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <!-- Warning / Cart Icon Header -->
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-amber-500/20 to-orange-500/10 border border-amber-200 text-[#EA580C] flex items-center justify-center mx-auto mb-5 shadow-xs">
                <div class="relative">
                    <svg class="w-8 h-8 text-[#EA580C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                    </svg>
                    <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-[#EA580C] text-[9px] text-white font-bold items-center justify-center">!</span>
                    </span>
                </div>
            </div>

            <!-- Title -->
            <h3 id="modal-title" class="text-xl font-black text-gray-900 tracking-tight mb-2">
                Package Already in Cart
            </h3>

            <!-- Message Body in English -->
            <div class="space-y-3 mb-6">
                <p class="text-sm text-gray-600 leading-relaxed">
                    @if (!string.IsNullOrWhiteSpace(PackageTitle))
                    {
                        <span>The package <strong class="text-gray-900 font-semibold">"@PackageTitle"</strong> is already in your shopping cart.</span>
                    }
                    else
                    {
                        <span>This training package is already in your shopping cart.</span>
                    }
                </p>

                <div class="bg-amber-50/80 border border-amber-200/70 rounded-2xl p-3.5 text-left text-xs text-amber-900 flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-[#EA580C] mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                    </svg>
                    <div class="space-y-1">
                        <p class="font-bold text-[#C2410C]">Single Trainee Policy</p>
                        <p class="text-amber-800 leading-relaxed">
                            Each 1-on-1 coaching package applies to a single trainee (maximum quantity: 1). You can still add other different packages to your cart.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col-reverse sm:flex-row items-center gap-3">
                <button type="button"
                        @onclick="HandleClose"
                        class="w-full sm:flex-1 py-3 px-4 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-sm rounded-xl transition duration-150 cursor-pointer">
                    Continue Browsing
                </button>
                <button type="button"
                        @onclick="HandleViewCart"
                        class="w-full sm:flex-1 py-3 px-4 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] hover:from-[#EA580C] hover:to-[#EA580C] text-white font-bold text-sm rounded-xl shadow-md shadow-orange-500/20 hover:shadow-orange-500/30 transition duration-150 flex items-center justify-center gap-2 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                    </svg>
                    <span>View Cart</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string? PackageTitle { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnViewCart { get; set; }

    private async Task HandleClose()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task HandleViewCart()
    {
        if (OnViewCart.HasDelegate)
        {
            await OnViewCart.InvokeAsync();
        }
        else
        {
            Navigation.NavigateTo("cart");
        }
    }
}

@page "/login"
@implements IDisposable
@inject IAuthService AuthService
@inject GoogleSignInService GoogleSignIn
@inject NavigationManager Navigation

<PageTitle>Đăng nhập - FitSocial</PageTitle>

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-4">
        <div class="fit-card p-4">
            <div class="text-center mb-4">
                <span class="fs-1">🏋️</span>
                <h4 class="fw-bold mt-2">Chào mừng trở lại!</h4>
                <p class="text-muted small">Đăng nhập để tiếp tục hành trình tập luyện</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 small" role="alert">
                    @errorMessage
                </div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Email</label>
                    <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="vidu@fitsocial.vn" />
                    <ValidationMessage For="@(() => loginModel.Email)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Mật khẩu</label>
                    <InputText type="password" @bind-Value="loginModel.Password" class="form-control" placeholder="••••••••" />
                    <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small" />
                </div>

                <button type="submit" class="btn-fit-primary w-100 justify-content-center py-2 mt-2" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Đang xử lý...</span>
                    }
                    else
                    {
                        <span>Đăng nhập</span>
                    }
                </button>
            </EditForm>

            <div class="d-flex align-items-center my-3">
                <hr class="flex-grow-1" />
                <span class="px-2 text-muted small">HOẶC</span>
                <hr class="flex-grow-1" />
            </div>

            @if (GoogleSignIn.IsConfigured && googleButtonOk)
            {
                <div id="google-login-btn" class="d-flex justify-content-center"></div>
            }
            else
            {
                <div class="alert alert-secondary py-2 small text-center mb-0">
                    @(GoogleSignIn.IsConfigured
                        ? "Không tải được nút Google. Hãy bấm Ctrl+F5 tải lại trang."
                        : "Đăng nhập Google chưa được cấu hình.")
                </div>
            }

            <div class="text-center mt-4 pt-3 border-top small text-muted">
                Chưa có tài khoản? <a href="register" class="fw-bold text-decoration-none">Đăng ký ngay</a>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequest loginModel = new();
    private string? errorMessage;
    private bool isLoading = false;
    private bool googleButtonOk = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && GoogleSignIn.IsConfigured)
        {
            GoogleSignIn.OnCredential += HandleGoogleCredentialAsync;
            googleButtonOk = await GoogleSignIn.RenderButtonAsync("google-login-btn", "signin_with");
            StateHasChanged();
        }
    }

    private async Task HandleGoogleCredentialAsync(string idToken)
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        var result = await AuthService.LoginWithGoogleAsync(idToken);
        if (result.Success)
        {
            Navigation.NavigateTo("");
        }
        else
        {
            errorMessage = result.Message ?? "Đăng nhập Google thất bại. Vui lòng thử lại.";
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;

        var result = await AuthService.LoginAsync(loginModel);
        if (result.Success)
        {
            Navigation.NavigateTo("");
        }
        else
        {
            errorMessage = result.Message ?? "Đăng nhập thất bại. Vui lòng kiểm tra lại thông tin.";
        }

        isLoading = false;
    }

    public void Dispose()
    {
        GoogleSignIn.OnCredential -= HandleGoogleCredentialAsync;
    }
}

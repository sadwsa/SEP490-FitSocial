@namespace FitSocial.Client.Components.Posts
<article class="bg-white rounded-xl shadow-sm p-4 transition hover:shadow-md w-full min-w-0">
    <div class="flex justify-between items-center mb-3">
        <div class="flex items-center gap-3">
            <div class="relative w-10 h-10 flex-shrink-0">
                @if (HasValidAvatarUrl(Post.AuthorAvatarUrl))
                {
                    <img src="@Post.AuthorAvatarUrl" alt=""
                         class="w-10 h-10 rounded-full object-cover border border-gray-100 flex-shrink-0"
                         onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                    <div class="w-10 h-10 rounded-full bg-gradient-to-r from-orange-400 to-amber-500 items-center justify-center text-white font-bold text-sm flex-shrink-0 select-none shadow-xs"
                         style="display: none;">
                        @GetAuthorInitial(Post.AuthorName)
                    </div>
                }
                else
                {
                    <div class="w-10 h-10 rounded-full bg-gradient-to-r from-orange-400 to-amber-500 flex items-center justify-center text-white font-bold text-sm flex-shrink-0 select-none shadow-xs">
                        @GetAuthorInitial(Post.AuthorName)
                    </div>
                }
            </div>
            <div>
                <h3 class="font-bold text-gray-900 text-sm">@(Post.AuthorName ?? "FitSocial Athlete")</h3>
                <!-- Post Metadata -->
                <div class="flex items-center gap-1.5 text-xs text-gray-500 flex-wrap">
                    <span>@GetTimeAgo(Post.CreatedAt)</span>
                    @if (!string.IsNullOrWhiteSpace(Post.PostType))
                    {
                        <span>&bull;</span>
                        @if (Post.PostType.Equals("Find Coach", StringComparison.OrdinalIgnoreCase) || Post.PostType.Equals("FindCoach", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 font-semibold px-2 py-0.5 rounded-full border border-amber-200 text-[11px]">
                                <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                                Find Coach
                            </span>
                        }
                        else if (Post.PostType.Equals("Find Trainee", StringComparison.OrdinalIgnoreCase) || Post.PostType.Equals("FindTrainee", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 font-semibold px-2 py-0.5 rounded-full border border-emerald-200 text-[11px]">
                                <svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                                    </path>
                                </svg>
                                Find Trainee
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 bg-orange-50 text-[#FF5500] font-semibold px-2 py-0.5 rounded-full border border-orange-100 text-[11px]">
                                @Post.PostType
                            </span>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(Post.LocationName) || !string.IsNullOrWhiteSpace(Post.LocationAddress))
                    {
                        <span>&bull;</span>
                        <span class="flex items-center gap-0.5 text-gray-500 truncate max-w-[200px]"
                              title="@(Post.LocationName ?? Post.LocationAddress)">
                            <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none"
                                 stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                </path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            @(Post.LocationName ?? Post.LocationAddress)
                        </span>
                    }
                </div>
            </div>
        </div>
        <div class="relative">
            <button type="button" @onclick:stopPropagation="true" @onclick="ToggleMenu"
                    class="text-gray-400 hover:text-gray-600 p-1.5 rounded-full hover:bg-gray-100 transition cursor-pointer" title="Options">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM18 10a2 2 0 11-4 0 2 2 0 014 0z">
                    </path>
                </svg>
            </button>
            @if (isMenuOpen)
            {
                <div class="absolute right-0 mt-1 w-44 bg-white rounded-xl shadow-lg border border-gray-100 py-1.5 z-20 animate-in fade-in zoom-in-95 duration-100"
                     @onclick:stopPropagation="true">
                    @if (IsOwnPost)
                    {
                        <button type="button" @onclick="HandleEdit"
                                class="w-full px-4 py-2 text-left text-xs font-medium text-gray-700 hover:bg-orange-50 hover:text-[#FF5500] flex items-center gap-2.5 transition cursor-pointer">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                            <span>Edit Post</span>
                        </button>
                        <button type="button" @onclick="HandleDelete"
                                class="w-full px-4 py-2 text-left text-xs font-medium text-red-600 hover:bg-red-50 flex items-center gap-2.5 transition cursor-pointer">
                            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                            <span>Delete Post</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="HandleReport"
                                class="w-full px-4 py-2 text-left text-xs font-medium text-gray-700 hover:bg-gray-50 flex items-center gap-2.5 transition cursor-pointer">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                            </svg>
                            <span>Report Post</span>
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Post.Content))
    {
        <p class="post-content-text text-gray-800 text-sm mb-3 leading-relaxed break-words">@Post.Content</p>
    }

    <!-- Post Media Slider -->
    <PostMediaSlider @key="@GetPostMediaKey(Post)" Media="@Post.Media" />

    <!-- Engagement Stats -->
    @if (Post.LikeCount > 0 || Post.CommentCount > 0)
    {
        <div class="flex justify-between items-center text-gray-500 text-xs py-2 border-b border-gray-100 mb-1">
            <div>
                @if (Post.LikeCount > 0)
                {
                    <span class="flex items-center gap-1 text-[#FF5500] font-medium">
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                        </svg>
                        @Post.LikeCount @(Post.LikeCount == 1 ? "Reaction" : "Reactions")
                    </span>
                }
            </div>
            <div>
                @if (Post.CommentCount > 0)
                {
                    <span>@Post.CommentCount @(Post.CommentCount == 1 ? "Comment" : "Comments")</span>
                }
            </div>
        </div>
    }

    <!-- Post Action Buttons -->
    <div class="flex gap-2 pt-1 @(Post.LikeCount == 0 && Post.CommentCount == 0 ? "border-t border-gray-100 pt-2" : "")">
        <button type="button" @onclick="HandleLike"
                class="flex-1 py-1.5 hover:bg-orange-50 rounded-lg font-medium text-sm flex items-center justify-center gap-2 transition group @(Post.IsLikedByCurrentUser ? "text-[#FF5500]" : "text-gray-600 hover:text-[#FF5500]")">
            <svg class="w-5 h-5 transition-colors @(Post.IsLikedByCurrentUser ? "fill-[#FF5500] text-[#FF5500]" : "text-gray-500 group-hover:text-[#FF5500]")"
                 fill="@(Post.IsLikedByCurrentUser ? "currentColor" : "none")" stroke="currentColor"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                </path>
            </svg>
            <span>@(Post.IsLikedByCurrentUser ? "Liked" : "React")</span>
        </button>
        <button type="button" @onclick="HandleComment"
                class="flex-1 py-1.5 hover:bg-orange-50 rounded-lg font-medium text-gray-600 hover:text-[#FF5500] text-sm flex items-center justify-center gap-2 transition">
            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z">
                </path>
            </svg>
            <span>Comment</span>
        </button>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public PostDto Post { get; set; } = default!;

    [Parameter]
    public Guid? CurrentUserId { get; set; }

    [Parameter]
    public EventCallback<PostDto> OnLike { get; set; }

    [Parameter]
    public EventCallback<PostDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<PostDto> OnDelete { get; set; }

    [Parameter]
    public EventCallback<Guid> OnReport { get; set; }

    [Parameter]
    public EventCallback<PostDto> OnComment { get; set; }

    private bool isMenuOpen = false;

    private bool IsOwnPost => CurrentUserId.HasValue && Post.AuthorId == CurrentUserId.Value;

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private async Task HandleLike()
    {
        if (OnLike.HasDelegate)
        {
            await OnLike.InvokeAsync(Post);
        }
    }

    private async Task HandleEdit()
    {
        isMenuOpen = false;
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(Post);
        }
    }

    private async Task HandleDelete()
    {
        isMenuOpen = false;
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(Post);
        }
    }

    private async Task HandleReport()
    {
        isMenuOpen = false;
        if (OnReport.HasDelegate)
        {
            await OnReport.InvokeAsync(Post.Id);
        }
    }

    private async Task HandleComment()
    {
        if (OnComment.HasDelegate)
        {
            await OnComment.InvokeAsync(Post);
        }
    }

    private static string GetPostMediaKey(PostDto post)
    {
        var mediaSignature = post.Media != null && post.Media.Any()
            ? string.Join("-", post.Media.Select(m => $"{m.Id}_{m.MediaUrl}"))
            : "empty";
        return $"slider-{post.Id}-{post.UpdatedAt?.Ticks ?? 0}-{post.Media?.Count ?? 0}-{mediaSignature}";
    }

    private static string GetTimeAgo(DateTime? date)
    {
        if (!date.HasValue) return "Just now";

        var timeSpan = DateTime.UtcNow - date.Value;
        if (timeSpan.TotalMinutes < 1) return "Just now";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays}d ago";

        return date.Value.ToLocalTime().ToString("MMM dd, yyyy");
    }
    private static string GetAuthorInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var trimmed = name.Trim();
        return trimmed.Length > 0 ? char.ToUpperInvariant(trimmed[0]).ToString() : "U";
    }

    private static bool HasValidAvatarUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        var trimmed = url.Trim();
        if (trimmed.Equals("null", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Equals("undefined", StringComparison.OrdinalIgnoreCase) ||
            trimmed.Equals("none", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (Uri.TryCreate(trimmed, UriKind.Absolute, out var uriResult))
        {
            return uriResult.Scheme == Uri.UriSchemeHttp || uriResult.Scheme == Uri.UriSchemeHttps;
        }

        return trimmed.StartsWith('/') && !trimmed.StartsWith("//");
    }
}

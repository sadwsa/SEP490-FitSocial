@page "/connection-error"
@layout EmptyLayout
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Not Found - FitConnect</PageTitle>

<div class="min-h-screen flex flex-col items-center justify-center bg-gray-50 px-4">
    <img src="ERROR.png" alt="Error" class="max-w-xs w-full mb-6" />
    <h1 class="text-2xl font-bold text-gray-800 mb-4">Not Found</h1>
    <button type="button" @onclick="RetryAsync"
            class="px-6 py-2.5 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white text-sm font-bold rounded-xl shadow-md hover:shadow-lg transition cursor-pointer">
        Retry
    </button>
</div>

@code {
    private void RetryAsync()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }
}

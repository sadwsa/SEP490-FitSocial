@page "/profile"
@namespace FitSocial.Client.Pages
@layout EmptyLayout
@attribute [Authorize]

<PageTitle>My Profile - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <!-- Header / Navigation Bar -->
    <AppHeader SearchTerm="@headerSearchTerm" OnSearchInput="HandleHeaderSearchInput"
               OnSearchKeyUp="HandleHeaderSearchKeyUp" OnSearch="ExecuteHeaderSearch" OnClearSearch="ClearHeaderSearch"
               UserName="@headerUserName" UserInitials="@headerUserInitials" UserRole="@headerUserRole"
               UserAvatarUrl="@headerUserAvatarUrl" OnLogout="HandleLogout" />

    <style>
            @@media (min-width: 1024px) {
                .home-3col-layout {
                    display: grid !important;
                    grid-template-columns: minmax(18rem, 1fr) minmax(0, 42rem) minmax(18rem, 1fr) !important;
                    align-items: start !important;
                }

                .home-left-sidebar {
                    justify-self: start !important;
                }

                .home-center-feed {
                    justify-self: end !important;
                    width: 100% !important;
                    max-width: 42rem !important;
                    min-width: 0 !important;
                }

                .home-right-sidebar {
                    justify-self: center !important;
                }
            }
    </style>

    <!-- Main Content Layout -->
    <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">
        <!-- Left Sidebar -->
        <AppSidebar ActiveItem="profile" />

        <!-- Center Column -->
        <section class="home-center-feed w-full max-w-2xl flex flex-col gap-6 min-w-0 pb-12">

            @if (isLoading)
            {
                <!-- Loading Skeleton -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden animate-pulse">
                    <div class="h-28 bg-gradient-to-r from-orange-200 to-amber-200"></div>
                    <div class="px-6 pb-6 pt-0 relative flex flex-row items-end gap-4 sm:gap-6">
                        <div
                            class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-gray-200 border-4 border-white shadow-md flex-shrink-0 -mt-14 sm:-mt-16">
                        </div>
                        <div class="flex-1 space-y-2 pt-3 sm:pt-4 pb-1" style="text-align: left !important;">
                            <div class="h-6 sm:h-8 bg-gray-200 rounded w-48 mb-2"></div>
                            <div class="flex gap-2">
                                <div class="h-6 bg-gray-200 rounded-full w-20"></div>
                                <div class="h-6 bg-gray-200 rounded-full w-28"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-4 animate-pulse">
                    <div class="h-5 bg-gray-200 rounded w-40"></div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                        <div class="h-16 bg-gray-100 rounded-xl"></div>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <!-- Error State -->
                <div
                    class="bg-white rounded-2xl shadow-sm border border-red-100 p-8 text-center flex flex-col items-center">
                    <div class="w-16 h-16 rounded-full bg-red-50 text-red-500 flex items-center justify-center mb-4">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <h2 class="text-xl font-bold text-gray-900 mb-2">Unable to Load Profile</h2>
                    <p class="text-gray-600 text-sm max-w-md mb-6">@errorMessage</p>

                    @if (isUnauthorized)
                    {
                        <button type="button" @onclick="GoToLogin"
                                class="px-6 py-2.5 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white font-semibold text-sm rounded-xl shadow-md hover:shadow-lg transition cursor-pointer">
                            Sign In Again
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="LoadProfileAsync"
                                class="px-6 py-2.5 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white font-semibold text-sm rounded-xl shadow-md hover:shadow-lg transition cursor-pointer">
                            Try Again
                        </button>
                    }
                </div>
            }
            else if (profile != null)
            {
                <!-- Profile Header Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <!-- Banner -->
                    <div class="h-28 sm:h-32 bg-gradient-to-r from-[#FF8C00] via-[#FF5500] to-[#FF3B00] relative">
                        <div class="absolute inset-0 bg-black/10"></div>
                    </div>

                    <!-- Avatar + Name + Role Header -->
                    <div class="px-6 pb-6 pt-0 relative flex flex-row items-end gap-4 sm:gap-6">
                        <!-- Avatar (negative margin on avatar only to overlap banner cleanly) -->
                        <div class="relative -mt-14 sm:-mt-16 flex-shrink-0">
                            @if (AvatarHelper.HasValidAvatarUrl(profile.AvatarUrl))
                            {
                                <img src="@profile.AvatarUrl" alt="@profile.FullName"
                                     class="w-24 h-24 sm:w-32 sm:h-32 rounded-full object-cover border-4 border-white shadow-lg bg-white"
                                     referrerpolicy="no-referrer"
                                     onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white items-center justify-center font-bold text-2xl sm:text-4xl border-4 border-white shadow-lg"
                                     style="display: none;">
                                    @AvatarHelper.GetInitials(profile.FullName)
                                </div>
                            }
                            else
                            {
                                <div
                                    class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold text-2xl sm:text-4xl border-4 border-white shadow-lg">
                                    @AvatarHelper.GetInitials(profile.FullName)
                                </div>
                            }
                        </div>

                        <!-- Name and Role Title (sits naturally in the white card with balanced padding & typography) -->
                        <div class="flex-1 min-w-0 pt-3 sm:pt-4 pb-1" style="text-align: left !important;">
                            <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold text-gray-900 truncate"
                                style="text-align: left !important; margin: 0 0 0.5rem 0; line-height: 1.25;">
                                @(string.IsNullOrWhiteSpace(profile.FullName) ? "Athlete" : profile.FullName)
                            </h1>

                            <div class="flex flex-wrap items-center gap-2 sm:gap-2.5"
                                 style="justify-content: flex-start !important; text-align: left !important;">
                                @if (profile.IsCoach)
                                {
                                    <span
                                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-orange-50 text-[#FF5500] border border-orange-200 shadow-2xs">
                                        <svg class="w-3.5 h-3.5 text-[#FF5500]" fill="currentColor" viewBox="0 0 20 20">
                                            <path
                                                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                        </svg>
                                        Coach
                                    </span>
                                }
                                else
                                {
                                    <span
                                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-2xs">
                                        <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                                                  clip-rule="evenodd" />
                                        </svg>
                                        Trainee
                                    </span>
                                }

                                @if (profile.CreatedAt.HasValue)
                                {
                                    <span
                                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-gray-50 text-gray-600 border border-gray-200 shadow-2xs">
                                        <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor"
                                             viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        Joined @profile.CreatedAt.Value.ToString("MMM yyyy")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Personal Information Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-7">
                    <div class="flex items-center gap-3 mb-5 pb-3 border-b border-gray-100">
                        <div
                            class="w-9 h-9 rounded-xl bg-orange-50 text-[#FF5500] flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-lg font-bold text-gray-900">Personal Information</h2>
                            <p class="text-xs text-gray-500">Account and contact details</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Email -->
                        <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                            <div
                                class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-medium text-gray-400">Email Address</p>
                                <p class="text-sm font-semibold text-gray-800 truncate mt-0.5" title="@profile.Email">
                                    @profile.Email</p>
                                </div>
                            </div>

                            <!-- Phone Number -->
                            <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                                <div
                                    class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-medium text-gray-400">Phone Number</p>
                                    <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                        @(string.IsNullOrWhiteSpace(profile.PhoneNumber) ? "Not provided" : profile.PhoneNumber)
                                    </p>
                                </div>
                            </div>

                            <!-- Date of Birth -->
                            <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                                <div
                                    class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-medium text-gray-400">Date of Birth</p>
                                    <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                        @(profile.DateOfBirth.HasValue ? profile.DateOfBirth.Value.ToString("dd/MM/yyyy") : "Not specified")
                                    </p>
                                </div>
                            </div>
                            <!-- Gender -->
                            <div class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3">
                                <div
                                    class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-medium text-gray-400">Gender</p>
                                    <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                        @(string.IsNullOrWhiteSpace(profile.Gender) ? "Not specified" : profile.Gender)
                                    </p>
                                </div>
                            </div>

                            <!-- Joined Date -->
                            <div
                                class="p-3.5 bg-gray-50/70 rounded-xl border border-gray-100 flex items-start gap-3 sm:col-span-2">
                                <div
                                    class="w-8 h-8 rounded-lg bg-white shadow-xs text-gray-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-medium text-gray-400">Member Since</p>
                                    <p class="text-sm font-semibold text-gray-800 mt-0.5">
                                        @(profile.CreatedAt.HasValue ? profile.CreatedAt.Value.ToString("MMMM dd, yyyy") :
                                    "N/A")
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (profile.IsCoach)
                    {
                        <!-- Coach-Specific Information Card -->
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-7">
                            <div class="flex items-center gap-3 mb-5 pb-3 border-b border-gray-100">
                                <div
                                    class="w-9 h-9 rounded-xl bg-orange-50 text-[#FF5500] flex items-center justify-center flex-shrink-0">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                                    </svg>
                                </div>
                                <div>
                                    <h2 class="text-lg font-bold text-gray-900">Coach Information</h2>
                                    <p class="text-xs text-gray-500">Coaching credentials and biography</p>
                                </div>
                            </div>

                            <!-- Highlights Row -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                                <!-- Experience Years -->
                                <div class="p-4 bg-orange-50/60 rounded-xl border border-orange-100/80 flex items-center gap-4">
                                    <div
                                        class="w-12 h-12 rounded-xl bg-white text-[#FF5500] flex items-center justify-center font-extrabold text-xl shadow-xs">
                                        @(profile.ExperienceYears ?? 0)
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-gray-900">Years of Experience</p>
                                        <p class="text-xs text-gray-500">Professional fitness coaching</p>
                                    </div>
                                </div>

                                <!-- Verification Approval Status -->
                                <div class="p-4 bg-gray-50 rounded-xl border border-gray-100 flex items-center justify-between">
                                    <div>
                                        <p class="text-sm font-bold text-gray-900">Verification Status</p>
                                        <p class="text-xs text-gray-500">Platform coach credentials</p>
                                    </div>
                                    <span
                                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold @GetApprovalBadgeClass(profile.ApprovalStatus)">
                                        @GetApprovalStatusLabel(profile.ApprovalStatus)
                                    </span>
                                </div>
                            </div>

                            <!-- Biography -->
                            <div>
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Biography</label>
                                @if (!string.IsNullOrWhiteSpace(profile.Bio))
                                {
                                    <div
                                        class="p-4 bg-gray-50/70 rounded-xl border border-gray-100 text-sm text-gray-700 leading-relaxed whitespace-pre-line">
                                        @profile.Bio
                                    </div>
                                }
                                else
                                {
                                    <div class="p-4 bg-gray-50/70 rounded-xl border border-gray-100 text-sm text-gray-400 italic">
                                        No biography provided yet.
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

            </section>

            <!-- Right Spacer (Empty to maintain 3-column balance on desktop) -->
            <div class="home-right-sidebar hidden lg:block w-72 flex-shrink-0"></div>
        </div>
    </div>

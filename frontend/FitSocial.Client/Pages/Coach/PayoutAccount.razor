@page "/coach/payout-account"
@layout EmptyLayout
@using FitSocial.Client.Layout
@using FitSocial.Client.Models.Coaches
@using FitSocial.Client.Services.Coaches
@using Microsoft.AspNetCore.Components.Authorization
@inject ICoachService CoachService
@inject AuthenticationStateProvider AuthStateProvider
@inject FitSocial.Client.Services.Auth.IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Payout Account - FitSocial Coach</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <AppHeader SearchTerm="@headerSearchTerm"
               UserName="@userName"
               UserInitials="@userInitials"
               UserRole="@userRole"
               OnLogout="HandleLogout" />

    <style>
        @@media (min-width: 1024px) {
            .home-3col-layout {
                display: grid !important;
                grid-template-columns: minmax(18rem, 1fr) minmax(0, 46rem) minmax(18rem, 1fr) !important;
                align-items: start !important;
            }

            .home-left-sidebar {
                justify-self: start !important;
            }

            .home-center-feed {
                justify-self: end !important;
                width: 100% !important;
                max-width: 46rem !important;
                min-width: 0 !important;
            }

            .home-right-sidebar {
                justify-self: center !important;
            }
        }
    </style>

    <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">
        <AppSidebar ActiveItem="payout-account" />

        <section class="home-center-feed w-full max-w-3xl flex flex-col gap-4 min-w-0 pb-10">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                <h1 class="text-xl font-bold text-gray-800">Payout Account</h1>
                <p class="text-xs text-gray-500 mt-0.5">Manage your bank account to receive payouts from FitSocial.</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm font-medium">@errorMessage</div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-600 px-4 py-3 rounded-xl text-sm font-medium">@successMessage</div>
            }

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                @if (isLoading)
                {
                    <div class="flex flex-col items-center justify-center py-10">
                        <div class="w-9 h-9 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-3"></div>
                        <p class="text-sm text-gray-500 font-medium">Loading your account details...</p>
                    </div>
                }
                else
                {
                    <h2 class="text-lg font-bold text-gray-800 mb-4">@(hasExistingAccount ? "Update Bank Account" : "Add Bank Account")</h2>
                    <EditForm Model="accountForm" OnValidSubmit="HandleSaveAccount">
                        <DataAnnotationsValidator />
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">Bank Name</label>
                                <InputText @bind-Value="accountForm.BankName" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF5500]" placeholder="e.g. Vietcombank" />
                                <ValidationMessage For="@(() => accountForm.BankName)" class="text-red-500 text-xs mt-1" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">Bank Code (BIN)</label>
                                <InputText @bind-Value="accountForm.BankCode" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF5500]" placeholder="e.g. VCB" />
                                <ValidationMessage For="@(() => accountForm.BankCode)" class="text-red-500 text-xs mt-1" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">Account Holder Name</label>
                                <InputText @bind-Value="accountForm.AccountName" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF5500] uppercase" placeholder="NGUYEN VAN A" />
                                <ValidationMessage For="@(() => accountForm.AccountName)" class="text-red-500 text-xs mt-1" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">Account Number</label>
                                <InputText @bind-Value="accountForm.AccountNumber" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#FF5500]" placeholder="Enter your account number" />
                                <ValidationMessage For="@(() => accountForm.AccountNumber)" class="text-red-500 text-xs mt-1" />
                            </div>
                        </div>
                        <div class="flex justify-end pt-2 border-t border-gray-100">
                            <button type="submit" disabled="@isSubmitting" class="px-5 py-2.5 bg-[#FF5500] text-white rounded-xl text-sm font-bold hover:bg-[#e04a00] transition disabled:opacity-50 flex items-center gap-2">
                                @if (isSubmitting)
                                {
                                    <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                }
                                @(hasExistingAccount ? "Save Changes" : "Save Account")
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </section>

        <aside class="home-right-sidebar hidden lg:flex w-72 flex-shrink-0 flex-col gap-4 sticky top-24"></aside>
    </div>
</div>

@code {
    private CreateCoachBankAccountDto accountForm = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool hasExistingAccount = false;
    private string errorMessage = "";
    private string successMessage = "";

    private string? headerSearchTerm = "";
    private string userName = "Coach";
    private string userInitials = "C";
    private string userRole = "Coach";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfoAsync();
        await LoadBankAccountAsync();
    }

    private async Task LoadBankAccountAsync()
    {
        isLoading = true;
        errorMessage = "";

        var response = await CoachService.GetBankAccountsAsync();
        if (response.Success && response.Data != null && response.Data.Any())
        {
            var existing = response.Data.First();
            hasExistingAccount = true;
            accountForm = new CreateCoachBankAccountDto
            {
                BankName = existing.BankName ?? "",
                BankCode = existing.BankCode ?? "",
                AccountName = existing.AccountName ?? "",
                AccountNumber = existing.AccountNumber ?? "",
                Branch = existing.Branch,
                IsDefault = true
            };
        }
        else
        {
            hasExistingAccount = false;
            accountForm = new CreateCoachBankAccountDto { IsDefault = true };
        }

        isLoading = false;
    }

    private async Task HandleSaveAccount()
    {
        isSubmitting = true;
        errorMessage = "";
        successMessage = "";

        var response = await CoachService.AddBankAccountAsync(accountForm);
        if (response.Success)
        {
            successMessage = hasExistingAccount ? "Bank account updated successfully!" : "Bank account added successfully!";
            hasExistingAccount = true;
        }
        else
        {
            errorMessage = response.Message ?? "Failed to save bank account.";
        }

        isSubmitting = false;
    }

    private async Task LoadUserInfoAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                userName = user.Identity.Name ?? "Coach";
                userRole = "Coach";
                var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 0)
                {
                    userInitials = parts.Length > 1
                        ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
                        : parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
                }
            }
        }
        catch { }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}

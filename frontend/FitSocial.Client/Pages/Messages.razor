{
    <div class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 animate-in fade-in"
         @onclick="CancelBlock">
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 max-w-sm w-full p-6 text-center animate-in zoom-in-95"
             @onclick:stopPropagation="true">

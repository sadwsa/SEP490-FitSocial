@page "/training-packages/workout/{OrderDetailsId:guid}"
@page "/workout-plan/{OrderDetailsId:guid}"
@layout EmptyLayout
@attribute [Authorize]
@inject FitSocial.Client.Services.TrainingPlans.ITrainingPlanClientService TrainingPlanService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@using FitSocial.Client.Layout
@using FitSocial.Client.Models.TrainingPlans

<PageTitle>@(workoutPlan?.PackageTitle ?? "Workout Hub") - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <AppHeader />

    <!-- Toast Notification -->
    @if (!string.IsNullOrWhiteSpace(toastMessage))
    {
        <div class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-emerald-600 text-white font-medium text-sm rounded-2xl shadow-xl transition-all duration-300 animate-in fade-in slide-in-from-top-4">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span>@toastMessage</span>
        </div>
    }

    <style>
        @@media (min-width: 1024px) {
            .workout-3col-layout {
                display: grid !important;
                grid-template-columns: minmax(18rem, 1fr) minmax(0, 68rem) minmax(0, 1fr) !important;
                align-items: start !important;
            }
            .workout-left-sidebar { justify-self: start !important; }
            .workout-main-content { justify-self: center !important; width: 100% !important; max-width: 68rem !important; }
        }
    </style>

    <div class="workout-3col-layout w-full pt-6 px-4 lg:px-8 flex flex-col items-start pb-20">
        <!-- Sidebar -->
        <AppSidebar ActiveItem="purchased-packages" Class="workout-left-sidebar" />

        <!-- Main Content -->
        <main class="workout-main-content w-full flex flex-col gap-6 min-w-0">
            <!-- Breadcrumb & Top Navigation -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <nav class="flex items-center gap-2 text-xs text-gray-500 font-medium">
                    <a href="/training-packages/purchased" class="hover:text-orange-600 transition flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        <span>Purchased Packages</span>
                    </a>
                    <span>/</span>
                    <span class="text-gray-800 font-bold truncate max-w-xs sm:max-w-md">@(workoutPlan?.PackageTitle ?? "Workout Hub")</span>
                </nav>

                <div class="flex items-center gap-2">
                    <span class="px-3.5 py-1.5 bg-[#FF5500] text-white text-xs font-bold rounded-xl shadow-xs flex items-center gap-1.5">
                        <span>Workout Hub</span>
                    </span>
                    <a href="/training-packages/meal-plan/@OrderDetailsId"
                       class="px-3.5 py-1.5 bg-white border border-gray-200 text-gray-600 text-xs font-semibold rounded-xl hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-200 transition shadow-2xs flex items-center gap-1.5">
                        <span>Meal Plan</span>
                    </a>
                    <a href="/training-packages/purchased" class="px-3.5 py-1.5 bg-white border border-gray-200 text-gray-700 text-xs font-semibold rounded-xl hover:bg-gray-50 transition shadow-2xs">
                        Back to List
                    </a>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="bg-white rounded-2xl p-16 shadow-xs border border-gray-100 flex flex-col items-center justify-center">
                    <div class="w-12 h-12 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-4"></div>
                    <p class="text-gray-500 font-medium text-base">Loading your workout program and progress...</p>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="bg-red-50 border border-red-200 rounded-2xl p-6 text-red-700 flex flex-col items-center gap-3 text-center">
                    <svg class="w-10 h-10 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                    </svg>
                    <p class="font-bold text-base">@errorMessage</p>
                    <button @onclick="LoadWorkoutPlanAsync" class="px-4 py-2 bg-red-600 text-white rounded-xl text-xs font-bold hover:bg-red-700 transition cursor-pointer">
                        Try Again
                    </button>
                </div>
            }
            else if (workoutPlan == null || workoutPlan.PlanStatus == "PENDING_COACH" || !workoutPlan.Weeks.Any())
            {
                <!-- Empty / Pending State -->
                <div class="bg-white rounded-2xl p-12 shadow-xs border border-gray-100 flex flex-col items-center text-center">
                    <div class="w-20 h-20 rounded-2xl bg-orange-50 border border-orange-100 text-[#FF5500] flex items-center justify-center mb-4">
                        <svg class="w-10 h-10 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                        </svg>
                    </div>
                    <span class="inline-block px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold rounded-full mb-2">
                        Plan In Preparation
                    </span>
                    <h2 class="text-xl font-black text-gray-900 mb-1">Coach is Designing Your Plan</h2>
                    <p class="text-sm text-gray-500 max-w-md mb-6 leading-relaxed">
                        Coach <strong class="text-gray-800">@(workoutPlan?.CoachName ?? "Your Coach")</strong> is formulating your weekly workout schedules and video tutorials. Please check back shortly!
                    </p>
                    <a href="/training-packages/purchased" class="px-5 py-2.5 bg-[#FF5500] hover:bg-orange-600 text-white font-bold text-xs rounded-xl shadow-xs transition">
                        Return to Purchased Packages
                    </a>
                </div>
            }
            else
            {
                <!-- BANNER: PROGRAM & TRAINING PROGRESS OVERVIEW (View Training Progress) -->
                <div class="bg-white rounded-2xl p-6 shadow-xs border border-gray-100">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-gray-100">
                        <div class="flex items-start gap-4">
                            @if (!string.IsNullOrWhiteSpace(workoutPlan.PackageThumbnailUrl))
                            {
                                <img src="@workoutPlan.PackageThumbnailUrl" alt="@workoutPlan.PackageTitle" class="w-20 h-20 rounded-2xl object-cover border border-gray-100 flex-shrink-0 shadow-xs" />
                            }
                            else
                            {
                                <div class="w-20 h-20 rounded-2xl bg-orange-50 text-[#FF5500] flex items-center justify-center flex-shrink-0 font-black text-xl border border-orange-100">
                                    FIT
                                </div>
                            }
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="px-2.5 py-0.5 text-[11px] font-bold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-100 uppercase tracking-wide">
                                        Enrolled Program
                                    </span>
                                    <span class="text-xs text-gray-400 flex items-center gap-1.5 flex-wrap">
                                        <span>Coach: <strong class="text-gray-700">@workoutPlan.CoachName</strong></span>
                                        @if (workoutPlan.CoachId != Guid.Empty)
                                        {
                                            <button type="button" @onclick="() => showReportCoachModal = true"
                                                    title="Report Coach"
                                                    class="px-2 py-0.5 text-[10px] text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition inline-flex items-center gap-1 cursor-pointer">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"></path></svg>
                                                <span>Report Coach</span>
                                            </button>
                                        }
                                    </span>
                                </div>
                                <h1 class="text-xl sm:text-2xl font-black text-gray-900 leading-snug">@workoutPlan.PackageTitle</h1>
                                <p class="text-xs sm:text-sm text-gray-500 mt-1 line-clamp-2">@workoutPlan.PlanTitle - @(string.IsNullOrWhiteSpace(workoutPlan.PlanDescription) ? "Follow your scheduled exercises and complete daily sessions." : workoutPlan.PlanDescription)</p>
                            </div>
                        </div>

                        <!-- Progress Summary Card -->
                        <div class="bg-gray-50 border border-gray-200/70 rounded-2xl p-4 flex items-center gap-5 md:min-w-[280px]">
                            <div class="relative w-16 h-16 flex-shrink-0 flex items-center justify-center">
                                <svg class="w-16 h-16 transform -rotate-90" viewBox="0 0 36 36">
                                    <path class="text-gray-200" stroke-width="3.5" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                    <path class="text-[#FF5500] transition-all duration-700 ease-out" stroke-dasharray="@($"{workoutPlan.ProgressPercentage}, 100")" stroke-width="3.5" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                </svg>
                                <span class="absolute font-black text-xs text-gray-800">@($"{workoutPlan.ProgressPercentage:N0}%")</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <span class="text-[10px] uppercase font-bold text-gray-400 block tracking-wider">Overall Progress</span>
                                <p class="text-sm font-black text-gray-900 mt-0.5">
                                    @workoutPlan.CompletedExercisesCount / @workoutPlan.TotalExercisesCount <span class="text-xs font-normal text-gray-500">Exercises Done</span>
                                </p>
                                <div class="w-full bg-gray-200 h-1.5 rounded-full overflow-hidden mt-1.5">
                                    <div class="bg-gradient-to-r from-orange-500 to-[#FF5500] h-full rounded-full transition-all duration-500" style="width: @($"{workoutPlan.ProgressPercentage}%")"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Week & Day Selectors -->
                    <div class="pt-5 flex flex-col gap-4">
                        <!-- 1. Week Selector Tabs -->
                        <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
                            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mr-2 flex-shrink-0">Weeks:</span>
                            @foreach (var week in workoutPlan.Weeks)
                            {
                                bool isSelectedWeek = week.WeekNumber == selectedWeekNumber;
                                <button type="button"
                                        @onclick="() => SelectWeek(week.WeekNumber)"
                                        class="px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 cursor-pointer whitespace-nowrap @(isSelectedWeek ? "bg-[#FF5500] text-white shadow-xs" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                                    <span>Week @week.WeekNumber</span>
                                    <span class="text-[10px] px-1.5 py-0.2 rounded-full @(isSelectedWeek ? "bg-white/20 text-white" : "bg-gray-200 text-gray-700")">
                                        @week.CompletedExercises/@week.TotalExercises
                                    </span>
                                </button>
                            }
                        </div>

                        <!-- 2. Day Selector Tabs -->
                        @if (CurrentWeek != null && CurrentWeek.Days.Any())
                        {
                            <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
                                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mr-2 flex-shrink-0">Days:</span>
                                @foreach (var day in CurrentWeek.Days)
                                {
                                    bool isSelectedDay = day.DayNumber == selectedDayNumber;
                                    <button type="button"
                                            @onclick="() => SelectDay(day.DayNumber)"
                                            class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-2 cursor-pointer whitespace-nowrap @(isSelectedDay ? "bg-gray-900 text-white shadow-xs" : "bg-gray-50 border border-gray-200 text-gray-600 hover:bg-gray-100")">
                                        @if (day.IsAllCompleted)
                                        {
                                            <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                        }
                                        <span>Day @day.DayNumber</span>
                                        <span class="text-[10px] opacity-75">(@day.CompletedExercises/@day.TotalExercises)</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- VIDEO TUTORIAL PLAYER SECTION (Khi bài tập có Video) -->
                @if (activeExercise != null && activeExercise.VideoTutorial != null && !string.IsNullOrWhiteSpace(activeExercise.VideoTutorial.VideoUrl))
                {
                    <div class="bg-gray-900 rounded-2xl overflow-hidden shadow-md border border-gray-800 text-white animate-in fade-in duration-300">
                        <div class="p-4 bg-gray-800/80 flex items-center justify-between border-b border-gray-700/60">
                            <div class="flex items-center gap-2.5">
                                <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
                                <span class="text-xs uppercase font-bold tracking-wider text-orange-400">Tutorial Video</span>
                                <span class="text-xs text-gray-300 font-semibold truncate max-w-sm sm:max-w-md">— @activeExercise.ExerciseName</span>
                            </div>
                            <button type="button" @onclick="() => activeExercise = null" class="text-gray-400 hover:text-white text-xs cursor-pointer">
                                Close Video &times;
                            </button>
                        </div>

                        <div class="w-full aspect-video bg-black max-h-[420px] flex items-center justify-center">
                            @{
                                var embedUrl = GetEmbedVideoUrl(activeExercise.VideoTutorial.VideoUrl);
                            }
                            @if (IsYoutubeUrl(activeExercise.VideoTutorial.VideoUrl))
                            {
                                <iframe src="@embedUrl"
                                        title="@activeExercise.VideoTutorial.Title"
                                        class="w-full h-full border-0"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen>
                                </iframe>
                            }
                            else
                            {
                                <video controls src="@activeExercise.VideoTutorial.VideoUrl" class="w-full h-full object-contain">
                                    Your browser does not support the video tag.
                                </video>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(activeExercise.VideoTutorial.Description))
                        {
                            <div class="p-3 bg-gray-800 text-xs text-gray-300 border-t border-gray-700/60">
                                <p><strong class="text-white">Coach Note:</strong> @activeExercise.VideoTutorial.Description</p>
                            </div>
                        }
                    </div>
                }

                <!-- EXERCISES LIST FOR SELECTED DAY -->
                <div class="bg-white rounded-2xl shadow-xs border border-gray-100 overflow-hidden">
                    <div class="p-5 border-b border-gray-100 flex items-center justify-between">
                        <div>
                            <h2 class="text-lg font-black text-gray-900">
                                Week @selectedWeekNumber — Day @selectedDayNumber Exercises
                            </h2>
                            <p class="text-xs text-gray-500 mt-0.5">
                                Follow each workout's specifications. Tap "Complete" after finishing each exercise.
                            </p>
                        </div>
                        <span class="text-xs font-bold text-gray-500 bg-gray-100 px-3 py-1.5 rounded-xl">
                            @(CurrentDay?.CompletedExercises ?? 0) / @(CurrentDay?.TotalExercises ?? 0) Completed
                        </span>
                    </div>

                    @if (CurrentDay == null || !CurrentDay.Exercises.Any())
                    {
                        <div class="p-12 text-center text-gray-400 text-sm">
                            No exercises scheduled for this day. Rest and recover!
                        </div>
                    }
                    else
                    {
                        <div class="divide-y divide-gray-100">
                            @foreach (var ex in CurrentDay.Exercises)
                            {
                                <div class="p-5 hover:bg-gray-50/60 transition flex flex-col md:flex-row md:items-center justify-between gap-5 @(ex.IsCompleted ? "bg-emerald-50/20" : "")">
                                    <!-- Exercise Specs -->
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2.5 mb-1.5 flex-wrap">
                                            <h3 class="text-base font-bold text-gray-900 @(ex.IsCompleted ? "line-through text-gray-500" : "")">
                                                @ex.ExerciseName
                                            </h3>
                                            @if (ex.IsCompleted)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                                                    <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                                    Completed
                                                </span>
                                            }
                                        </div>

                                        <!-- Specifications Badges (Sets, Reps, Rest, Duration) -->
                                        <div class="flex flex-wrap items-center gap-2 mb-2 text-xs">
                                            @if (ex.Sets.HasValue)
                                            {
                                                <span class="bg-gray-100 text-gray-700 px-2.5 py-1 rounded-lg font-bold border border-gray-200/60">
                                                    @ex.Sets Sets
                                                </span>
                                            }
                                            @if (ex.Reps.HasValue)
                                            {
                                                <span class="bg-orange-50 text-[#FF5500] px-2.5 py-1 rounded-lg font-bold border border-orange-100">
                                                    @ex.Reps Reps / Set
                                                </span>
                                            }
                                            @if (ex.RestSeconds.HasValue)
                                            {
                                                <span class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded-lg font-medium border border-blue-100">
                                                    @ex.RestSeconds s Rest
                                                </span>
                                            }
                                            @if (ex.DurationMinutes.HasValue)
                                            {
                                                <span class="bg-purple-50 text-purple-700 px-2.5 py-1 rounded-lg font-medium border border-purple-100">
                                                    @ex.DurationMinutes mins
                                                </span>
                                            }
                                        </div>

                                        <!-- Notes by Coach -->
                                        @if (!string.IsNullOrWhiteSpace(ex.Notes))
                                        {
                                            <p class="text-xs text-gray-500 italic bg-gray-50 p-2.5 rounded-xl border border-gray-100 mb-2">
                                                <strong class="text-gray-700 font-semibold">Coach Instruction:</strong> @ex.Notes
                                            </p>
                                        }

                                        <!-- Trainee Notes (if logged) -->
                                        @if (!string.IsNullOrWhiteSpace(ex.TraineeNotes))
                                        {
                                            <p class="text-xs text-emerald-700 bg-emerald-50/70 p-2 rounded-lg border border-emerald-100">
                                                <strong class="font-semibold">Your Note:</strong> @ex.TraineeNotes
                                            </p>
                                        }
                                    </div>

                                    <!-- Actions: Watch Video Tutorial & Complete Workout -->
                                    <div class="flex items-center gap-3 flex-shrink-0 self-start md:self-center">
                                        <!-- Watch Tutorial Video Button -->
                                        @if (ex.VideoTutorial != null && !string.IsNullOrWhiteSpace(ex.VideoTutorial.VideoUrl))
                                        {
                                            <button type="button"
                                                    @onclick="() => SetActiveVideo(ex)"
                                                    class="px-3.5 py-2 rounded-xl text-xs font-bold border transition flex items-center gap-1.5 cursor-pointer @(activeExercise?.TrainingPlanExerciseId == ex.TrainingPlanExerciseId ? "bg-orange-50 text-[#FF5500] border-orange-200" : "bg-white border-gray-200 text-gray-700 hover:bg-gray-50")">
                                                <svg class="w-4 h-4 text-red-500 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path></svg>
                                                <span>Watch Video</span>
                                            </button>
                                        }

                                        <!-- Complete Workout Button (Mark Daily Workout) - One-way only -->
                                        @if (ex.IsCompleted)
                                        {
                                            <span class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-100 text-emerald-700 border border-emerald-200 flex items-center gap-1.5 select-none">
                                                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    disabled="@(togglingExerciseId == ex.TrainingPlanExerciseId)"
                                                    @onclick="() => HandleMarkComplete(ex)"
                                                    class="px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-xs bg-[#FF5500] hover:bg-orange-600 text-white disabled:opacity-50">
                                                @if (togglingExerciseId == ex.TrainingPlanExerciseId)
                                                {
                                                    <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                                }
                                                else
                                                {
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                    <span>Complete</span>
                                                }
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </main>
    </div>

    @if (showReportCoachModal && workoutPlan != null && workoutPlan.CoachId != Guid.Empty)
    {
        <ReportUserModal IsVisible="@showReportCoachModal"
                         ReportedUserId="@workoutPlan.CoachId"
                         ReportedUserName="@workoutPlan.CoachName"
                         IsCoach="true"
                         PackageContext="@workoutPlan.PackageTitle"
                         OnClose="() => showReportCoachModal = false"
                         OnReportSubmitted="HandleCoachReportSubmitted" />
    }
</div>

@code {
    [Parameter]
    public Guid OrderDetailsId { get; set; }

    private TraineeWorkoutPlanProgressDto? workoutPlan;
    private bool isLoading = true;
    private string? errorMessage;
    private string? toastMessage;
    private bool showReportCoachModal = false;

    private short selectedWeekNumber = 1;
    private short selectedDayNumber = 1;
    private TraineeWorkoutExerciseDto? activeExercise;
    private Guid? togglingExerciseId;

    private TraineeWorkoutWeekDto? CurrentWeek =>
        workoutPlan?.Weeks.FirstOrDefault(w => w.WeekNumber == selectedWeekNumber)
        ?? workoutPlan?.Weeks.FirstOrDefault();

    private TraineeWorkoutDayDto? CurrentDay =>
        CurrentWeek?.Days.FirstOrDefault(d => d.DayNumber == selectedDayNumber)
        ?? CurrentWeek?.Days.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkoutPlanAsync();
    }

    private async Task LoadWorkoutPlanAsync()
    {
        isLoading = true;
        errorMessage = null;

        var res = await TrainingPlanService.GetTraineeWorkoutPlanAsync(OrderDetailsId);
        if (res.Success && res.Data != null)
        {
            workoutPlan = res.Data;
            if (workoutPlan.Weeks.Any())
            {
                selectedWeekNumber = workoutPlan.Weeks.First().WeekNumber;
                if (workoutPlan.Weeks.First().Days.Any())
                {
                    selectedDayNumber = workoutPlan.Weeks.First().Days.First().DayNumber;
                }
            }
        }
        else
        {
            errorMessage = res.Message ?? "Failed to load workout plan.";
        }

        isLoading = false;
    }

    private void SelectWeek(short weekNumber)
    {
        selectedWeekNumber = weekNumber;
        var week = workoutPlan?.Weeks.FirstOrDefault(w => w.WeekNumber == weekNumber);
        if (week != null && week.Days.Any())
        {
            selectedDayNumber = week.Days.First().DayNumber;
        }
    }

    private void SelectDay(short dayNumber)
    {
        selectedDayNumber = dayNumber;
    }

    private void SetActiveVideo(TraineeWorkoutExerciseDto ex)
    {
        activeExercise = ex;
    }

    private async Task HandleMarkComplete(TraineeWorkoutExerciseDto ex)
    {
        if (ex.IsCompleted) return; // Already completed, do nothing

        togglingExerciseId = ex.TrainingPlanExerciseId;
        var dto = new ToggleWorkoutCompletionDto
        {
            TrainingPlanExerciseId = ex.TrainingPlanExerciseId,
            LogDate = DateTime.UtcNow,
            Status = "COMPLETED"
        };

        var res = await TrainingPlanService.ToggleWorkoutCompletionAsync(dto);
        if (res.Success && res.Data != null)
        {
            ex.IsCompleted = res.Data.IsCompleted;
            ex.WorkoutCompletionLogId = res.Data.WorkoutCompletionLogId;
            ex.CompletedAt = res.Data.CompletedAt;

            if (workoutPlan != null)
            {
                workoutPlan.TotalExercisesCount = res.Data.TotalExercisesCount;
                workoutPlan.CompletedExercisesCount = res.Data.CompletedExercisesCount;
            }

            // Recalculate day and week counts
            if (CurrentDay != null)
            {
                CurrentDay.CompletedExercises = CurrentDay.Exercises.Count(e => e.IsCompleted);
            }
            if (CurrentWeek != null)
            {
                CurrentWeek.CompletedExercises = CurrentWeek.Days.Sum(d => d.CompletedExercises);
            }

            ShowToast($"Great job! Completed {ex.ExerciseName}!");
        }
        else
        {
            ShowToast(res.Message ?? "Unable to update workout status.");
        }

        togglingExerciseId = null;
    }

    private void HandleCoachReportSubmitted(Guid coachId)
    {
        showReportCoachModal = false;
        ShowToast("Coach report submitted successfully. Our team will review it.");
    }

    private void ShowToast(string message)
    {
        toastMessage = message;
        StateHasChanged();
        _ = Task.Delay(3500).ContinueWith(_ =>
        {
            toastMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private bool IsYoutubeUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        return url.Contains("youtube.com") || url.Contains("youtu.be");
    }

    private string? GetEmbedVideoUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        url = url.Trim();
        if (url.Contains("youtube.com/watch?v="))
        {
            var id = url.Split("v=")[1].Split("&")[0];
            return $"https://www.youtube.com/embed/{id}";
        }
        if (url.Contains("youtu.be/"))
        {
            var id = url.Split("youtu.be/")[1].Split("?")[0];
            return $"https://www.youtube.com/embed/{id}";
        }
        return url;
    }

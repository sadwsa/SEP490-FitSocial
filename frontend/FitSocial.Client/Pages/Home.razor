@page "/home"
@namespace FitSocial.Client.Pages
@layout EmptyLayout
@attribute [Authorize(Roles = "TRAINEE,COACH")]
@implements IDisposable
@inject IPostService PostService
@inject ISportService SportService
@inject ILocationService LocationService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.Security.Claims
@using FitSocial.Client.Components.Posts

<PageTitle>Home Feed - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <!-- Floating Success Toast Notification -->
    @if (!string.IsNullOrWhiteSpace(toastSuccessMessage))
    {
        <div
            class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-emerald-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-emerald-500/50 backdrop-blur transition-all duration-300 animate-in fade-in slide-in-from-top-4">
            <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <span>@toastSuccessMessage</span>
            <button type="button" @onclick="DismissToast"
                    class="ml-2 text-white/80 hover:text-white text-lg font-bold transition cursor-pointer"
                    title="Close">&times;</button>
        </div>
    }

    <!-- 1. Header / Navigation Bar -->
    <header class="sticky top-0 z-50 bg-white shadow-sm h-16 flex items-center justify-between px-4 lg:px-10"
            style="display: flex !important; flex-direction: row !important; align-items: center !important; justify-content: space-between !important;">
        <div class="flex items-center gap-4 w-1/3">
            <!-- Brand Logo -->
            <a href="home" class="flex-shrink-0 flex items-center hover:opacity-95 transition" title="FitSocial Home">
                <img src="logo.jpg" alt="FitSocial"
                     class="h-11 w-11 object-cover rounded-xl shadow-sm hover:scale-105 transition-transform duration-200" />
            </a>
            <div class="hidden md:flex relative w-full max-w-sm">
                <input type="text" placeholder="Search posts, coaches, friends..." value="@searchTerm"
                       @oninput="HandleSearchInput" @onkeyup="HandleSearchKeyUp"
                       class="w-full bg-gray-100 rounded-full py-2 pl-4 pr-16 focus:outline-none focus:ring-2 focus:ring-[#FF5500] text-sm transition" />
                <div class="absolute right-2.5 top-2 flex items-center gap-1">
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="text-gray-400 hover:text-gray-600 p-0.5 rounded-full transition cursor-pointer"
                                @onclick="ClearSearch" title="Clear search">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    }
                    <button class="text-gray-400 hover:text-[#FF5500] p-0.5 rounded-full transition cursor-pointer"
                            @onclick="ExecuteSearch" title="Search">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 md:gap-4 w-1/3">
            <button class="relative p-2 text-gray-600 hover:bg-orange-50 rounded-full transition" title="Shopping Cart">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z">
                    </path>
                </svg>
                <span
                class="absolute top-1 right-1 bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white text-xs font-bold w-4 h-4 flex items-center justify-center rounded-full">2</span>
            </button>
            <button class="relative p-2 text-gray-600 hover:bg-orange-50 rounded-full transition" title="Messages">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z">
                    </path>
                </svg>
                <span
                class="absolute top-1 right-1 bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white text-xs font-bold w-4 h-4 flex items-center justify-center rounded-full">5</span>
            </button>
            <button class="relative p-2 text-gray-600 hover:bg-orange-50 rounded-full transition" title="Notifications">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                    </path>
                </svg>
                <span
                class="absolute top-1 right-1 bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white text-xs font-bold w-4 h-4 flex items-center justify-center rounded-full">9</span>
            </button>

            <!-- Profile Avatar & Dropdown -->
            <div class="relative">
                <button @onclick="ToggleProfileMenu"
                        class="w-9 h-9 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold ml-2 shadow-sm hover:opacity-90 transition cursor-pointer"
                        title="User Profile">
                    @userInitials
                </button>
                @if (showProfileMenu)
                {
                    <div
                        class="absolute right-0 mt-2 w-52 bg-white rounded-xl shadow-xl border border-gray-100 py-2 z-50 animate-in fade-in">
                        <div class="px-4 py-2 border-b border-gray-100">
                            <p class="text-sm font-semibold text-gray-900 truncate">@(string.IsNullOrWhiteSpace(userName) ?
                                                                                                                                                                    "User" : userName)</p>
                                <p class="text-xs text-[#FF5500] font-medium uppercase tracking-wider mt-0.5">
                                    @(string.IsNullOrWhiteSpace(userRole) ? "Athlete" : userRole)</p>
                                </div>
                                <a href="profile"
                                   class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-orange-50 hover:text-[#FF5500] transition">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                    My Profile
                                </a>
                                <a href="change-password"
                                   class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-orange-50 hover:text-[#FF5500] transition">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z">
                                        </path>
                                    </svg>
                                    Change Password
                                </a>
                                <hr class="my-1 border-gray-100" />
                                <button @onclick="HandleLogout"
                                        class="w-full flex items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition text-left">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                                        </path>
                                    </svg>
                                    Log Out
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </header>

            <style>
                    @@media (min-width: 1024px) {
                        .home-3col-layout {
                            display: grid !important;
                            grid-template-columns: minmax(18rem, 1fr) minmax(0, 42rem) minmax(18rem, 1fr) !important;
                            align-items: start !important;
                        }

                        .home-left-sidebar {
                            justify-self: start !important;
                        }

                        .home-center-feed {
                            justify-self: end !important;
                            width: 100% !important;
                            max-width: 42rem !important;
                            min-width: 0 !important;
                        }

                        .home-right-sidebar {
                            justify-self: center !important;
                        }
                    }

                    .post-content-text {
                        word-break: break-word;
                        overflow-wrap: anywhere;
                        word-wrap: break-word;
                        white-space: pre-line;
                    }
            </style>

            <!-- Main Content Layout (3-Column Horizontal Row) -->
            <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">

                <!-- Left Sidebar: Menu Navigation -->
                <aside class="home-left-sidebar hidden lg:block w-72 flex-shrink-0 sticky top-24">
                    <nav class="flex flex-col gap-1">
                        <a href="home"
                           class="p-3 bg-white rounded-xl shadow-sm font-semibold bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] bg-clip-text text-transparent flex items-center gap-3 border-l-4 border-[#FF5500]">
                            <svg class="w-5 h-5 text-[#FF5500]" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z">
                                </path>
                            </svg>
                            News Feed
                        </a>
                        <a href="community"
                           class="p-3 hover:bg-orange-50/60 rounded-xl font-medium text-gray-700 flex items-center gap-3 transition">
                            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
                                </path>
                            </svg>
                            Friends
                        </a>
                        <a href="workouts"
                           class="p-3 hover:bg-orange-50/60 rounded-xl font-medium text-gray-700 flex items-center gap-3 transition">
                            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                                </path>
                            </svg>
                            My Packages
                        </a>
                        <a href="community"
                           class="p-3 hover:bg-orange-50/60 rounded-xl font-medium text-gray-700 flex items-center gap-3 transition">
                            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                                </path>
                            </svg>
                            Coaches List
                        </a>
                    </nav>
                </aside>

                <!-- Center Column: Main Feed -->
                <section class="home-center-feed w-full max-w-2xl flex flex-col gap-4 min-w-0">

                    <!-- Create Post Box -->
                    <CreatePostBox UserInitials="@userInitials" IsCoach="@isCoach"
                                   OnOpen="HandleCreatePostBoxOpen" />

                    <!-- Filter Bar -->
                    <PostFilterBar TotalCount="@totalCount" SearchTerm="@searchTerm" SelectedPostType="@selectedPostType"
                                   SelectedSportId="@selectedFilterSportId" SelectedLocationId="@selectedFilterLocationId"
                                   AvailableSports="@availableSports" AvailableLocations="@availableLocations"
                                   OnApplyFilters="HandleApplyFilters" OnClearSearch="ClearSearch" OnResetAll="ResetAllSearchAndFilters" />

                    <!-- Feed Posts Stream -->
                    @if (isLoading)
                    {
                        <div class="flex flex-col gap-4">
                            @for (int i = 0; i < 2; i++)
                            {
                                <div class="bg-white rounded-xl shadow-sm p-4 animate-pulse">
                                    <div class="flex items-center gap-3 mb-4">
                                        <div class="w-10 h-10 rounded-full bg-gray-200"></div>
                                        <div class="flex-1 space-y-2">
                                            <div class="h-3.5 bg-gray-200 rounded w-1/4"></div>
                                            <div class="h-2.5 bg-gray-200 rounded w-1/3"></div>
                                        </div>
                                    </div>
                                    <div class="space-y-2 mb-4">
                                        <div class="h-3 bg-gray-200 rounded"></div>
                                        <div class="h-3 bg-gray-200 rounded w-5/6"></div>
                                    </div>
                                    <div class="h-48 bg-gray-100 rounded-lg mb-3"></div>
                                </div>
                            }
                        </div>
                    }
                    else if (posts == null || !posts.Any())
                    {
                        <div class="bg-white rounded-xl shadow-sm p-10 text-center text-gray-500">
                            <div class="w-16 h-16 mx-auto mb-3 text-orange-400">
                                <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                          d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z">
                                    </path>
                                </svg>
                            </div>
                            <h3 class="text-base font-bold text-gray-800 mb-1">No posts found</h3>
                            <p class="text-xs text-gray-400 mb-4">
                                @(HasActiveFilters || !string.IsNullOrWhiteSpace(searchTerm)
                                    ? "No posts match your search query or filter criteria. Try adjusting your search or filters."
                                    : "Be the first to share your workout journey today!")
                            </p>
                            @if (!string.IsNullOrWhiteSpace(searchTerm) || HasActiveFilters)
                            {
                                <button @onclick="ResetAllSearchAndFilters"
                                        class="inline-flex items-center gap-1.5 px-4 py-2 bg-orange-50 text-[#FF5500] hover:bg-orange-100 rounded-xl text-xs font-semibold transition cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                                        </path>
                                    </svg>
                                    Reset Search & Filters
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var post in posts)
                        {
                            <PostCard @key="post.Id" Post="post" CurrentUserId="currentUserId" OnLike="ToggleLike"
                                      OnEdit="OpenEditPostModal" OnDelete="OpenDeletePostModal" OnReport="HandleReportPost" />
                        }
                    }

                    <!-- Load More / Pagination -->
                    @if (hasNextPage)
                    {
                        <div class="flex justify-center pt-2 pb-4">
                            <button type="button" @onclick="LoadMorePostsAsync" disabled="@isLoadingMore"
                                    class="px-6 py-2.5 bg-white hover:bg-orange-50 text-gray-700 hover:text-[#FF5500] border border-gray-200 hover:border-orange-200 rounded-xl shadow-xs hover:shadow-sm font-semibold text-xs transition-all duration-150 flex items-center gap-2 cursor-pointer disabled:opacity-60">
                                @if (isLoadingMore)
                                {
                                    <span
                                    class="w-4 h-4 border-2 border-[#FF5500] border-t-transparent rounded-full animate-spin"></span>
                                    <span>Loading more posts...</span>
                                }
                                else
                                {
                                    <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                    <span>Load More Posts</span>
                                }
                            </button>
                        </div>
                    }

                </section>

                <!-- Right Sidebar: Widgets & Shortcuts -->
                <aside class="home-right-sidebar hidden lg:flex w-72 flex-shrink-0 flex-col gap-4 sticky top-24">

                    <!-- Top 5 Coaches Box -->
                    <div class="bg-white rounded-xl shadow-sm p-4">
                        <h3 class="font-bold text-gray-800 mb-3 text-sm flex items-center gap-2">
                            <svg class="w-5 h-5 text-[#FF8C00]" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z">
                                </path>
                            </svg>
                            Top 5 Coaches
                        </h3>
                        <div class="flex flex-col gap-4">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div
                                        class="w-8 h-8 rounded-full bg-purple-500 flex items-center justify-center text-white text-xs font-bold">
                                        D</div>
                                        <div>
                                            <h4 class="text-sm font-semibold text-gray-900">Coach Dat</h4>
                                            <p class="text-xs text-[#FF8C00]">⭐ 4.9</p>
                                        </div>
                                    </div>
                                    <a href="community"
                                       class="text-xs text-[#FF5500] font-semibold hover:bg-orange-50 px-3 py-1 rounded-lg border border-transparent hover:border-orange-200 transition">View</a>
                                </div>
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <div
                                            class="w-8 h-8 rounded-full bg-[#FF5500] flex items-center justify-center text-white text-xs font-bold">
                                            T</div>
                                            <div>
                                                <h4 class="text-sm font-semibold text-gray-900">Coach Tuan</h4>
                                                <p class="text-xs text-[#FF8C00]">⭐ 4.8</p>
                                            </div>
                                        </div>
                                        <a href="community"
                                           class="text-xs text-[#FF5500] font-semibold hover:bg-orange-50 px-3 py-1 rounded-lg border border-transparent hover:border-orange-200 transition">View</a>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <div
                                                class="w-8 h-8 rounded-full bg-emerald-500 flex items-center justify-center text-white text-xs font-bold">
                                                A</div>
                                                <div>
                                                    <h4 class="text-sm font-semibold text-gray-900">Coach Alex</h4>
                                                    <p class="text-xs text-[#FF8C00]">⭐ 5.0</p>
                                                </div>
                                            </div>
                                            <a href="community"
                                               class="text-xs text-[#FF5500] font-semibold hover:bg-orange-50 px-3 py-1 rounded-lg border border-transparent hover:border-orange-200 transition">View</a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Latest Workout Packages Box -->
                                <div class="bg-white rounded-xl shadow-sm p-4">
                                    <h3 class="font-bold text-gray-800 mb-3 text-sm flex items-center gap-2">
                                        <svg class="w-5 h-5 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                        </svg>
                                        Latest Workout Packages
                                    </h3>
                                    <div class="flex flex-col gap-3">
                                        <a href="workouts" class="group cursor-pointer block">
                                            <h4 class="text-sm font-semibold text-gray-900 group-hover:text-[#FF5500] transition-colors">
                                                30-Day Full Body Fat Loss</h4>
                                                <p class="text-xs text-gray-500">By Coach Dat • $20.00</p>
                                            </a>
                                            <hr class="border-gray-100">
                                            <a href="workouts" class="group cursor-pointer block">
                                                <h4 class="text-sm font-semibold text-gray-900 group-hover:text-[#FF5500] transition-colors">
                                                    High-Intensity Hypertrophy</h4>
                                                    <p class="text-xs text-gray-500">By Coach Tuan • $32.00</p>
                                                </a>
                                                <hr class="border-gray-100">
                                                <a href="workouts" class="group cursor-pointer block">
                                                    <h4 class="text-sm font-semibold text-gray-900 group-hover:text-[#FF5500] transition-colors">
                                                        Core & Functional Mobility</h4>
                                                        <p class="text-xs text-gray-500">By Coach Alex • $25.00</p>
                                                    </a>
                                                </div>
                                                <a href="workouts"
                                                   class="block w-full mt-3 text-xs font-semibold text-[#FF5500] hover:underline text-center">
                                                    View All Packages
                                                </a>
                                            </div>

                                        </aside>
                                    </div>

                                    <!-- Create Post Modal Dialog -->
                                    <CreatePostModal IsVisible="@showCreatePostModal" InitialPostType="@createPostInitialType" IsCoach="@isCoach"
                                                     UserName="@userName" UserInitials="@userInitials" AvailableSports="@availableSports"
                                                     AvailableLocations="@availableLocations" OnClose="CloseCreatePostModal" OnPostCreated="OnPostCreated" />

                                    <!-- Edit Post Modal Dialog -->
                                    <EditPostModal IsVisible="@showEditPostModal" Post="@editingPost" IsCoach="@isCoach"
                                                   AvailableSports="@availableSports" AvailableLocations="@availableLocations" OnClose="CloseEditPostModal"
                                                   OnPostUpdated="OnPostUpdated" />

                                    <!-- Delete Confirmation Modal Dialog -->
                                    <DeletePostModal IsVisible="@showDeleteModal" Post="@postToDelete" OnClose="CloseDeleteModal"
                                                     OnPostDeleted="OnPostDeleted" />
                                </div>

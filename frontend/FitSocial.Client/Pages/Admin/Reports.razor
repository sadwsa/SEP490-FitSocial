@page "/admin/reports"
@page "/reports"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN,STAFF")]
@implements IDisposable
@using FitSocial.Client.Models.Common
@using FitSocial.Client.Models.Reports
@using FitSocial.Client.Services.Reports
@inject IReportService ReportService
@inject NavigationManager Navigation

<PageTitle>Reports - FitConnect Admin Console</PageTitle>

<AuthorizeView Roles="ADMIN,STAFF">
    <Authorized>
        <h2 class="view-title">Reports</h2>
        <p class="view-sub">Manage and review reports submitted by users</p>

        <!-- Status Filter Tabs -->
        <div class="cat-tabs mb-3">
            <button type="button" class="cat-tab @(statusFilter == "" ? "active" : "")" @onclick='() => SetStatusFilterAsync("")'>
                All
            </button>
            <button type="button" class="cat-tab @(statusFilter == "PENDING" ? "active" : "")" @onclick='() => SetStatusFilterAsync("PENDING")'>
                <span class="status-dot dot-locked" style="background:#f59e0b;"></span> Pending
            </button>
            <button type="button" class="cat-tab @(statusFilter == "RESOLVED" ? "active" : "")" @onclick='() => SetStatusFilterAsync("RESOLVED")'>
                <span class="status-dot dot-active"></span> Resolved
            </button>
            <button type="button" class="cat-tab @(statusFilter == "REJECTED" ? "active" : "")" @onclick='() => SetStatusFilterAsync("REJECTED")'>
                <span class="status-dot dot-locked"></span> Rejected
            </button>
        </div>

        <!-- Toolbar: Search & Target Type Filter -->
        <div class="toolbar wrap">
            <div class="search-wrap grow">
                <span class="search-icon"><AppIcon Name="search" /></span>
                <input value="@searchTerm"
                       @oninput="OnSearchInput"
                       @onkeydown="HandleSearchKeyDown"
                       class="toolbar-input"
                       placeholder="Search reason, reporter, or reported user..." />
            </div>

            <select value="@targetTypeFilter" @onchange="OnTargetTypeFilterChangedAsync" class="toolbar-select">
                <option value="">All target types</option>
                <option value="POST">Post</option>
                <option value="USER">User</option>
            </select>

            <button type="button" class="row-btn" @onclick="LoadReportsAsync" disabled="@isLoadingReports">
                <span class="btn-ic"><AppIcon Name="refresh" /></span> Refresh
            </button>
        </div>

        <!-- Loading Indicator -->
        @if (isLoadingReports)
        {
            <div class="py-4 text-center muted flex items-center justify-center gap-2">
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <span>Loading reports...</span>
            </div>
        }

        <!-- Reports Table -->
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Report</th>
                        <th>Reporter</th>
                        <th>Target</th>
                        <th>Role</th>
                        <th>Violations</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in pagedReports.Items)
                    {
                        <tr>
                            <td>
                                <code>#@ShortId(r.ReportId)</code>
                            </td>
                            <td>
                                <div class="flex items-center gap-2">
                                    <img src="@GetAvatar(r.ReporterAvatarUrl, r.ReporterName, r.ReporterEmail)"
                                         alt="@r.ReporterName"
                                         class="user-avatar-sm" />
                                    <div>
                                        <strong>@(r.ReporterName ?? "Anonymous")</strong>
                                        <br />
                                        <small class="muted">@(r.ReporterEmail ?? "No email")</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (string.Equals(r.TargetType, "POST", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div>
                                        <span class="target-badge post">Post</span>
                                        <div class="target-preview mt-1" title="@r.ReportedPostContent">
                                            "@(Truncate(r.ReportedPostContent, 45) ?? "Post content")"
                                        </div>
                                        <small class="muted">by @(r.ReportedPostAuthorName ?? "Unknown")</small>
                                    </div>
                                }
                                else if (string.Equals(r.TargetType, "USER", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="flex items-center gap-2">
                                        <img src="@GetAvatar(r.ReportedUserAvatarUrl, r.ReportedUserName, r.ReportedUserEmail)"
                                             alt="@r.ReportedUserName"
                                             class="user-avatar-sm" />
                                        <div>
                                            <span class="target-badge user">User</span>
                                            <br />
                                            <strong>@(r.ReportedUserName ?? "Unknown")</strong>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <span class="target-badge unknown">@(r.TargetType)</span>
                                        <br />
                                        <small class="muted"><code>@ShortId(r.TargetId)</code></small>
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="role-badge @(r.ReportedUserRole?.ToLowerInvariant() ?? "trainee")">
                                    @(r.ReportedUserRole ?? "USER")
                                </span>
                            </td>
                            <td>
                                <span class="violation-pill @(r.ReportedUserViolationCount >= 3 ? "high" : (r.ReportedUserViolationCount > 0 ? "medium" : "low"))"
                                      title="Current violations: @r.ReportedUserViolationCount">
                                    @r.ReportedUserViolationCount
                                </span>
                            </td>
                            <td>
                                <div class="reason-cell" title="@r.Reason">
                                    @(r.Reason ?? "No reason specified")
                                </div>
                            </td>
                            <td>
                                @if (string.Equals(r.Status, "RESOLVED", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="status-badge active">Resolved</span>
                                }
                                else if (string.Equals(r.Status, "REJECTED", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="status-badge locked">Rejected</span>
                                }
                                else
                                {
                                    <span class="status-badge pending">Pending</span>
                                }
                            </td>
                            <td>
                                <small class="muted">
                                    @(r.CreatedAt?.ToLocalTime().ToString("MMM dd, yyyy HH:mm") ?? "N/A")
                                </small>
                            </td>
                            <td class="text-end whitespace-nowrap">
                                <button type="button" class="row-btn view" @onclick="() => OpenReportDetails(r)" title="View report details">
                                    <span class="btn-ic"><AppIcon Name="eye" /></span> View
                                </button>
                            </td>
                        </tr>
                    }

                    @if (!isLoadingReports && !pagedReports.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-8">
                                <div class="flex flex-col items-center justify-center text-gray-400">
                                    <svg class="w-12 h-12 mb-2 stroke-current opacity-40" fill="none" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                    </svg>
                                    <p class="font-semibold text-gray-700">No reports found</p>
                                    <p class="text-xs text-gray-500 mt-1">
                                        @(string.IsNullOrWhiteSpace(searchTerm) && string.IsNullOrWhiteSpace(statusFilter) && string.IsNullOrWhiteSpace(targetTypeFilter)
                                            ? "No user reports have been submitted yet."
                                            : "No reports match your current search or filter criteria.")
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <CommonPagination CurrentPage="@currentPage"
                          PageSize="@pageSize"
                          TotalCount="@pagedReports.TotalCount"
                          PageChanged="GoToPageAsync"
                          ItemName="reports" />

        <!-- Report Details Modal -->
        @if (showDetailsModal && selectedReport != null)
        {
            <div class="modal-overlay" @onclick="CloseDetailsModal">
                <div class="modal-card" @onclick:stopPropagation="true">
                    <!-- Modal Header -->
                    <div class="modal-header">
                        <div>
                            <h3>Report Details</h3>
                            <small>ID: @selectedReport.ReportId</small>
                        </div>
                        <button type="button" class="modal-close-btn" @onclick="CloseDetailsModal" title="Close">✕</button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body">
                        <!-- Reporter Information -->
                        <div class="info-card">
                            <div class="info-card-title">
                                <AppIcon Name="person" />
                                <span>Reporter</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <img src="@GetAvatar(selectedReport.ReporterAvatarUrl, selectedReport.ReporterName, selectedReport.ReporterEmail)"
                                     alt="@selectedReport.ReporterName"
                                     class="user-avatar-md" />
                                <div>
                                    <div class="font-bold text-gray-900">@(selectedReport.ReporterName ?? "Anonymous")</div>
                                    <div class="text-xs text-gray-600">@(selectedReport.ReporterEmail ?? "No email")</div>
                                    <div class="text-xs text-gray-400 mt-0.5"><code>Reporter ID: @(selectedReport.ReporterId?.ToString() ?? "N/A")</code></div>
                                </div>
                            </div>
                        </div>

                        <!-- Reported Target Information -->
                        <div class="info-card">
                            <div class="info-card-title">
                                @if (string.Equals(selectedReport.TargetType, "POST", StringComparison.OrdinalIgnoreCase))
                                {
                                    <AppIcon Name="doc" />
                                    <span>Reported Target (Post & Author)</span>
                                }
                                else
                                {
                                    <AppIcon Name="person" />
                                    <span>Reported Target (User)</span>
                                }
                            </div>

                            @if (string.Equals(selectedReport.TargetType, "POST", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="space-y-3">
                                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                                        <span class="text-gray-500">Post ID: <code>@(selectedReport.ReportedPostId?.ToString() ?? "N/A")</code></span>
                                        <span class="font-medium text-gray-700">
                                            Author:
                                            @if (selectedReport.ReportedPostAuthorId.HasValue && selectedReport.ReportedPostAuthorId.Value != Guid.Empty)
                                            {
                                                <a href="/profile/@selectedReport.ReportedPostAuthorId.Value" class="text-[#FF5500] hover:underline font-bold">
                                                    @(selectedReport.ReportedPostAuthorName ?? "Unknown")
                                                </a>
                                            }
                                            else
                                            {
                                                <strong>@(selectedReport.ReportedPostAuthorName ?? "Unknown")</strong>
                                            }
                                        </span>
                                    </div>
                                    <div class="content-quote">
                                        @(string.IsNullOrWhiteSpace(selectedReport.ReportedPostContent) ? "No text content in post." : selectedReport.ReportedPostContent)
                                    </div>
                                    <div class="pt-1">
                                        @if (selectedReport.ReportedPostId.HasValue && selectedReport.ReportedPostId.Value != Guid.Empty && !selectedReport.ReportedPostIsDeleted)
                                        {
                                            <a href="/admin/posts/@selectedReport.ReportedPostId.Value" class="post-view-link">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                                </svg>
                                                <span>View Original Post</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="post-unavailable-note">
                                                <AppIcon Name="warning" />
                                                <span>This post has been deleted or is no longer accessible.</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (string.Equals(selectedReport.TargetType, "USER", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="flex items-center gap-3">
                                    <img src="@GetAvatar(selectedReport.ReportedUserAvatarUrl, selectedReport.ReportedUserName, selectedReport.ReportedUserEmail)"
                                         alt="@selectedReport.ReportedUserName"
                                         class="user-avatar-md" />
                                    <div>
                                        <div class="font-bold text-gray-900">@(selectedReport.ReportedUserName ?? "Unknown")</div>
                                        <div class="text-xs text-gray-600">@(selectedReport.ReportedUserEmail ?? "No email")</div>
                                        <div class="text-xs text-gray-400 mt-0.5"><code>User ID: @(selectedReport.ReportedUserId?.ToString() ?? "N/A")</code></div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-xs text-gray-600">
                                    Target ID: <code>@(selectedReport.TargetId?.ToString() ?? "N/A")</code>
                                </div>
                            }

                            <!-- Reported User Profile & Moderation Status Summary -->
                            <div class="mt-3 pt-3 border-t border-gray-100 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                                <div>
                                    <span class="text-gray-500 block mb-0.5">User Role:</span>
                                    <span class="role-badge @(selectedReport.ReportedUserRole?.ToLowerInvariant() ?? "trainee")">
                                        @(selectedReport.ReportedUserRole ?? "USER")
                                    </span>
                                </div>
                                <div>
                                    <span class="text-gray-500 block mb-0.5">Current Violations:</span>
                                    <span class="violation-pill @(selectedReport.ReportedUserViolationCount >= 3 ? "high" : (selectedReport.ReportedUserViolationCount > 0 ? "medium" : "low"))">
                                        @selectedReport.ReportedUserViolationCount violation(s)
                                    </span>
                                </div>
                                @if (string.Equals(selectedReport.ReportedUserRole, "COACH", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="sm:col-span-2">
                                        <span class="text-gray-500 block mb-0.5">Sold Training Packages:</span>
                                        <strong class="@(selectedReport.HasSoldTrainingPackage == true ? "text-amber-700" : "text-gray-700")">
                                            @(selectedReport.HasSoldTrainingPackage == true ? "Yes (Active / Completed packages sold to Trainees)" : "No")
                                        </strong>
                                        @if (selectedReport.HasSoldTrainingPackage == true)
                                        {
                                            <div class="p-2 text-xs bg-amber-50 border border-amber-200 text-amber-800 rounded mt-1.5 leading-relaxed">
                                                <strong>Coach Policy:</strong> This Coach has sold training packages to trainees. Account <strong>LOCK</strong> is disabled to protect active training packages. Only <strong>BLOCK</strong> can be applied when violation threshold is met.
                                            </div>
                                        }
                                    </div>
                                }
                                @if (selectedReport.ReportedUserIsLocked == true)
                                {
                                    <div class="sm:col-span-2">
                                        <span class="status-badge locked">Account Locked</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Report Submission & Reason Details -->
                        <div class="info-card">
                            <div class="info-card-title">
                                <AppIcon Name="info" />
                                <span>Report Information</span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                                <div>
                                    <span class="text-gray-500 block mb-0.5">Status:</span>
                                    @if (string.Equals(selectedReport.Status, "RESOLVED", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge active">Resolved</span>
                                    }
                                    else if (string.Equals(selectedReport.Status, "REJECTED", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge locked">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge pending">Pending</span>
                                    }
                                </div>
                                <div>
                                    <span class="text-gray-500 block mb-0.5">Submitted On:</span>
                                    <strong class="text-gray-800">@(selectedReport.CreatedAt?.ToLocalTime().ToString("f") ?? "N/A")</strong>
                                </div>
                                <div class="sm:col-span-2">
                                    <span class="text-gray-500 block mb-0.5">Reason:</span>
                                    <div class="p-2.5 bg-white border border-gray-200 rounded-lg text-gray-900 font-medium leading-relaxed">
                                        @(selectedReport.Reason ?? "No reason provided")
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(selectedReport.Description))
                                {
                                    <div class="sm:col-span-2">
                                        <span class="text-gray-500 block mb-0.5">Description:</span>
                                        <div class="p-2.5 bg-gray-50 border border-gray-200 rounded-lg text-gray-700 leading-relaxed">
                                            @selectedReport.Description
                                        </div>
                                    </div>
                                }

                                @if (selectedReport.ResolvedBy.HasValue || selectedReport.ResolvedAt.HasValue)
                                {
                                    <div>
                                        <span class="text-gray-500 block mb-0.5">Resolved By:</span>
                                        <strong class="text-gray-800">@(selectedReport.ResolverName ?? selectedReport.ResolvedBy.ToString())</strong>
                                    </div>
                                    <div>
                                        <span class="text-gray-500 block mb-0.5">Resolved Date:</span>
                                        <strong class="text-gray-800">@(selectedReport.ResolvedAt?.ToLocalTime().ToString("f") ?? "N/A")</strong>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Evidence Images (Only for Report User) -->
                        @if (string.Equals(selectedReport.TargetType, "USER", StringComparison.OrdinalIgnoreCase))
                        {
                            var evidenceImages = GetEvidenceImages(selectedReport);
                            <div class="info-card">
                                <div class="info-card-title justify-between">
                                    <span class="flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                        <span>Evidence Images</span>
                                    </span>
                                    @if (evidenceImages.Count > 0)
                                    {
                                        <span class="evidence-count-badge">@evidenceImages.Count @(evidenceImages.Count == 1 ? "image" : "images")</span>
                                    }
                                </div>

                                @if (evidenceImages.Count == 0)
                                {
                                    <div class="evidence-empty-state">
                                        No evidence images provided
                                    </div>
                                }
                                else
                                {
                                    <div class="evidence-grid">
                                        @for (int i = 0; i < evidenceImages.Count; i++)
                                        {
                                            var item = evidenceImages[i];
                                            var isValid = IsValidMediaUrl(item.MediaUrl) && !failedEvidenceMediaIds.Contains(item.MediaId);

                                            if (isValid)
                                            {
                                                <button type="button"
                                                        class="evidence-item"
                                                        @onclick="() => OpenEvidenceLightbox(evidenceImages, item.MediaId)"
                                                        title="Click to preview image">
                                                    <img src="@item.MediaUrl"
                                                         alt="Evidence image @(i + 1)"
                                                         loading="lazy"
                                                         @onerror="() => MarkEvidenceImageFailed(item.MediaId)" />
                                                    <span class="evidence-zoom-hint">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path>
                                                        </svg>
                                                    </span>
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="evidence-item-error" title="Unable to load image">
                                                    <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                    </svg>
                                                    <span>Image unavailable</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <!-- Actions Section -->
                        <div class="modal-actions-box">
                            <div class="flex items-center gap-2">
                                <AppIcon Name="shield" />
                                <strong class="text-sm text-gray-900">Process Violation Report</strong>
                            </div>
                            <p class="text-xs text-gray-600 mt-1">
                                Apply disciplinary action based on FitConnect Business Rules. Threshold: 1st & 2nd violations = Warn; 3rd violation onwards (&gt;2) = Lock or Block.
                            </p>

                            @if (!string.Equals(selectedReport.Status, "PENDING", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="p-3 bg-gray-100 border border-gray-200 rounded-lg text-xs text-gray-600 mt-2">
                                    This report has already been processed with status <strong>@selectedReport.Status</strong>. No further actions can be taken.
                                </div>
                            }
                            else
                            {
                                <div class="actions-btn-group mt-2">
                                    <!-- Warn Action -->
                                    <button type="button" class="btn-warning-action" @onclick='() => RequestProcessAction("WARN", "Warn User", $"Issue a formal violation warning to user {GetReportedUserName(selectedReport)}. Their violation count will increase from {selectedReport.ReportedUserViolationCount} to {selectedReport.ReportedUserViolationCount + 1}.")'>
                                        Warn User (@(selectedReport.ReportedUserViolationCount + 1))
                                    </button>

                                    <!-- Lock Action -->
                                    @if (selectedReport.AvailableActions.Contains("LOCK"))
                                    {
                                        <button type="button" class="btn-danger-action" @onclick='() => RequestProcessAction("LOCK", "Lock Account", $"Lock account for {GetReportedUserName(selectedReport)}. The user will be signed out and unable to log in.")'>
                                            Lock Account
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-disabled-action" disabled title="@GetLockDisabledReason(selectedReport)">
                                            Lock Account 🔒
                                        </button>
                                    }

                                    <!-- Block Action -->
                                    @if (selectedReport.AvailableActions.Contains("BLOCK"))
                                    {
                                        <button type="button" class="btn-danger-action" @onclick='() => RequestProcessAction("BLOCK", "Block User", $"Block {GetReportedUserName(selectedReport)}. If this is a Coach who sold packages, only their coach profile will be blocked.")'>
                                            Block User
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-disabled-action" disabled title="@GetBlockDisabledReason(selectedReport)">
                                            Block User 🚫
                                        </button>
                                    }

                                    <!-- Delete Post Action (Only for Post Reports) -->
                                    @if (selectedReport.AvailableActions.Contains("DELETE_POST") || selectedReport.ReportedPostId.HasValue)
                                    {
                                        @if (selectedReport.AvailableActions.Contains("DELETE_POST"))
                                        {
                                            <button type="button" class="btn-danger-action" @onclick="OpenDeletePostModal" style="background:#b91c1c;">
                                                Delete Post
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn-disabled-action" disabled title="Post is already deleted or not available for deletion.">
                                                Delete Post 🗑️
                                            </button>
                                        }
                                    }

                                    <!-- Reject Action -->
                                    <button type="button" class="btn-secondary-action" @onclick='() => RequestProcessAction("REJECT", "Reject Report", "Reject/dismiss this report. Violation count will NOT increase and no notification will be sent.")'>
                                        Reject Report
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="modal-footer">
                        <button type="button" class="btn-modal-cancel" @onclick="CloseDetailsModal">Close</button>
                    </div>
                </div>
            </div>
        }

        <!-- Confirmation Modal for Actions -->
        @if (showConfirmModal)
        {
            <div class="modal-overlay" style="z-index:1100;" @onclick="CancelConfirm">
                <div class="modal-card confirm" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>@confirmTitle</h3>
                        <button type="button" class="modal-close-btn" @onclick="CancelConfirm" title="Close" disabled="@isProcessingAction">✕</button>
                    </div>
                    <div class="modal-body">
                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <AppIcon Name="warning" />
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-gray-900">@confirmMessage</p>
                                <p class="text-xs text-gray-500 mt-1">Please confirm if you want to proceed with this moderation action.</p>

                                <div class="mt-3">
                                    <label class="text-xs font-medium text-gray-700 block mb-1">Staff Note (Optional):</label>
                                    <textarea @bind="actionNote" class="w-full text-xs p-2 border border-gray-300 rounded-lg focus:outline-none focus:border-red-500" rows="2" placeholder="Enter reason or note for this action..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-modal-cancel" @onclick="CancelConfirm" disabled="@isProcessingAction">Cancel</button>
                        <button type="button" class="btn-modal-confirm" @onclick="ExecuteConfirmedActionAsync" disabled="@isProcessingAction">
                            @if (isProcessingAction)
                            {
                                <span>Processing...</span>
                            }
                            else
                            {
                                <span>Confirm</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Dedicated Modal for Delete Post -->
        @if (showDeletePostModal && selectedReport != null)
        {
            <div class="modal-overlay" style="z-index:1150;" @onclick="CancelDeletePost">
                <div class="modal-card confirm" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>Delete Post</h3>
                        <button type="button" class="modal-close-btn" @onclick="CancelDeletePost" title="Close" disabled="@isProcessingAction">✕</button>
                    </div>
                    <div class="modal-body">
                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                                <AppIcon Name="warning" />
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-semibold text-gray-900">This action will soft-delete and permanently hide the post from users.</p>
                                <p class="text-xs text-gray-500 mt-1">
                                    The post owner (<strong>@(selectedReport.ReportedPostAuthorName ?? "Post Author")</strong>) will receive a violation notification with the reason you provide, and their violation count will increase.
                                </p>

                                <div class="mt-3">
                                    <label class="text-xs font-semibold text-gray-700 block mb-1">
                                        Deletion Reason <span class="text-red-500">*</span>:
                                    </label>
                                    <textarea @bind="deletePostReason"
                                              @bind:event="oninput"
                                              class="w-full text-xs p-2.5 border @(!string.IsNullOrEmpty(deletePostReasonError) ? "border-red-500 ring-1 ring-red-300" : "border-gray-300") rounded-lg focus:outline-none focus:border-red-500"
                                              rows="3"
                                              placeholder="Enter required reason for post removal (e.g. Violates community guidelines, inappropriate content)..."></textarea>
                                    @if (!string.IsNullOrEmpty(deletePostReasonError))
                                    {
                                        <p class="text-xs text-red-600 mt-1 font-semibold">@deletePostReasonError</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-modal-cancel" @onclick="CancelDeletePost" disabled="@isProcessingAction">Cancel</button>
                        <button type="button" class="btn-modal-confirm" @onclick="ConfirmDeletePostAsync" disabled="@isProcessingAction">
                            @if (isProcessingAction)
                            {
                                <span>Processing...</span>
                            }
                            else
                            {
                                <span>Confirm Delete</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Evidence Image Lightbox Modal -->
        @if (isLightboxOpen && lightboxImages.Count > 0)
        {
            <div class="report-lightbox-overlay" @onclick="CloseLightbox">
                <div class="report-lightbox-dialog" @onclick:stopPropagation="true">
                    <div class="report-lightbox-topbar">
                        <div class="report-lightbox-info">
                            <span>Evidence Image</span>
                            @if (lightboxImages.Count > 1)
                            {
                                <span class="report-lightbox-counter">(@(lightboxIndex + 1) / @lightboxImages.Count)</span>
                            }
                        </div>
                        <button type="button" class="report-lightbox-close-btn" @onclick="CloseLightbox" title="Close">✕</button>
                    </div>

                    <div class="report-lightbox-main">
                        @if (lightboxImages.Count > 1)
                        {
                            <button type="button"
                                    class="report-lightbox-arrow prev"
                                    @onclick="PrevLightboxImage"
                                    disabled="@(lightboxIndex <= 0)"
                                    title="Previous image">
                                ‹
                            </button>
                        }

                        <div class="report-lightbox-img-stage">
                            <img src="@lightboxImages[lightboxIndex]"
                                 alt="Evidence image @(lightboxIndex + 1)"
                                 class="report-lightbox-img" />
                        </div>

                        @if (lightboxImages.Count > 1)
                        {
                            <button type="button"
                                    class="report-lightbox-arrow next"
                                    @onclick="NextLightboxImage"
                                    disabled="@(lightboxIndex >= lightboxImages.Count - 1)"
                                    title="Next image">
                                ›
                            </button>
                        }
                    </div>

                    @if (lightboxImages.Count > 1)
                    {
                        <div class="report-lightbox-strip">
                            @for (int k = 0; k < lightboxImages.Count; k++)
                            {
                                var stripIdx = k;
                                <img src="@lightboxImages[stripIdx]"
                                     alt="Thumbnail @(stripIdx + 1)"
                                     class="report-lightbox-strip-item @(stripIdx == lightboxIndex ? "active" : "")"
                                     @onclick="() => lightboxIndex = stripIdx" />
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="auth-alert error" role="alert">
            <AppIcon Name="warning" />
            <span>You do not have permission to access the Reports console.</span>
        </div>
        <button type="button" class="btn-back" @onclick='() => Navigation.NavigateTo("/admin/login")'>
            Go to portal sign in
        </button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string searchTerm = "";
    private string statusFilter = "";
    private string targetTypeFilter = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private PagedResult<ReportListItemDto> pagedReports = new();
    private System.Timers.Timer? searchDebounceTimer;
    private bool isLoadingReports = false;

    // Details Modal State
    private bool showDetailsModal = false;
    private ReportListItemDto? selectedReport;

    // Confirmation Modal State
    private bool showConfirmModal = false;
    private string confirmTitle = "";
    private string confirmMessage = "";
    private string pendingActionCode = "";
    private string actionNote = "";
    private bool isProcessingAction = false;

    // Delete Post Modal State
    private bool showDeletePostModal = false;
    private string deletePostReason = "";
    private string? deletePostReasonError;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportsAsync();
    }

    private async Task LoadReportsAsync()
    {
        isLoadingReports = true;
        LoadingService.Show("Loading reports...");
        try
        {
            var res = await ReportService.GetReportsAsync(
                searchTerm: searchTerm,
                status: string.IsNullOrWhiteSpace(statusFilter) ? null : statusFilter,
                targetType: string.IsNullOrWhiteSpace(targetTypeFilter) ? null : targetTypeFilter,
                pageNumber: currentPage,
                pageSize: pageSize);

            if (res.Success && res.Data != null)
            {
                pagedReports = res.Data;
                if (pagedReports.TotalPages > 0 && currentPage > pagedReports.TotalPages)
                {
                    currentPage = pagedReports.TotalPages;
                    await LoadReportsAsync();
                    return;
                }
            }
            else if (!string.IsNullOrEmpty(res.Message))
            {
                ToastService.ShowError(res.Message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Unable to load reports. Please try again. ({ex.Message})");
        }
        finally
        {
            isLoadingReports = false;
            LoadingService.Hide();
        }
    }

    private async Task SetStatusFilterAsync(string status)
    {
        if (statusFilter == status) return;
        statusFilter = status;
        currentPage = 1;
        await LoadReportsAsync();
    }

    private async Task OnTargetTypeFilterChangedAsync(ChangeEventArgs e)
    {
        targetTypeFilter = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadReportsAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        searchDebounceTimer?.Stop();
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Timers.Timer(400) { AutoReset = false };
        searchDebounceTimer.Elapsed += async (_, _) =>
        {
            currentPage = 1;
            await InvokeAsync(LoadReportsAsync);
            await InvokeAsync(StateHasChanged);
        };
        searchDebounceTimer.Start();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            searchDebounceTimer?.Stop();
            currentPage = 1;
            await LoadReportsAsync();
        }
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || (pagedReports.TotalPages > 0 && page > pagedReports.TotalPages) || page == currentPage)
            return;

        currentPage = page;
        await LoadReportsAsync();
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            pageSize = newSize;
            currentPage = 1;
            await LoadReportsAsync();
        }
    }

    private IEnumerable<int> GetVisiblePageNumbers()
    {
        var total = pagedReports.TotalPages;
        if (total <= 1) yield break;

        var current = currentPage;
        var delta = 2;
        var left = Math.Max(1, current - delta);
        var right = Math.Min(total, current + delta);

        if (left > 1)
        {
            yield return 1;
            if (left > 2) yield return -1;
        }

        for (var i = left; i <= right; i++)
        {
            yield return i;
        }

        if (right < total)
        {
            if (right < total - 1) yield return -1;
            yield return total;
        }
    }

    private async Task OpenReportDetails(ReportListItemDto report)
    {
        selectedReport = report;
        failedEvidenceMediaIds.Clear();
        CloseLightbox();
        showDetailsModal = true;
        LoadingService.Show("Loading report details...");
        try
        {
            var res = await ReportService.GetReportByIdAsync(report.ReportId);
            if (res.Success && res.Data != null)
            {
                selectedReport = res.Data;
            }
        }
        catch
        {
            // Fallback to list item data
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void CloseDetailsModal()
    {
        CloseLightbox();
        failedEvidenceMediaIds.Clear();
        showDetailsModal = false;
        selectedReport = null;
    }

    // Evidence Images & Lightbox State
    private readonly HashSet<Guid> failedEvidenceMediaIds = new();
    private bool isLightboxOpen = false;
    private List<string> lightboxImages = new();
    private int lightboxIndex = 0;

    private static List<ReportMediaItemDto> GetEvidenceImages(ReportListItemDto report)
    {
        if (report.Media == null || report.Media.Count == 0)
        {
            return new List<ReportMediaItemDto>();
        }

        return report.Media
            .Where(m => string.IsNullOrWhiteSpace(m.MediaFor) ||
                        string.Equals(m.MediaFor, "REPORT", StringComparison.OrdinalIgnoreCase))
            .OrderBy(m => m.SortOrder ?? short.MaxValue)
            .ToList();
    }

    private static bool IsValidMediaUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        var trimmed = url.Trim();
        if (trimmed.StartsWith("/")) return true;
        return Uri.TryCreate(trimmed, UriKind.Absolute, out var uri) &&
               (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);
    }

    private void MarkEvidenceImageFailed(Guid mediaId)
    {
        failedEvidenceMediaIds.Add(mediaId);
    }

    private void OpenEvidenceLightbox(List<ReportMediaItemDto> evidenceImages, Guid clickedMediaId)
    {
        var validUrls = new List<string>();
        var targetIndex = 0;

        foreach (var img in evidenceImages)
        {
            if (IsValidMediaUrl(img.MediaUrl) && !failedEvidenceMediaIds.Contains(img.MediaId))
            {
                if (img.MediaId == clickedMediaId)
                {
                    targetIndex = validUrls.Count;
                }
                validUrls.Add(img.MediaUrl!.Trim());
            }
        }

        if (validUrls.Count == 0) return;

        lightboxImages = validUrls;
        lightboxIndex = Math.Clamp(targetIndex, 0, lightboxImages.Count - 1);
        isLightboxOpen = true;
    }

    private void CloseLightbox()
    {
        isLightboxOpen = false;
        lightboxImages.Clear();
        lightboxIndex = 0;
    }

    private void PrevLightboxImage()
    {
        if (lightboxIndex > 0) lightboxIndex--;
    }

    private void NextLightboxImage()
    {
        if (lightboxIndex < lightboxImages.Count - 1) lightboxIndex++;
    }

    private void RequestProcessAction(string actionCode, string actionTitle, string actionDescription)
    {
        pendingActionCode = actionCode;
        actionNote = "";
        confirmTitle = actionTitle;
        confirmMessage = actionDescription;
        showConfirmModal = true;
    }

    private void CancelConfirm()
    {
        if (isProcessingAction) return;
        showConfirmModal = false;
        actionNote = "";
    }

    private async Task ExecuteConfirmedActionAsync()
    {
        if (selectedReport == null || string.IsNullOrWhiteSpace(pendingActionCode)) return;

        isProcessingAction = true;
        LoadingService.Show("Processing violation report...");
        try
        {
            var req = new ProcessViolationReportRequest
            {
                Action = pendingActionCode,
                Note = string.IsNullOrWhiteSpace(actionNote) ? null : actionNote.Trim()
            };

            var res = await ReportService.ProcessReportAsync(selectedReport.ReportId, req);
            if (res.Success && res.Data != null)
            {
                selectedReport = res.Data;
                ToastService.ShowSuccess($"Report #{ShortId(selectedReport.ReportId)} processed successfully with action: {pendingActionCode}.");
                showConfirmModal = false;
                await LoadReportsAsync();
            }
            else
            {
                ToastService.ShowError(res.Message ?? "Failed to process report.");
                showConfirmModal = false;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error processing report: {ex.Message}");
            showConfirmModal = false;
        }
        finally
        {
            isProcessingAction = false;
            LoadingService.Hide();
        }
    }

    private void OpenDeletePostModal()
    {
        deletePostReason = "";
        deletePostReasonError = null;
        showDeletePostModal = true;
    }

    private void CancelDeletePost()
    {
        if (isProcessingAction) return;
        showDeletePostModal = false;
        deletePostReason = "";
        deletePostReasonError = null;
    }

    private async Task ConfirmDeletePostAsync()
    {
        if (selectedReport == null) return;

        if (string.IsNullOrWhiteSpace(deletePostReason))
        {
            deletePostReasonError = "Deletion reason is required and cannot be empty.";
            return;
        }

        deletePostReasonError = null;
        isProcessingAction = true;
        LoadingService.Show("Deleting post...");
        try
        {
            var req = new ProcessViolationReportRequest
            {
                Action = "DELETE_POST",
                Reason = deletePostReason.Trim(),
                Note = deletePostReason.Trim()
            };

            var res = await ReportService.ProcessReportAsync(selectedReport.ReportId, req);
            if (res.Success && res.Data != null)
            {
                selectedReport = res.Data;
                ToastService.ShowSuccess($"Post deleted and report #{ShortId(selectedReport.ReportId)} resolved successfully.");
                showDeletePostModal = false;
                await LoadReportsAsync();
            }
            else
            {
                ToastService.ShowError(res.Message ?? "Failed to delete post.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting post: {ex.Message}");
        }
        finally
        {
            isProcessingAction = false;
            LoadingService.Hide();
        }
    }

    private string GetReportedUserName(ReportListItemDto report)
    {
        if (string.Equals(report.TargetType, "POST", StringComparison.OrdinalIgnoreCase))
        {
            return report.ReportedPostAuthorName ?? "Post Author";
        }
        return report.ReportedUserName ?? "User";
    }

    private string GetLockDisabledReason(ReportListItemDto report)
    {
        if (string.Equals(report.ReportedUserRole, "COACH", StringComparison.OrdinalIgnoreCase) && report.HasSoldTrainingPackage == true)
        {
            return "Cannot lock account: This Coach has sold training packages to trainees. Only BLOCK is allowed.";
        }
        if (report.ReportedUserViolationCount < 2)
        {
            return $"Cannot lock account: Violation count must be greater than 2 (current: {report.ReportedUserViolationCount}). Please issue a Warning first.";
        }
        return "Lock account is currently unavailable.";
    }

    private string GetBlockDisabledReason(ReportListItemDto report)
    {
        if (report.ReportedUserViolationCount < 2)
        {
            return $"Cannot block user: Violation count must be greater than 2 (current: {report.ReportedUserViolationCount}). Please issue a Warning first.";
        }
        return "Block user is currently unavailable.";
    }

    private static string ShortId(Guid? id)
    {
        if (!id.HasValue || id == Guid.Empty) return "N/A";
        var str = id.Value.ToString();
        return str.Length > 8 ? str.Substring(0, 8) : str;
    }

    private static string? Truncate(string? value, int maxLength)
    {
        if (string.IsNullOrEmpty(value)) return value;
        return value.Length <= maxLength ? value : value.Substring(0, maxLength) + "…";
    }

    private static string GetAvatar(string? avatarUrl, string? name, string? email)
    {
        if (AvatarHelper.HasValidAvatarUrl(avatarUrl))
        {
            return avatarUrl!;
        }

        var label = !string.IsNullOrWhiteSpace(name) ? name : (!string.IsNullOrWhiteSpace(email) ? email : "User");
        return $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(label)}&background=FF8C00&color=fff";
    }

    public void Dispose()
    {
        searchDebounceTimer?.Stop();
        searchDebounceTimer?.Dispose();
    }
}

@namespace FitSocial.Client.Components.Posts

<div class="bg-white rounded-xl shadow-sm p-4 hover:shadow-md transition-shadow">
    <div class="flex gap-3 items-center">
        <div class="w-10 h-10 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] flex-shrink-0 flex items-center justify-center text-white font-bold text-sm shadow-sm">
            @UserInitials
        </div>
        <div @onclick='() => Open()'
             class="w-full bg-gray-100 hover:bg-gray-200/80 rounded-full py-2.5 px-4 text-gray-500 text-sm transition cursor-pointer flex items-center select-none">
            <span>What's on your mind about today's workout?</span>
        </div>
    </div>
    <hr class="my-3 border-gray-100" />
    <div class="flex flex-wrap justify-between items-center gap-2 px-1">
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <button type="button" @onclick='() => Open("PHOTO")'
                    class="text-gray-600 font-medium hover:bg-orange-50 px-3 py-1.5 rounded-lg flex items-center gap-2 text-xs md:text-sm transition cursor-pointer"
                    title="Add photo or video">
                <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                    </path>
                </svg>
                <span>Photo/Video</span>
            </button>
            <button type="button" @onclick='() => Open(postType: "Find Coach")'
                    class="text-gray-600 font-medium hover:bg-orange-50 px-3 py-1.5 rounded-lg flex items-center gap-2 text-xs md:text-sm transition cursor-pointer"
                    title="Find Coach">
                <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <span>Find Coach</span>
            </button>
            @if (IsCoach)
            {
                <button type="button" @onclick='() => Open(postType: "Find Trainee")'
                        class="text-gray-600 font-medium hover:bg-orange-50 px-3 py-1.5 rounded-lg flex items-center gap-2 text-xs md:text-sm transition cursor-pointer"
                        title="Find Trainee">
                    <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                        </path>
                    </svg>
                    <span>Find Trainee</span>
                </button>
            }
        </div>
        <!-- Post Button with Logo Gradient -->
        <button type="button" @onclick='() => Open()'
                class="bg-gradient-to-r from-[#FF8C00] via-[#FF5500] to-[#FF3B00] hover:opacity-95 text-white px-5 py-1.5 rounded-lg font-semibold shadow-sm text-sm transition cursor-pointer">
            Post
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string UserInitials { get; set; } = "Me";

    [Parameter]
    public bool IsCoach { get; set; }

    [Parameter]
    public EventCallback<(string? trigger, string? postType)> OnOpen { get; set; }

    private async Task Open(string? trigger = null, string? postType = null)
    {
        if (OnOpen.HasDelegate)
        {
            await OnOpen.InvokeAsync((trigger, postType));
        }
    }
}

@page "/coaches"
@layout EmptyLayout
@inject ICoachService CoachService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject FitSocial.Client.Services.Auth.IAuthService AuthService
@attribute [Authorize]
@using FitSocial.Client.Layout
@using System.Security.Claims

<PageTitle>Discover Coaches - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <AppHeader SearchTerm="@headerSearchTerm"
               OnSearchInput="HandleHeaderSearchInput"
               OnSearchKeyUp="HandleHeaderSearchKeyUp"
               OnSearch="ExecuteHeaderSearch"
               OnClearSearch="ClearHeaderSearch"
               UserName="@userName"
               UserInitials="@userInitials"
               UserRole="@userRole"
               OnLogout="HandleLogout" />

    <style>
        @@media (min-width: 1024px) {
            .home-3col-layout {
                display: grid !important;
                grid-template-columns: minmax(18rem, 1fr) minmax(0, 42rem) minmax(18rem, 1fr) !important;
                align-items: start !important;
            }

            .home-left-sidebar { justify-self: start !important; }
            .home-center-feed { justify-self: end !important; width: 100% !important; max-width: 42rem !important; min-width: 0 !important; }
            .home-right-sidebar { justify-self: center !important; }
        }
    </style>

    <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">
        <!-- Left Sidebar -->
        <AppSidebar ActiveItem="coaches" />

        <!-- Center Column -->
        <section class="home-center-feed w-full max-w-2xl flex flex-col gap-4 min-w-0 pb-10">
            <!-- Header Section -->
            <div class="bg-white rounded-xl shadow-sm p-5 flex flex-col sm:flex-row justify-between items-center gap-4">
                <h1 class="text-xl font-bold text-gray-800">Discover Coaches</h1>
            </div>

            <!-- Filter Section -->
            <div class="bg-white rounded-xl shadow-sm p-4">
                <form @onsubmit="SearchCoaches" class="flex flex-col sm:flex-row gap-3">
                    <input type="text" class="flex-1 bg-gray-100 rounded-lg py-2 px-4 focus:outline-none focus:ring-2 focus:ring-[#FF5500] text-sm text-gray-700" placeholder="Search by name or bio..." @bind="searchKeyword">
                    <input type="number" class="w-full sm:w-28 bg-gray-100 rounded-lg py-2 px-4 focus:outline-none focus:ring-2 focus:ring-[#FF5500] text-sm text-gray-700" placeholder="Min Exp" min="0" @bind="minExperience">
                    <select class="w-full sm:w-36 bg-gray-100 rounded-lg py-2 px-3 focus:outline-none focus:ring-2 focus:ring-[#FF5500] text-sm text-gray-700" @bind="sortBy">
                        <option value="">Sort: Default</option>
                        <option value="exp_desc">Exp: High-Low</option>
                        <option value="exp_asc">Exp: Low-High</option>
                        <option value="name_asc">Name: A-Z</option>
                    </select>
                    <button type="submit" class="bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white px-5 py-2 rounded-lg font-semibold text-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </button>
                </form>
            </div>

            <!-- Content -->
            @if (isLoading)
            {
                <div class="flex justify-center py-10">
                    <div class="w-8 h-8 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin"></div>
                </div>
            }
            else if (errorMessage != null)
            {
                <div class="bg-red-50 text-red-600 p-4 rounded-xl text-center text-sm font-medium">@errorMessage</div>
            }
            else if (!coaches.Any())
            {
                <div class="bg-white rounded-xl shadow-sm p-10 text-center text-gray-500">
                    <div class="w-16 h-16 mx-auto mb-3 text-gray-300 flex justify-center items-center">
                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    </div>
                    <h3 class="text-base font-bold text-gray-800 mb-1">No coaches found</h3>
                    <p class="text-xs text-gray-400">Try adjusting your search filters.</p>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-4">
                    @foreach (var coach in coaches)
                    {
                        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 hover:shadow-md transition duration-200">
                            <div class="flex flex-col sm:flex-row gap-4">
                                <!-- Left: Avatar -->
                                <div class="flex-shrink-0 mx-auto sm:mx-0">
                                    <div class="inline-block p-1 rounded-full bg-gradient-to-tr from-yellow-400 via-orange-500 to-red-500">
                                        @if (!string.IsNullOrEmpty(coach.AvatarUrl))
                                        {
                                            <img src="@coach.AvatarUrl" class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-2 border-white object-cover bg-white" alt="@coach.FullName" />
                                        }
                                        else
                                        {
                                            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-2 border-white bg-gray-100 flex items-center justify-center text-gray-400">
                                                <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path></svg>
                                            </div>
                                        }
                                    </div>
                                </div>
                                
                                <!-- Center: Details -->
                                <div class="flex-grow text-center sm:text-left">
                                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-2">
                                        <div>
                                            <h5 class="font-bold text-gray-900 text-lg mb-0">@coach.FullName</h5>
                                            <p class="text-gray-500 text-xs font-medium">@("@coach_" + coach.CoachId.ToString().Substring(0, 6))</p>
                                        </div>
                                        <button @onclick="@(() => Navigation.NavigateTo($"/profile/{coach.CoachId}"))"
                                                class="hidden sm:block bg-gray-50 hover:bg-orange-50 text-gray-800 hover:text-[#FF5500] border border-gray-200 hover:border-orange-200 px-4 py-1.5 rounded-lg text-sm font-semibold transition-colors duration-200 cursor-pointer whitespace-nowrap">
                                            View Profile
                                        </button>
                                    </div>

                                    <!-- Bio -->
                                    <p class="text-gray-700 text-sm mb-4 line-clamp-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @(string.IsNullOrEmpty(coach.Bio) ? "Fitness enthusiast & professional coach. Let's build your dream body together!" : coach.Bio)
                                    </p>
                                    
                                    <!-- Stats -->
                                    <div class="flex justify-center sm:justify-start gap-6 pt-2">
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                            <span class="font-semibold text-gray-800 text-sm">@coach.ExperienceYears <span class="text-gray-500 font-normal">Yrs Exp</span></span>
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                            <span class="font-semibold text-gray-800 text-sm">5.0 <span class="text-gray-500 font-normal">Rating</span></span>
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
                                            <span class="font-semibold text-[#FF5500] text-sm">PRO</span>
                                        </div>
                                    </div>

                                    <button @onclick="@(() => Navigation.NavigateTo($"/profile/{coach.CoachId}"))"
                                            class="mt-4 w-full block sm:hidden bg-gray-50 hover:bg-orange-50 text-gray-800 hover:text-[#FF5500] border border-gray-200 hover:border-orange-200 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 cursor-pointer">
                                        View Profile
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- Right Sidebar (Empty) -->
        <aside class="home-right-sidebar hidden lg:flex w-72 flex-shrink-0 flex-col gap-4 sticky top-24"></aside>
    </div>
</div>

@code {
    private IEnumerable<CoachListDto> coaches = new List<CoachListDto>();
    private bool isLoading = true;
    private string? errorMessage;

    // Filters
    private string? searchKeyword = "";
    private int? minExperience;
    private string? sortBy = "";
    
    // Header state
    private string? headerSearchTerm = "";
    private string userName = "User";
    private string userInitials = "U";
    private string userRole = "Trainee";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfoAsync();
        await LoadCoaches();
    }

    private async Task LoadUserInfoAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                userName = user.Identity.Name ?? "User";
                var isCoach = user.IsInRole("COACH") || user.IsInRole("Coach") || user.IsInRole("coach");
                userRole = isCoach ? "Coach" : "Trainee";

                var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 0)
                {
                    userInitials = parts.Length > 1 
                        ? $"{parts[0][0]}{parts[^1][0]}".ToUpper() 
                        : parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
                }
            }
        }
        catch
        {
            userInitials = "U";
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }

    private void HandleHeaderSearchInput(ChangeEventArgs e)
    {
        headerSearchTerm = e.Value?.ToString();
    }

    private async Task HandleHeaderSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteHeaderSearch();
        }
    }

    private async Task ExecuteHeaderSearch()
    {
        searchKeyword = headerSearchTerm;
        await LoadCoaches();
    }

    private async Task ClearHeaderSearch()
    {
        headerSearchTerm = string.Empty;
        searchKeyword = string.Empty;
        await LoadCoaches();
    }

    private async Task SearchCoaches()
    {
        await LoadCoaches();
    }

    private async Task LoadCoaches()
    {
        isLoading = true;
        errorMessage = null;

        var response = await CoachService.GetAllCoachesAsync(searchKeyword, minExperience, sortBy);
        if (response.Success && response.Data != null)
        {
            coaches = response.Data;
        }
        else
        {
            errorMessage = response.Message ?? "Failed to load coaches.";
        }

        isLoading = false;
    }
}

# ==========================================
# 🏋️ FitSocial - .gitignore
# .NET 8 (Clean Architecture Web API & Blazor WASM Frontend)
# ==========================================

# ------------------------------------------
# 1. .NET Build & Compilation Outputs
# ------------------------------------------
**/[Bb]in/
**/[Oo]bj/
**/[Aa]pp_data/
**/[Aa]rtifacts/
**/[Pp]ublish/
**/[Dd]ist/

# ------------------------------------------
# 2. Visual Studio & IDE Specifics
# ------------------------------------------
**/.vs/
**/.dotnet/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# Rider
**/.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------
# 3. Environment, Secrets & Local Configs
# ------------------------------------------
**/*appsettings.local.json
**/*appsettings.*.local.json
.env
.env*.local
*.pfx
*.pem
*.key
*.cer

# ------------------------------------------
# 4. Local Database Files
# ------------------------------------------
*.db
*.db-shm
*.db-wal
*.mdf
*.ldf

# ------------------------------------------
# 5. OS & System Files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------
# 6. Node / Web Legacy (nếu có công cụ frontend ngoài)
# ------------------------------------------
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

@page "/home"
@layout EmptyLayout
@attribute [Authorize(Roles = "TRAINEE,COACH")]
@implements IDisposable
@inject IPostService PostService
@inject ISportService SportService
@inject ILocationService LocationService
@inject IFileUploadService FileUploadService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using System.Security.Claims

<PageTitle>Home Feed - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <!-- Floating Success Toast Notification -->
    @if (!string.IsNullOrWhiteSpace(toastSuccessMessage))
    {
        <div
            class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-emerald-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-emerald-500/50 backdrop-blur transition-all duration-300 animate-in fade-in slide-in-from-top-4">
            <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <span>@toastSuccessMessage</span>
            <button type="button" @onclick="DismissToast"
                    class="ml-2 text-white/80 hover:text-white text-lg font-bold transition cursor-pointer"
                    title="Close">&times;</button>
        </div>
    }

    <!-- 1. Header / Navigation Bar -->
    <header class="sticky top-0 z-50 bg-white shadow-sm h-16 flex items-center justify-between px-4 lg:px-10"
            style="display: flex !important; flex-direction: row !important; align-items: center !important; justify-content: space-between !important;">
        <div class="flex items-center gap-4 w-1/3">
            <!-- Brand Logo -->
            <a href="home" class="flex-shrink-0 flex items-center hover:opacity-95 transition" title="FitSocial Home">
                <img src="logo.jpg" alt="FitSocial"
                     class="h-11 w-11 object-cover rounded-xl shadow-sm hover:scale-105 transition-transform duration-200" />
            </a>
            <div class="hidden md:flex relative w-full max-w-sm">
                <input type="text" placeholder="Search posts, coaches, friends..." @bind="searchTerm"
                       @bind:event="oninput" @onkeyup="HandleSearchKeyUp"
                       class="w-full bg-gray-100 rounded-full py-2 pl-4 pr-10 focus:outline-none focus:ring-2 focus:ring-[#FF5500] text-sm" />
                <button class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600 transition"
                        @onclick="ExecuteSearch" title="Search">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </button>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 md:gap-4 w-1/3">
            <button class="relative p-2 text-gray-600 hover:bg-orange-50 rounded-full transition" title="Shopping Cart">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z">
                    </path>
                </svg>
                <span
                class="absolute top-1 right-1 bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white text-xs font-bold w-4 h-4 flex items-center justify-center rounded-full">2</span>
            </button>
            <button class="relative p-2 text-gray-600 hover:bg-orange-50 rounded-full transition" title="Messages">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z">
                    </path>
                </svg>
                <span
                class="absolute top-1 right-1 bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white text-xs font-bold w-4 h-4 flex items-center justify-center rounded-full">5</span>
            </button>
            <button class="relative p-2 text-gray-600 hover:bg-orange-50 rounded-full transition" title="Notifications">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                    </path>
                </svg>
                <span
                class="absolute top-1 right-1 bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white text-xs font-bold w-4 h-4 flex items-center justify-center rounded-full">9</span>
            </button>

            <!-- Profile Avatar & Dropdown -->
            <div class="relative">
                <button @onclick="ToggleProfileMenu"
                        class="w-9 h-9 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] text-white flex items-center justify-center font-bold ml-2 shadow-sm hover:opacity-90 transition cursor-pointer"
                        title="User Profile">
                    @userInitials
                </button>
                @if (showProfileMenu)
                {
                    <div
                        class="absolute right-0 mt-2 w-52 bg-white rounded-xl shadow-xl border border-gray-100 py-2 z-50 animate-in fade-in">
                        <div class="px-4 py-2 border-b border-gray-100">
                            <p class="text-sm font-semibold text-gray-900 truncate">@(string.IsNullOrWhiteSpace(userName) ?
                                                                                                                                    "User" : userName)</p>
                                <p class="text-xs text-[#FF5500] font-medium uppercase tracking-wider mt-0.5">
                                    @(string.IsNullOrWhiteSpace(userRole) ? "Athlete" : userRole)</p>
                                </div>
                                <a href="profile"
                                   class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-orange-50 hover:text-[#FF5500] transition">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                    My Profile
                                </a>
                                <a href="change-password"
                                   class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-orange-50 hover:text-[#FF5500] transition">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z">
                                        </path>
                                    </svg>
                                    Change Password
                                </a>
                                <hr class="my-1 border-gray-100" />
                                <button @onclick="HandleLogout"
                                        class="w-full flex items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition text-left">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                                        </path>
                                    </svg>
                                    Log Out
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </header>

            <style>
                    @@media (min-width: 1024px) {
                        .home-3col-layout {
                            display: grid !important;
                            grid-template-columns: minmax(18rem, 1fr) minmax(0, 42rem) minmax(18rem, 1fr) !important;
                            align-items: start !important;
                        }

                        .home-left-sidebar {
                            justify-self: start !important;
                        }

                        .home-center-feed {
                            justify-self: end !important;
                            width: 100% !important;
                            max-width: 42rem !important;
                            min-width: 0 !important;
                        }

                        .home-right-sidebar {
                            justify-self: center !important;
                        }
                    }

                    .post-content-text {
                        word-break: break-word;
                        overflow-wrap: anywhere;
                        word-wrap: break-word;
                        white-space: pre-line;
                    }
            </style>

            <!-- Main Content Layout (3-Column Horizontal Row) -->
            <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">

                <!-- Left Sidebar: Menu Navigation -->
                <aside class="home-left-sidebar hidden lg:block w-72 flex-shrink-0 sticky top-24">
                    <nav class="flex flex-col gap-1">
                        <a href="home"
                           class="p-3 bg-white rounded-xl shadow-sm font-semibold bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] bg-clip-text text-transparent flex items-center gap-3 border-l-4 border-[#FF5500]">
                            <svg class="w-5 h-5 text-[#FF5500]" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z">
                                </path>
                            </svg>
                            News Feed
                        </a>
                        <a href="community"
                           class="p-3 hover:bg-orange-50/60 rounded-xl font-medium text-gray-700 flex items-center gap-3 transition">
                            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
                                </path>
                            </svg>
                            Friends
                        </a>
                        <a href="workouts"
                           class="p-3 hover:bg-orange-50/60 rounded-xl font-medium text-gray-700 flex items-center gap-3 transition">
                            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                                </path>
                            </svg>
                            My Packages
                        </a>
                        <a href="community"
                           class="p-3 hover:bg-orange-50/60 rounded-xl font-medium text-gray-700 flex items-center gap-3 transition">
                            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                                </path>
                            </svg>
                            Coaches List
                        </a>
                    </nav>
                </aside>

                <!-- Center Column: Main Feed -->
                <section class="home-center-feed w-full max-w-2xl flex flex-col gap-4 min-w-0">

                    <!-- Create Post Box -->
                    <div class="bg-white rounded-xl shadow-sm p-4 hover:shadow-md transition-shadow">
                        <div class="flex gap-3 items-center">
                            <div
                                class="w-10 h-10 rounded-full bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] flex-shrink-0 flex items-center justify-center text-white font-bold text-sm shadow-sm">
                                @userInitials
                            </div>
                            <div @onclick='() => OpenCreatePostModal()'
                                 class="w-full bg-gray-100 hover:bg-gray-200/80 rounded-full py-2.5 px-4 text-gray-500 text-sm transition cursor-pointer flex items-center select-none">
                                <span>What's on your mind about today's workout?</span>
                            </div>
                        </div>
                        <hr class="my-3 border-gray-100" />
                        <div class="flex flex-wrap justify-between items-center gap-2 px-1">
                            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                                <button type="button" @onclick='() => OpenCreatePostModal("PHOTO")'
                                        class="text-gray-600 font-medium hover:bg-orange-50 px-3 py-1.5 rounded-lg flex items-center gap-2 text-xs md:text-sm transition"
                                        title="Add photo or video">
                                    <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                        </path>
                                    </svg>
                                    <span>Photo/Video</span>
                                </button>
                                <button type="button" @onclick='() => OpenCreatePostModal(postType: "Find Coach")'
                                        class="text-gray-600 font-medium hover:bg-orange-50 px-3 py-1.5 rounded-lg flex items-center gap-2 text-xs md:text-sm transition"
                                        title="Find Coach">
                                    <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                    </svg>
                                    <span>Find Coach</span>
                                </button>
                                @if (isCoach)
                                {
                                    <button type="button" @onclick='() => OpenCreatePostModal(postType: "Find Trainee")'
                                            class="text-gray-600 font-medium hover:bg-orange-50 px-3 py-1.5 rounded-lg flex items-center gap-2 text-xs md:text-sm transition"
                                            title="Find Trainee">
                                        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                                            </path>
                                        </svg>
                                        <span>Find Trainee</span>
                                    </button>
                                }
                            </div>
                            <!-- Post Button with Logo Gradient -->
                            <button type="button" @onclick='() => OpenCreatePostModal()'
                                    class="bg-gradient-to-r from-[#FF8C00] via-[#FF5500] to-[#FF3B00] hover:opacity-95 text-white px-5 py-1.5 rounded-lg font-semibold shadow-sm text-sm transition">
                                Post
                            </button>
                        </div>
                    </div>

                    <!-- Filter Bar -->
                    <div class="flex items-center justify-between py-1 border-b border-gray-200">
                        <div class="flex items-center gap-2">
                            <h2 class="font-semibold text-gray-700 text-sm">Latest Posts</h2>
                            @if (!string.IsNullOrWhiteSpace(searchTerm))
                            {
                                <span
                                    class="text-xs bg-orange-100 text-[#FF5500] px-2 py-0.5 rounded-full font-medium flex items-center gap-1">
                                    Query: "@searchTerm"
                                    <button @onclick="ClearSearch" class="hover:text-red-600 font-bold ml-1"
                                            title="Clear query">×</button>
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedPostType))
                            {
                                <span
                                    class="text-xs bg-orange-100 text-[#FF5500] px-2 py-0.5 rounded-full font-medium flex items-center gap-1">
                                    Type: @selectedPostType
                                    <button @onclick="() => FilterByPostType(null)" class="hover:text-red-600 font-bold ml-1"
                                            title="Clear filter">×</button>
                                </span>
                            }
                        </div>
                        <div class="relative">
                            <button @onclick="ToggleFilterDropdown"
                                    class="text-xs text-[#FF5500] font-medium flex items-center gap-1 hover:underline">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4">
                                    </path>
                                </svg>
                                Filter Posts
                            </button>
                            @if (showFilterDropdown)
                            {
                                <div
                                    class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg border border-gray-100 py-1 z-40 text-xs">
                                    <button @onclick="() => FilterByPostType(null)"
                                            class="w-full text-left px-4 py-2 hover:bg-orange-50 font-medium @(string.IsNullOrEmpty(selectedPostType) ? "text-[#FF5500] bg-orange-50/50" : "text-gray-700")">
                                        All Categories
                                    </button>
                                    <button @onclick='() => FilterByPostType("Normal")'
                                            class="w-full text-left px-4 py-2 hover:bg-orange-50 font-medium @(selectedPostType == "Normal" ? "text-[#FF5500] bg-orange-50/50" : "text-gray-700")">
                                        Normal
                                    </button>
                                    <button @onclick='() => FilterByPostType("Find Coach")'
                                            class="w-full text-left px-4 py-2 hover:bg-orange-50 font-medium @(selectedPostType == "Find Coach" ? "text-[#FF5500] bg-orange-50/50" : "text-gray-700")">
                                        Find Coach
                                    </button>
                                    <button @onclick='() => FilterByPostType("Find Trainee")'
                                            class="w-full text-left px-4 py-2 hover:bg-orange-50 font-medium @(selectedPostType == "Find Trainee" ? "text-[#FF5500] bg-orange-50/50" : "text-gray-700")">
                                        Find Trainee
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Feed Posts Stream -->
                    @if (isLoading)
                    {
                        <div class="flex flex-col gap-4">
                            @for (int i = 0; i < 2; i++)
                            {
                                <div class="bg-white rounded-xl shadow-sm p-4 animate-pulse">
                                    <div class="flex items-center gap-3 mb-4">
                                        <div class="w-10 h-10 rounded-full bg-gray-200"></div>
                                        <div class="flex-1 space-y-2">
                                            <div class="h-3.5 bg-gray-200 rounded w-1/4"></div>
                                            <div class="h-2.5 bg-gray-200 rounded w-1/3"></div>
                                        </div>
                                    </div>
                                    <div class="space-y-2 mb-4">
                                        <div class="h-3 bg-gray-200 rounded"></div>
                                        <div class="h-3 bg-gray-200 rounded w-5/6"></div>
                                    </div>
                                    <div class="h-48 bg-gray-100 rounded-lg mb-3"></div>
                                </div>
                            }
                        </div>
                    }
                    else if (posts == null || !posts.Any())
                    {
                        <div class="bg-white rounded-xl shadow-sm p-10 text-center text-gray-500">
                            <div class="w-16 h-16 mx-auto mb-3 text-orange-400">
                                <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                          d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z">
                                    </path>
                                </svg>
                            </div>
                            <h3 class="text-base font-bold text-gray-800 mb-1">No posts found</h3>
                            <p class="text-xs text-gray-400 mb-4">Be the first to share your workout journey today!</p>
                            @if (!string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrWhiteSpace(selectedPostType))
                            {
                                <button @onclick="ResetFilters" class="text-xs text-[#FF5500] font-semibold hover:underline">
                                    Reset Search & Filters
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var post in posts)
                        {
                            <article class="bg-white rounded-xl shadow-sm p-4 transition hover:shadow-md w-full min-w-0" @key="post.Id">
                                <div class="flex justify-between items-center mb-3">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(post.AuthorAvatarUrl))
                                        {
                                            <img src="@post.AuthorAvatarUrl" alt="@post.AuthorName"
                                                 class="w-10 h-10 rounded-full object-cover border border-gray-100" />
                                        }
                                        else
                                        {
                                            <div
                                                class="w-10 h-10 rounded-full bg-gradient-to-r from-orange-400 to-amber-500 flex items-center justify-center text-white font-bold text-sm">
                                                @(string.IsNullOrWhiteSpace(post.AuthorName) ? "U" : post.AuthorName.Substring(0,
                                    1).ToUpper())
                                            </div>
                                        }
                                        <div>
                                            <h3 class="font-bold text-gray-900 text-sm">@(post.AuthorName ?? "FitSocial Athlete")</h3>
                                            <!-- Post Metadata -->
                                            <div class="flex items-center gap-1.5 text-xs text-gray-500 flex-wrap">
                                                <span>@GetTimeAgo(post.CreatedAt)</span>
                                                @if (!string.IsNullOrWhiteSpace(post.PostType))
                                                {
                                                    <span>•</span>
                                                    @if (post.PostType.Equals("Find Coach", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span
                                                            class="inline-flex items-center gap-1 bg-amber-50 text-amber-700 font-semibold px-2 py-0.5 rounded-full border border-amber-200 text-[11px]">
                                                            <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor"
                                                                 viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                                            </svg>
                                                            Find Coach
                                                        </span>

@page "/register"
@layout AuthLayout
@using System.Timers
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject IAuthService AuthService
@inject GoogleSignInService GoogleSignIn
@inject PendingCoachRegistration PendingCoach
@inject ITermsService TermsService
@inject IEkycService EkycService
@inject IPaymentService PaymentService
@inject NavigationManager Navigation

<PageTitle>Join the FitSocial Community</PageTitle>

<div class="reg-hero">
    <img src="Logo_FitSocial.jpg" alt="FitSocial" class="hero-logo" />
    <div class="hero-text">
        <h1 class="hero-title">Join the <span>FitSocial</span> Community</h1>
        <p class="hero-sub">Unlock your unlimited physical potential, sync your smart training journey and connect with thousands of athletes and top coaches.</p>
    </div>
</div>

<div class="reg-card">
    <!-- Role tabs -->
    <div class="role-tabs">
        <button type="button" class="role-tab @(selectedRole == "TRAINEE" ? "active" : "")" @onclick='() => SelectRole("TRAINEE")'>
            <span class="role-icon"><AppIcon Name="person" /></span>
            <span>Trainee</span>
        </button>
        <button type="button" class="role-tab @(selectedRole == "COACH" ? "active" : "")" @onclick='() => SelectRole("COACH")'>
            <span class="role-icon"><AppIcon Name="briefcase" /></span>
            <span>Coach</span>
        </button>
    </div>

    <!-- Google (Trainee only) -->
    @if (!isCoach)
    {
        <button type="button" class="btn-google" @onclick="HandleGoogleButtonAsync">
            <AppIcon Name="google" /><span>Sign in with Google</span>
        </button>
    }

    @if (isCoach)
    {
        <div class="coach-banner">
            <span class="coach-banner-icon"><AppIcon Name="shield" /></span>
            <div>
                <strong>For Certified Professional Coaches</strong>
                <p>Join the official FitSocial coaching network to offer 1-on-1 classes, publish lesson plans and earn from your sports expertise.</p>
            </div>
        </div>
        <!-- Step indicator for Coach 5-step -->
        <div class="coach-steps">
            @for (int i = 1; i <= 5; i++)
            {
                var step = i;
                <div class="cstep @(coachStep == step ? "active" : coachStep > step ? "done" : "")">
                    <span class="cstep-dot">@(coachStep > step ? "✓" : step.ToString())</span>
                    <small>@GetStepLabel(step)</small>
                </div>
                @if (step < 5) { <span class="cstep-line @(coachStep > step ? "done" : "")"></span> }
            }
        </div>
    }

    @if (!isCoach)
    {
        <div class="divider"><span>OR SIGN UP WITH EMAIL</span></div>
    }

    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <div class="auth-alert info" role="alert"><AppIcon Name="info" /><span>@infoMessage</span></div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="auth-alert error" role="alert"><AppIcon Name="warning" /><span>@errorMessage</span></div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="auth-alert success" role="alert"><AppIcon Name="check" /><span>@successMessage</span></div>
    }

    @if (!isCoach)
    {
        <!-- ================= TRAINEE FLOW (unchanged) ================= -->
        <EditForm EditContext="@editContext" OnSubmit="HandleCompleteRegister">
            <DataAnnotationsValidator />

            <div class="field">
                <label>Full name <span class="req">*</span></label>
                <div class="input-wrap">
                    <span class="input-icon"><AppIcon Name="person" /></span>
                    <InputText @bind-Value="registerModel.FullName" class="form-control has-icon" placeholder="E.g.: John Smith" />
                </div>
                <ValidationMessage For="@(() => registerModel.FullName)" class="field-error" />
            </div>

            <div class="field">
                <label>Email address <span class="req">*</span></label>
                <div class="input-wrap">
                    <span class="input-icon"><AppIcon Name="envelope" /></span>
                    <InputText @bind-Value="registerModel.Email" class="form-control has-icon" placeholder="athlete@fitsocial.vn" />
                </div>
                <ValidationMessage For="@(() => registerModel.Email)" class="field-error" />
            </div>

            <div class="field">
                <label>Secure password <span class="req">*</span></label>
                <div class="input-wrap">
                    <span class="input-icon"><AppIcon Name="lock" /></span>
                    <InputText type="@(showPassword ? "text" : "password")" @bind-Value="registerModel.Password" class="form-control has-icon has-eye" placeholder="Minimum 8 characters" />
                    <button type="button" class="eye-btn" @onclick="() => showPassword = !showPassword" title="Show/hide password">
                        <AppIcon Name="@(showPassword ? "eye-slash" : "eye")" />
                    </button>
                </div>
                <ValidationMessage For="@(() => registerModel.Password)" class="field-error" />
            </div>

            <div class="field">
                <label>Confirm password <span class="req">*</span></label>
                <div class="input-wrap">
                    <span class="input-icon"><AppIcon Name="lock" /></span>
                    <InputText type="@(showConfirmPassword ? "text" : "password")" @bind-Value="registerModel.ConfirmPassword" class="form-control has-icon has-eye" placeholder="Re-enter your password" />
                    <button type="button" class="eye-btn" @onclick="() => showConfirmPassword = !showConfirmPassword" title="Show/hide password">
                        <AppIcon Name="@(showConfirmPassword ? "eye-slash" : "eye")" />
                    </button>
                </div>
                <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="field-error" />
            </div>

            <div class="otp-panel">
                <div class="otp-head">
                    <span class="otp-icon"><AppIcon Name="envelope" /></span>
                    <div><strong>Secure OTP verification</strong><p>A 6-digit OTP code will be sent to your email to activate your account right after confirmation.</p></div>
                </div>
                <div class="otp-boxes">
                    @for (int i = 0; i < 6; i++)
                    {
                        int idx = i;
                        <input maxlength="1" inputmode="numeric" autocomplete="one-time-code" class="otp-box" value="@otpDigits[idx]" @oninput="(e) => OnOtpInput(e, idx)" @onkeydown="(e) => OnOtpKeyDown(e, idx)" @ref="otpRefs[idx]" />
                    }
                </div>
                @if (showOtpError && CombinedOtp.Length != 6) { <div class="field-error text-center">Please enter the full 6-digit OTP code.</div> }
                <div class="otp-foot">
                    <span class="resend-hint">Didn't receive the code?</span>
                    @if (!otpSent) { <button type="button" class="resend-link" @onclick="HandleSendOtp" disabled="@isSendingOtp"><AppIcon Name="refresh" /> Send OTP@(isSendingOtp ? "..." : "")</button> }
                    else if (countdown > 0) { <span class="resend-wait"><AppIcon Name="refresh" /> Resend OTP (@(countdown)s)</span> }
                    else { <button type="button" class="resend-link" @onclick="HandleSendOtp" disabled="@isSendingOtp"><AppIcon Name="refresh" /> Resend OTP@(isSendingOtp ? "..." : "")</button> }
                </div>
            </div>

            <label class="terms">
                <input type="checkbox" @bind="agreedTerms" />
                <span>I agree to the <a href="" @onclick:preventDefault>Terms of Service</a> and <a href="" @onclick:preventDefault>Privacy Policy</a> of the FitSocial sports platform. @(latestTerm != null ? $"({latestTerm.Version})" : "")</span>
            </label>
            @if (latestTerm != null) { <details class="terms-box"><summary>@latestTerm.Title</summary><div class="terms-content">@latestTerm.Content</div></details> }
            @if (showTermsError && !agreedTerms) { <div class="field-error">Please agree to the terms of service to continue.</div> }

            <button type="submit" class="btn-auth-primary" disabled="@isLoading">
                @if (isLoading) { <span class="spinner-border spinner-border-sm me-2" role="status"></span><span>Creating account...</span> } else { <span>Create Trainee Account Now →</span> }
            </button>
        </EditForm>
    }
    else
    {
        <!-- ================= COACH 5-STEP WIZARD ================= -->
        @if (coachStep == 1)
        {
            <!-- Step 1: Account info + OTP (tương tự trainee) -->
            <EditForm EditContext="@editContext" OnSubmit="HandleCoachStep1Next">
                <DataAnnotationsValidator />
                <div class="field">
                    <label>Coach full name <span class="req">*</span></label>
                    <div class="input-wrap"><span class="input-icon"><AppIcon Name="person" /></span><InputText @bind-Value="registerModel.FullName" class="form-control has-icon" placeholder="Coach: John Smith" /></div>
                    <ValidationMessage For="@(() => registerModel.FullName)" class="field-error" />
                </div>
                <div class="field">
                    <label>Contact phone number <span class="req">*</span></label>
                    <div class="input-wrap"><span class="input-icon"><AppIcon Name="phone" /></span><InputText @bind-Value="registerModel.PhoneNumber" class="form-control has-icon" placeholder="0912345678" /></div>
                    @if (showCoachErrors && string.IsNullOrWhiteSpace(registerModel.PhoneNumber)) { <div class="field-error">Please enter your contact phone number.</div> }
                </div>
                <div class="field">
                    <label>Professional work email <span class="req">*</span></label>
                    <div class="input-wrap"><span class="input-icon"><AppIcon Name="envelope" /></span><InputText @bind-Value="registerModel.Email" class="form-control has-icon" placeholder="athlete@fitsocial.vn" /></div>
                    <ValidationMessage For="@(() => registerModel.Email)" class="field-error" />
                </div>
                <div class="field">
                    <label>Secure password <span class="req">*</span></label>
                    <div class="input-wrap"><span class="input-icon"><AppIcon Name="lock" /></span><InputText type="@(showPassword ? "text" : "password")" @bind-Value="registerModel.Password" class="form-control has-icon has-eye" placeholder="Minimum 8 characters" /><button type="button" class="eye-btn" @onclick="() => showPassword = !showPassword"><AppIcon Name="@(showPassword ? "eye-slash" : "eye")" /></button></div>
                    <ValidationMessage For="@(() => registerModel.Password)" class="field-error" />
                </div>
                <div class="field">
                    <label>Confirm password <span class="req">*</span></label>
                    <div class="input-wrap"><span class="input-icon"><AppIcon Name="lock" /></span><InputText type="@(showConfirmPassword ? "text" : "password")" @bind-Value="registerModel.ConfirmPassword" class="form-control has-icon has-eye" placeholder="Re-enter your password" /><button type="button" class="eye-btn" @onclick="() => showConfirmPassword = !showConfirmPassword"><AppIcon Name="@(showConfirmPassword ? "eye-slash" : "eye")" /></button></div>
                    <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="field-error" />
                </div>
                <div class="otp-panel">
                    <div class="otp-head"><span class="otp-icon"><AppIcon Name="envelope" /></span><div><strong>Secure OTP verification</strong><p>A 6-digit code will be sent to your email.</p></div></div>
                    <div class="otp-boxes">
                        @for (int i = 0; i < 6; i++) { int idx = i; <input maxlength="1" inputmode="numeric" class="otp-box" value="@otpDigits[idx]" @oninput="(e) => OnOtpInput(e, idx)" @onkeydown="(e) => OnOtpKeyDown(e, idx)" @ref="otpRefs[idx]" /> }
                    </div>
                    @if (showOtpError && CombinedOtp.Length != 6) { <div class="field-error text-center">Please enter the full 6-digit OTP code.</div> }
                    <div class="otp-foot">
                        <span class="resend-hint">Didn't receive the code?</span>
                        @if (!otpSent) { <button type="button" class="resend-link" @onclick="HandleSendOtp" disabled="@isSendingOtp"><AppIcon Name="refresh" /> Send OTP</button> }
                        else if (countdown > 0) { <span class="resend-wait"><AppIcon Name="refresh" /> Resend OTP (@(countdown)s)</span> }
                        else { <button type="button" class="resend-link" @onclick="HandleSendOtp" disabled="@isSendingOtp"><AppIcon Name="refresh" /> Resend OTP</button> }
                    </div>
                </div>
                <button type="submit" class="btn-auth-primary btn-coach" disabled="@isLoading">@if (isLoading) { <span class="spinner-border spinner-border-sm me-2"></span><span>Verifying...</span> } else { <span>Next: Identity Verification →</span> }</button>
            </EditForm>
        }
        else if (coachStep == 2)
        {
            <!-- Step 2: CCCD - thực: Bóc tách + Face Matching + Liveness (Portrait + Left/Right + Gần/Xa) -->
            <div class="field"><label>Identity card (CCCD) - Front side <span class="req">*</span></label><UploadBox Label="Front" UploadTitle="Upload Front Side of CCCD" UploadSubtitle="JPG, PNG (max 10MB)" @bind-Value="registerModel.FrontCardUrl" /></div>
            <div class="field"><label>Identity card (CCCD) - Back side <span class="req">*</span></label><UploadBox Label="Back" UploadTitle="Upload Back Side of CCCD" UploadSubtitle="JPG, PNG (max 10MB)" @bind-Value="registerModel.BackCardUrl" /></div>
            <div class="field">
                <label>Live Face Verification (Biometric) <span class="req">*</span></label>
                <div class="liveness-instruct alert alert-info" style="font-size:13px; margin-bottom:8px; padding:8px 10px; border-radius:8px; background:#e8f4fd; border:1px solid #b6e0ff;">
                    <strong>Hướng dẫn sống:</strong> Nhìn thẳng (Portrait) - đưa mặt lại gần/ra xa 20cm để rõ nét - sau đó quay trái 30° và phải 30° nếu muốn tăng độ chính xác. Ánh sáng đủ, không đeo kính râm.
                </div>
                <LiveFaceCapture @bind-Value="registerModel.FaceImageUrl" />
                <small class="muted">Bắt buộc: Portrait chính diện (dùng cho đối sánh + liveness Portrait)</small>
            </div>
            <details class="field" open>
                <summary style="cursor:pointer; font-weight:600; margin:6px 0;">Nâng cao: Thêm pose trái/phải (khuyến nghị - tăng tỉ lệ pass liveness)</summary>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:8px;">
                    <div><label>Left pose - Quay trái 30° <small class="muted">(optional)</small></label><LiveFaceCapture @bind-Value="registerModel.FaceImageLeftUrl" /></div>
                    <div><label>Right pose - Quay phải 30° <small class="muted">(optional)</small></label><LiveFaceCapture @bind-Value="registerModel.FaceImageRightUrl" /></div>
                </div>
                <small class="muted">Nếu có Left/Right, backend sẽ gọi <code>face_liveness</code> với <code>label_pose=Left/Right</code> thêm ngoài <code>Portrait</code>. Gần/xa thực hiện trong lúc capture Portrait (tiến/lùi 20cm).</small>
            </details>
            @if (!string.IsNullOrEmpty(ekycError)) { <div class="field-error">@ekycError</div> }
            @if (ekycResult != null) { <div class="auth-alert success"><AppIcon Name="check" /><span>CCCD verified: @ekycResult.FullNameOnCard (@ekycResult.IdCardNumber)</span></div> }
            <div class="wiz-actions">
                <button type="button" class="btn-back" @onclick="() => coachStep = 1">← Back</button>
                <button type="button" class="btn-auth-primary btn-coach flex-grow-1" @onclick="HandleEkycNext" disabled="@isVerifyingEkyc">@if (isVerifyingEkyc) { <span class="spinner-border spinner-border-sm me-2"></span><span>Verifying...</span> } else { <span>Next: Certificates →</span> }</button>
            </div>
        }
        else if (coachStep == 3)
        {
            <!-- Step 3: Certificates -->
            <div class="field">
                <label>Years of experience <span class="req">*</span></label><InputNumber @bind-Value="registerModel.ExperienceYears" class="form-control" placeholder="E.g.: 4" min="0" max="60" />
                @if (showCoachErrors && !(registerModel.ExperienceYears >= 0 && registerModel.ExperienceYears <= 60)) { <div class="field-error">Please enter years of experience (0-60).</div> }
            </div>
            <div class="field">
                <label>Credentials & professional certificates <span class="req">*</span></label>
                @foreach (var cert in registerModel.Certificates)
                {
                    <div class="cert-row">
                        <InputText @bind-Value="cert.CertificateName" class="form-control" placeholder="Certificate name (e.g. NASM, CSCS, ACE)" />
                        <InputDate @bind-Value="cert.IssuedDate" class="form-control" placeholder="Issued date" />
                        <UploadBox Label="Cert" UploadTitle="Choose certificate file" UploadSubtitle="PDF, PNG, JPG (max 10MB)" @bind-Value="cert.CertificateUrl" />
                        <button type="button" class="btn-remove" @onclick="() => RemoveCertificate(cert)">Remove</button>
                    </div>
                }
                <button type="button" class="btn-add-cert" @onclick="AddCertificate">+ Add certificate</button>
                @if (showCoachErrors && !registerModel.Certificates.Any(c => !string.IsNullOrWhiteSpace(c.CertificateUrl))) { <div class="field-error">Please upload at least one certificate.</div> }
                <small class="muted">Accepted: NASM, CSCS, ACE. PDF, PNG, JPG (max 10MB). Pending manual verification within 3 days after payment.</small>
            </div>
            <div class="field"><label>Biography</label><InputTextArea @bind-Value="registerModel.Biography" class="form-control" rows="3" placeholder="Coaching background and data-driven approach..." /></div>
            <label class="terms"><input type="checkbox" @bind="agreedTerms" /><span>I agree to the <a href="" @onclick:preventDefault>Terms of Service</a> and <a href="" @onclick:preventDefault>Privacy Policy</a> (@latestTerm?.Version) </span></label>
            @if (latestTerm != null) { <details class="terms-box"><summary>@latestTerm.Title</summary><div class="terms-content">@latestTerm.Content</div></details> }
            @if (showTermsError && !agreedTerms) { <div class="field-error">Please agree to the terms.</div> }
            <div class="wiz-actions">
                <button type="button" class="btn-back" @onclick="() => coachStep = 2">← Back</button>
                <button type="button" class="btn-auth-primary btn-coach flex-grow-1" @onclick="HandleCertificatesNext"><span>Next: Confirm →</span></button>
            </div>
        }
        else if (coachStep == 4)
        {
            <!-- Step 4: Confirm before payment -->
            <h4 class="fw-bold">Confirm Your Information</h4>
            <div class="confirm-box">
                <p><strong>Coach:</strong> @registerModel.FullName</p>
                <p><strong>Email:</strong> @registerModel.Email</p>
                <p><strong>Phone:</strong> @registerModel.PhoneNumber</p>
                <p><strong>Experience:</strong> @registerModel.ExperienceYears years</p>
                <p><strong>Bio:</strong> @registerModel.Biography</p>
                <p><strong>Certificates:</strong> @registerModel.Certificates.Count file(s)</p>
                <p><strong>CCCD:</strong> @(ekycResult?.IdCardNumber ?? "Verified")</p>
                @if (latestTerm != null) { <p><strong>Terms:</strong> @latestTerm.Version - @latestTerm.Title (Agreed)</p> }
                <hr />
                <p class="fw-bold">Total: @previewAmount VND</p>
            </div>
            <div class="wiz-actions">
                <button type="button" class="btn-back" @onclick="() => coachStep = 3">← Back</button>
                <button type="button" class="btn-auth-primary btn-coach flex-grow-1" @onclick="HandleConfirmPay" disabled="@isLoading">@if (isLoading) { <span class="spinner-border spinner-border-sm me-2"></span><span>Creating payment...</span> } else { <span>Pay @previewAmount VND →</span> }</button>
            </div>
        }
        else if (coachStep == 5)
        {
            <!-- Step 5: QR (same as CoachPayment but inline) -->
            <div class="qr-panel">
                <p class="qr-title">Scan with your banking app to pay</p>
                <img src="@QrImageUrl" alt="VietQR" class="qr-image" />
                <div class="qr-amount">@previewAmount VND</div>
                <div class="order-box"><div class="order-row"><span>Content</span><strong>COACH ACTIVATION</strong></div><div class="order-row"><span>Account</span><span>@activation?.AccountNumber (@activation?.AccountName)</span></div><div class="order-row"><span>Order code</span><span>@activation?.OrderCode</span></div></div>
                <p class="pay-note">Keep exact amount and content. Expires in about 15 minutes.</p>
                <div class="pay-actions">
                    <button type="button" class="btn-back" @onclick="HandleCancelOrderAsync" disabled="@isLoading">Cancel order</button>
                    <button type="button" class="btn-auth-primary btn-coach flex-grow-1" @onclick="HandleVerifyPaidAsync" disabled="@isLoading">@if (isLoading) { <span class="spinner-border spinner-border-sm me-2"></span><span>Verifying...</span> } else { <span>I've Paid — Verify Now →</span> }</button>
                </div>
                <p class="pay-note text-center"><a href="@activation?.CheckoutUrl" target="_blank">Open full PayOS checkout</a></p>
            </div>
        }
    }
</div>

<div class="reg-footer">
    Already have an account? <a href="login">Log in now</a>
</div>

@code {
    private RegisterRequest registerModel = new();
    private EditContext editContext = default!;

    private string selectedRole = "TRAINEE";
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private bool agreedTerms = false;
    private bool showTermsError = false;
    private bool showOtpError = false;
    private bool showCoachErrors = false;

    private string? infoMessage;
    private string? errorMessage;
    private string? successMessage;

    private bool otpSent = false;
    private bool isSendingOtp = false;
    private bool isLoading = false;
    private string[] otpDigits = new string[6] { "", "", "", "", "", "" };
    private ElementReference[] otpRefs = new ElementReference[6];

    private int countdown = 60;
    private Timer? timer;

    private string CombinedOtp => string.Concat(otpDigits);
    private bool isCoach => selectedRole == "COACH";
    private int coachStep = 1;

    // New wizard state
    private FitSocial.Client.Services.Terms.TermsDto? latestTerm;
    private EkycResult? ekycResult;
    private string? ekycError;
    private bool isVerifyingEkyc = false;
    private string previewAmount = "2,000";
    private ActivationLink? activation;

    private string QrImageUrl
    {
        get
        {
            var qr = activation?.QrCode ?? "";
            if (qr.StartsWith("data:", StringComparison.OrdinalIgnoreCase) || qr.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return qr;
            return $"https://api.qrserver.com/v1/create-qr-code/?size=240x240&data={Uri.EscapeDataString(qr)}";
        }
    }

    private string GetStepLabel(int step) => step switch { 1 => "Account", 2 => "CCCD", 3 => "Certificates", 4 => "Confirm", 5 => "Pay", _ => step.ToString() };

    protected override void OnInitialized()
    {
        editContext = new EditContext(registerModel);
        if (PendingCoach.HasDraft && PendingCoach.Draft != null)
        {
            registerModel = PendingCoach.Draft;
            selectedRole = "COACH";
            coachStep = 1;
            editContext = new EditContext(registerModel);
            infoMessage = "Welcome back! Your information has been restored. Please resend the OTP code to continue.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try { latestTerm = await TermsService.GetLatestAsync(); } catch { }
        // Fetch price for preview (no sports)
        try {
            var draft = new RegisterRequest { Email = "preview@fitsocial.vn", FullName = "Preview", Password = "123456", ConfirmPassword = "123456", PhoneNumber = "0900000000", ExperienceYears = 1 };
            var prep = await PaymentService.PrepareCoachActivationAsync(draft);
            if (prep.Success && prep.Data != null) previewAmount = prep.Data.AmountVnd.ToString("N0");
        } catch { }
    }

    private async Task HandleGoogleButtonAsync()
    {
        errorMessage = null; successMessage = null; infoMessage = null;
        if (!GoogleSignIn.IsConfigured) { infoMessage = "Google sign-in is not configured."; return; }
        await GoogleSignIn.BeginRedirectSignInAsync(selectedRole);
    }

    private void AddCertificate() { registerModel.Certificates.Add(new CoachCertificateItem()); }
    private void RemoveCertificate(CoachCertificateItem c) { registerModel.Certificates.Remove(c); }

    private void SelectRole(string role)
    {
        if (selectedRole != role)
        {
            otpSent = false; Array.Clear(otpDigits, 0, otpDigits.Length); timer?.Stop(); countdown = 60; showCoachErrors = false; coachStep = 1;
        }
        selectedRole = role; infoMessage = null;
    }

    private async Task HandleSendOtp()
    {
        errorMessage = null; successMessage = null; infoMessage = null;
        if (string.IsNullOrWhiteSpace(registerModel.Email) || !registerModel.Email.Contains("@")) { errorMessage = "Please enter a valid email address before requesting an OTP code."; return; }
        isSendingOtp = true;
        var result = await AuthService.SendOtpAsync(new SendOtpRequest { Email = registerModel.Email.Trim(), Purpose = selectedRole == "COACH" ? "REGISTER_COACH" : "REGISTER_TRAINEE" });
        if (result.Success) { otpSent = true; Array.Clear(otpDigits, 0, otpDigits.Length); StartCountdown(); successMessage = "The OTP code has been sent to your email (valid for 5 minutes)."; if (otpRefs[0].Context != null) await otpRefs[0].FocusAsync(); }
        else errorMessage = result.Message ?? "Failed to send the OTP code. Please try again.";
        isSendingOtp = false;
    }

    private async Task OnOtpInput(ChangeEventArgs e, int idx)
    {
        var raw = e.Value?.ToString() ?? ""; var digits = new string(raw.Where(char.IsDigit).ToArray());
        otpDigits[idx] = digits.Length > 0 ? digits[^1].ToString() : "";
        if (!string.IsNullOrEmpty(otpDigits[idx]) && idx < 5) await otpRefs[idx + 1].FocusAsync();
    }

    private async Task OnOtpKeyDown(KeyboardEventArgs e, int idx)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(otpDigits[idx]) && idx > 0) await otpRefs[idx - 1].FocusAsync();
    }

    private async Task HandleCompleteRegister()
    {
        errorMessage = null; successMessage = null; showTermsError = true; showOtpError = true; showCoachErrors = true;
        registerModel.OtpCode = CombinedOtp;
        bool formValid = editContext.Validate();
        bool otpOk = otpSent && CombinedOtp.Length == 6;
        if (!otpSent) { errorMessage = "Please click \"Send OTP\" to receive a verification code first."; return; }
        if (!otpOk) { errorMessage = "Please enter the full 6-digit OTP code."; return; }
        if (!agreedTerms) { errorMessage = "Please agree to the terms of service to continue."; return; }
        if (!formValid) { errorMessage = "Please review the information you entered."; return; }
        // Map TermId for trainee (coach sets it in step 3)
        if (!isCoach)
        {
            if (latestTerm == null) { errorMessage = "Terms are still loading. Please try again in a moment."; return; }
            registerModel.TermId = latestTerm.TermId;
        }
        isLoading = true;
        if (!isCoach) registerModel.PhoneNumber = null;
        registerModel.Gender = null; registerModel.DateOfBirth = null;
        if (isCoach)
        {
            PendingCoach.Draft = registerModel;
            Navigation.NavigateTo("/coach-payment"); return;
        }
        var result = await AuthService.RegisterAsync(registerModel);
        if (result.Success) { successMessage = "Account created successfully! Redirecting..."; await Task.Delay(1500); Navigation.NavigateTo("/home"); }
        else errorMessage = result.Message ?? "Registration failed. The OTP code is incorrect or has expired.";
        isLoading = false;
    }

    // --- Coach wizard handlers ---
    private async Task HandleCoachStep1Next()
    {
        errorMessage = null; successMessage = null; showOtpError = true; showCoachErrors = true;
        registerModel.OtpCode = CombinedOtp;
        bool formValid = editContext.Validate();
        bool otpOk = otpSent && CombinedOtp.Length == 6;
        if (string.IsNullOrWhiteSpace(registerModel.PhoneNumber)) { errorMessage = "Please enter your contact phone number."; return; }
        if (!formValid) { errorMessage = "Please review the information you entered."; return; }
        if (!otpSent) { errorMessage = "Please click \"Send OTP\" to receive a verification code first."; return; }
        if (!otpOk) { errorMessage = "Please enter the full 6-digit OTP code."; return; }
        isLoading = true;
        var verify = await AuthService.VerifyOtpAsync(registerModel.Email.Trim(), CombinedOtp, "REGISTER_COACH");
        isLoading = false;
        if (!verify.Success) { errorMessage = verify.Message ?? "Invalid OTP code."; showOtpError = true; return; }
        // OTP correct, go to eKYC
        coachStep = 2;
    }

    private async Task HandleEkycNext()
    {
        ekycError = null;
        if (string.IsNullOrWhiteSpace(registerModel.FrontCardUrl) || string.IsNullOrWhiteSpace(registerModel.BackCardUrl)) { ekycError = "Please upload both front and back of your ID card."; return; }
        if (string.IsNullOrWhiteSpace(registerModel.FaceImageUrl)) { ekycError = "Please capture your live face image."; return; }
        isVerifyingEkyc = true;
        var res = await EkycService.VerifyAsync(new EkycRequest { FrontCardUrl = registerModel.FrontCardUrl, BackCardUrl = registerModel.BackCardUrl, FaceImageUrl = registerModel.FaceImageUrl, FaceImageLeftUrl = registerModel.FaceImageLeftUrl, FaceImageRightUrl = registerModel.FaceImageRightUrl });
        isVerifyingEkyc = false;
        if (!res.Success) { ekycError = res.Error ?? "ID verification failed."; return; }
        ekycResult = res.Data;
        showCoachErrors = false;
        showTermsError = false;
        coachStep = 3;
        if (latestTerm == null) latestTerm = await TermsService.GetLatestAsync();
    }

    private void HandleCertificatesNext()
    {
        showCoachErrors = true; showTermsError = true;
        errorMessage = null;
        if (!(registerModel.ExperienceYears >= 0 && registerModel.ExperienceYears <= 60)) { errorMessage = "Please enter years of experience (0-60)."; return; }
        if (!registerModel.Certificates.Any(c => !string.IsNullOrWhiteSpace(c.CertificateUrl))) { errorMessage = "Please upload at least one certificate."; return; }
        if (!agreedTerms) { errorMessage = "Please agree to the terms."; return; }
        // Store term
        registerModel.TermId = latestTerm?.TermId;
        coachStep = 4;
        // Prepare price preview
        _ = Task.Run(async () => {
            var prep = await PaymentService.PrepareCoachActivationAsync(registerModel);
            if (prep.Success && prep.Data != null) { previewAmount = prep.Data.AmountVnd.ToString("N0"); await InvokeAsync(StateHasChanged); }
        });
    }

    private async Task HandleConfirmPay()
    {
        isLoading = true; errorMessage = null;
        // Keep pending for QR page
        PendingCoach.Draft = registerModel;
        var link = await PaymentService.CreateActivationLinkAsync(registerModel);
        if (!link.Success || link.Data == null) { errorMessage = link.Message ?? "Could not create payment link."; isLoading = false; return; }
        activation = link.Data;
        coachStep = 5;
        isLoading = false;
    }

    private async Task HandleVerifyPaidAsync()
    {
        if (activation == null) return;
        isLoading = true; errorMessage = null;
        var res = await PaymentService.CompleteActivationAsync(activation.OrderCode);
        if (res.Success) { successMessage = "Payment successful! Coach account created. Redirecting to login..."; await Task.Delay(1500); Navigation.NavigateTo("/login"); }
        else errorMessage = res.Message ?? "Payment not completed yet.";
        isLoading = false;
    }

    private async Task HandleCancelOrderAsync()
    {
        if (activation != null) await PaymentService.CancelActivationAsync(activation.OrderCode);
        coachStep = 4;
    }

    private void StartCountdown()
    {
        countdown = 60; timer?.Dispose(); timer = new Timer(1000);
        timer.Elapsed += (sender, e) => {
            if (countdown > 0) { countdown--; InvokeAsync(StateHasChanged); } else timer?.Stop();
        };
        timer.Start();
    }

    public void Dispose() { timer?.Dispose(); }
}

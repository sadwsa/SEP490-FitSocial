@page "/coach-activation"
@layout AuthLayout
@inject IPaymentService PaymentService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Coach Activation Payment - FitConnect</PageTitle>

<div class="login-hero">
    <img src="img/fitconnect-logo.png" alt="FitConnect" class="hero-logo" />
    <div class="hero-text">
        <h1 class="hero-title">Sign In to <span>FitConnect</span></h1>
        <p class="hero-sub">Access your training log, connect with coaches and continue your breakthrough sports journey.</p>
    </div>
</div>

<div class="reg-card">
        @if (isLoading)
        {
            <div class="flex flex-col items-center justify-center py-16">
                <div class="w-10 h-10 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-4"></div>
                <p class="text-gray-500 font-medium text-sm">Preparing your payment...</p>
            </div>
        }
        else if (activation == null)
        {
            <div class="bg-red-50 border border-red-200 text-red-700 p-6 rounded-xl text-center">
                <p class="font-bold mb-1">Could not prepare payment</p>
                <p class="text-sm mb-4">@(errorMessage ?? "Unknown error")</p>
                <button @onclick='() => Navigation.NavigateTo("/login")' class="px-5 py-2 bg-gray-100 text-sm font-semibold rounded-lg hover:bg-gray-200 transition">Back to Login</button>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center">
                <p class="font-bold text-gray-900 text-sm mb-4 text-center">Scan QR Code with Banking App</p>
                <div class="border border-gray-200 w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center mb-4 bg-white">
                    @if (!string.IsNullOrWhiteSpace(QrImageUrl))
                    {
                        <img src="@QrImageUrl" alt="VietQR payment code" class="w-60 h-60 sm:w-64 sm:h-64 object-contain" />
                    }
                    else
                    {
                        <div class="text-center text-gray-400 text-sm"><p>[ QR CODE IMAGE ]</p></div>
                    }
                </div>
                <div class="text-lg font-black text-gray-900 mb-5">@activation.Amount.ToString("N0") VND</div>
                <div class="w-full border border-gray-100 bg-gray-50/60 rounded-xl px-5 py-4 mb-3 flex flex-col gap-3 text-sm">
                    <div><span class="text-gray-500 text-xs">Content </span><span class="text-gray-900 font-semibold text-xs">COACH ACTIVATION</span></div>
                    <div><span class="text-gray-500 text-xs">Account </span><span class="text-gray-900 font-semibold text-xs">@activation.AccountNumber (@activation.AccountName)</span></div>
                    <div><span class="text-gray-500 text-xs">Order code </span><span class="text-gray-900 font-semibold text-xs">@activation.OrderCode</span></div>
                </div>
                <p class="text-xs text-gray-400 mb-2">Keep exact amount and content. Expires in about 15 minutes.</p>
                <p class="text-xs text-[#EA580C] font-semibold mb-4 flex items-center gap-1.5">
                    <span class="w-3 h-3 border-2 border-[#FF5500] border-t-transparent rounded-full animate-spin inline-block"></span>
                    Auto-checking payment status...
                </p>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="w-full bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl mb-4">@errorMessage</div>
                }
                <div class="w-full flex flex-col sm:flex-row gap-3">
                    <button @onclick="HandleVerifyPaidAsync" disabled="@isProcessing"
                            class="flex-1 py-3 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white font-bold text-sm rounded-xl shadow-md hover:shadow-lg transition disabled:opacity-60 cursor-pointer">
                        @(isProcessing ? "Verifying..." : "I've Paid — Verify Now")
                    </button>
                </div>
                <div class="text-center mt-4">
                    <button type="button" @onclick="GoToLoginAsync"
                            class="text-sm text-gray-500 hover:text-[#FF5500] underline bg-transparent border-0 cursor-pointer">
                        Quay lại đăng nhập
                    </button>
                </div>
            </div>
        }
    </div>

@code {
    private ActivationLink? activation;
    private bool isLoading = true;
    private bool isProcessing = false;
    private string? errorMessage;

    private string QrImageUrl
    {
        get
        {
            var qr = activation?.QrCode ?? "";
            if (string.IsNullOrWhiteSpace(qr)) return "";
            if (qr.StartsWith("data:", StringComparison.OrdinalIgnoreCase) || qr.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                return qr;
            return $"https://api.qrserver.com/v1/create-qr-code/?size=240x240&data={Uri.EscapeDataString(qr)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var res = await PaymentService.RegenerateCoachActivationAsync();
            if (res.Success && res.Data != null)
            {
                activation = res.Data;
                _ = StartAutoCheckAsync();
            }
            else
                errorMessage = res.Message ?? "Could not create payment link.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isLoading = false; }
    }

    private async Task HandleVerifyPaidAsync()
    {
        if (activation == null) return;
        isProcessing = true;
        errorMessage = null;
        try
        {
            var result = await PaymentService.CompleteActivationAsync(activation.OrderCode);
            if (result.Success && result.Data != null)
            {
                successMessage = "Payment successful! Your account is now active. Please sign in again.";
                StateHasChanged();
                await AuthService.LogoutAsync();
                await Task.Delay(1500);
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            errorMessage = result.Message ?? "Payment not completed yet.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isProcessing = false; }
    }

    private string? successMessage;
    private CancellationTokenSource? _autoCheckCts;

    private async Task StartAutoCheckAsync()
    {
        _autoCheckCts = new CancellationTokenSource();
        try
        {
            while (!_autoCheckCts.Token.IsCancellationRequested)
            {
                await Task.Delay(3000, _autoCheckCts.Token);
                if (activation == null) break;
                var res = await PaymentService.CompleteActivationAsync(activation.OrderCode);
                if (res.Success)
                {
                    successMessage = "Payment successful! Your account is now active. Please sign in again.";
                    StateHasChanged();
                    await Task.Delay(1500, _autoCheckCts.Token);
                    Navigation.NavigateTo("/login", forceLoad: true);
                    return;
                }
            }
        }
        catch (OperationCanceledException) { }
        catch { }
    }

    private async Task GoToLoginAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        _autoCheckCts?.Cancel();
        _autoCheckCts?.Dispose();
    }
}

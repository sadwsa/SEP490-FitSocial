                        }
                    </button>
                </div>
            </div>
        </div>
    }

@code {
    [Parameter]
    public Guid OrderDetailsId { get; set; }

    private TraineeWorkoutPlanProgressDto? workoutPlan;
    private bool isLoading = true;
    private string? errorMessage;
    private string? toastMessage;
    private bool toastIsError = false;
    private int _toastVersion = 0;
    private bool showReportCoachModal = false;

    private short selectedWeekNumber = 1;
    private short selectedDayNumber = 1;
    private TraineeWorkoutExerciseDto? activeExercise;
    private Guid? togglingExerciseId;
    private readonly Dictionary<Guid, string> exerciseNotes = new();

    private string GetExerciseNote(Guid exerciseId) =>
        exerciseNotes.TryGetValue(exerciseId, out var n) ? n : string.Empty;

    private void SetExerciseNote(Guid exerciseId, string? val)
    {
        if (string.IsNullOrWhiteSpace(val))
        {
            exerciseNotes.Remove(exerciseId);
        }
        else
        {
            exerciseNotes[exerciseId] = val;
        }
    }

    private TraineeWorkoutWeekDto? CurrentWeek =>
        workoutPlan?.Weeks.FirstOrDefault(w => w.WeekNumber == selectedWeekNumber)
        ?? workoutPlan?.Weeks.FirstOrDefault();

    private TraineeWorkoutDayDto? CurrentDay =>
        CurrentWeek?.Days.FirstOrDefault(d => d.DayNumber == selectedDayNumber)
        ?? CurrentWeek?.Days.FirstOrDefault();

    /// <summary>Business today in UTC+7, matching how the backend derives IsToday.</summary>
    private static readonly TimeSpan BusinessTimeZoneOffset = TimeSpan.FromHours(7);
    private static DateTime BusinessToday => DateTime.UtcNow.Add(BusinessTimeZoneOffset).Date;

    private static string FormatDayLabel(TraineeWorkoutDayDto day)
    {
        if (!day.ScheduledDate.HasValue)
        {
            return $"Day {day.DayNumber}";
        }

        var date = day.ScheduledDate.Value;
        var dayOfWeek = date.ToString("ddd");
        var label = date.ToString("dd/MM");

        return day.IsToday
            ? $"{dayOfWeek} ({label}) · Today"
            : $"{dayOfWeek} ({label})";
    }

    /// <summary>True when the exercise's scheduled day is before business today (UTC+7).</summary>
    private bool IsDayPast(TraineeWorkoutExerciseDto ex)
    {
        var date = ex.ScheduledDate ?? CurrentDay?.ScheduledDate;
        return date.HasValue && date.Value.Date < BusinessToday;
    }

    private Guid _loadedOrderDetailsId;

    protected override async Task OnInitializedAsync()
    {
        // This page has no search bar -> disable shared topbar search
        Shell.ShowSearch = false;
        await Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (OrderDetailsId != Guid.Empty && OrderDetailsId != _loadedOrderDetailsId)
        {
            _loadedOrderDetailsId = OrderDetailsId;
            await LoadWorkoutPlanAsync();
        }
    }

    public void Dispose()
    {
        Shell.Reset();
    }

    private async Task LoadWorkoutPlanAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var res = await TrainingPlanService.GetTraineeWorkoutPlanAsync(OrderDetailsId);
            if (res.Success && res.Data != null)
            {
                workoutPlan = res.Data;
                if (workoutPlan.Weeks.Any())
                {
                    var todayWeek = workoutPlan.Weeks.FirstOrDefault(w => w.Days.Any(d => d.IsToday));
                    var todayDay = todayWeek?.Days.FirstOrDefault(d => d.IsToday);
                    if (todayWeek != null && todayDay != null)
                    {
                        selectedWeekNumber = todayWeek.WeekNumber;
                        selectedDayNumber = todayDay.DayNumber;
                    }
                    else
                    {
                        selectedWeekNumber = workoutPlan.Weeks.First().WeekNumber;
                        if (workoutPlan.Weeks.First().Days.Any())
                        {
                            selectedDayNumber = workoutPlan.Weeks.First().Days.First().DayNumber;
                        }
                    }
                }
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load workout plan.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to load workout plan: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectWeek(short weekNumber)
    {
        selectedWeekNumber = weekNumber;
        var week = workoutPlan?.Weeks.FirstOrDefault(w => w.WeekNumber == weekNumber);
        if (week != null && week.Days.Any())
        {
            selectedDayNumber = week.Days.First().DayNumber;
        }
    }

    private void SelectDay(short dayNumber)
    {
        selectedDayNumber = dayNumber;
    }

    private void SetActiveVideo(TraineeWorkoutExerciseDto ex)
    {
        activeExercise = ex;
    }

    private async Task HandleSaveMissedReason(TraineeWorkoutExerciseDto ex)
    {
        var note = GetExerciseNote(ex.TrainingPlanExerciseId);
        if (string.IsNullOrWhiteSpace(note))
        {
            ShowToast("Please enter the reason for missing this workout.", isError: true);
            return;
        }

        togglingExerciseId = ex.TrainingPlanExerciseId;
        try
        {
            var dto = new ToggleWorkoutCompletionDto
            {
                TrainingPlanExerciseId = ex.TrainingPlanExerciseId,
                LogDate = ex.ScheduledDate ?? CurrentDay?.ScheduledDate ?? BusinessToday,
                Status = "INCOMPLETE",
                Notes = note.Trim()
            };

            var res = await TrainingPlanService.ToggleWorkoutCompletionAsync(dto);
            if (res.Success && res.Data != null)
            {
                ex.Status = "INCOMPLETE";
                ex.TraineeNotes = res.Data.Notes;
                exerciseNotes.Remove(ex.TrainingPlanExerciseId);
                ShowToast("Missed workout reason saved successfully!");
            }
            else
            {
                ShowToast(res.Message ?? "Failed to save missed workout reason.", isError: true);
            }
        }
        catch (Exception exception)
        {
            ShowToast($"Error: {exception.Message}", isError: true);
        }
        finally
        {
            togglingExerciseId = null;
        }
    }

    private void HandleCoachReportSubmitted(Guid coachId)
    {
        showReportCoachModal = false;
        ShowToast("Coach report submitted successfully. Our team will review it.");
    }

    private void ShowToast(string message, bool isError = false)
    {
        toastMessage = message;
        toastIsError = isError;
        var version = ++_toastVersion;
        StateHasChanged();
        _ = Task.Delay(3500).ContinueWith(_ =>
        {
            if (version != _toastVersion) return;
            toastMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }

    private bool IsYoutubeUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        return url.Contains("youtube.com") || url.Contains("youtu.be");
    }

    private string? GetEmbedVideoUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        url = url.Trim();
        if (url.Contains("youtube.com/watch?v="))
        {
            var id = url.Split("v=")[1].Split("&")[0];
            return $"https://www.youtube.com/embed/{id}";
        }
        if (url.Contains("youtu.be/"))
        {
            var id = url.Split("youtu.be/")[1].Split("?")[0];
            return $"https://www.youtube.com/embed/{id}";
        }
        return url;
    }

    private bool showProofModal = false;
    private TraineeWorkoutExerciseDto? submittingExercise;
    private string? proofMediaUrl;
    private string? proofNotes;
    private string? proofErrorMessage;
    private bool isUploadingProof = false;
    private bool isSubmittingProof = false;

    private void OpenSubmitProofModal(TraineeWorkoutExerciseDto ex)
    {
        submittingExercise = ex;
        proofMediaUrl = ex.MediaUrl;
        var inlineNote = GetExerciseNote(ex.TrainingPlanExerciseId);
        proofNotes = string.IsNullOrWhiteSpace(inlineNote) ? ex.TraineeNotes : inlineNote;
        proofErrorMessage = null;
        showProofModal = true;
    }

    private void CloseSubmitProofModal() => ResetSubmitProofModal(false);

    private void ResetSubmitProofModal(bool force)
    {
        if (!force && (isSubmittingProof || isUploadingProof)) return;
        showProofModal = false;
        submittingExercise = null;
        proofMediaUrl = null;
        proofNotes = null;
        proofErrorMessage = null;
    }

    private async Task HandleProofFileUpload(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        proofErrorMessage = null;
        isUploadingProof = true;
        try
        {
            var res = await FileUploadService.UploadAsync(file);
            if (res.Success && !string.IsNullOrWhiteSpace(res.Data))
            {
                proofMediaUrl = res.Data;
                ShowToast("Proof uploaded successfully!");
            }
            else
            {
                proofErrorMessage = res.Message ?? "Failed to upload file.";
                ShowToast(proofErrorMessage, isError: true);
            }
        }
        catch (Exception ex)
        {
            proofErrorMessage = $"Upload error: {ex.Message}";
            ShowToast(proofErrorMessage, isError: true);
        }
        finally
        {
            isUploadingProof = false;
        }
    }

    private async Task SubmitProofAsync()
    {
        if (submittingExercise == null || isSubmittingProof) return;

        proofErrorMessage = null;
        if (string.IsNullOrWhiteSpace(proofMediaUrl) && string.IsNullOrWhiteSpace(proofNotes))
        {
            proofErrorMessage = "Please attach proof photo/video or add workout notes.";
            ShowToast(proofErrorMessage, isError: true);
            return;
        }

        isSubmittingProof = true;
        try
        {
            var dto = new RequestWorkoutCompletionDto
            {
                TrainingPlanExerciseId = submittingExercise.TrainingPlanExerciseId,
                LogDate = submittingExercise.ScheduledDate ?? CurrentDay?.ScheduledDate ?? BusinessToday,
                MediaUrl = string.IsNullOrWhiteSpace(proofMediaUrl) ? null : proofMediaUrl.Trim(),
                Notes = string.IsNullOrWhiteSpace(proofNotes) ? null : proofNotes.Trim()
            };

            var res = await TrainingPlanService.RequestWorkoutCompletionAsync(dto);
            if (res.Success && res.Data != null)
            {
                submittingExercise.IsCompleted = false;
                submittingExercise.Status = "PENDING_REVIEW";
                submittingExercise.MediaUrl = res.Data.MediaUrl;
                submittingExercise.TraineeNotes = res.Data.Notes;
                submittingExercise.WorkoutCompletionLogId = res.Data.WorkoutCompletionLogId;
                exerciseNotes.Remove(submittingExercise.TrainingPlanExerciseId);

                ResetSubmitProofModal(force: true);
                ShowToast("🎉 Workout completion request submitted! Please wait for coach review.");
            }
            else
            {
                proofErrorMessage = res.Message ?? "Failed to submit workout completion request.";
                ShowToast(proofErrorMessage, isError: true);
            }
        }
        catch (Exception ex)
        {
            proofErrorMessage = $"Error: {ex.Message}";
            ShowToast(proofErrorMessage, isError: true);
        }
        finally
        {
            isSubmittingProof = false;
        }
    }
}

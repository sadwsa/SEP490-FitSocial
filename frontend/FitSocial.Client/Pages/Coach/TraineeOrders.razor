@page "/coach/trainee-orders"
@page "/trainee-orders"
@implements IDisposable
@attribute [Authorize(Roles = "COACH")]
@inject FitSocial.Client.Services.Checkout.ICheckoutService CheckoutService
@inject FitSocial.Client.Services.Conversations.IConversationService ConversationService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject FitSocial.Client.Services.Auth.IAuthService AuthService
@inject AppShellContext Shell
@using FitSocial.Client.Layout
@using FitSocial.Client.Models.Orders
@using System.Security.Claims

<PageTitle>Trainee Purchase Orders - FitConnect</PageTitle>

<!-- Main Content Section -->
<div class="flex flex-col gap-6 min-w-0">
    <!-- Header Banner -->
    <div class="bg-white rounded-2xl shadow-sm p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border border-gray-100">
        <div>
            <h1 class="text-2xl font-black text-gray-900 tracking-tight">Trainee Purchase Orders History</h1>
            <p class="text-sm text-gray-500 mt-0.5">List of trainees who purchased packages and their order history to prepare training programs.</p>
        </div>

        <div class="flex items-center gap-2.5">
            <button @onclick="LoadTraineeOrdersAsync"
                    disabled="@isLoading"
                    class="px-4 py-2 bg-gray-50 hover:bg-gray-100 text-gray-700 font-semibold text-sm rounded-xl border border-gray-200 transition flex items-center gap-2 shadow-xs disabled:opacity-50 cursor-pointer">
                <AppIcon Name="refresh" Size="16" Class="@(isLoading ? "animate-spin text-[#EA580C]" : "text-gray-500")" />
                <span>Refresh</span>
            </button>
            <a href="coach/dashboard"
               class="px-4 py-2 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white font-semibold text-sm rounded-xl shadow-xs hover:shadow-md hover:-translate-y-0.5 transition flex items-center gap-2">
                <AppIcon Name="chart" Size="16" />
                <span>Dashboard</span>
            </a>
        </div>
    </div>

    <!-- Error Banner -->
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="p-4 bg-red-50 border border-red-200 rounded-2xl flex items-center justify-between text-red-700 text-sm">
            <div class="flex items-center gap-3">
                <AppIcon Name="warning" Size="20" Class="flex-shrink-0 text-red-500" />
                <span>@errorMessage</span>
            </div>
            <button @onclick="LoadTraineeOrdersAsync" class="font-semibold underline hover:text-red-800 cursor-pointer">Try Again</button>
        </div>
    }

    @if (isLoading && trainees == null)
    {
        <div class="bg-white rounded-2xl p-16 shadow-xs border border-gray-100 flex flex-col items-center justify-center">
            <div class="w-12 h-12 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-4"></div>
            <p class="text-gray-500 font-medium text-base">Loading trainees and purchase orders...</p>
        </div>
    }
    else if (trainees != null && trainees.Count == 0)
    {
        <!-- Empty State -->
        <div class="bg-white rounded-2xl shadow-xs border border-gray-100 p-12 text-center flex flex-col items-center">
            <div class="w-20 h-20 mb-4 rounded-full bg-orange-50 text-[#EA580C] flex items-center justify-center">
                <AppIcon Name="person" Size="40" />
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-2">No Trainee Orders Yet</h3>
            <p class="text-gray-500 max-w-md text-sm mb-6 leading-relaxed">
                No trainees have completed payment for your training packages yet. When trainees purchase your packages, their orders will appear here so you can prepare customized workout and nutrition plans!
            </p>
            <a href="training-packages" class="bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white px-6 py-2.5 rounded-xl font-bold text-sm shadow-xs hover:shadow-md transition">
                Manage My Packages
            </a>
        </div>
    }
    else if (trainees != null)
    {
        <!-- Search + filter bar -->
        <div class="bg-white rounded-2xl shadow-xs border border-gray-100 p-4 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <h2 class="text-lg font-black text-gray-900 tracking-tight">Enrolled Trainees</h2>
                <span class="bg-orange-100 text-[#C2410C] text-xs font-bold px-2 py-0.5 rounded-full">
                    @FilteredTrainees.Count
                </span>
            </div>

            <div class="relative w-full sm:w-80">
                <AppIcon Name="search" Size="16" Class="text-gray-400 absolute left-3 top-3 pointer-events-none" />
                <input type="text"
                       @bind="searchTraineeKeyword"
                       @bind:event="oninput"
                       placeholder="Search trainees by name, email..."
                       class="w-full pl-9 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-[#EA580C] focus:bg-white transition" />
            </div>
        </div>

        @if (FilteredTrainees.Count == 0)
        {
            <div class="bg-white rounded-2xl shadow-xs border border-gray-100 p-12 text-center text-sm text-gray-400">
                No trainees match your search keyword.
            </div>
        }
        else
        {
            <!-- Lưới ô vuông bo tròn, giống trang Coaches List / Package List -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var t in FilteredTrainees)
                {
                    <div class="bg-white rounded-2xl shadow-sm hover:shadow-md border border-gray-100 hover:border-orange-200 transition-all duration-300 flex flex-col overflow-hidden group">
                        <div class="p-5 flex flex-col flex-1">

                            <!-- Avatar + tên -->
                            <div class="flex items-center gap-4 mb-3">
                                <div class="relative flex-shrink-0">
                                    @if (!string.IsNullOrWhiteSpace(t.AvatarUrl))
                                    {
                                        <img src="@t.AvatarUrl" class="w-16 h-16 rounded-full border-[3px] border-[#FF5500] p-0.5 object-cover bg-white" alt="@t.FullName" referrerpolicy="no-referrer" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="w-16 h-16 rounded-full border-[3px] border-[#FF5500] p-0.5 bg-gradient-to-tr from-[#FF8C00] to-[#FF5500] text-white flex items-center justify-center font-bold text-xl bg-clip-content">
                                            @(t.FullName.Length >= 2 ? t.FullName.Substring(0, 2).ToUpper() : "TR")
                                        </div>
                                    }
                                    <span class="absolute bottom-0 right-0 w-3.5 h-3.5 bg-emerald-500 border-2 border-white rounded-full"></span>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h5 class="font-bold text-gray-900 text-base leading-tight truncate">@t.FullName</h5>
                                    <p class="text-gray-500 text-xs font-medium truncate mt-0.5">@t.Email</p>
                                    <p class="text-[11px] text-gray-400 truncate mt-1">
                                        Last order: @(t.LatestPurchasedAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "N/A")
                                    </p>
                                </div>
                            </div>

                            <!-- Thống kê -->
                            <div class="flex items-center gap-3 pt-3 mb-4 border-t border-gray-100 flex-wrap">
                                <div class="flex items-center gap-1.5">
                                    <AppIcon Name="doc" Size="16" Class="text-gray-400 flex-shrink-0" />
                                    <span class="font-semibold text-gray-800 text-sm">@t.TotalOrdersCount <span class="text-gray-500 font-normal text-xs">@(t.TotalOrdersCount > 1 ? "packages" : "package")</span></span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <AppIcon Name="cash" Size="16" Class="text-orange-400 flex-shrink-0" />
                                    <span class="font-semibold text-gray-800 text-sm">@t.TotalSpent.ToString("N0") <span class="text-gray-500 font-normal text-xs">VND</span></span>
                                </div>
                            </div>

                            <!-- Nút -->
                            <div class="grid grid-cols-2 gap-2">
                                <button type="button"
                                        @onclick="@(() => Navigation.NavigateTo($"/coach/trainee-orders/{t.TraineeId}"))"
                                        class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-xl text-sm font-bold hover:shadow-xs transition-all duration-200 cursor-pointer text-center truncate">
                                    View Details
                                </button>
                                <button type="button"
                                        @onclick="@(() => HandleMessageTraineeAsync(t.TraineeId))"
                                        disabled="@(openingChatTraineeId == t.TraineeId)"
                                        class="px-3 py-2 bg-[#FF5500] hover:bg-[#E64A00] text-white rounded-xl text-sm font-bold hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer flex items-center justify-center gap-1.5 disabled:opacity-50">
                                    @if (openingChatTraineeId == t.TraineeId)
                                    {
                                        <span class="inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                    }
                                    else
                                    {
                                        <AppIcon Name="chat" Size="15" />
                                    }
                                    <span>Message</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<CoachTraineeGroupDto>? trainees;
    private string searchTraineeKeyword = string.Empty;
    private bool isLoading = true;
    private string? errorMessage;
    private Guid? openingChatTraineeId;

    // Header State
    private string? headerSearchTerm = "";
    private string userName = "Coach";
    private string userInitials = "C";

    private List<CoachTraineeGroupDto> FilteredTrainees
    {
        get
        {
            if (trainees == null) return new();
            if (string.IsNullOrWhiteSpace(searchTraineeKeyword)) return trainees;

            var kw = searchTraineeKeyword.Trim().ToLowerInvariant();
            return trainees
                .Where(t => (t.FullName != null && t.FullName.ToLowerInvariant().Contains(kw))
                         || (t.Email != null && t.Email.ToLowerInvariant().Contains(kw)))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Topbar do AppShellLayout render: đăng ký hành vi tìm kiếm cho trang này
        Shell.SearchTerm = headerSearchTerm ?? string.Empty;
        Shell.SearchInputHandler = e =>
        {
            HandleHeaderSearchInput(e);
            return Task.CompletedTask;
        };
        Shell.SearchKeyUpHandler = e =>
        {
            HandleHeaderSearchKeyUp(e);
            return Task.CompletedTask;
        };
        Shell.SearchExecuteHandler = () => { ExecuteHeaderSearch(); return Task.CompletedTask; };
        Shell.SearchClearHandler = () => { ClearHeaderSearch(); return Task.CompletedTask; };

        await LoadUserInfoAsync();
        await LoadTraineeOrdersAsync();
    }

    public void Dispose()
    {
        Shell.Reset();
    }

    private async Task LoadTraineeOrdersAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var res = await CheckoutService.GetCoachTraineeOrdersAsync();
            if (res.Success && res.Data != null)
            {
                trainees = res.Data;
            }
            else
            {
                errorMessage = res.Message ?? "Failed to load trainee purchase orders.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Connection error: {ex.Message}";
        }

        isLoading = false;
    }

    private async Task LoadUserInfoAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                userName = user.Identity.Name ?? "Coach";
                var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 0)
                {
                    userInitials = parts.Length > 1
                        ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
                        : parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
                }
            }
            else
            {
                Navigation.NavigateTo($"login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
            }
        }
        catch
        {
            userInitials = "C";
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }

    private void HandleHeaderSearchInput(ChangeEventArgs e) { headerSearchTerm = e.Value?.ToString(); }
    private void HandleHeaderSearchKeyUp(KeyboardEventArgs e) { }
    private void ExecuteHeaderSearch() { }
    private void ClearHeaderSearch() { headerSearchTerm = string.Empty; }

    private async Task HandleMessageTraineeAsync(Guid traineeId)
    {
        if (openingChatTraineeId.HasValue) return;

        try
        {
            openingChatTraineeId = traineeId;
            StateHasChanged();

            var res = await ConversationService.GetOrCreateDirectConversationAsync(traineeId);
            if (res.Success && res.Data != null)
            {
                Navigation.NavigateTo($"messages/{res.Data.ConversationId}");
            }
            else
            {
                errorMessage = res.Message ?? "Could not open conversation with this trainee.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error opening chat: {ex.Message}";
        }
        finally
        {
            openingChatTraineeId = null;
            StateHasChanged();
        }
    }
}
@page "/training-packages/purchased"
@layout EmptyLayout
@inject ITrainingPackageService PackageService
@inject ICoachService CoachService
@inject NavigationManager Navigation
@using FitSocial.Client.Layout
@using FitSocial.Client.Models.TrainingPackages
@using FitSocial.Client.Models.Coaches
@using FitSocial.Client.Services.TrainingPackages
@using FitSocial.Client.Services.Coaches

<PageTitle>Purchased Packages - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <AppHeader />

    <style>
        @@media (min-width: 1024px) {
            .home-3col-layout {
                display: grid !important;
                grid-template-columns: minmax(18rem, 1fr) minmax(0, 42rem) minmax(18rem, 1fr) !important;
                align-items: start !important;
            }

            .home-left-sidebar {
                justify-self: start !important;
            }

            .home-center-feed {
                justify-self: end !important;
                width: 100% !important;
                max-width: 42rem !important;
                min-width: 0 !important;
            }

            .home-right-sidebar {
                justify-self: center !important;
            }
        }
    </style>

    <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">
        <!-- Sidebar -->
        <AppSidebar ActiveItem="purchased-packages" />

        <!-- Main Content -->
        <section class="home-center-feed w-full max-w-2xl flex flex-col gap-4 min-w-0 pb-10">
            <div class="bg-white rounded-xl shadow-sm p-5 flex justify-between items-center gap-4 border border-gray-100">
                <h1 class="text-xl font-bold text-gray-800">My Purchased Packages</h1>
            </div>

            @if (isLoading)
            {
                <div class="flex flex-col items-center justify-center py-10">
                    <div class="w-8 h-8 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-3"></div>
                    <p class="text-sm text-gray-500">Loading your purchases...</p>
                </div>
            }
            else if (errorMessage != null)
            {
                <div class="bg-red-50 text-red-600 p-4 rounded-xl text-center text-sm font-medium border border-red-100">@errorMessage</div>
            }
            else if (!packages.Any())
            {
                <div class="bg-white rounded-xl shadow-sm p-10 text-center flex flex-col items-center border border-gray-100">
                    <div class="w-16 h-16 mb-4 text-gray-300">
                        <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    </div>
                    <h4 class="font-bold text-gray-800 text-lg mb-2">No purchased packages</h4>
                    <p class="text-sm text-gray-500 mb-5">You haven't bought any training packages yet.</p>
                </div>
            }
            else
            {
                <!-- Giao diện kiểu Danh sách (List) -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <ul class="divide-y divide-gray-100">
                        @foreach (var pkg in packages)
                        {
                            <li class="p-5 hover:bg-gray-50 transition duration-200 cursor-pointer flex flex-col sm:flex-row justify-between sm:items-center gap-4" @onclick="() => ViewDetails(pkg.PackageId)">
                                <div>
                                    <h3 class="text-lg font-bold text-gray-800">@pkg.Title</h3>
                                    <p class="text-sm text-gray-500 mb-2">Coach: <span class="font-semibold text-gray-700">@pkg.CoachName</span></p>
                                    <div class="flex gap-3 text-xs font-semibold text-gray-500">
                                        <span class="bg-gray-100 px-2 py-1 rounded">@($"{pkg.DurationDays} Days")</span>
                                        <span class="bg-gray-100 px-2 py-1 rounded">@($"{pkg.Price:N0} đ")</span>
                                    </div>
                                </div>
                                <div class="text-right flex flex-col sm:items-end gap-2">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full bg-green-50 text-green-600 text-sm font-bold border border-green-100">
                                        Purchased
                                    </span>

                                    <!-- Nút Rate Coach bật Modal -->
                                    <button type="button" @onclick="() => OpenReviewModal(pkg.CoachId)" @onclick:stopPropagation="true" class="mt-1 px-4 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg border border-gray-200 transition-colors">
                                        Rate Coach
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>

        <aside class="home-right-sidebar hidden lg:flex w-72 flex-shrink-0 flex-col gap-4 sticky top-24"></aside>
    </div>
</div>

<!-- ĐÂY LÀ GIAO DIỆN CỬA SỔ BẬT LÊN (MODAL) NHẬP REVIEW -->
@if (isReviewModalOpen)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 z-[100] flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl max-w-sm w-full p-6 animate-fade-in-up">
            <h3 class="text-xl font-bold text-gray-900 mb-2 text-center">Rate Coach</h3>
            <p class="text-sm text-gray-500 text-center mb-6">How was your training experience?</p>

            @if (!string.IsNullOrEmpty(reviewErrorMessage))
            {
                <div class="bg-red-50 text-red-600 p-3 rounded-lg text-sm mb-4 font-medium border border-red-100">
                    @reviewErrorMessage
                </div>
            }

            <EditForm Model="reviewDto" OnValidSubmit="SubmitReview">
                <!-- Chọn số sao -->
                <div class="flex justify-center gap-2 mb-6">
                    @for (int i = 1; i <= 5; i++)
                    {
                        int star = i;
                        <button type="button" @onclick="() => reviewDto.Rating = star" class="focus:outline-none transition-transform hover:scale-110">
                            <svg class="w-10 h-10 @(star <= reviewDto.Rating ? "text-yellow-400" : "text-gray-200")" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                            </svg>
                        </button>
                    }
                </div>

                <!-- Nhập bình luận -->
                <div class="mb-6">
                    <InputTextArea @bind-Value="reviewDto.Comment" rows="3" class="w-full p-3 bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-300 resize-none text-sm" placeholder="Write your review here..."></InputTextArea>
                </div>

                <!-- Nút Cancel / Submit -->
                <div class="flex justify-end gap-3">
                    <button type="button" @onclick="CloseReviewModal" class="px-4 py-2 text-sm font-semibold text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">Cancel</button>
                    <button type="submit" disabled="@isSubmittingReview" class="px-4 py-2 text-sm font-semibold text-white bg-gray-800 rounded-lg hover:bg-gray-900 disabled:opacity-50 transition-colors flex items-center gap-2">
                        @if (isSubmittingReview)
                        {
                            <span class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        }
                        Submit
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private IEnumerable<TrainingPackageResponseDto> packages = new List<TrainingPackageResponseDto>();
    private bool isLoading = true;
    private string? errorMessage;

    // --- Các biến và hàm cho Modal Review ---
    private bool isReviewModalOpen = false;
    private Guid selectedCoachId;
    private CreateReviewDto reviewDto = new CreateReviewDto();
    private bool isSubmittingReview = false;
    private string? reviewErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        var response = await PackageService.GetPurchasedPackagesAsync();
        if (response.Success && response.Data != null)
        {
            packages = response.Data;
        }
        else
        {
            errorMessage = response.Message ?? "Failed to load purchased packages.";
        }
        isLoading = false;
    }

    private void ViewDetails(Guid id)
    {
        Navigation.NavigateTo($"/training-packages/{id}");
    }

    private void OpenReviewModal(Guid coachId)
    {
        selectedCoachId = coachId;
        reviewDto = new CreateReviewDto { Rating = 5 }; // Mặc định 5 sao
        reviewErrorMessage = null;
        isReviewModalOpen = true;
    }

    private void CloseReviewModal()
    {
        isReviewModalOpen = false;
    }

    private async Task SubmitReview()
    {
        isSubmittingReview = true;
        reviewErrorMessage = null;

        var response = await CoachService.SubmitReviewAsync(selectedCoachId, reviewDto);
        if (response.Success)
        {
            isReviewModalOpen = false; // Tắt modal khi thành công
            // (Bạn có thể gọi thư viện Toast Alert ở đây nếu muốn thông báo xanh)
        }
        else
        {
            reviewErrorMessage = response.Message ?? "Failed to submit review.";
        }
        isSubmittingReview = false;
    }
}

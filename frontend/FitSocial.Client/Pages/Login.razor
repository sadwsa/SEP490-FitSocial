@page "/login"
@layout AuthLayout
@inject IAuthService AuthService
@inject GoogleSignInService GoogleSignIn
@inject ITokenStorage TokenStorage
@inject NavigationManager Navigation

<PageTitle>Sign In - FitConnect</PageTitle>

<div class="login-hero">
    <img src="img/fitconnect-logo.png" alt="FitConnect" class="hero-logo" />
    <div class="hero-text">
        <h1 class="hero-title">Sign In to <span>FitConnect</span></h1>
        <p class="hero-sub">Access your training log, connect with coaches and continue your breakthrough sports journey.</p>
    </div>
</div>

<div class="reg-card">
    <!-- Google (redirect flow, works in Guest/Incognito) -->
    <button type="button" class="btn-google" @onclick="HandleGoogleButtonAsync">
        <AppIcon Name="google" /><span>Sign in with Google</span>
    </button>

    <div class="divider"><span>OR SIGN IN WITH ACCOUNT</span></div>

    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <div class="auth-alert info" role="alert"><AppIcon Name="info" /><span>@infoMessage</span></div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="auth-alert error" role="alert"><AppIcon Name="warning" /><span>@errorMessage</span></div>
    }

    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        <div class="field">
            <label>Email address <span class="req">*</span></label>
            <div class="input-wrap">
                <span class="input-icon"><AppIcon Name="envelope" /></span>
                <InputText @bind-Value="loginModel.Email" class="form-control has-icon" placeholder="E.g.: athlete@fitsocial.vn" />
            </div>
            <ValidationMessage For="@(() => loginModel.Email)" class="field-error" />
        </div>

        <div class="field">
            <label>Password <span class="req">*</span></label>
            <div class="input-wrap">
                <span class="input-icon"><AppIcon Name="lock" /></span>
                <InputText type="@(showPassword ? "text" : "password")" @bind-Value="loginModel.Password" class="form-control has-icon has-eye" placeholder="Enter your account password" />
                <button type="button" class="eye-btn" @onclick="() => showPassword = !showPassword" title="Show/hide password">
                    <AppIcon Name="@(showPassword ? "eye-slash" : "eye")" />
                </button>
            </div>
            <ValidationMessage For="@(() => loginModel.Password)" class="field-error" />
        </div>

        <div class="login-options">
            <label class="remember">
                <input type="checkbox" @bind="rememberMe" />
                <span>Remember me on this device</span>
            </label>
            <button type="button" class="link-button" @onclick='() => Navigation.NavigateTo("/forgot-password")'>Forgot password?</button>
        </div>

        <button type="submit" class="btn-auth-primary" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Signing in...</span>
            }
            else
            {
                <span>Sign In Now →</span>
            }
        </button>
    </EditForm>

    <div class="reg-footer">
        New to FitConnect? <a href="register">Create an account now →</a>
    </div>
</div>

@if (_showBlockedModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl border border-red-100 p-6 sm:p-8 text-center animate-in zoom-in-95 duration-200" style="color: #1e293b;">
            <!-- Icon -->
            <div class="w-16 h-16 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center mx-auto mb-4 border border-red-100 shadow-inner">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-gray-900 tracking-tight">Account Blocked</h3>

            <!-- Message -->
            <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                @_blockedMessage
            </p>

            <div class="mt-4 p-3 bg-amber-50/80 border border-amber-200 rounded-xl text-xs text-amber-800 text-left flex items-start gap-2">
                <svg class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>You may review the violation reports filed against your account and submit explanations/evidence for staff evaluation.</span>
            </div>

            <!-- Actions -->
            <div class="grid grid-cols-2 gap-3 mt-6">
                <button type="button"
                        @onclick="() => _showBlockedModal = false"
                        class="w-full py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm rounded-xl transition cursor-pointer">
                    Close
                </button>
                <button type="button"
                        @onclick="NavigateToAppeal"
                        class="w-full py-2.5 px-4 bg-gradient-to-r from-[#FF5500] to-[#FF8C00] hover:from-[#e04c00] hover:to-[#e67e00] text-white font-semibold text-sm rounded-xl shadow-md transition cursor-pointer flex items-center justify-center gap-1.5">
                    <span>Appeal Now</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private LoginRequest loginModel = new();
    private bool showPassword = false;
    private bool rememberMe = true;
    private string? infoMessage;
    private string? errorMessage;
    private bool isLoading = false;
    private bool _showBlockedModal = false;
    private string? _blockedAppealToken;
    private string? _blockedMessage;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "authError")]
    public string? AuthError { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        rememberMe = await TokenStorage.GetRememberMeAsync();

        // Error forwarded from /login-callback (Google round-trip loses in-memory state)
        if (!string.IsNullOrWhiteSpace(AuthError))
        {
            errorMessage = AuthError;
        }

        // Already signed in -> skip the login page, routing by CURRENT role
        // (an admin revisiting /login must go back to /admin, never to home)
        if (await AuthService.IsAuthenticatedAsync())
        {
            NavigateAfterLogin(await GetCurrentRoleAsync());
        }
    }

    private async Task<string?> GetCurrentRoleAsync()
    {
        if (AuthState == null)
        {
            return null;
        }

        var user = (await AuthState).User;
        if (user.IsInRole(AppRoles.Admin))
        {
            return AppRoles.Admin;
        }
        if (user.IsInRole(AppRoles.Staff))
        {
            return AppRoles.Staff;
        }
        if (user.IsInRole(AppRoles.Coach))
        {
            return AppRoles.Coach;
        }
        if (user.IsInRole(AppRoles.Trainee))
        {
            return AppRoles.Trainee;
        }
        return null;
    }

    private void NavigateAfterLogin(string? roleCode = null)
    {
        bool isBackOffice = string.Equals(roleCode?.Trim(), AppRoles.Admin, StringComparison.OrdinalIgnoreCase)
            || string.Equals(roleCode?.Trim(), AppRoles.Staff, StringComparison.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(ReturnUrl) &&
            !ReturnUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            bool wantsAdminArea = ReturnUrl.TrimStart('/').StartsWith("admin", StringComparison.OrdinalIgnoreCase);
            if (wantsAdminArea == isBackOffice)
            {
                Navigation.NavigateTo(ReturnUrl);
                return;
            }
        }

        Navigation.NavigateTo(isBackOffice ? "/admin" : "home");
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;
        infoMessage = null;

        await TokenStorage.SetRememberMeAsync(rememberMe);

        // Shared login for all roles: no RoleCode sent, backend skips the role check
        loginModel.RoleCode = null;
        loginModel.RememberMe = rememberMe;
        var result = await AuthService.LoginAsync(loginModel);
        if (result.Success)
        {
            NavigateAfterLogin(result.Data?.User?.RoleCode);
        }
        else
        {
            if (result.Data?.IsBlockedDueToReports == true)
            {
                _blockedAppealToken = result.Data.AppealToken;
                _blockedMessage = !string.IsNullOrWhiteSpace(result.Data.BlockReasonMessage)
                    ? result.Data.BlockReasonMessage
                    : (result.Message ?? "Your account has been blocked due to multiple reports. You can submit an appeal if you believe this decision is incorrect.");
                _showBlockedModal = true;
            }
            else
            {
                errorMessage = result.Message ?? "Sign-in failed. Please check your information and try again.";
            }
        }

        isLoading = false;
    }

    private void NavigateToAppeal()
    {
        _showBlockedModal = false;
        if (!string.IsNullOrWhiteSpace(_blockedAppealToken))
        {
            Navigation.NavigateTo($"appeal?token={Uri.EscapeDataString(_blockedAppealToken)}");
        }
        else
        {
            Navigation.NavigateTo("appeal");
        }
    }

    private async Task HandleGoogleButtonAsync()
    {
        errorMessage = null;
        infoMessage = null;

        if (!GoogleSignIn.IsConfigured)
        {
            infoMessage = "Google sign-in is not configured.";
            return;
        }

        await TokenStorage.SetRememberMeAsync(rememberMe);
        await GoogleSignIn.BeginRedirectSignInAsync(null);
    }
}


@page "/workouts"

<PageTitle>Bài tập & Kế hoạch - FitSocial</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">🏋️ Danh mục Bài tập & Lộ trình</h3>
        <p class="text-muted mb-0">Khám phá các bài tập từ cơ bản đến nâng cao cho mục tiêu thể hình của bạn</p>
    </div>
    <button class="btn-fit-primary">
        <span>➕</span> <span>Tạo giáo án mới</span>
    </button>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3 col-6">
        <div class="fit-card text-center py-3">
            <span class="fs-1">🏋️‍♂️</span>
            <h6 class="fw-bold mt-2 mb-1">Gym & Tạ</h6>
            <small class="text-muted">45 bài tập</small>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="fit-card text-center py-3">
            <span class="fs-1">🤸</span>
            <h6 class="fw-bold mt-2 mb-1">Calisthenics</h6>
            <small class="text-muted">32 bài tập</small>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="fit-card text-center py-3">
            <span class="fs-1">🏃</span>
            <h6 class="fw-bold mt-2 mb-1">Cardio & Chạy</h6>
            <small class="text-muted">20 bài tập</small>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="fit-card text-center py-3">
            <span class="fs-1">🧘‍♀️</span>
            <h6 class="fw-bold mt-2 mb-1">Yoga & Giãn cơ</h6>
            <small class="text-muted">18 bài tập</small>
        </div>
    </div>
</div>

<div class="fit-card">
    <h5 class="fw-bold mb-3">Lộ trình phổ biến trong tuần</h5>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Tên bài tập / Lịch tập</th>
                    <th>Cấp độ</th>
                    <th>Thời lượng</th>
                    <th>Calo ước tính</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <strong>Push Day (Ngực - Vai - Tay sau)</strong>
                        <div class="text-muted small">Tập trung sức mạnh & độ dày cơ thân trên</div>
                    </td>
                    <td><span class="fit-badge fit-badge-primary">Trung cấp</span></td>
                    <td>60 phút</td>
                    <td>420 kcal</td>
                    <td><button class="btn btn-sm btn-outline-primary">Bắt đầu</button></td>
                </tr>
                <tr>
                    <td>
                        <strong>Pull Day (Lưng - Xô - Tay trước)</strong>
                        <div class="text-muted small">Kéo xà, Deadlift, Dumbbell Row</div>
                    </td>
                    <td><span class="fit-badge fit-badge-primary">Trung cấp</span></td>
                    <td>55 phút</td>
                    <td>390 kcal</td>
                    <td><button class="btn btn-sm btn-outline-primary">Bắt đầu</button></td>
                </tr>
                <tr>
                    <td>
                        <strong>Leg Day (Chân - Mông - Bụng)</strong>
                        <div class="text-muted small">Squat, Lunges, Leg Press, Plank</div>
                    </td>
                    <td><span class="fit-badge fit-badge-success">Nâng cao</span></td>
                    <td>70 phút</td>
                    <td>520 kcal</td>
                    <td><button class="btn btn-sm btn-outline-primary">Bắt đầu</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

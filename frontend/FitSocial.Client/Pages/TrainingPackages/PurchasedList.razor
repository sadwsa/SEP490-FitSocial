<!-- MODAL CREATE REFUND REQUEST -->
@if (isRefundModalOpen && refundPackage != null)
{
    <div class="fixed inset-0 bg-black/60 backdrop-blur-xs z-[100] flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full p-6 max-h-[92vh] overflow-y-auto animate-in fade-in zoom-in-95 border border-gray-100">
            <!-- Modal Header -->
            <div class="flex items-start justify-between gap-3 pb-4 border-b border-gray-100 mb-5">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-600 border border-rose-100">Refund Request</span>
                        <span class="text-xs text-gray-400">•</span>
                        <span class="text-xs text-gray-500 font-medium">Order #@((refundPackage.OrderId?.ToString("N") ?? "").Substring(0, Math.Min(8, (refundPackage.OrderId?.ToString("N") ?? "").Length)).ToUpperInvariant())</span>
                    </div>
                    <h3 class="text-xl font-black text-gray-900 leading-snug">@refundPackage.Title</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Coach: <strong class="text-gray-700">@refundPackage.CoachName</strong></p>
                </div>
                <button type="button" @onclick="CloseRefundModal" class="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 flex items-center justify-center transition cursor-pointer flex-shrink-0" title="Close">
                    &times;
                </button>
            </div>

            <!-- Target Bank Account Info -->
            @if (defaultBankAccount != null)
            {
                <div class="mb-5 bg-blue-50/60 border border-blue-100 rounded-xl p-3.5 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                        </div>
                        <div class="min-w-0">
                            <p class="text-[11px] font-bold uppercase tracking-wider text-blue-600">Refund Payout Account (Napas 24/7)</p>
                            <p class="text-sm font-bold text-gray-900 truncate">
                                @defaultBankAccount.BankName - <span class="font-black text-blue-900">@defaultBankAccount.AccountName</span>
                                @if (!string.IsNullOrWhiteSpace(defaultBankAccount.MaskedAccountNumber))
                                {
                                    <span class="text-gray-500 font-mono text-xs ml-1">(@defaultBankAccount.MaskedAccountNumber)</span>
                                }
                            </p>
                        </div>
                    </div>
                    <a href="/payout-account" target="_blank" class="text-xs font-semibold text-blue-600 hover:underline shrink-0">Change Account</a>
                </div>
            }

            <!-- 2 Case Selection -->
            <div class="mb-5">
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">
                    Select Refund Reason <span class="text-red-500">*</span>
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <!-- Case 1: Within 7 days, feels not suitable -->
                    @{
                        bool within7Days = IsWithin7Days(refundPackage);
                    }
                    <div class="relative p-4 rounded-xl border-2 transition-all cursor-pointer @(refundCaseChoice == "NOT_SUITABLE" ? "border-[#FF5500] bg-orange-50/30" : "border-gray-200 hover:border-gray-300 bg-white") @(!within7Days ? "opacity-60 cursor-not-allowed bg-gray-50" : "")"
                         @onclick="@(async () => { if (within7Days) await OnRefundCaseChanged("NOT_SUITABLE"); })">
                        <div class="flex items-start justify-between gap-2 mb-1.5">
                            <span class="text-sm font-bold text-gray-900">1. Not Suitable</span>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">No Proof Required</span>
                        </div>
                        <p class="text-xs text-gray-500 leading-relaxed mb-2">
                            Applicable within the first 7 days after purchase if the content or workout plan does not suit you.
                        </p>
                        @if (!within7Days)
                        {
                            <span class="inline-block text-[11px] font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded">
                                Expired (Past 7 days from purchase)
                            </span>
                        }
                        else
                        {
                            <span class="inline-block text-[11px] font-bold text-emerald-600">
                                ✓ Eligible (Within first 7 days)
                            </span>
                        }
                    </div>

                    <!-- Case 2: Coach late schedule -->
                    <div class="relative p-4 rounded-xl border-2 transition-all cursor-pointer @(refundCaseChoice == "COACH_LATE" ? "border-[#FF5500] bg-orange-50/30" : "border-gray-200 hover:border-gray-300 bg-white")"
                         @onclick="@(async () => await OnRefundCaseChanged("COACH_LATE"))">
                        <div class="flex items-start justify-between gap-2 mb-1.5">
                            <span class="text-sm font-bold text-gray-900">2. Coach Delayed Schedule</span>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-100">Image Proof Required</span>
                        </div>
                        <p class="text-xs text-gray-500 leading-relaxed mb-2">
                            Coach failed to provide workout schedules or plans on time. Eligible anytime during package period.
                        </p>
                        <span class="inline-block text-[11px] font-bold text-amber-600">
                            Screenshot evidence required
                        </span>
                    </div>
                </div>
            </div>

            <!-- Image Evidence Upload (Required if COACH_LATE) -->
            <div class="mb-5 p-4 rounded-xl border border-gray-200 bg-gray-50/50">
                <div class="flex items-center justify-between mb-2">
                    <label class="text-xs font-bold uppercase tracking-wider text-gray-700 flex items-center gap-1.5">
                        <span>Image Evidence</span>
                        @if (refundCaseChoice == "COACH_LATE")
                        {
                            <span class="text-rose-600 font-bold">* (Required)</span>
                        }
                        else
                        {
                            <span class="text-gray-400 font-normal">(Optional)</span>
                        }
                    </label>
                    <span class="text-xs text-gray-500">@(refundEvidenceUrls.Count)/5 images</span>
                </div>

                <!-- Upload Area -->
                <div class="flex flex-col gap-3">
                    <label class="border-2 border-dashed border-gray-300 hover:border-[#FF5500] bg-white rounded-xl p-4 text-center cursor-pointer transition flex flex-col items-center justify-center @(isUploadingEvidence ? "opacity-60 pointer-events-none" : "")">
                        <InputFile OnChange="HandleRefundEvidenceUpload" multiple accept="image/*" class="hidden" disabled="@(isUploadingEvidence || refundEvidenceUrls.Count >= 5)" />
                        @if (isUploadingEvidence)
                        {
                            <div class="w-6 h-6 border-2 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-1"></div>
                            <span class="text-xs text-gray-500">Uploading image...</span>
                        }
                        else
                        {
                            <svg class="w-8 h-8 text-gray-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <span class="text-xs font-semibold text-gray-700">Click to upload screenshot evidence (PNG, JPG, max 10MB)</span>
                            <span class="text-[11px] text-gray-400 mt-0.5">Chat messages, delayed schedule screenshots, or unfulfilled commitments</span>
                        }
                    </label>

                    @if (!string.IsNullOrWhiteSpace(evidenceUploadError))
                    {
                        <div class="text-xs text-red-600 bg-red-50 p-2 rounded-lg border border-red-100">@evidenceUploadError</div>
                    }

                    <!-- Preview List -->
                    @if (refundEvidenceUrls.Any())
                    {
                        <div class="grid grid-cols-3 sm:grid-cols-5 gap-2 pt-1">
                            @foreach (var url in refundEvidenceUrls)
                            {
                                <div class="relative group rounded-xl overflow-hidden border border-gray-200 aspect-square bg-gray-100 shadow-2xs">
                                    <img src="@url" class="w-full h-full object-cover" alt="Evidence" />
                                    <button type="button" @onclick="() => RemoveEvidenceImage(url)" class="absolute top-1 right-1 w-6 h-6 rounded-full bg-black/70 hover:bg-red-600 text-white flex items-center justify-center text-xs transition cursor-pointer" title="Remove image">
                                        &times;
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Policy Preview Card -->
            <div class="mb-5 p-4 rounded-xl border border-gray-200 bg-gradient-to-br from-gray-50 to-orange-50/30">
                <div class="flex items-center justify-between pb-2 mb-3 border-b border-gray-200/80">
                    <span class="text-xs font-bold uppercase tracking-wider text-gray-700 flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                        Estimated Refund Policy Calculation
                    </span>
                    @if (isCalculatingPolicy)
                    {
                        <div class="flex items-center gap-1.5 text-xs text-gray-500">
                            <div class="w-3.5 h-3.5 border-2 border-[#FF5500] border-t-transparent rounded-full animate-spin"></div>
                            <span>Calculating...</span>
                        </div>
                    }
                </div>

                @if (refundPolicyPreview != null)
                {
                    <div class="space-y-2 text-xs">
                        <div class="flex justify-between items-center text-gray-600">
                            <span>Total Amount Paid:</span>
                            <span class="font-bold text-gray-900">@refundPolicyPreview.TotalPaidAmount.ToString("N0") đ</span>
                        </div>
                        <div class="flex justify-between items-center text-gray-600">
                            <span>Completed Sessions:</span>
                            <span class="font-bold text-gray-900">@refundPolicyPreview.CompletedSessions / @refundPolicyPreview.TotalSessions sessions</span>
                        </div>
                        @if (refundPolicyPreview.CoachPayoutAmount > 0)
                        {
                            <div class="flex justify-between items-center text-amber-700">
                                <span>Deducted for Coach effort (sessions/plan):</span>
                                <span class="font-bold">-@refundPolicyPreview.CoachPayoutAmount.ToString("N0") đ</span>
                            </div>
                        }
                        <div class="pt-2 border-t border-gray-200 flex justify-between items-center">
                            <span class="text-sm font-bold text-gray-900">Estimated Trainee Refund Amount:</span>
                            <span class="text-base sm:text-lg font-black text-emerald-600">
                                @refundPolicyPreview.TraineeRefundAmount.ToString("N0") đ
                            </span>
                        </div>
                        <p class="text-[11px] text-gray-500 italic mt-1 leading-relaxed bg-white/60 p-2.5 rounded-lg border border-gray-100">
                            ℹ️ @refundPolicyPreview.CaseDescription
                        </p>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(policyPreviewError))
                {
                    <div class="text-xs text-rose-600 bg-rose-50 p-2.5 rounded-lg border border-rose-100">
                        @policyPreviewError
                    </div>
                }
            </div>

            <!-- Detailed reason input -->
            <div class="mb-5">
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1.5">
                    Detailed Reason (Optional)
                </label>
                <textarea @bind="refundCustomReason" rows="3" class="w-full text-xs p-3 border border-gray-200 rounded-xl focus:border-[#FF5500] focus:ring-1 focus:ring-[#FF5500] outline-none transition" placeholder="Provide additional details to help Admin review faster..."></textarea>
            </div>

            @if (!string.IsNullOrWhiteSpace(refundSubmitError))
            {
                <div class="mb-5 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-start gap-2">
                    <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span>@refundSubmitError</span>
                </div>
            }

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-gray-100">
                <button type="button" @onclick="CloseRefundModal" disabled="@isSubmittingRefund" class="px-4 py-2.5 text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-xl transition cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="SubmitRefundRequestAsync" disabled="@(isSubmittingRefund || (refundCaseChoice == "COACH_LATE" && !refundEvidenceUrls.Any()))" class="px-5 py-2.5 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl transition cursor-pointer shadow-xs flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                    @if (isSubmittingRefund)
                    {
                        <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        <span>Submitting request...</span>
                    }
                    else
                    {
                        <span>Submit Refund Request</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<TrainingPackageResponseDto> packages = new List<TrainingPackageResponseDto>();
    private bool isLoading = true;
    private string? errorMessage;

    // --- Các biến và hàm cho Modal Xem Chi Tiết Gói Đã Mua ---
    private bool isDetailModalOpen = false;
    private TrainingPackageResponseDto? selectedDetailPackage;

    private void OpenPackageDetailsModal(TrainingPackageResponseDto pkg)
    {
        selectedDetailPackage = pkg;
        isDetailModalOpen = true;
    }

    private void ClosePackageDetailsModal()
    {
        isDetailModalOpen = false;
        selectedDetailPackage = null;
    }

    private void OpenReviewFromDetails()
    {
        if (selectedDetailPackage == null) return;
        var pkg = selectedDetailPackage;
        ClosePackageDetailsModal();
        if (!pkg.HasReviewed)
        {
            OpenReviewModal(pkg);
        }
        else if (!pkg.IsReviewEdited)
        {
            OpenEditReviewModal(pkg);
        }
    }

    // --- Các biến và hàm cho Modal Review ---
    private bool isReviewModalOpen = false;
    private bool isEditingMode = false;
    private Guid selectedPackageId;
    private string selectedPackageTitle = string.Empty;
    private CreatePackageReviewDto reviewDto = new CreatePackageReviewDto();
    private bool isSubmittingReview = false;
    private string? reviewErrorMessage;
    private string? toastSuccessMessage;

    protected override async Task OnInitializedAsync()
    {
        // Trang này không có ô tìm kiếm riêng -> tắt ô tìm kiếm ở topbar dùng chung
        Shell.ShowSearch = false;

        await LoadPurchasedPackagesAsync();
    }

    public void Dispose()
    {
        Shell.Reset();
    }

    private async Task LoadPurchasedPackagesAsync()
    {
        isLoading = true;
        var response = await PackageService.GetPurchasedPackagesAsync();
        if (response.Success && response.Data != null)
        {
            packages = response.Data;
        }
        else
        {
            errorMessage = response.Message ?? "Failed to load purchased packages.";
        }
        isLoading = false;
    }

    private void ViewDetails(Guid id)
    {
        Navigation.NavigateTo($"/training-packages/{id}");
    }

    private void OpenReviewModal(TrainingPackageResponseDto pkg)
    {
        selectedPackageId = pkg.PackageId;
        selectedPackageTitle = pkg.Title ?? "Training Package";
        isEditingMode = false;
        reviewDto = new CreatePackageReviewDto { Rating = 5, Comment = "" };
        reviewErrorMessage = null;
        isReviewModalOpen = true;
    }

    private void OpenEditReviewModal(TrainingPackageResponseDto pkg)
    {
        selectedPackageId = pkg.PackageId;
        selectedPackageTitle = pkg.Title ?? "Training Package";
        isEditingMode = true;
        reviewDto = new CreatePackageReviewDto
        {
            Rating = pkg.UserRating ?? 5,
            Comment = pkg.UserComment ?? ""
        };
        reviewErrorMessage = null;
        isReviewModalOpen = true;
    }

    private void CloseReviewModal()
    {
        isReviewModalOpen = false;
    }

    private async Task SubmitReview()
    {
        isSubmittingReview = true;
        reviewErrorMessage = null;

        var response = await PackageService.SubmitPackageReviewAsync(selectedPackageId, reviewDto);
        if (response.Success)
        {
            isReviewModalOpen = false;
            toastSuccessMessage = isEditingMode 
                ? "Review updated successfully!" 
                : "Your review has been submitted successfully!";
            await LoadPurchasedPackagesAsync();
            _ = Task.Run(async () =>
            {
                await Task.Delay(3500);
                toastSuccessMessage = null;
                await InvokeAsync(StateHasChanged);
            });
        }
        else
        {
            reviewErrorMessage = response.Message ?? "Failed to submit review.";
        }
        isSubmittingReview = false;
    }

    // --- Các biến và hàm cho Modal Báo Cáo Coach ---
    private bool isReportCoachModalOpen = false;
    private Guid reportCoachId;
    private string reportCoachName = string.Empty;
    private string reportPackageTitle = string.Empty;

    /// <summary>
    /// Opens the report modal from inside the details modal. The details modal is closed first
    /// so the two dialogs are never stacked (mirrors OpenReviewFromDetails).
    /// </summary>
    private void OpenReportCoachFromDetails()
    {
        if (selectedDetailPackage == null) return;
        var pkg = selectedDetailPackage;
        ClosePackageDetailsModal();
        OpenReportCoachModal(pkg);
    }

    private void OpenReportCoachModal(TrainingPackageResponseDto? pkg)
    {
        if (pkg == null || pkg.CoachId == Guid.Empty) return;
        reportCoachId = pkg.CoachId;
        reportCoachName = pkg.CoachName ?? "Coach";
        reportPackageTitle = pkg.Title ?? "Training Package";
        isReportCoachModalOpen = true;
    }

    private void HandleCoachReportSubmitted(Guid coachId)
    {
        isReportCoachModalOpen = false;
        toastSuccessMessage = "Coach report submitted successfully. Our team will review it.";
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3500);
            toastSuccessMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    // --- Refund Request & Bank Account State & Methods ---
    private bool isCheckingBankAccount = false;
    private bool isNoBankAccountModalOpen = false;
    private List<CoachBankAccountDto> userBankAccounts = new();
    private CoachBankAccountDto? defaultBankAccount;

    private bool isRefundModalOpen = false;
    private TrainingPackageResponseDto? refundPackage;
    private string refundCaseChoice = "NOT_SUITABLE";
    private string refundCustomReason = string.Empty;
    private List<string> refundEvidenceUrls = new();
    private bool isUploadingEvidence = false;
    private string? evidenceUploadError;
    private bool isCalculatingPolicy = false;
    private RefundPolicyCalculation? refundPolicyPreview;
    private string? policyPreviewError;
    private bool isSubmittingRefund = false;
    private string? refundSubmitError;

    private bool IsWithin7Days(TrainingPackageResponseDto? pkg)
    {
        if (pkg == null) return false;
        var purchaseDate = pkg.OrderCreatedAt ?? pkg.CreatedAt;
        return (DateTime.UtcNow - purchaseDate).TotalDays <= 7.0;
    }

    private async Task HandleRefundClick(TrainingPackageResponseDto pkg)
    {
        if (!pkg.OrderId.HasValue || pkg.OrderId.Value == Guid.Empty)
        {
            errorMessage = "Order ID not found for this package.";
            return;
        }

        isCheckingBankAccount = true;
        StateHasChanged();

        try
        {
            var bankRes = await CoachService.GetBankAccountsAsync();
            userBankAccounts = (bankRes.Success && bankRes.Data != null)
                ? bankRes.Data
                : new List<CoachBankAccountDto>();

            if (!userBankAccounts.Any())
            {
                // No bank account linked -> show warning modal linking to /payout-account
                isNoBankAccountModalOpen = true;
                return;
            }

            defaultBankAccount = userBankAccounts.FirstOrDefault(b => b.IsDefault == true) ?? userBankAccounts.FirstOrDefault();

            refundPackage = pkg;
            bool within7Days = IsWithin7Days(pkg);
            refundCaseChoice = within7Days ? "NOT_SUITABLE" : "COACH_LATE";
            refundCustomReason = string.Empty;
            refundEvidenceUrls.Clear();
            evidenceUploadError = null;
            refundSubmitError = null;

            isRefundModalOpen = true;
            await FetchPolicyPreviewAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error checking information: {ex.Message}";
        }
        finally
        {
            isCheckingBankAccount = false;
            StateHasChanged();
        }
    }

    private void CloseRefundModal()
    {
        isRefundModalOpen = false;
        refundPackage = null;
        refundEvidenceUrls.Clear();
        refundPolicyPreview = null;
        evidenceUploadError = null;
        refundSubmitError = null;
    }

    private async Task OnRefundCaseChanged(string newCase)
    {
        refundCaseChoice = newCase;
        refundSubmitError = null;
        await FetchPolicyPreviewAsync();
    }

    private async Task FetchPolicyPreviewAsync()
    {
        if (refundPackage == null || !refundPackage.OrderId.HasValue) return;

        isCalculatingPolicy = true;
        policyPreviewError = null;
        StateHasChanged();

        try
        {
            var reasonParam = refundCaseChoice == "NOT_SUITABLE"
                ? "Not suitable within first 7 days"
                : "Coach delayed schedule / training plan";

            var res = await RefundService.CalculatePolicyForOrderAsync(
                refundPackage.OrderId.Value,
                reasonParam,
                defaultBankAccount?.BankId);

            if (res.Success && res.Data != null)
            {
                refundPolicyPreview = res.Data;
            }
            else
            {
                policyPreviewError = res.Message ?? "Unable to calculate refund policy.";
            }
        }
        catch (Exception ex)
        {
            policyPreviewError = ex.Message;
        }
        finally
        {
            isCalculatingPolicy = false;
            StateHasChanged();
        }
    }

    private async Task HandleRefundEvidenceUpload(InputFileChangeEventArgs e)
    {
        evidenceUploadError = null;
        isUploadingEvidence = true;
        StateHasChanged();

        try
        {
            var files = e.GetMultipleFiles(5);
            foreach (var file in files)
            {
                if (file.Size > 10 * 1024 * 1024)
                {
                    evidenceUploadError = $"File '{file.Name}' exceeds 10MB limit.";
                    continue;
                }

                var uploadRes = await FileUploadService.UploadAsync(file);
                if (uploadRes.Success && !string.IsNullOrWhiteSpace(uploadRes.Data))
                {
                    refundEvidenceUrls.Add(uploadRes.Data);
                }
                else
                {
                    evidenceUploadError = uploadRes.Message ?? $"Failed to upload file '{file.Name}'.";
                }
            }
        }
        catch (Exception ex)
        {
            evidenceUploadError = $"File upload error: {ex.Message}";
        }
        finally
        {
            isUploadingEvidence = false;
            StateHasChanged();
        }
    }

    private void RemoveEvidenceImage(string url)
    {
        refundEvidenceUrls.Remove(url);
    }

    private async Task SubmitRefundRequestAsync()
    {
        if (refundPackage == null || !refundPackage.OrderId.HasValue) return;

        if (refundCaseChoice == "COACH_LATE" && !refundEvidenceUrls.Any())
        {
            refundSubmitError = "Image evidence is required when reporting delayed schedule.";
            return;
        }

        isSubmittingRefund = true;
        refundSubmitError = null;
        StateHasChanged();

        try
        {
            var reasonText = refundCaseChoice == "NOT_SUITABLE"
                ? "Not suitable within first 7 days"
                : "Coach delayed schedule / training plan";

            if (!string.IsNullOrWhiteSpace(refundCustomReason))
            {
                reasonText += $": {refundCustomReason.Trim()}";
            }

            var dto = new CreateRefundRequestDto
            {
                OrderId = refundPackage.OrderId.Value,
                Reason = reasonText,
                EvidenceUrls = refundEvidenceUrls.Any() ? refundEvidenceUrls : null,
                BankAccountId = defaultBankAccount?.BankId
            };

            var res = await RefundService.CreateRefundRequestAsync(dto);
            if (res.Success)
            {
                isRefundModalOpen = false;
                toastSuccessMessage = "Refund request has been submitted successfully and is pending review!";
                await LoadPurchasedPackagesAsync();
                _ = Task.Run(async () =>
                {
                    await Task.Delay(4000);
                    toastSuccessMessage = null;
                    await InvokeAsync(StateHasChanged);
                });
            }
            else
            {
                refundSubmitError = res.Message ?? "Unable to submit refund request.";
            }
        }
        catch (Exception ex)
        {
            refundSubmitError = ex.Message;
        }
        finally
        {
            isSubmittingRefund = false;
            StateHasChanged();
        }
    }
}

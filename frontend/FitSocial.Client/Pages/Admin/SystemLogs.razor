@page "/admin/system-logs"
@page "/admin/logs"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN")]
@using FitSocial.Client.Models.Common
@using FitSocial.Client.Models.SystemLogs
@using FitSocial.Client.Services.SystemLogs
@inject ISystemLogService LogService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>System Logs - FitConnect Admin Console</PageTitle>

<AuthorizeView Roles="ADMIN">
    <Authorized>
        <div class="audit-page">
            <!-- 3.1 Page Header & Breadcrumb -->
            <header class="audit-header">
                <div class="audit-header-left">
                    <nav class="audit-breadcrumb" aria-label="Breadcrumb">
                        <a href="/admin" @onclick:preventDefault="true" @onclick='() => Navigation.NavigateTo("/admin")'>Admin Console</a>
                        <span class="breadcrumb-sep">/</span>
                        <span class="breadcrumb-current">System Logs</span>
                    </nav>
                    <h1 class="audit-title">System Logs</h1>
                    <p class="audit-subtitle">Monitor and review administrative activities across FitConnect.</p>
                </div>
                <div class="audit-header-actions">
                    <button type="button" class="audit-btn" @onclick="RefreshAllAsync" disabled="@isLoading" title="Refresh activity logs">
                        <span class="btn-icon @(isLoading ? "spinning" : "")"><AppIcon Name="refresh" /></span>
                        <span>Refresh</span>
                    </button>
                </div>
            </header>

            <!-- Error Banner -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="audit-alert error" role="alert">
                    <div class="alert-left">
                        <AppIcon Name="warning" />
                        <span>@errorMessage</span>
                    </div>
                    <div class="alert-actions">
                        <button type="button" class="audit-btn sm" @onclick="RefreshAllAsync">Retry</button>
                        <button type="button" class="alert-close" @onclick="() => errorMessage = null" aria-label="Dismiss">✕</button>
                    </div>
                </div>
            }

            <!-- 3.3 Search and Filtering -->
            <section class="filter-panel" aria-label="Search and filter controls">
                <!-- Role quick pills -->
                <div class="filter-top-row">
                    <div class="role-pills" role="group" aria-label="Filter by actor role">
                        <button type="button"
                                class="role-pill @(string.IsNullOrEmpty(selectedRole) ? "active" : "")"
                                @onclick='() => SetRoleFilterAsync("")'>
                            All Roles
                        </button>
                        <button type="button"
                                class="role-pill @(selectedRole == "ADMIN" ? "active" : "")"
                                @onclick='() => SetRoleFilterAsync("ADMIN")'>
                            <span class="role-dot admin"></span> Admin
                        </button>
                        <button type="button"
                                class="role-pill @(selectedRole == "STAFF" ? "active" : "")"
                                @onclick='() => SetRoleFilterAsync("STAFF")'>
                            <span class="role-dot staff"></span> Staff
                        </button>
                    </div>

                    @if (HasActiveFilters())
                    {
                        <button type="button" class="audit-btn reset-btn" @onclick="ResetAllFiltersAsync">
                            ✕ Reset Filters
                        </button>
                    }
                </div>

                <!-- Main filter controls -->
                <div class="filter-controls-grid">
                    <!-- Search by actor name/email, action, affected entity or target ID -->
                    <div class="search-field">
                        <span class="search-field-icon"><AppIcon Name="search" /></span>
                        <input type="text"
                               value="@searchTerm"
                               @oninput="OnSearchInput"
                               @onkeydown="HandleSearchKeyDown"
                               class="filter-input search-input"
                               placeholder="Search by actor name, email, action, entity, or target ID..." />
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <button type="button" class="clear-search-btn" @onclick="ClearSearchAsync" title="Clear search">✕</button>
                        }
                    </div>

                    <!-- Role dropdown -->
                    <div class="filter-group">
                        <label class="filter-field-label">Actor Role</label>
                        <select class="filter-select" value="@selectedRole" @onchange="OnRoleChanged">
                            <option value="">All (Admin &amp; Staff)</option>
                            <option value="ADMIN">Admin</option>
                            <option value="STAFF">Staff</option>
                        </select>
                    </div>

                    <!-- Action Type dropdown -->
                    <div class="filter-group">
                        <label class="filter-field-label">Action Type</label>
                        <select class="filter-select" value="@selectedActionType" @onchange="OnActionTypeChanged">
                            <option value="">All Actions</option>
                            <option value="CREATE">CREATE</option>
                            <option value="UPDATE">UPDATE</option>
                            <option value="DELETE">DELETE</option>
                            <option value="LOCK">LOCK</option>
                            <option value="UNLOCK">UNLOCK</option>
                            <option value="APPROVE">APPROVE</option>
                            <option value="REJECT">REJECT</option>
                        </select>
                    </div>

                    <!-- Result Status dropdown -->
                    <div class="filter-group">
                        <label class="filter-field-label">Result</label>
                        <select class="filter-select" value="@selectedStatus" @onchange="OnStatusChanged">
                            <option value="">All Results</option>
                            <option value="Success">Success</option>
                            <option value="Failed">Failed</option>
                        </select>
                    </div>

                    <!-- Date Range -->
                    <div class="filter-group date-range-group">
                        <label class="filter-field-label">Date Range</label>
                        <div class="date-inputs-row">
                            <input type="date"
                                   class="filter-input date-picker"
                                   value="@(fromDateFilter?.ToString("yyyy-MM-dd"))"
                                   @onchange="OnFromDateChanged"
                                   title="From date" />
                            <span class="date-sep">to</span>
                            <input type="date"
                                   class="filter-input date-picker"
                                   value="@(toDateFilter?.ToString("yyyy-MM-dd"))"
                                   @onchange="OnToDateChanged"
                                   title="To date" />
                        </div>
                    </div>

                    <div class="filter-group filter-btn-group">
                        <label class="filter-field-label">&nbsp;</label>
                        <div class="filter-action-btns">
                            <button type="button" class="audit-btn primary" @onclick="ApplyFiltersAsync">
                                Apply
                            </button>
                            <button type="button" class="audit-btn" @onclick="ResetAllFiltersAsync" disabled="@(!HasActiveFilters())">
                                Reset Filters
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 3.4 Activity Table -->
            @if (isLoading)
            {
                <div class="table-container">
                    <table class="audit-table">
                        <thead>
                            <tr>
                                <th class="col-actor">Actor</th>
                                <th class="col-role">Role</th>
                                <th class="col-action">Action</th>
                                <th class="col-target">Target</th>
                                <th class="col-timestamp">Timestamp</th>
                                <th class="col-status">Status</th>
                                <th class="col-details text-center">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 6; i++)
                            {
                                <tr class="skeleton-row">
                                    <td>
                                        <div class="skeleton-line md"></div>
                                        <div class="skeleton-line sm mt-1"></div>
                                    </td>
                                    <td><div class="skeleton-badge"></div></td>
                                    <td>
                                        <div class="skeleton-line md"></div>
                                        <div class="skeleton-line sm mt-1"></div>
                                    </td>
                                    <td>
                                        <div class="skeleton-line sm"></div>
                                        <div class="skeleton-line xs mt-1"></div>
                                    </td>
                                    <td>
                                        <div class="skeleton-line sm"></div>
                                        <div class="skeleton-line xs mt-1"></div>
                                    </td>
                                    <td><div class="skeleton-badge"></div></td>
                                    <td class="col-details text-center"><div class="skeleton-btn"></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (pagedLogs.Items.Count == 0)
            {
                <div class="empty-state-card">
                    <div class="empty-state-icon"><AppIcon Name="doc" /></div>
                    <h3>No administrative activities found</h3>
                    <p>No ADMIN or STAFF audit records match your current search and filter criteria.</p>
                    @if (HasActiveFilters())
                    {
                        <button type="button" class="audit-btn primary mt-3" @onclick="ResetAllFiltersAsync">
                            Reset Filters
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="table-container">
                    <table class="audit-table">
                        <thead>
                            <tr>
                                <th class="col-actor">Actor</th>
                                <th class="col-role">Role</th>
                                <th class="col-action">Action</th>
                                <th class="col-target">Target</th>
                                <th class="col-timestamp sortable-th" @onclick="ToggleSortOrderAsync" title="Sort by timestamp">
                                    <span>Timestamp</span>
                                    <span class="sort-indicator">@(sortOrder == "asc" ? "↑" : "↓")</span>
                                </th>
                                <th class="col-status">Status</th>
                                <th class="col-details text-center">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in pagedLogs.Items)
                            {
                                var actionType = SystemLogUseCaseHelper.GetCanonicalActionType(log);
                                var readableTitle = SystemLogUseCaseHelper.GetHumanReadableActionTitle(log.Action);
                                var targetDisplay = SystemLogUseCaseHelper.ResolveTargetDisplayName(log);
                                var readableMessage = SystemLogUseCaseHelper.FormatReadableDescription(log);
                                var statusText = string.IsNullOrWhiteSpace(log.Status) ? "Success" : log.Status;

                                <tr class="audit-row" @onclick="() => OpenDetailModal(log)">
                                    <!-- Actor: Staff/Admin name and email -->
                                    <td class="col-actor">
                                        <div class="actor-cell">
                                            <div class="actor-avatar @GetRoleAvatarClass(log.ActorRole)">
                                                @GetActorInitials(log.ActorName)
                                            </div>
                                            <div class="actor-info">
                                                <div class="actor-name" title="@(log.ActorName ?? "System")">
                                                    @(string.IsNullOrWhiteSpace(log.ActorName) ? "Administrative User" : log.ActorName)
                                                </div>
                                                <div class="actor-email" title="@(log.ActorEmail ?? "—")">
                                                    @(string.IsNullOrWhiteSpace(log.ActorEmail) ? "—" : log.ActorEmail)
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Role: ADMIN or STAFF badge -->
                                    <td class="col-role">
                                        <span class="role-badge @GetRoleBadgeClass(log.ActorRole)">
                                            @FormatActorRole(log.ActorRole)
                                        </span>
                                    </td>

                                    <!-- Action: Human-readable activity -->
                                    <td class="col-action">
                                        <div class="action-cell">
                                            <div class="action-header-line">
                                                <span class="action-type-badge @GetActionTypeBadgeClass(actionType)">@actionType</span>
                                                <span class="action-title" title="@readableTitle">@readableTitle</span>
                                            </div>
                                            <div class="action-desc" title="@readableMessage">@readableMessage</div>
                                        </div>
                                    </td>

                                    <!-- Target: Affected entity and its identifier -->
                                    <td class="col-target">
                                        <div class="target-cell">
                                            <span class="entity-badge">@FormatSource(log.Source)</span>
                                            @if (targetDisplay != "—")
                                            {
                                                <div class="target-name" title="@targetDisplay">@targetDisplay</div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(log.EntityId) && !Guid.TryParse(log.EntityId, out _))
                                            {
                                                <div class="target-id font-mono" title="@log.EntityId">@log.EntityId</div>
                                            }
                                        </div>
                                    </td>

                                    <!-- Timestamp: Date and time -->
                                    <td class="col-timestamp">
                                        <div class="ts-date">@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd")</div>
                                        <div class="ts-time font-mono">@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</div>
                                    </td>

                                    <!-- Status: Success / Failed -->
                                    <td class="col-status">
                                        <span class="result-badge @(statusText.Equals("Failed", StringComparison.OrdinalIgnoreCase) ? "failed" : "success")">
                                            <span class="result-dot"></span>
                                            @statusText
                                        </span>
                                    </td>

                                    <!-- Details: View Details action -->
                                    <td class="col-details text-center" @onclick:stopPropagation="true">
                                        <button type="button" class="audit-btn sm view-details-btn" @onclick="() => OpenDetailModal(log)">
                                            View Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Bar -->
                <CommonPagination CurrentPage="@currentPage"
                                  PageSize="@pageSize"
                                  TotalCount="@pagedLogs.TotalCount"
                                  PageChanged="GoToPageAsync"
                                  ItemName="activities" />
            }

            <!-- 3.5 Activity Details Drawer / Modal (Before & After) -->
            @if (selectedLog != null)
            {
                var ucInfo = SystemLogUseCaseHelper.Resolve(selectedLog);
                var modalActionType = SystemLogUseCaseHelper.GetCanonicalActionType(selectedLog);
                var modalStatus = string.IsNullOrWhiteSpace(selectedLog.Status) ? "Success" : selectedLog.Status;

                <div class="modal-backdrop" @onclick="CloseDetailModal">
                    <div class="modal-drawer" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="auditModalTitle">
                        <!-- Modal Header -->
                        <div class="modal-header">
                            <div class="modal-header-main">
                                <div class="modal-title-row">
                                    <h2 id="auditModalTitle" class="modal-title">Activity Details</h2>
                                    <span class="log-id-pill">@selectedLog.LogIdDisplay</span>
                                    <span class="action-type-badge @GetActionTypeBadgeClass(modalActionType)">@modalActionType</span>
                                    <span class="result-badge @(modalStatus.Equals("Failed", StringComparison.OrdinalIgnoreCase) ? "failed" : "success")">
                                        <span class="result-dot"></span>
                                        @modalStatus
                                    </span>
                                </div>
                                <p class="modal-subtitle">@ucInfo.UseCaseTitle</p>
                            </div>
                            <div class="modal-header-actions">
                                <button type="button" class="modal-close-btn" @onclick="CloseDetailModal" aria-label="Close details">✕</button>
                            </div>
                        </div>

                        <!-- Modal Body -->
                        <div class="modal-body">
                            <div class="info-sections-grid">
                                <!-- Actor & Target Information -->
                                <section class="detail-section-card">
                                    <h3 class="section-heading">Actor Information</h3>
                                    <div class="kv-list">
                                        <div class="kv-row">
                                            <span class="kv-label">Full Name</span>
                                            <span class="kv-value">@(string.IsNullOrWhiteSpace(selectedLog.ActorName) ? "—" : selectedLog.ActorName)</span>
                                        </div>
                                        <div class="kv-row">
                                            <span class="kv-label">Email</span>
                                            <span class="kv-value">@(string.IsNullOrWhiteSpace(selectedLog.ActorEmail) ? "—" : selectedLog.ActorEmail)</span>
                                        </div>
                                        <div class="kv-row">
                                            <span class="kv-label">Role</span>
                                            <span class="kv-value">
                                                <span class="role-badge @GetRoleBadgeClass(selectedLog.ActorRole)">
                                                    @FormatActorRole(selectedLog.ActorRole)
                                                </span>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="target-inline-box">
                                        <h3 class="section-heading">Target Information</h3>
                                        <div class="kv-row">
                                            <span class="kv-label">Entity Type</span>
                                            <span class="kv-value"><span class="entity-badge">@FormatSource(selectedLog.Source)</span></span>
                                        </div>
                                    </div>
                                </section>

                                <!-- Activity Information -->
                                <section class="detail-section-card">
                                    <h3 class="section-heading">Activity Information</h3>
                                    <div class="kv-list">
                                        <div class="kv-row">
                                            <span class="kv-label">Action Type</span>
                                            <span class="kv-value">
                                                <span class="action-type-badge @GetActionTypeBadgeClass(modalActionType)">@modalActionType</span>
                                                <span class="font-mono muted-code">(@selectedLog.Action)</span>
                                            </span>
                                        </div>
                                        <div class="kv-row">
                                            <span class="kv-label">Timestamp</span>
                                            <span class="kv-value font-mono">
                                                @selectedLog.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                            </span>
                                        </div>
                                        <div class="kv-row">
                                            <span class="kv-label">Result</span>
                                            <span class="kv-value">
                                                <span class="result-badge @(modalStatus.Equals("Failed", StringComparison.OrdinalIgnoreCase) ? "failed" : "success")">
                                                    <span class="result-dot"></span>
                                                    @modalStatus
                                                </span>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="activity-description-box">
                                        <span class="kv-label">Description</span>
                                        <p>@(string.IsNullOrWhiteSpace(ucInfo.Description) ? "—" : ucInfo.Description)</p>
                                    </div>
                                </section>
                            </div>

                            <!-- Change History (Before and After) -->
                            <section class="detail-section-card change-history-section">
                                <div class="change-history-header">
                                    <div>
                                        <h3 class="section-heading mb-0">Change History</h3>
                                        <p class="change-history-sub">
                                            @if (modalActionType == "CREATE")
                                            {
                                                <span>Initial values recorded upon entity creation (Before is <strong>—</strong>).</span>
                                            }
                                            else if (modalActionType == "DELETE")
                                            {
                                                <span>Snapshot of values prior to deletion (After is <strong>—</strong>).</span>
                                            }
                                            else
                                            {
                                                <span>Comparison of modified fields before and after the operation.</span>
                                            }
                                        </p>
                                    </div>
                                </div>

                                @if (ucInfo.FieldChanges.Count > 0)
                                {
                                    <div class="diff-table-wrap">
                                        <table class="diff-table">
                                            <thead>
                                                <tr>
                                                    <th class="col-diff-field">Field</th>
                                                    <th class="col-diff-before">Before</th>
                                                    <th class="col-diff-after">After</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var field in ucInfo.FieldChanges)
                                                {
                                                    var isExpanded = _expandedFields.Contains(field.Key);
                                                    <tr>
                                                        <td class="diff-field-cell">
                                                            <div class="diff-field-name">@field.DisplayName</div>
                                                            <div class="diff-field-key font-mono">@field.Key</div>
                                                        </td>

                                                        <!-- Before Value (Subtle Red Highlight) -->
                                                        <td class="diff-before-cell @(field.FormattedOldValue != "—" ? "has-before-val" : "empty-val")">
                                                            @if (field.FormattedOldValue == "—")
                                                            {
                                                                <span class="null-dash">—</span>
                                                            }
                                                            else if (field.IsLongText)
                                                            {
                                                                <div class="expandable-value before-box @(isExpanded ? "expanded" : "")">
                                                                    @field.FormattedOldValue
                                                                </div>
                                                                @if (field.FormattedOldValue.Length > 120 || field.FormattedOldValue.Contains('\n'))
                                                                {
                                                                    <button type="button" class="expand-toggle-btn" @onclick="() => ToggleFieldExpand(field.Key)">
                                                                        @(isExpanded ? "Show less" : "Expand")
                                                                    </button>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="diff-pill before-pill">@field.FormattedOldValue</span>
                                                            }
                                                        </td>

                                                        <!-- After Value (Subtle Green Highlight) -->
                                                        <td class="diff-after-cell @(field.FormattedNewValue != "—" ? "has-after-val" : "empty-val")">
                                                            @if (field.FormattedNewValue == "—")
                                                            {
                                                                <span class="null-dash">—</span>
                                                            }
                                                            else if (field.IsLongText)
                                                            {
                                                                <div class="expandable-value after-box @(isExpanded ? "expanded" : "")">
                                                                    @field.FormattedNewValue
                                                                </div>
                                                                @if (field.FormattedNewValue.Length > 120 || field.FormattedNewValue.Contains('\n'))
                                                                {
                                                                    <button type="button" class="expand-toggle-btn" @onclick="() => ToggleFieldExpand(field.Key)">
                                                                        @(isExpanded ? "Show less" : "Expand")
                                                                    </button>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <span class="diff-pill after-pill">@field.FormattedNewValue</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="no-diff-box">
                                        <div class="diff-table-wrap">
                                            <table class="diff-table">
                                                <thead>
                                                    <tr>
                                                        <th class="col-diff-field">Field</th>
                                                        <th class="col-diff-before">Before</th>
                                                        <th class="col-diff-after">After</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td class="diff-field-cell">
                                                            <div class="diff-field-name">Field Snapshot</div>
                                                        </td>
                                                        <td class="diff-before-cell empty-val"><span class="null-dash">—</span></td>
                                                        <td class="diff-after-cell empty-val"><span class="null-dash">—</span></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <p class="no-diff-note">No detailed field-level changes were recorded for this activity.</p>
                                    </div>
                                }
                            </section>
                        </div>

                        <!-- Modal Footer -->
                        <div class="modal-footer">
                            <button type="button" class="audit-btn" @onclick="CloseDetailModal">Close</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="unauthorized-card">
            <h3>Access Denied</h3>
            <p>You do not have permission to access the System Logs console. This page requires Administrator privileges.</p>
            <button type="button" class="audit-btn primary mt-3" @onclick='() => Navigation.NavigateTo("/admin")'>
                Back to Dashboard
            </button>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private PagedResult<SystemLogItemModel> pagedLogs = new();
    private SystemLogItemModel? selectedLog;

    private bool isLoading = true;
    private string? errorMessage;

    // Filters
    private string searchTerm = string.Empty;
    private string selectedRole = string.Empty;
    private string selectedActionType = string.Empty;
    private string selectedStatus = string.Empty;
    private string selectedLevel = string.Empty;
    private string selectedSource = string.Empty;
    private DateTime? fromDateFilter;
    private DateTime? toDateFilter;
    private string sortOrder = "desc";
    private int currentPage = 1;
    private int pageSize = 20;

    // Modal state
    private HashSet<string> _expandedFields = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAllAsync();
    }

    private async Task RefreshAllAsync()
    {
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var request = new GetSystemLogsRequest
            {
                Search = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm.Trim(),
                Role = string.IsNullOrWhiteSpace(selectedRole) ? null : selectedRole.Trim(),
                ActionType = string.IsNullOrWhiteSpace(selectedActionType) ? null : selectedActionType.Trim(),
                Status = string.IsNullOrWhiteSpace(selectedStatus) ? null : selectedStatus.Trim(),
                Level = string.IsNullOrWhiteSpace(selectedLevel) ? null : selectedLevel.Trim(),
                Source = string.IsNullOrWhiteSpace(selectedSource) ? null : selectedSource.Trim(),
                FromDate = fromDateFilter,
                ToDate = toDateFilter.HasValue ? toDateFilter.Value.Date.AddDays(1).AddTicks(-1) : null,
                SortOrder = sortOrder,
                PageNumber = currentPage,
                PageSize = pageSize
            };

            var response = await LogService.GetSystemLogsAsync(request);
            if (response.Success && response.Data != null)
            {
                pagedLogs = response.Data;
            }
            else
            {
                errorMessage = response.Message ?? "Failed to load system logs.";
                pagedLogs = new PagedResult<SystemLogItemModel>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "A connection error occurred while retrieving system logs: " + ex.Message;
            pagedLogs = new PagedResult<SystemLogItemModel>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetRoleFilterAsync(string role)
    {
        selectedRole = role;
        currentPage = 1;
        await LoadLogsAsync();
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        selectedRole = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        await LoadLogsAsync();
    }

    private async Task OnActionTypeChanged(ChangeEventArgs e)
    {
        selectedActionType = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        await LoadLogsAsync();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        await LoadLogsAsync();
    }

    private void OnFromDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            fromDateFilter = dt.Date;
        else
            fromDateFilter = null;
    }

    private void OnToDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            toDateFilter = dt.Date;
        else
            toDateFilter = null;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadLogsAsync();
        }
    }

    private async Task ClearSearchAsync()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        await LoadLogsAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        currentPage = 1;
        await RefreshAllAsync();
    }

    private async Task ToggleSortOrderAsync()
    {
        sortOrder = sortOrder == "desc" ? "asc" : "desc";
        currentPage = 1;
        await LoadLogsAsync();
    }

    private async Task ResetAllFiltersAsync()
    {
        searchTerm = string.Empty;
        selectedRole = string.Empty;
        selectedActionType = string.Empty;
        selectedStatus = string.Empty;
        selectedLevel = string.Empty;
        selectedSource = string.Empty;
        fromDateFilter = null;
        toDateFilter = null;
        sortOrder = "desc";
        currentPage = 1;
        await RefreshAllAsync();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrWhiteSpace(searchTerm) ||
               !string.IsNullOrWhiteSpace(selectedRole) ||
               !string.IsNullOrWhiteSpace(selectedActionType) ||
               !string.IsNullOrWhiteSpace(selectedStatus) ||
               !string.IsNullOrWhiteSpace(selectedLevel) ||
               !string.IsNullOrWhiteSpace(selectedSource) ||
               fromDateFilter.HasValue ||
               toDateFilter.HasValue;
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || (pagedLogs.TotalPages > 0 && page > pagedLogs.TotalPages)) return;
        currentPage = page;
        await LoadLogsAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            pageSize = size;
            currentPage = 1;
            await LoadLogsAsync();
        }
    }

    private void OpenDetailModal(SystemLogItemModel log)
    {
        selectedLog = log;
        _expandedFields.Clear();
    }

    private void CloseDetailModal()
    {
        selectedLog = null;
        _expandedFields.Clear();
    }

    private void ToggleFieldExpand(string key)
    {
        if (!_expandedFields.Add(key))
        {
            _expandedFields.Remove(key);
        }
    }

    private static string GetActorInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "AD";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
        }
        return name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }

    private static string FormatActorRole(string? role)
    {
        if (string.IsNullOrWhiteSpace(role)) return "STAFF";
        var r = role.Trim().ToUpperInvariant();
        return r == "ADMIN" ? "ADMIN" : "STAFF";
    }

    private static string GetRoleBadgeClass(string? role)
    {
        var r = FormatActorRole(role);
        return r == "ADMIN" ? "admin" : "staff";
    }

    private static string GetRoleAvatarClass(string? role)
    {
        var r = FormatActorRole(role);
        return r == "ADMIN" ? "avatar-admin" : "avatar-staff";
    }

    private static string GetActionTypeBadgeClass(string? actionType)
    {
        return (actionType?.ToUpperInvariant()) switch
        {
            "CREATE" => "act-create",
            "UPDATE" => "act-update",
            "DELETE" => "act-delete",
            "LOCK" => "act-lock",
            "UNLOCK" => "act-unlock",
            "APPROVE" => "act-approve",
            "REJECT" => "act-reject",
            _ => "act-update"
        };
    }

    private static string FormatSource(string? source)
    {
        if (string.IsNullOrWhiteSpace(source)) return "System";
        return source switch
        {
            "CoachSubscriptionPlan" => "Subscription Plan",
            "RefundRequest" => "Refund Request",
            "CoachProfile" => "Coach Application",
            "CoachCertificate" => "Coach Certificate",
            "CoachUpgrade" => "Coach Upgrade",
            "PaymentGatewayConfig" => "Payment Gateway",
            _ => source
        };
    }

    private int GetStartIndex()
    {
        if (pagedLogs.TotalCount == 0) return 0;
        return (currentPage - 1) * pageSize + 1;
    }

    private int GetEndIndex()
    {
        return Math.Min(currentPage * pageSize, pagedLogs.TotalCount);
    }
}

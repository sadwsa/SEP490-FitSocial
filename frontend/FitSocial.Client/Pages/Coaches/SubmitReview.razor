@page "/coaches/{coachId:guid}/review"
@layout EmptyLayout
@inject ICoachService CoachService
@inject NavigationManager Navigation
@using FitSocial.Client.Layout
@using FitSocial.Client.Models.Coaches
@using FitSocial.Client.Services.Coaches

<PageTitle>Submit Review - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white rounded-xl shadow-lg p-8 space-y-6 border border-gray-100">

        <div class="text-center">
            <div class="mx-auto w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-[#FF5500]" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
            </div>
            <h2 class="text-2xl font-extrabold text-gray-900">Rate Your Coach</h2>
            <p class="mt-2 text-sm text-gray-500">How was your training experience?</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="bg-red-50 text-red-600 p-4 rounded-lg text-sm font-medium border border-red-100">
                @errorMessage
            </div>
        }

        <EditForm Model="@reviewDto" OnValidSubmit="HandleSubmitReview">

            <!-- Clickable Stars -->
            <div class="flex justify-center gap-2 mb-6">
                @for (int i = 1; i <= 5; i++)
                {
                    int starValue = i;
                    <button type="button" @onclick="() => SetRating(starValue)" class="focus:outline-none transition-transform hover:scale-110">
                        <svg class="w-10 h-10 @(starValue <= reviewDto.Rating ? "text-yellow-400" : "text-gray-200")" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                        </svg>
                    </button>
                }
            </div>

            <!-- Comment Input -->
            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Write a review (optional)</label>
                <InputTextArea @bind-Value="reviewDto.Comment" rows="4" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#FF5500] focus:border-transparent outline-none transition-all resize-none text-sm" placeholder="Tell us what you liked or what could be improved..." />
            </div>

            <!-- Action Buttons -->
            <div class="flex gap-4">
                <button type="button" @onclick="GoBack" class="flex-1 py-3 px-4 bg-white border border-gray-200 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition-colors">
                    Cancel
                </button>
                <button type="submit" disabled="@isSubmitting" class="flex-1 py-3 px-4 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white font-semibold rounded-xl hover:shadow-md transition-all flex items-center justify-center gap-2">
                    @if (isSubmitting)
                    {
                        <svg class="animate-spin h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <span>Submit Review</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public Guid coachId { get; set; }

    private CreateReviewDto reviewDto = new CreateReviewDto();
    private bool isSubmitting = false;
    private string? errorMessage;

    private void SetRating(int rating)
    {
        reviewDto.Rating = rating;
    }

    private async Task HandleSubmitReview()
    {
        isSubmitting = true;
        errorMessage = null;

        var response = await CoachService.SubmitReviewAsync(coachId, reviewDto);

        if (response.Success)
        {
            // Quay về trang chi tiết Coach sau khi Review xong
            Navigation.NavigateTo($"/coaches/{coachId}");
        }
        else
        {
            // Lỗi ở đây đa số sẽ là do backend chặn: "Bạn chưa mua hàng nên không được review"
            errorMessage = response.Message ?? "An error occurred while submitting your review.";
        }

        isSubmitting = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo($"/coaches/{coachId}");
    }
}

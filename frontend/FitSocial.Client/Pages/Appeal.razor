@page "/appeal"
@layout AuthLayout
@using FitSocial.Client.Models.Appeals
@using FitSocial.Client.Services.Appeals
@using FitSocial.Client.Services.Files
@using FitSocial.Client.Services.Auth
@using System.Security.Claims
@inject IAppealService AppealService
@inject IFileUploadService FileUploadService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Appeal Violation Report - FitSocial</PageTitle>

<div class="min-h-screen bg-slate-50/80 py-8 px-4 sm:px-6 lg:px-8 flex justify-center items-start text-slate-800">
    <div class="w-full max-w-4xl">
        <!-- Top Navbar / Brand Header -->
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200">
            <div class="flex items-center gap-3">
                <img src="Logo_FitSocial.jpg" alt="FitSocial" class="w-10 h-10 rounded-xl shadow-xs object-cover" />
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-slate-900 leading-none">FitSocial Appeals</h1>
                    <p class="text-xs text-slate-500 mt-1">Report Review & Account Verification</p>
                </div>
            </div>

            <div>
                @if (_isAuthenticated)
                {
                    <button type="button"
                            @onclick='() => Navigation.NavigateTo("notifications")'
                            class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white hover:bg-slate-100 px-3.5 py-2 rounded-xl border border-slate-200 transition cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        <span>Back to Notifications</span>
                    </button>
                }
                else
                {
                    <button type="button"
                            @onclick='() => Navigation.NavigateTo("login")'
                            class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white hover:bg-slate-100 px-3.5 py-2 rounded-xl border border-slate-200 transition cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        <span>Return to Sign In</span>
                    </button>
                }
            </div>
        </div>

        @if (_isBlockedSession)
        {
            <!-- Blocked Account Banner -->
            <div class="mb-6 p-4 rounded-2xl bg-amber-50 border border-amber-200/80 flex items-start gap-3 shadow-xs">
                <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="text-sm font-bold text-amber-900">Appeal Access Session Active</h3>
                    <p class="text-xs text-amber-800 mt-0.5 leading-relaxed">
                        Your account has reached the report threshold. This secure session grants you direct access to review the reports on file and submit an explanation with supporting evidence.
                    </p>
                </div>
            </div>
        }

        @if (_isLoading)
        {
            <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 p-16 text-center">
                <div class="w-10 h-10 border-3 border-[#FF5500] border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                <h3 class="text-sm font-bold text-slate-800">Loading appeal information...</h3>
                <p class="text-xs text-slate-500 mt-1">Retrieving report details and appeal session context.</p>
            </div>
        }
        else if (_successAppeal != null)
        {
            <!-- Success / Submitted Confirmation Card -->
            <div class="bg-white rounded-3xl shadow-sm border border-emerald-100 p-8 sm:p-10 text-center animate-in fade-in duration-300">
                <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-4 border border-emerald-200 shadow-inner">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>

                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 mb-2">
                    Appeal Submitted Successfully
                </span>

                <h2 class="text-2xl font-bold text-slate-900 mt-2">Your Appeal Is Under Review</h2>
                <p class="text-sm text-slate-600 max-w-lg mx-auto mt-2 leading-relaxed">
                    Our compliance team has received your submission. Staff will examine the reported content alongside your explanation and evidence.
                </p>

                <div class="mt-6 p-4 max-w-md mx-auto rounded-2xl bg-slate-50 border border-slate-200 text-left space-y-2 text-xs">
                    <div class="flex justify-between">
                        <span class="text-slate-500">Appeal Reference ID:</span>
                        <span class="font-mono font-semibold text-slate-800">@_successAppeal.AppealId.ToString().Substring(0, 8)...</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Status:</span>
                        <span class="font-bold text-amber-600">@_successAppeal.Status</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Submitted At:</span>
                        <span class="font-semibold text-slate-800">@_successAppeal.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    @if (_successAppeal.Media.Any())
                    {
                        <div class="flex justify-between">
                            <span class="text-slate-500">Attached Evidence:</span>
                            <span class="font-semibold text-slate-800">@_successAppeal.Media.Count file@(_successAppeal.Media.Count > 1 ? "s" : "")</span>
                        </div>
                    }
                </div>

                <div class="mt-8 flex justify-center gap-3">
                    @if (_isAuthenticated)
                    {
                        <button type="button"
                                @onclick='() => Navigation.NavigateTo("notifications")'
                                class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition cursor-pointer">
                            Return to Notifications
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                @onclick='() => Navigation.NavigateTo("login")'
                                class="px-5 py-2.5 rounded-xl bg-[#FF5500] hover:bg-[#e04c00] text-white text-xs font-bold transition cursor-pointer">
                            Return to Sign In
                        </button>
                    }
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(_criticalError))
        {
            <!-- Critical Error Card -->
            <div class="bg-red-50 border border-red-200 rounded-3xl p-8 text-center">
                <div class="w-12 h-12 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center mx-auto mb-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <h3 class="text-base font-bold text-red-900">Unable to Open Appeal</h3>
                <p class="text-xs text-red-700 mt-1 max-w-md mx-auto">@_criticalError</p>
                <button type="button"
                        @onclick='() => Navigation.NavigateTo("login")'
                        class="mt-4 px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-xl transition cursor-pointer">
                    Back to Login
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Left Column: Report Details & Report Selector -->
                <div class="lg:col-span-5 flex flex-col gap-5">
                    <!-- Report Context Card -->
                    <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 p-5 sm:p-6">
                        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                            <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-[#FF5500]"></span>
                                Report Overview
                            </h2>
                            @if (_selectedReport != null)
                            {
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold @GetStatusBadgeClass(_selectedReport.Status)">
                                    @(_selectedReport.Status ?? "RESOLVED")
                                </span>
                            }
                        </div>

                        @if (_selectedReport == null)
                        {
                            <div class="py-8 text-center text-slate-400">
                                <svg class="w-8 h-8 mx-auto mb-2 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                <p class="text-xs">Please select a report from the list below to review and appeal.</p>
                            </div>
                        }
                        else
                        {
                            <div class="space-y-4">
                                <div>
                                    <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Violation Reason</label>
                                    <p class="text-sm font-semibold text-slate-900 mt-0.5">
                                        @FormatReason(_selectedReport.Reason)
                                    </p>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_selectedReport.Description))
                                {
                                    <div>
                                        <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Report Description</label>
                                        <div class="mt-1 p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-700 leading-relaxed max-h-32 overflow-y-auto">
                                            @FormatDescription(_selectedReport.Description)
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(_selectedReport.ReportedPostSnippet))
                                {
                                    <div>
                                        <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Flagged Content Snippet</label>
                                        <div class="mt-1 p-3 rounded-xl bg-orange-50/60 border border-orange-100 text-xs text-orange-950 italic">
                                            "@_selectedReport.ReportedPostSnippet"
                                        </div>
                                    </div>
                                }

                                <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-100 text-[11px] text-slate-500">
                                    <div>
                                        <span class="block text-slate-400">Filed On:</span>
                                        <span class="font-medium text-slate-700">@FormatDate(_selectedReport.CreatedAt)</span>
                                    </div>
                                    <div>
                                        <span class="block text-slate-400">Resolved On:</span>
                                        <span class="font-medium text-slate-700">@FormatDate(_selectedReport.ResolvedAt)</span>
                                    </div>
                                </div>

                                @if (_selectedReport.HasActiveAppeal)
                                {
                                    <div class="p-3 rounded-xl bg-indigo-50 border border-indigo-200 text-xs text-indigo-900 flex items-start gap-2">
                                        <svg class="w-4 h-4 text-indigo-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        <span>This report currently has an appeal in status: <strong>@_selectedReport.CurrentAppealStatus</strong>. A new appeal cannot be submitted while one is active.</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Multiple Reports Switcher (if user has > 1 report) -->
                    @if (_appealableReports.Count > 1)
                    {
                        <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 p-5">
                            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">
                                Your Reports (@_appealableReports.Count)
                            </h3>
                            <div class="space-y-2 max-h-60 overflow-y-auto pr-1">
                                @foreach (var r in _appealableReports)
                                {
                                    var isSelected = _selectedReport?.ReportId == r.ReportId;
                                    <button type="button"
                                            @onclick="() => SelectReport(r)"
                                            class="w-full text-left p-3 rounded-2xl border transition cursor-pointer @(isSelected ? "bg-orange-50/80 border-[#FF5500] shadow-xs" : "bg-slate-50 hover:bg-slate-100 border-slate-200")">
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs font-bold @(isSelected ? "text-[#FF5500]" : "text-slate-800")">
                                                @FormatReason(r.Reason)
                                            </span>
                                            <span class="text-[10px] px-2 py-0.5 rounded-full @(r.HasActiveAppeal ? "bg-indigo-100 text-indigo-700" : "bg-slate-200 text-slate-600")">
                                                @(r.HasActiveAppeal ? r.CurrentAppealStatus : r.Status)
                                            </span>
                                        </div>
                                        <p class="text-[11px] text-slate-500 mt-1 line-clamp-1">
                                            @FormatDescription(r.Description)
                                        </p>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Right Column: Appeal Form -->
                <div class="lg:col-span-7">
                    <div class="bg-white rounded-3xl shadow-sm border border-slate-200/80 p-6 sm:p-8">
                        <div class="mb-6">
                            <h2 class="text-lg font-bold text-slate-900">Submit Your Appeal</h2>
                            <p class="text-xs text-slate-500 mt-1">
                                Explain the circumstance of the report. Be objective and provide clear context or evidence for Staff evaluation.
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(_formError))
                        {
                            <div class="mb-5 p-3.5 rounded-2xl bg-red-50 border border-red-200 text-xs text-red-700 flex items-center gap-2">
                                <svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span>@_formError</span>
                            </div>
                        }

                        <EditForm Model="@_submitModel" OnValidSubmit="HandleSubmitAppealAsync">
                            <DataAnnotationsValidator />

                            <!-- Appeal Reason Summary -->
                            <div class="mb-5">
                                <label class="block text-xs font-bold text-slate-800 mb-1.5">
                                    Appeal Reason Summary <span class="text-red-500">*</span>
                                </label>
                                <InputText @bind-Value="_submitModel.Reason"
                                           class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-[#FF5500] focus:ring-2 focus:ring-orange-100 outline-none text-xs text-slate-900 transition"
                                           placeholder="E.g., Misunderstanding of post intention / Unfair accusation" />
                                <div class="flex justify-between items-center mt-1">
                                    <ValidationMessage For="@(() => _submitModel.Reason)" class="text-[11px] text-red-600 font-medium" />
                                    <span class="text-[10px] text-slate-400 ml-auto">@(_submitModel.Reason?.Length ?? 0)/500 chars</span>
                                </div>
                            </div>

                            <!-- Detailed Explanation -->
                            <div class="mb-5">
                                <label class="block text-xs font-bold text-slate-800 mb-1.5">
                                    Detailed Explanation & Counter-Arguments <span class="text-red-500">*</span>
                                </label>
                                <InputTextArea @bind-Value="_submitModel.Content"
                                               rows="6"
                                               class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-[#FF5500] focus:ring-2 focus:ring-orange-100 outline-none text-xs text-slate-900 leading-relaxed transition"
                                               placeholder="Provide a thorough explanation of what transpired, why you believe the report is inaccurate, or any corrective steps taken..." />
                                <div class="flex justify-between items-center mt-1">
                                    <ValidationMessage For="@(() => _submitModel.Content)" class="text-[11px] text-red-600 font-medium" />
                                    <span class="text-[10px] text-slate-400 ml-auto">@(_submitModel.Content?.Length ?? 0)/2000 chars</span>
                                </div>
                            </div>

                            <!-- Evidence Upload Section -->
                            <div class="mb-6">
                                <label class="block text-xs font-bold text-slate-800 mb-1">
                                    Supporting Evidence (Images or Videos - Optional)
                                </label>
                                <p class="text-[11px] text-slate-500 mb-2.5">
                                    Screenshots, video recordings, or supporting documents (Images max 10MB, Videos max 100MB).
                                </p>

                                <div class="flex flex-wrap items-center gap-2 mb-3">
                                    <label class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl border border-dashed border-slate-300 hover:border-[#FF5500] bg-slate-50/50 hover:bg-orange-50/30 text-xs font-semibold text-slate-700 hover:text-[#FF5500] cursor-pointer transition">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                        </svg>
                                        <span>@(_isUploadingFile ? "Uploading..." : "Attach Evidence")</span>
                                        <InputFile OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp,.gif,.mp4,.mov,.avi,.mkv,.webm,image/*,video/*" class="hidden" disabled="@_isUploadingFile" />
                                    </label>

                                    @if (_isUploadingFile)
                                    {
                                        <div class="inline-flex items-center gap-2 text-xs text-slate-500">
                                            <div class="w-3.5 h-3.5 border-2 border-[#FF5500] border-t-transparent rounded-full animate-spin"></div>
                                            <span>Processing file...</span>
                                        </div>
                                    }
                                </div>

                                <!-- Attached Files Chips -->
                                @if (_evidenceList.Any())
                                {
                                    <div class="space-y-2.5">
                                        @for (int i = 0; i < _evidenceList.Count; i++)
                                        {
                                            var idx = i;
                                            var url = _evidenceList[idx];
                                            var isVideo = IsVideoUrl(url);
                                            <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs hover:bg-slate-100/70 transition">
                                                <div class="flex items-center gap-2.5 truncate">
                                                    @if (isVideo)
                                                    {
                                                        <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center flex-shrink-0 font-bold text-[10px] border border-purple-200">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                                            </svg>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="w-8 h-8 rounded-lg bg-orange-100 text-[#FF5500] flex items-center justify-center flex-shrink-0 font-bold text-[10px] border border-orange-200">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                            </svg>
                                                        </div>
                                                    }
                                                    <div class="truncate">
                                                        <a href="@url" target="_blank" rel="noopener noreferrer" class="text-slate-800 hover:text-[#FF5500] truncate font-medium block">
                                                            @(isVideo ? "Video Evidence" : "Image Evidence") #@(idx + 1)
                                                        </a>
                                                        <span class="text-[10px] text-slate-400">@(isVideo ? "Video (Click to open)" : "Image (Click to open)")</span>
                                                    </div>
                                                </div>
                                                <button type="button"
                                                        @onclick="() => RemoveEvidence(idx)"
                                                        class="text-slate-400 hover:text-red-500 p-1 rounded-lg transition cursor-pointer"
                                                        title="Remove evidence">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                                    </svg>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Submit Action Button -->
                            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                                <button type="submit"
                                        disabled="@(_isSubmitting || _selectedReport == null || _selectedReport.HasActiveAppeal)"
                                        class="px-6 py-2.5 bg-gradient-to-r from-[#FF5500] to-[#FF8C00] hover:from-[#e04c00] hover:to-[#e67e00] text-white font-bold text-xs rounded-xl shadow-md transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2">
                                    @if (_isSubmitting)
                                    {
                                        <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                        <span>Submitting Appeal...</span>
                                    }
                                    else
                                    {
                                        <span>Submit Appeal to Staff</span>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                        </svg>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "reportId")]
    public Guid? ReportId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private bool _isUploadingFile = false;
    private bool _isAuthenticated = false;
    private bool _isBlockedSession = false;

    private string? _criticalError;
    private string? _formError;

    private List<AppealableReport> _appealableReports = new();
    private AppealableReport? _selectedReport;
    private SubmitAppealRequest _submitModel = new();
    private List<string> _evidenceList = new();
    private AppealDetail? _successAppeal;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _criticalError = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

            if (!string.IsNullOrWhiteSpace(Token))
            {
                _isBlockedSession = true;
                _submitModel.AppealToken = Token.Trim();
            }

            if (!_isAuthenticated && string.IsNullOrWhiteSpace(_submitModel.AppealToken))
            {
                _criticalError = "You must be signed in or access this page with a valid appeal token.";
                return;
            }

            // Load appealable reports
            var reportsRes = await AppealService.GetMyAppealableReportsAsync(_submitModel.AppealToken);
            if (reportsRes.Success && reportsRes.Data != null)
            {
                _appealableReports = reportsRes.Data;
            }

            // Try to match preselected report
            if (ReportId.HasValue && ReportId.Value != Guid.Empty)
            {
                _selectedReport = _appealableReports.FirstOrDefault(r => r.ReportId == ReportId.Value);

                if (_selectedReport == null)
                {
                    // Fetch directly if not in list
                    var singleRes = await AppealService.GetAppealableReportByIdAsync(ReportId.Value, _submitModel.AppealToken);
                    if (singleRes.Success && singleRes.Data != null)
                    {
                        _selectedReport = singleRes.Data;
                        if (!_appealableReports.Any(r => r.ReportId == _selectedReport.ReportId))
                        {
                            _appealableReports.Insert(0, _selectedReport);
                        }
                    }
                    else
                    {
                        _criticalError = singleRes?.Message ?? "You can only appeal reports that were filed against your own account or content. You do not have permission to view or appeal this report.";
                        return;
                    }
                }
            }
            else if (_appealableReports.Any())
            {
                _selectedReport = _appealableReports.First();
            }

            if (_selectedReport != null)
            {
                _submitModel.ReportId = _selectedReport.ReportId;
            }
            else if (!_appealableReports.Any())
            {
                _criticalError = "No eligible violation reports were found on file for your account.";
            }
        }
        catch (Exception ex)
        {
            _criticalError = "An error occurred while loading appeal information: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectReport(AppealableReport report)
    {
        _selectedReport = report;
        _submitModel.ReportId = report.ReportId;
        _formError = null;
    }

    private static readonly string[] AllowedImageExts = { ".jpg", ".jpeg", ".png", ".webp", ".gif" };
    private static readonly string[] AllowedVideoExts = { ".mp4", ".mov", ".avi", ".mkv", ".webm" };
    private const long MaxImageBytes = 10 * 1024 * 1024; // 10MB
    private const long MaxVideoBytes = 100 * 1024 * 1024; // 100MB

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _formError = null;
        var file = e.File;
        if (file == null) return;

        if (_evidenceList.Count >= 10)
        {
            _formError = "You can upload a maximum of 10 evidence files.";
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        var isImage = AllowedImageExts.Contains(ext);
        var isVideo = AllowedVideoExts.Contains(ext);

        if (!isImage && !isVideo)
        {
            _formError = $"Unsupported file format for '{file.Name}'. Only images (JPG, PNG, WEBP, GIF) and videos (MP4, MOV, AVI, MKV, WEBM) are supported.";
            return;
        }

        if (isImage && file.Size > MaxImageBytes)
        {
            _formError = $"Image '{file.Name}' exceeds the maximum allowed size (10MB).";
            return;
        }

        if (isVideo && file.Size > MaxVideoBytes)
        {
            _formError = $"Video '{file.Name}' exceeds the maximum allowed size (100MB).";
            return;
        }

        _isUploadingFile = true;
        try
        {
            var res = await FileUploadService.UploadAsync(file);
            if (res.Success && !string.IsNullOrWhiteSpace(res.Data))
            {
                _evidenceList.Add(res.Data);
            }
            else
            {
                _formError = res.Message ?? "Failed to upload evidence file.";
            }
        }
        catch (Exception ex)
        {
            _formError = "Error uploading file: " + ex.Message;
        }
        finally
        {
            _isUploadingFile = false;
        }
    }

    private static bool IsVideoUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        var u = url.ToLowerInvariant();
        return u.EndsWith(".mp4") || u.EndsWith(".mov") || u.EndsWith(".avi") || 
               u.EndsWith(".mkv") || u.EndsWith(".webm") || u.Contains("/video/upload/");
    }

    private void RemoveEvidence(int index)
    {
        if (index >= 0 && index < _evidenceList.Count)
        {
            _evidenceList.RemoveAt(index);
        }
    }

    private async Task HandleSubmitAppealAsync()
    {
        _formError = null;

        if (_selectedReport == null || _submitModel.ReportId == Guid.Empty || _submitModel.ReportId != _selectedReport.ReportId)
        {
            _formError = "Please select a report to appeal.";
            return;
        }

        if (!_appealableReports.Any(r => r.ReportId == _submitModel.ReportId))
        {
            _formError = "You can only submit an appeal for reports filed against your own account or content.";
            return;
        }

        if (_selectedReport.HasActiveAppeal)
        {
            _formError = $"An appeal is already active ({_selectedReport.CurrentAppealStatus}) for this report.";
            return;
        }

        _isSubmitting = true;
        try
        {
            _submitModel.EvidenceUrls = _evidenceList.ToList();
            var res = await AppealService.SubmitAppealAsync(_submitModel);
            if (res.Success && res.Data != null)
            {
                _successAppeal = res.Data;
            }
            else
            {
                _formError = res.Message ?? "Failed to submit appeal. Please check your information.";
            }
        }
        catch (Exception ex)
        {
            _formError = "An unexpected error occurred: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string FormatDate(DateTime? dt)
    {
        if (!dt.HasValue) return "N/A";
        return dt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }

    private string FormatReason(string? reason)
    {
        if (string.IsNullOrWhiteSpace(reason)) return "Violation Report";

        var trimmed = reason.Trim();
        if (trimmed.Contains("Spam", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("quảng cáo", StringComparison.OrdinalIgnoreCase))
            return "Spam or advertising";
        if (trimmed.Contains("giao tiếp", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("chuẩn mực", StringComparison.OrdinalIgnoreCase))
            return "Inappropriate conduct or abusive communication";
        if (trimmed.Contains("chuyên nghiệp", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("lịch", StringComparison.OrdinalIgnoreCase))
            return "Unprofessional behavior / Missing scheduled sessions";
        if (trimmed.Contains("quấy rối", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("xúc phạm", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("công kích", StringComparison.OrdinalIgnoreCase))
            return "Harassment or bullying";
        if (trimmed.Contains("lừa đảo", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("gian lận", StringComparison.OrdinalIgnoreCase))
            return "Scam or fraudulent behavior";
        if (trimmed.Contains("tiêu chuẩn", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("vi phạm", StringComparison.OrdinalIgnoreCase))
            return "Community guidelines violation";

        return trimmed;
    }

    private string FormatDescription(string? desc)
    {
        if (string.IsNullOrWhiteSpace(desc)) return "No description provided.";

        var trimmed = desc.Trim();
        if (trimmed.Contains("liên kết", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("quảng cáo", StringComparison.OrdinalIgnoreCase))
            return "Posted suspicious external links or unauthorized promotional content.";
        if (trimmed.Contains("phát ngôn", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("tin nhắn", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("công kích", StringComparison.OrdinalIgnoreCase))
            return "Repeated aggressive remarks and violation of community conduct standards.";
        if (trimmed.Contains("lịch", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("buổi", StringComparison.OrdinalIgnoreCase))
            return "Did not attend scheduled session and failed to respond to messages.";
        if (trimmed.Contains("tiêu chuẩn", StringComparison.OrdinalIgnoreCase) || trimmed.Contains("quy định", StringComparison.OrdinalIgnoreCase))
            return "Reported for violating FitSocial community terms.";

        return trimmed;
    }

    private string GetStatusBadgeClass(string? status)
    {
        return (status?.ToUpperInvariant()) switch
        {
            "ACTIONTAKEN" or "RESOLVED" => "bg-emerald-100 text-emerald-800",
            "REJECTED" or "DISMISSED" => "bg-red-100 text-red-800",
            _ => "bg-amber-100 text-amber-800"
        };
    }

@page "/wallet/history"
@implements IDisposable
@attribute [Authorize]
@using FitSocial.Client.Layout
@using FitSocial.Client.Models.Transactions
@using FitSocial.Client.Services.Transactions
@using Microsoft.AspNetCore.Authorization
@inject ITransactionService TransactionService
@inject AuthenticationStateProvider AuthStateProvider
@inject AppShellContext Shell

<PageTitle>Transaction History - FitConnect</PageTitle>

<div class="flex flex-col gap-6 min-w-0 pb-12">
    <!-- Header Section -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <div class="flex items-center gap-2.5 mb-1">
                <div class="w-10 h-10 rounded-2xl bg-orange-50 border border-orange-100 flex items-center justify-center text-[#FF5500]">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                </div>
                <div>
                    <h1 class="text-xl font-black text-gray-800 tracking-tight">Transaction History</h1>
                    <p class="text-xs text-gray-500">Comprehensive overview of all payments, payouts, and subscription renewals</p>
                </div>
            </div>
        </div>

        @if (isCoach)
        {
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-3 py-1 rounded-xl bg-orange-50 text-[#FF5500] font-bold text-xs border border-orange-100">
                    <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
                    Coach Account
                </span>
            </div>
        }
    </div>

    <!-- Quick Stats Cards (Tóm tắt dòng tiền) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Total Inflow -->
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"></path></svg>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Total Received (Page)</p>
                <h4 class="text-lg font-black text-emerald-600 truncate">+@totalInflow.ToString("N0") VND</h4>
            </div>
        </div>

        <!-- Total Outflow -->
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-red-50 border border-red-100 flex items-center justify-center text-red-500 flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 13l-5 5m0 0l-5-5m5 5V6"></path></svg>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Total Paid (Page)</p>
                <h4 class="text-lg font-black text-red-500 truncate">-@totalOutflow.ToString("N0") VND</h4>
            </div>
        </div>

        <!-- Total Transactions Count -->
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-orange-50 border border-orange-100 flex items-center justify-center text-[#FF5500] flex-shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Total Entries</p>
                <h4 class="text-lg font-black text-gray-800">@totalItems</h4>
            </div>
        </div>
    </div>

    <!-- Filters & Tabs Container -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-5 flex flex-col gap-4">
        <!-- Tabs -->
        <div class="flex flex-wrap items-center gap-2 border-b border-gray-100 pb-4">
            <button @onclick='() => SetTypeFilter("ALL")'
                    class="px-4 py-2 rounded-xl text-xs font-bold transition cursor-pointer @(currentType == "ALL" ? "bg-[#FF5500] text-white shadow-sm" : "bg-gray-50 text-gray-600 hover:bg-gray-100")">
                All Transactions
            </button>
            <button @onclick='() => SetTypeFilter("PACKAGE_PURCHASE")'
                    class="px-4 py-2 rounded-xl text-xs font-bold transition cursor-pointer @(currentType == "PACKAGE_PURCHASE" ? "bg-[#FF5500] text-white shadow-sm" : "bg-gray-50 text-gray-600 hover:bg-gray-100")">
                @(isCoach ? "Package Sales" : "Package Purchases")
            </button>
            @if (isCoach)
            {
                <button @onclick='() => SetTypeFilter("PAYOUT")'
                        class="px-4 py-2 rounded-xl text-xs font-bold transition cursor-pointer @(currentType == "PAYOUT" ? "bg-[#FF5500] text-white shadow-sm" : "bg-gray-50 text-gray-600 hover:bg-gray-100")">
                    System Payouts
                </button>
            }
            <button @onclick='() => SetTypeFilter("REFUND")'
                    class="px-4 py-2 rounded-xl text-xs font-bold transition cursor-pointer @(currentType == "REFUND" ? "bg-[#FF5500] text-white shadow-sm" : "bg-gray-50 text-gray-600 hover:bg-gray-100")">
                Refunds
            </button>
            @if (isCoach)
            {
                <button @onclick='() => SetTypeFilter("COACH_ACTIVATION")'
                        class="px-4 py-2 rounded-xl text-xs font-bold transition cursor-pointer @(currentType == "COACH_ACTIVATION" ? "bg-[#FF5500] text-white shadow-sm" : "bg-gray-50 text-gray-600 hover:bg-gray-100")">
                    Coach Subscription
                </button>
            }
        </div>

        <!-- Date Range Filter Controls -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-1">
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-gray-500">From:</span>
                    <input type="date" @bind="fromDate" class="px-3 py-1.5 rounded-xl border border-gray-200 text-xs text-gray-700 bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-[#FF5500]" />
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-gray-500">To:</span>
                    <input type="date" @bind="toDate" class="px-3 py-1.5 rounded-xl border border-gray-200 text-xs text-gray-700 bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-[#FF5500]" />
                </div>
                <button @onclick="ApplyDateFilter" class="px-4 py-1.5 rounded-xl bg-gray-900 text-white text-xs font-bold hover:bg-black transition shadow-sm cursor-pointer">
                    Filter
                </button>
                @if (fromDate.HasValue || toDate.HasValue || currentType != "ALL")
                {
                    <button @onclick="ResetFilters" class="px-3 py-1.5 rounded-xl border border-gray-200 text-gray-600 text-xs font-bold hover:bg-gray-100 transition cursor-pointer">
                        Clear
                    </button>
                }
            </div>

            <div class="text-xs text-gray-400 font-medium">
                Page @currentPage of @(totalPages == 0 ? 1 : totalPages)
            </div>
        </div>
    </div>

    <!-- Transaction List Container -->
    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
        @if (isLoading)
        {
            <div class="flex flex-col items-center justify-center py-20">
                <div class="w-10 h-10 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-3"></div>
                <p class="text-sm text-gray-500 font-medium">Loading transactions...</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="p-12 text-center flex flex-col items-center justify-center">
                <p class="text-sm font-bold text-red-600 mb-3">@errorMessage</p>
                <button @onclick="LoadDataAsync" class="px-4 py-2 rounded-xl bg-gray-900 text-white text-xs font-bold hover:bg-black transition cursor-pointer">
                    Try Again
                </button>
            </div>
        }
        else if (transactions == null || !transactions.Any())
        {
            <div class="p-16 text-center flex flex-col items-center justify-center">
                <div class="w-16 h-16 mb-4 rounded-2xl bg-orange-50 border border-orange-100 flex items-center justify-center text-[#FF5500]">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                </div>
                <h4 class="font-bold text-gray-800 text-base mb-1">No transactions found</h4>
                <p class="text-xs text-gray-500 max-w-sm">There are no records matching your selected filter or time range.</p>
            </div>
        }
        else
        {
            <ul class="divide-y divide-gray-100">
                @foreach (var tx in transactions)
                {
                    <li class="p-5 hover:bg-orange-50/30 transition duration-150 ease-in-out">
                        <div class="flex items-center justify-between gap-4">
                            <!-- Left: Icon & Details -->
                            <div class="flex items-center flex-1 min-w-0">
                                <div class="flex-shrink-0 mr-4">
                                    @if (tx.Type == "PAYOUT")
                                    {
                                        <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                                        </div>
                                    }
                                    else if (tx.Type == "REFUND")
                                    {
                                        <div class="w-12 h-12 rounded-2xl bg-purple-50 border border-purple-100 flex items-center justify-center text-purple-600">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                        </div>
                                    }
                                    else if (tx.Type == "COACH_ACTIVATION")
                                    {
                                        <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-2xl bg-orange-50 border border-orange-100 flex items-center justify-center text-[#FF5500]">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                                        </div>
                                    }
                                </div>
                                <div class="min-w-0">
                                    <p class="text-sm font-bold text-gray-800 truncate">
                                        @tx.Description
                                    </p>
                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="text-xs text-gray-400">
                                            @tx.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                        @if (!string.IsNullOrEmpty(tx.ReferenceId))
                                        {
                                            <span class="text-gray-300">•</span>
                                            <span class="text-[11px] font-mono text-gray-400 truncate max-w-[150px] sm:max-w-[200px]" title="@tx.ReferenceId">
                                                Ref: @tx.ReferenceId
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Amount & Status Badge -->
                            <div class="flex flex-col items-end flex-shrink-0 text-right">
                                <p class="text-sm font-black @(tx.Amount < 0 ? "text-red-500" : "text-emerald-600") whitespace-nowrap">
                                    @(tx.Amount > 0 ? "+" : "")@(tx.Amount.ToString("N0")) @tx.Currency
                                </p>
                                <div class="mt-1.5">
                                    @if (tx.Status == "COMPLETED" || tx.Status == "PROCESSED" || tx.Status == "ACTIVE" || tx.Status == "PAID" || tx.Status == "APPROVED")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-600 text-[10px] font-bold border border-emerald-100 uppercase tracking-wider">
                                            Completed
                                        </span>
                                    }
                                    else if (tx.Status == "PENDING")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-600 text-[10px] font-bold border border-amber-100 uppercase tracking-wider">
                                            Pending
                                        </span>
                                    }
                                    else if (tx.Status == "REFUNDED")
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-purple-50 text-purple-600 text-[10px] font-bold border border-purple-100 uppercase tracking-wider">
                                            Refunded
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-gray-100 text-gray-500 text-[10px] font-bold border border-gray-200 uppercase tracking-wider">
                                            @tx.Status
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </li>
                }
            </ul>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="p-4 border-t border-gray-100 flex justify-between items-center bg-gray-50/50">
                    <button @onclick="PreviousPage" disabled="@(!hasPrevious)" class="px-4 py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-700 bg-white hover:bg-gray-50 hover:text-[#FF5500] disabled:opacity-40 disabled:cursor-not-allowed transition shadow-sm cursor-pointer">
                        Previous
                    </button>
                    <span class="text-xs font-bold text-gray-500">Page @currentPage of @totalPages</span>
                    <button @onclick="NextPage" disabled="@(!hasNext)" class="px-4 py-2 border border-gray-200 rounded-xl text-xs font-bold text-gray-700 bg-white hover:bg-gray-50 hover:text-[#FF5500] disabled:opacity-40 disabled:cursor-not-allowed transition shadow-sm cursor-pointer">
                        Next
                    </button>
                </div>
            }
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeFromQuery { get; set; }

    private List<TransactionHistoryDto> transactions = new();
    private bool isLoading = true;
    private string? errorMessage;

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int totalItems = 0;
    private bool hasNext = false;
    private bool hasPrevious = false;

    private string currentType = "ALL";
    private string? _lastAppliedTypeQuery;
    private DateTime? fromDate;
    private DateTime? toDate;

    private decimal totalInflow = 0;
    private decimal totalOutflow = 0;

    private bool isCoach = false;

    protected override async Task OnInitializedAsync()
    {
        Shell.ShowSearch = false;
        await LoadUserInfoAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var requestedType = !string.IsNullOrWhiteSpace(TypeFromQuery)
            ? TypeFromQuery.Trim().ToUpperInvariant()
            : "ALL";

        if (_lastAppliedTypeQuery != requestedType)
        {
            _lastAppliedTypeQuery = requestedType;
            currentType = requestedType;
            currentPage = 1;
            await LoadDataAsync();
        }
    }

    public void Dispose()
    {
        Shell.Reset();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var filter = new TransactionFilterDto
            {
                PageIndex = currentPage,
                PageSize = pageSize,
                Type = currentType == "ALL" ? null : currentType,
                FromDate = fromDate,
                ToDate = toDate
            };

            var response = await TransactionService.GetMyTransactionsAsync(filter);
            if (response.Success && response.Data != null)
            {
                transactions = response.Data.Items ?? new List<TransactionHistoryDto>();
                totalPages = response.Data.TotalPages;
                totalItems = response.Data.TotalCount;
                hasNext = response.Data.HasNextPage;
                hasPrevious = response.Data.HasPreviousPage;

                totalInflow = transactions.Where(t => t.Amount > 0).Sum(t => t.Amount);
                totalOutflow = transactions.Where(t => t.Amount < 0).Sum(t => Math.Abs(t.Amount));
            }
            else
            {
                errorMessage = response.Message ?? "Failed to load transaction history.";
                transactions = new();
                totalInflow = 0;
                totalOutflow = 0;
                totalItems = 0;
                totalPages = 1;
                hasNext = false;
                hasPrevious = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading transactions: {ex.Message}";
            transactions = new();
            totalInflow = 0;
            totalOutflow = 0;
            totalItems = 0;
            totalPages = 1;
            hasNext = false;
            hasPrevious = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetTypeFilter(string type)
    {
        currentType = type;
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task ApplyDateFilter()
    {
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task ResetFilters()
    {
        currentType = "ALL";
        fromDate = null;
        toDate = null;
        currentPage = 1;
        await LoadDataAsync();
    }

    private async Task PreviousPage()
    {
        if (hasPrevious)
        {
            currentPage--;
            await LoadDataAsync();
        }
    }

    private async Task NextPage()
    {
        if (hasNext)
        {
            currentPage++;
            await LoadDataAsync();
        }
    }

    private async Task LoadUserInfoAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                isCoach = user.IsInRole("COACH") || user.IsInRole("Coach") || user.IsInRole("coach");
            }
        }
        catch
        {
            isCoach = false;
        }
    }
}

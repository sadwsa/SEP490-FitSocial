@namespace FitSocial.Client.Layout
@inject NavigationManager Navigation

<aside class="home-left-sidebar hidden lg:block w-72 flex-shrink-0 sticky top-24 @Class">
    <nav class="flex flex-col gap-1">
        <!-- News Feed -->
        <a href="home"
           class="@GetItemClass("home")">
            <svg class="w-5 h-5 @GetIconClass("home")" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z">
                </path>
            </svg>
            News Feed
        </a>

        <!-- Friends / Community -->
        <a href="community"
           class="@GetItemClass("community")">
            <svg class="w-5 h-5 @GetIconClass("community")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
                </path>
            </svg>
            Friends
        </a>

        <!-- My Packages / Training Packages -->
        <a href="training-packages"
           class="@GetItemClass("packages")">
            <svg class="w-5 h-5 @GetIconClass("packages")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                </path>
            </svg>
            My Packages
        </a>

        <!-- Coaches List -->
        <a href="coaches"
           class="@GetItemClass("coaches")">
            <svg class="w-5 h-5 @GetIconClass("coaches")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                </path>
            </svg>
            Coaches List
        </a>

        <!-- Messages -->
        <a href="messages"
           class="@GetItemClass("messages")">
            <svg class="w-5 h-5 @GetIconClass("messages")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z">
                </path>
            </svg>
            Messages
        </a>

        @if (ChildContent != null)
        {
            <div class="mt-2 pt-2 border-t border-gray-100 flex flex-col gap-1">
                @ChildContent
            </div>
        }
    </nav>
</aside>

@code {
    [Parameter] public string? ActiveItem { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsActive(string name)
    {
        if (!string.IsNullOrWhiteSpace(ActiveItem))
        {
            return string.Equals(ActiveItem, name, StringComparison.OrdinalIgnoreCase);
        }

        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
        var rootSegment = relativePath.Split('?', '/')[0];

        return name switch
        {
            "home" => string.IsNullOrEmpty(rootSegment) || rootSegment == "home",
            "community" => rootSegment == "community",
            "packages" => rootSegment == "training-packages" || rootSegment == "workouts",
            "coaches" => rootSegment == "coaches",
            "messages" => rootSegment == "messages",
            _ => false
        };
    }

    private string GetItemClass(string name)
    {
        return IsActive(name)
            ? "p-3 bg-white rounded-xl shadow-sm font-semibold bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] bg-clip-text text-transparent flex items-center gap-3 border-l-4 border-[#FF5500] transition"
            : "p-3 hover:bg-orange-50/60 rounded-xl font-medium text-gray-700 flex items-center gap-3 transition";
    }

    private string GetIconClass(string name)
    {
        return IsActive(name) ? "text-[#FF5500]" : "text-gray-500";
    }
}

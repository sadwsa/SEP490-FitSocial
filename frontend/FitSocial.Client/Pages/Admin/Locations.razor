@page "/admin/locations"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN,STAFF")]
@implements IDisposable
@using FitSocial.Client.Models.Common
@using FitSocial.Client.Models.Locations
@using FitSocial.Client.Services.Locations
@inject ILocationService LocationService
@inject NavigationManager Navigation

<PageTitle>Location List Management - FitSocial Admin Portal</PageTitle>

<AuthorizeView Roles="ADMIN,STAFF">
    <Authorized>
        <div class="locations-page">
            <!-- Toast notification for success -->
            @if (!string.IsNullOrEmpty(toastMessage))
            {
                <div class="toast-alert success" role="alert">
                    <AppIcon Name="check" />
                    <span>@toastMessage</span>
                    <button type="button" class="btn-close-toast" @onclick="DismissToast" aria-label="Close notification">✕</button>
                </div>
            }

            <!-- Header section matching reference image -->
            <div class="page-top-bar">
                <div class="header-left">
                    <div class="breadcrumb-trail">
                        <span class="bc-admin">ADMIN PORTAL</span>
                        <span class="bc-sep">&gt;</span>
                        <span class="bc-dest">LOCATIONS &amp; FACILITIES</span>
                    </div>
                    <h1 class="page-heading">Location List Management</h1>
                </div>

                <!-- Add New Location button (UC_35.1) -->
                <div class="header-right">
                    <button type="button" class="btn-add-location" @onclick="OpenCreateModal">
                        <span class="btn-add-icon"><AppIcon Name="location-plus" /></span>
                        <span>+ Add New Location</span>
                    </button>
                </div>
            </div>

            <!-- Main card container -->
            <div class="locations-card">
                <!-- Search and Stats toolbar -->
                <div class="search-and-stats-bar">
                    <div class="search-input-box">
                        <span class="search-icon"><AppIcon Name="search" /></span>
                        <input type="text"
                               value="@searchTerm"
                               @oninput="OnSearchInput"
                               @onkeydown="OnSearchKeyDown"
                               placeholder="Search by ID, location name, district..."
                               class="search-input" />
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <button type="button" class="btn-clear-search" @onclick="ClearSearchAsync" title="Clear search">✕</button>
                        }
                    </div>

                    <div class="stats-and-actions">
                        <div class="count-badge" title="Total locations">
                            All (@(pagedResult.TotalCount))
                        </div>
                        <button type="button" class="btn-refresh" @onclick="() => LoadLocationsAsync(currentPage)" disabled="@isLoading" title="Refresh">
                            <AppIcon Name="refresh" Class="@(isLoading ? "icon-spin" : "")" />
                        </button>
                    </div>
                </div>

                <!-- Error State -->
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="state-card error-state">
                        <div class="state-content">
                            <span class="state-icon"><AppIcon Name="warning" /></span>
                            <span class="state-message">@errorMessage</span>
                            <button type="button" class="btn-retry" @onclick="() => LoadLocationsAsync(currentPage)">
                                <AppIcon Name="refresh" /> Retry
                            </button>
                        </div>
                    </div>
                }

                <!-- Loading State overlay / indicator -->
                @if (isLoading)
                {
                    <div class="loading-state">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Loading locations...</span>
                    </div>
                }

                <!-- Table -->
                <div class="table-responsive">
                    <table class="locations-table">
                        <thead>
                            <tr>
                                <th class="col-check">
                                    <input type="checkbox"
                                           class="table-checkbox"
                                           checked="@isAllSelected"
                                           @onchange="ToggleSelectAll"
                                           aria-label="Select all rows" />
                                </th>
                                <th class="col-id">LOCATION ID</th>
                                <th class="col-name">LOCATION NAME</th>
                                <th class="col-address">ADDRESS</th>
                                <th class="col-actions">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!isLoading && string.IsNullOrWhiteSpace(errorMessage) && !pagedResult.Items.Any())
                            {
                                <tr>
                                    <td colspan="5" class="empty-state-cell">
                                        <div class="empty-state">
                                            <span class="empty-icon"><AppIcon Name="location" /></span>
                                            <p class="empty-title">
                                                @(string.IsNullOrWhiteSpace(searchTerm) ? "No locations found." : "No locations match your search.")
                                            </p>
                                            @if (!string.IsNullOrWhiteSpace(searchTerm))
                                            {
                                                <button type="button" class="btn-clear-filter" @onclick="ClearSearchAsync">Clear search filter</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                var index = 0;
                                @foreach (var item in pagedResult.Items)
                                {
                                    index++;
                                    var displayIndex = (currentPage - 1) * pageSize + index;
                                    var displayIndexString = (100 + displayIndex).ToString();
                                    var isRowSelected = selectedLocationIds.Contains(item.LocationId);
                                    <tr class="location-row @(isRowSelected ? "row-selected" : "")">
                                        <td class="col-check">
                                            <input type="checkbox"
                                                   class="row-checkbox"
                                                   checked="@isRowSelected"
                                                   @onchange="(e) => ToggleSelectRow(item.LocationId, e)"
                                                   aria-label="Select row" />
                                        </td>
                                        <td class="col-id">
                                            <span class="loc-id">#@displayIndexString</span>
                                        </td>
                                        <td class="col-name">
                                            <span class="loc-name">@item.LocationName</span>
                                        </td>
                                        <td class="col-address">
                                            <div class="loc-address-wrap">
                                                <span class="loc-pin-icon">
                                                    <AppIcon Name="location" />
                                                </span>
                                                <span class="loc-address">@(string.IsNullOrWhiteSpace(item.Address) ? "No address specified" : item.Address)</span>
                                            </div>
                                        </td>
                                        <td class="col-actions">
                                            <button type="button" class="btn-action-edit" @onclick="() => OpenEditModal(item)" title="Edit location">
                                                <AppIcon Name="pencil" />
                                            </button>
                                            <button type="button"
                                                    class="btn-action-delete"
                                                    @onclick="() => OpenDeleteModal(item, displayIndexString)"
                                                    title="Delete Location">
                                                <AppIcon Name="trash" />
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination footer matching reference image -->
                <div class="pagination-footer">
                    <div class="pagination-info">
                        @if (pagedResult.TotalCount > 0)
                        {
                            var start = (currentPage - 1) * pageSize + 1;
                            var end = Math.Min(currentPage * pageSize, pagedResult.TotalCount);
                            <span>Showing <strong>@start - @end</strong> of <strong>@pagedResult.TotalCount</strong> locations</span>
                        }
                        else
                        {
                            <span>Showing <strong>0</strong> locations</span>
                        }
                    </div>

                    <!-- Pagination Controls: Always visible -->
                    <div class="pagination-controls">
                        <button type="button"
                                class="page-nav-btn prev-btn"
                                disabled="@(!pagedResult.HasPreviousPage || currentPage <= 1)"
                                @onclick="() => GoToPageAsync(currentPage - 1)"
                                title="Previous page">
                            &lt;
                        </button>

                        @if (pagedResult.TotalPages <= 1)
                        {
                            <button type="button" class="page-num-btn active">1</button>
                        }
                        else
                        {
                            @foreach (var p in GetVisiblePageNumbers())
                            {
                                if (p == -1)
                                {
                                    <span class="page-ellipsis">...</span>
                                }
                                else
                                {
                                    var pageNumber = p;
                                    <button type="button"
                                            class="page-num-btn @(pageNumber == currentPage ? "active" : "")"
                                            @onclick="() => GoToPageAsync(pageNumber)">
                                        @pageNumber
                                    </button>
                                }
                            }
                        }

                        <button type="button"
                                class="page-nav-btn next-btn"
                                disabled="@(!pagedResult.HasNextPage || currentPage >= pagedResult.TotalPages)"
                                @onclick="() => GoToPageAsync(currentPage + 1)"
                                title="Next page">
                            &gt;
                        </button>
                    </div>

                    <!-- Page Size Selector -->
                    <div class="page-size-selector">
                        <span>Per page:</span>
                        <select value="@pageSize" @onchange="OnPageSizeChangedAsync" class="page-size-select">
                            <option value="5">5 / page</option>
                            <option value="6">6 / page</option>
                            <option value="10">10 / page</option>
                            <option value="20">20 / page</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================== -->
        <!-- Add New Location Modal (UC_35.1)               -->
        <!-- ============================================== -->
        @if (showCreateModal)
        {
            <div class="modal-backdrop" @onclick="CloseCreateModal">
                <div class="modal-card" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="create-modal-title">
                    <!-- Modal Header -->
                    <div class="modal-header">
                        <div class="modal-title-group">
                            <div class="modal-icon-badge">
                                <AppIcon Name="location-plus" />
                            </div>
                            <h2 id="create-modal-title" class="modal-title">Add New Location</h2>
                        </div>
                        <button type="button" class="btn-close-modal" @onclick="CloseCreateModal" title="Close" disabled="@isSaving">
                            ✕
                        </button>
                    </div>

                    <!-- Modal Body / Form -->
                    <form @onsubmit="HandleCreateLocationAsync" @onsubmit:preventDefault="true" class="modal-form">
                        @if (!string.IsNullOrWhiteSpace(modalErrorMessage))
                        {
                            <div class="form-alert error" role="alert">
                                <AppIcon Name="warning" />
                                <span>@modalErrorMessage</span>
                            </div>
                        }

                        <!-- Field 1: Location Name -->
                        <div class="form-group">
                            <label class="form-label" for="locNameInput">
                                Location Name <span class="required-star">*</span>
                            </label>
                            <input id="locNameInput"
                                   type="text"
                                   class="form-control @(!string.IsNullOrEmpty(nameValidationError) ? "is-invalid" : "")"
                                   placeholder="E.g., FitSocial Flagship Hub - District 1"
                                   value="@newLocationModel.LocationName"
                                   @oninput="OnLocationNameInput"
                                   maxlength="200"
                                   disabled="@isSaving"
                                   autofocus />
                            @if (!string.IsNullOrEmpty(nameValidationError))
                            {
                                <div class="validation-message">@nameValidationError</div>
                            }
                        </div>

                        <!-- Field 2: Address -->
                        <div class="form-group">
                            <label class="form-label" for="locAddressInput">
                                Address <span class="required-star">*</span>
                            </label>
                            <textarea id="locAddressInput"
                                      class="form-control form-textarea @(!string.IsNullOrEmpty(addressValidationError) ? "is-invalid" : "")"
                                      placeholder="Building no., street, ward, district, city..."
                                      rows="3"
                                      value="@newLocationModel.Address"
                                      @oninput="OnAddressInput"
                                      maxlength="200"
                                      disabled="@isSaving"></textarea>
                            @if (!string.IsNullOrEmpty(addressValidationError))
                            {
                                <div class="validation-message">@addressValidationError</div>
                            }
                        </div>

                        <!-- Modal Actions / Footer -->
                        <div class="modal-actions">
                            <button type="button"
                                    class="btn-modal-cancel"
                                    @onclick="CloseCreateModal"
                                    disabled="@isSaving">
                                Cancel
                            </button>
                            <button type="submit"
                                    class="btn-modal-save"
                                    disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Create Location</span>
                                }
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- ============================================== -->
        <!-- Edit Location Modal (UC_35.2 - Matching Image 2) -->
        <!-- ============================================== -->
        @if (showEditModal)
        {
            <div class="modal-backdrop" @onclick="CloseEditModal">
                <div class="modal-card" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">
                    <!-- Modal Header -->
                    <div class="modal-header">
                        <div class="modal-title-group">
                            <div class="modal-icon-badge">
                                <AppIcon Name="location" />
                            </div>
                            <h2 id="edit-modal-title" class="modal-title">Edit Location</h2>
                        </div>
                        <button type="button" class="btn-close-modal" @onclick="CloseEditModal" title="Close" disabled="@isSavingEdit">
                            ✕
                        </button>
                    </div>

                    <!-- Modal Body / Form -->
                    <form @onsubmit="HandleUpdateLocationAsync" @onsubmit:preventDefault="true" class="modal-form">
                        @if (!string.IsNullOrWhiteSpace(editModalErrorMessage))
                        {
                            <div class="form-alert error" role="alert">
                                <AppIcon Name="warning" />
                                <span>@editModalErrorMessage</span>
                            </div>
                        }

                        <!-- Field 1: Location Name -->
                        <div class="form-group">
                            <label class="form-label" for="editLocNameInput">
                                Location Name <span class="required-star">*</span>
                            </label>
                            <input id="editLocNameInput"
                                   type="text"
                                   class="form-control @(!string.IsNullOrEmpty(editNameValidationError) ? "is-invalid" : "")"
                                   placeholder="E.g., FitSocial Flagship Hub - District 1"
                                   value="@editLocationModel.LocationName"
                                   @oninput="OnEditLocationNameInput"
                                   maxlength="200"
                                   disabled="@isSavingEdit"
                                   autofocus />
                            @if (!string.IsNullOrEmpty(editNameValidationError))
                            {
                                <div class="validation-message">@editNameValidationError</div>
                            }
                        </div>

                        <!-- Field 2: Address -->
                        <div class="form-group">
                            <label class="form-label" for="editLocAddressInput">
                                Address <span class="required-star">*</span>
                            </label>
                            <textarea id="editLocAddressInput"
                                      class="form-control form-textarea @(!string.IsNullOrEmpty(editAddressValidationError) ? "is-invalid" : "")"
                                      placeholder="Building no., street, ward, district, city..."
                                      rows="3"
                                      value="@editLocationModel.Address"
                                      @oninput="OnEditAddressInput"
                                      maxlength="200"
                                      disabled="@isSavingEdit"></textarea>
                            @if (!string.IsNullOrEmpty(editAddressValidationError))
                            {
                                <div class="validation-message">@editAddressValidationError</div>
                            }
                        </div>

                        <!-- Modal Actions / Footer -->
                        <div class="modal-actions">
                            <button type="button"
                                    class="btn-modal-cancel"
                                    @onclick="CloseEditModal"
                                    disabled="@isSavingEdit">
                                Cancel
                            </button>
                            <button type="submit"
                                    class="btn-modal-save"
                                    disabled="@isSavingEdit">
                                @if (isSavingEdit)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Updating...</span>
                                }
                                else
                                {
                                    <span>Update Location</span>
                                }
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <!-- ============================================== -->
        <!-- Confirm Delete Location Modal (UC_35.3 - Image 3) -->
        <!-- ============================================== -->
        @if (showDeleteModal && targetLocation != null)
        {
            <div class="modal-backdrop-custom" @onclick="CloseDeleteModal">
                <div class="delete-modal-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
                    <div class="delete-icon-badge">
                        <AppIcon Name="trash" />
                    </div>

                    <h3 class="delete-modal-title" id="deleteModalTitle">Confirm Delete Location</h3>

                    <div class="delete-prompt-box">
                        Are you sure you want to delete <strong>@targetLocation.LocationName</strong> (ID #@targetIndexString)?
                    </div>

                    @if (!string.IsNullOrWhiteSpace(deleteErrorMessage))
                    {
                        <div class="delete-error-alert" role="alert">
                            <AppIcon Name="warning" />
                            <span>@deleteErrorMessage</span>
                        </div>
                    }

                    <div class="delete-modal-actions">
                        <button type="button" class="btn-modal-cancel" @onclick="CloseDeleteModal" disabled="@isDeleting">
                            Cancel
                        </button>
                        <button type="button" class="btn-modal-delete" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">
                            @if (isDeleting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Deleting...</span>
                            }
                            else
                            {
                                <span>Delete</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Warning Modal: Cannot delete location in use -->
        @if (showWarningModal)
        {
            <div class="modal-backdrop-custom" @onclick="CloseWarningModal">
                <div class="warning-modal-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="warningModalTitle">
                    <div class="warning-icon-badge">
                        <AppIcon Name="warning" />
                    </div>

                    <h3 class="warning-modal-title" id="warningModalTitle">Cannot Delete Location</h3>

                    <div class="warning-prompt-box">
                        <p class="warning-main-text">
                            @(string.IsNullOrWhiteSpace(warningMessage)
                                ? $"Location \"{warningLocationName}\" is currently being used by posts and cannot be deleted."
                                : warningMessage)
                        </p>
                        <p class="warning-sub-text">
                            Please remove or update this location from associated posts before deleting.
                        </p>
                    </div>

                    <div class="warning-modal-actions">
                        <button type="button" class="btn-modal-understand" @onclick="CloseWarningModal">
                            Understood
                        </button>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="auth-denied-container">
            <div class="auth-alert error" role="alert">
                <AppIcon Name="warning" />
                <span>You do not have permission to access the Location List Management console. Staff or Admin authorization is required.</span>
            </div>
            <button type="button" class="btn-back" @onclick='() => Navigation.NavigateTo("/admin/login")'>
                Go to portal sign in
            </button>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string searchTerm = "";
    private int currentPage = 1;
    private int pageSize = 5; // Default 5 per page so pagination is immediately useful
    private PagedResult<LocationDto> pagedResult = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string? toastMessage;
    private System.Timers.Timer? debounceTimer;
    private System.Threading.CancellationTokenSource? toastCts;
    private HashSet<Guid> selectedLocationIds = new();

    // Create Modal state (UC_35.1)
    private bool showCreateModal = false;
    private bool isSaving = false;
    private string? modalErrorMessage;
    private string? nameValidationError;
    private string? addressValidationError;
    private CreateLocationDto newLocationModel = new();

    // Edit Modal state (UC_35.2)
    private bool showEditModal = false;
    private bool isSavingEdit = false;
    private Guid editingLocationId;
    private UpdateLocationDto editLocationModel = new();
    private string? editModalErrorMessage;
    private string? editNameValidationError;
    private string? editAddressValidationError;

    // Delete Modal State (UC_35.3)
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private LocationDto? targetLocation;
    private string targetIndexString = "";
    private string? deleteErrorMessage;

    // Warning Modal State (Cannot delete when location is used by posts)
    private bool showWarningModal = false;
    private string warningLocationName = "";
    private string warningMessage = "";

    private bool isAllSelected => pagedResult.Items.Any() && pagedResult.Items.All(i => selectedLocationIds.Contains(i.LocationId));

    protected override async Task OnInitializedAsync()
    {
        await LoadLocationsAsync(1);
    }

    private async Task LoadLocationsAsync(int page)
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            currentPage = page;

            var res = await LocationService.GetPagedLocationsAsync(searchTerm, currentPage, pageSize);
            if (res.Success && res.Data != null)
            {
                pagedResult = res.Data;
            }
            else
            {
                errorMessage = !string.IsNullOrWhiteSpace(res.Message)
                    ? res.Message
                    : "Unable to load locations.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load locations: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize) && newSize > 0)
        {
            pageSize = newSize;
            currentPage = 1;
            await LoadLocationsAsync(1);
        }
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            foreach (var item in pagedResult.Items)
            {
                selectedLocationIds.Add(item.LocationId);
            }
        }
        else
        {
            foreach (var item in pagedResult.Items)
            {
                selectedLocationIds.Remove(item.LocationId);
            }
        }
    }

    private void ToggleSelectRow(Guid id, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            selectedLocationIds.Add(id);
        }
        else
        {
            selectedLocationIds.Remove(id);
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        debounceTimer?.Stop();
        debounceTimer?.Dispose();
        debounceTimer = new System.Timers.Timer(350);
        debounceTimer.AutoReset = false;
        debounceTimer.Elapsed += async (_, _) =>
        {
            await InvokeAsync(async () =>
            {
                currentPage = 1;
                await LoadLocationsAsync(1);
            });
        };
        debounceTimer.Start();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            debounceTimer?.Stop();
            currentPage = 1;
            await LoadLocationsAsync(1);
        }
    }

    private async Task ClearSearchAsync()
    {
        searchTerm = "";
        debounceTimer?.Stop();
        currentPage = 1;
        await LoadLocationsAsync(1);
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || (pagedResult.TotalPages > 0 && page > pagedResult.TotalPages) || page == currentPage)
        {
            return;
        }

        await LoadLocationsAsync(page);
    }

    // Create Modal Handlers (UC_35.1)
    private void OpenCreateModal()
    {
        newLocationModel = new CreateLocationDto();
        nameValidationError = null;
        addressValidationError = null;
        modalErrorMessage = null;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        if (isSaving) return;
        showCreateModal = false;
        newLocationModel = new CreateLocationDto();
        nameValidationError = null;
        addressValidationError = null;
        modalErrorMessage = null;
    }

    private void OnLocationNameInput(ChangeEventArgs e)
    {
        newLocationModel.LocationName = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(newLocationModel.LocationName))
        {
            nameValidationError = null;
        }
    }

    private void OnAddressInput(ChangeEventArgs e)
    {
        newLocationModel.Address = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(newLocationModel.Address))
        {
            addressValidationError = null;
        }
    }

    private async Task HandleCreateLocationAsync()
    {
        if (isSaving) return;

        // Frontend validation
        bool hasError = false;
        nameValidationError = null;
        addressValidationError = null;
        modalErrorMessage = null;

        var trimmedName = newLocationModel.LocationName?.Trim() ?? "";
        var trimmedAddress = newLocationModel.Address?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            nameValidationError = "Location name is required.";
            hasError = true;
        }
        else if (trimmedName.Length > 200)
        {
            nameValidationError = "Location name cannot exceed 200 characters.";
            hasError = true;
        }

        if (string.IsNullOrWhiteSpace(trimmedAddress))
        {
            addressValidationError = "Address is required.";
            hasError = true;
        }
        else if (trimmedAddress.Length > 200)
        {
            addressValidationError = "Address cannot exceed 200 characters.";
            hasError = true;
        }

        if (hasError)
        {
            return;
        }

        try
        {
            isSaving = true;
            var requestDto = new CreateLocationDto
            {
                LocationName = trimmedName,
                Address = trimmedAddress
            };

            var res = await LocationService.CreateLocationAsync(requestDto);
            if (res.Success)
            {
                showCreateModal = false;
                ShowToast("Location created successfully.");
                currentPage = 1;
                await LoadLocationsAsync(1);
            }
            else
            {
                modalErrorMessage = !string.IsNullOrWhiteSpace(res.Message)
                    ? res.Message
                    : "Unable to create location. Please check your input.";
            }
        }
        catch (Exception ex)
        {
            modalErrorMessage = $"Error creating location: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // Edit Modal Handlers (UC_35.2)
    private void OpenEditModal(LocationDto item)
    {
        editingLocationId = item.LocationId;
        editLocationModel = new UpdateLocationDto
        {
            LocationName = item.LocationName,
            Address = item.Address
        };
        editNameValidationError = null;
        editAddressValidationError = null;
        editModalErrorMessage = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        if (isSavingEdit) return;
        showEditModal = false;
        editLocationModel = new UpdateLocationDto();
        editNameValidationError = null;
        editAddressValidationError = null;
        editModalErrorMessage = null;
    }

    private void OnEditLocationNameInput(ChangeEventArgs e)
    {
        editLocationModel.LocationName = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(editLocationModel.LocationName))
        {
            editNameValidationError = null;
        }
    }

    private void OnEditAddressInput(ChangeEventArgs e)
    {
        editLocationModel.Address = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(editLocationModel.Address))
        {
            editAddressValidationError = null;
        }
    }

    private async Task HandleUpdateLocationAsync()
    {
        if (isSavingEdit) return;

        bool hasError = false;
        editNameValidationError = null;
        editAddressValidationError = null;
        editModalErrorMessage = null;

        var trimmedName = editLocationModel.LocationName?.Trim() ?? "";
        var trimmedAddress = editLocationModel.Address?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            editNameValidationError = "Location name is required.";
            hasError = true;
        }
        else if (trimmedName.Length > 200)
        {
            editNameValidationError = "Location name cannot exceed 200 characters.";
            hasError = true;
        }

        if (string.IsNullOrWhiteSpace(trimmedAddress))
        {
            editAddressValidationError = "Address is required.";
            hasError = true;
        }
        else if (trimmedAddress.Length > 200)
        {
            editAddressValidationError = "Address cannot exceed 200 characters.";
            hasError = true;
        }

        if (hasError)
        {
            return;
        }

        try
        {
            isSavingEdit = true;
            var requestDto = new UpdateLocationDto
            {
                LocationName = trimmedName,
                Address = trimmedAddress
            };

            var res = await LocationService.UpdateLocationAsync(editingLocationId, requestDto);
            if (res.Success)
            {
                showEditModal = false;
                ShowToast("Location updated successfully.");
                await LoadLocationsAsync(currentPage);
            }
            else
            {
                editModalErrorMessage = !string.IsNullOrWhiteSpace(res.Message)
                    ? res.Message
                    : "Unable to update location. Please check your input.";
            }
        }
        catch (Exception ex)
        {
            editModalErrorMessage = $"Error updating location: {ex.Message}";
        }
        finally
        {
            isSavingEdit = false;
            StateHasChanged();
        }
    }

    // Delete Modal Handlers (UC_35.3)
    private void OpenDeleteModal(LocationDto item, string displayIndex)
    {
        if (item.PostCount > 0)
        {
            warningLocationName = item.LocationName;
            warningMessage = $"Location \"{item.LocationName}\" is currently being used by {item.PostCount} post(s) and cannot be deleted.";
            showWarningModal = true;
            return;
        }

        targetLocation = item;
        targetIndexString = displayIndex;
        deleteErrorMessage = null;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        if (isDeleting) return;
        showDeleteModal = false;
        targetLocation = null;
        targetIndexString = "";
        deleteErrorMessage = null;
    }

    private void CloseWarningModal()
    {
        showWarningModal = false;
        warningLocationName = "";
        warningMessage = "";
    }

    private async Task ConfirmDeleteAsync()
    {
        if (isDeleting || targetLocation == null) return;

        try
        {
            isDeleting = true;
            deleteErrorMessage = null;

            var res = await LocationService.DeleteLocationAsync(targetLocation.LocationId);
            if (res.Success)
            {
                showDeleteModal = false;
                targetLocation = null;
                ShowToast("Location deleted successfully.");

                if (pagedResult.Items.Count == 1 && currentPage > 1)
                {
                    currentPage--;
                }

                await LoadLocationsAsync(currentPage);
            }
            else
            {
                if (res.Message?.Contains("post", StringComparison.OrdinalIgnoreCase) == true ||
                    res.Message?.Contains("used by", StringComparison.OrdinalIgnoreCase) == true ||
                    res.Message?.Contains("in use", StringComparison.OrdinalIgnoreCase) == true ||
                    res.Message?.Contains("linked", StringComparison.OrdinalIgnoreCase) == true)
                {
                    var locName = targetLocation.LocationName;
                    showDeleteModal = false;
                    targetLocation = null;
                    warningLocationName = locName;
                    warningMessage = res.Message;
                    showWarningModal = true;
                }
                else
                {
                    deleteErrorMessage = !string.IsNullOrWhiteSpace(res.Message)
                        ? res.Message
                        : "Unable to delete location. It may be in use by existing records.";
                }
            }
        }
        catch (Exception ex)
        {
            deleteErrorMessage = $"Error deleting location: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private void ShowToast(string message)
    {
        toastMessage = message;
        toastCts?.Cancel();
        toastCts?.Dispose();
        toastCts = new System.Threading.CancellationTokenSource();
        var token = toastCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(3500, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        toastMessage = null;
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException) { }
        });
    }

    private void DismissToast()
    {
        toastMessage = null;
        toastCts?.Cancel();
    }

    private List<int> GetVisiblePageNumbers()
    {
        var list = new List<int>();
        var total = pagedResult.TotalPages;
        if (total <= 1) return list;

        if (total <= 7)
        {
            for (var i = 1; i <= total; i++) list.Add(i);
            return list;
        }

        list.Add(1);

        if (currentPage <= 4)
        {
            for (var i = 2; i <= Math.Min(5, total - 1); i++) list.Add(i);
            if (total > 6) list.Add(-1);
            list.Add(total);
        }
        else if (currentPage >= total - 3)
        {
            list.Add(-1);
            for (var i = total - 4; i <= total; i++) list.Add(i);
        }
        else
        {
            list.Add(-1);
            list.Add(currentPage - 1);
            list.Add(currentPage);
            list.Add(currentPage + 1);
            list.Add(-1);
            list.Add(total);
        }

        return list;
    }

    public void Dispose()
    {
        debounceTimer?.Stop();
        debounceTimer?.Dispose();
        toastCts?.Cancel();
        toastCts?.Dispose();
    }
}

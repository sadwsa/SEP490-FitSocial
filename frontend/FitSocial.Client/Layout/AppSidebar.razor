@namespace FitSocial.Client.Layout
@inject NavigationManager Navigation
@implements IDisposable

@* Sidebar trái. Chiều cao / vị trí dán mép do AppShellLayout.razor.css đảm nhiệm. *@
<aside class="app-shell-nav w-full">
    <div class="app-shell-card bg-white rounded-2xl shadow-sm p-3 @Class">
        <nav class="flex flex-col gap-1">
        <!-- News Feed -->
        <a href="home" class="@GetItemClass("home")">
            <svg class="w-5 h-5 @GetIconClass("home")" fill="currentColor" viewBox="0 0 20 20">
                <path
                    d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z">
                </path>
            </svg>
            News Feed
        </a>

        <!-- Package List (Available to all users: Trainees, Coaches, Guests) -->
        <a href="packages" class="@GetItemClass("package-list")">
            <svg class="w-5 h-5 @GetIconClass("package-list")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z">
                </path>
            </svg>
            Package List
        </a>

        <AuthorizeView Roles="COACH">
            <Authorized>
                <!-- My Packages (Coach only: Manage and CRUD own packages) -->
                <a href="training-packages" class="@GetItemClass("my-packages")">
                    <svg class="w-5 h-5 @GetIconClass("my-packages")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                        </path>
                    </svg>
                    My Packages
                </a>
            </Authorized>
        </AuthorizeView>

        <!-- Coaches List -->
        <a href="coaches" class="@GetItemClass("coaches")">
            <svg class="w-5 h-5 @GetIconClass("coaches")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 3 0 11-4 0 2 3 0 014 0zM7 10a2 3 0 11-4 0 2 3 0 014 0z">
                </path>
            </svg>
            Coaches List
        </a>

        <!-- Gỡ mục "Notifications" khỏi sidebar: chuông thông báo đã nằm ở AppHeader,
             mục cũ chiếm chỗ dọc và trùng chức năng. Trang /notifications vẫn truy cập được. -->

        <AuthorizeView Roles="COACH">
            <Authorized>
                <!-- Coach Dashboard & Revenue / Orders -->
                <a href="coach/dashboard" class="@GetItemClass("coach-dashboard")">
                    <svg class="w-5 h-5 @GetIconClass("coach-dashboard")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                        </path>
                    </svg>
                    Coach Dashboard
                </a>

                <!-- Trainee Purchase Orders History -->
                <a href="coach/trainee-orders" class="@GetItemClass("trainee-orders")">
                    <svg class="w-5 h-5 @GetIconClass("trainee-orders")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01">
                        </path>
                    </svg>
                    Trainee Orders
                </a>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="ADMIN,STAFF">
            <Authorized>
                <!-- Reports -->
                <a href="reports"
                   class="@GetItemClass("reports")">
                    <svg class="w-5 h-5 @GetIconClass("reports")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9">
                        </path>
                    </svg>
                    Reports
                </a>
            </Authorized>
        </AuthorizeView>

        @if (ChildContent != null)
        {
            <div class="mt-2 pt-2 border-t border-gray-100 flex flex-col gap-1">
                @ChildContent
            </div>
        }
        </nav>
    </div>
</aside>

@code {
    [Parameter] public string? ActiveItem { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        // Bảo đảm ô màu cam luôn cập nhật ngay khi đổi trang.
        // Nếu chỉ dựa vào vòng render của layout thì đôi lúc sidebar bị
        // render lại trước khi NavigationManager cập nhật Uri -> tô sai chỗ.
        Navigation.LocationChanged += HandleLocationChanged;
    }

    public void Dispose() => Navigation.LocationChanged -= HandleLocationChanged;

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private bool IsActive(string name)
    {
        if (!string.IsNullOrWhiteSpace(ActiveItem))
        {
            if (string.Equals(ActiveItem, name, StringComparison.OrdinalIgnoreCase))
                return true;

            if (name == "package-list" && string.Equals(ActiveItem, "packages", StringComparison.OrdinalIgnoreCase))
                return true;

            return false;
        }

        // Đường dẫn hiện tại, bỏ query + hash, tách thành các đoạn
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
        var path = relativePath.Split('?')[0].Split('#')[0].Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var root = segments.Length > 0 ? segments[0] : string.Empty;

        // /cart, /checkout... nằm trong luồng mua hàng -> về Package List
        // LƯU Ý: /training-packages/purchased (My Purchased Packages) cố ý KHÔNG map
        // vào Package List – sidebar không có mục tương ứng nên không tô cam gì cả.
        bool isBuyingFlow = root == "cart" || root == "checkout";

        // /training-packages/... (không phải marketplace) -> về My Packages
        // purchased bị loại có chủ đích, xem ghi chú ở trên.
        bool isCoachPackageFlow =
            root == "training-packages" &&
            !segments.Contains("marketplace") &&
            !segments.Contains("purchased");

        // /workout-plan/... và /meal-plan/... là kế hoạch thuộc gói -> My Packages
        bool isPlanFlow = root == "workout-plan" || root == "meal-plan";

        return name switch
        {
            "home" => string.IsNullOrEmpty(root) || root == "home",

            "package-list" =>
                root == "packages" ||
                (root == "training-packages" && segments.Contains("marketplace")) ||
                isBuyingFlow,

            "my-packages" => isCoachPackageFlow || isPlanFlow,

            "coaches" => root == "coaches",

            "coach-dashboard" =>
                root == "coach" && (segments.Length == 1 || segments.Contains("dashboard")),

            "trainee-orders" =>
                (root == "coach" && segments.Contains("trainee-orders")) ||
                root == "trainee-orders",

            "reports" =>
                root == "reports" ||
                (root == "admin" && path.Contains("reports")),

            _ => false
        };
    }

    private string GetItemClass(string name)
    {
        return IsActive(name)
            ? "p-3 bg-orange-50 rounded-xl font-semibold bg-gradient-to-r from-[#FF8C00] to-[#FF3B00] bg-clip-text text-transparent flex items-center gap-3 border-l-4 border-[#FF5500] transition"
            : "p-3 hover:bg-orange-50/60 rounded-xl font-medium text-gray-700 border-l-4 border-transparent flex items-center gap-3 transition";
    }

    private string GetIconClass(string name)
    {
        return IsActive(name) ? "text-[#FF5500]" : "text-gray-500";
    }
}
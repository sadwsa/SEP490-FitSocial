@page "/forgot-password"
@layout AuthLayout
@using System.Timers
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Reset Password - FitSocial</PageTitle>

<div class="login-hero">
    <img src="Logo_FitSocial.jpg" alt="FitSocial" class="hero-logo" />
    <div class="hero-text">
        <h1 class="hero-title">Reset <span>Password</span></h1>
        <p class="hero-sub">Enter your account email to receive a verification code, then set a new password.</p>
    </div>
</div>

<div class="reg-card">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="auth-alert error" role="alert"><AppIcon Name="warning" /><span>@errorMessage</span></div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="auth-alert success" role="alert"><AppIcon Name="check" /><span>@successMessage</span></div>
    }

    @if (!codeSent)
    {
        <EditForm Model="@forgotModel" OnValidSubmit="HandleSendCode">
            <DataAnnotationsValidator />

            <div class="field">
                <label>Email address <span class="req">*</span></label>
                <div class="input-wrap">
                    <span class="input-icon"><AppIcon Name="envelope" /></span>
                    <InputText @bind-Value="forgotModel.Email" class="form-control has-icon" placeholder="E.g.: athlete@fitsocial.vn" />
                </div>
                <ValidationMessage For="@(() => forgotModel.Email)" class="field-error" />
            </div>

            <button type="submit" class="btn-auth-primary" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Sending code...</span>
                }
                else
                {
                    <span>Send Verification Code →</span>
                }
            </button>
        </EditForm>
    }
    else
    {
        <div class="otp-email-box">
            <p class="otp-email-hint">Verification code sent to:</p>
            <p class="otp-email-value">@resetModel.Email</p>
            <button type="button" class="link-button" @onclick="GoBack">
                Use a different email
            </button>
        </div>

        <EditForm EditContext="@editContext" OnSubmit="HandleReset">
            <DataAnnotationsValidator />

            <div class="field text-center">
                <label class="d-block">OTP code (6 digits) <span class="req">*</span></label>
                <div class="otp-boxes">
                    @for (int i = 0; i < 6; i++)
                    {
                        int idx = i;
                        <input maxlength="1"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               class="otp-box"
                               value="@otpDigits[idx]"
                               @oninput="(e) => OnOtpInput(e, idx)"
                               @onkeydown="(e) => OnOtpKeyDown(e, idx)"
                               @ref="otpRefs[idx]" />
                    }
                </div>
                @if (showOtpError && CombinedOtp.Length != 6)
                {
                    <div class="field-error text-center">Please enter the full 6-digit OTP code.</div>
                }
            </div>

            <div class="field">
                <label>New password <span class="req">*</span></label>
                <div class="input-wrap">
                    <span class="input-icon"><AppIcon Name="lock" /></span>
                    <InputText type="@(showPassword ? "text" : "password")" @bind-Value="resetModel.NewPassword" class="form-control has-icon has-eye" placeholder="Minimum 6 characters" />
                    <button type="button" class="eye-btn" @onclick="() => showPassword = !showPassword" title="Show/hide password">
                        <AppIcon Name="@(showPassword ? "eye-slash" : "eye")" />
                    </button>
                </div>
                <ValidationMessage For="@(() => resetModel.NewPassword)" class="field-error" />
            </div>

            <div class="field">
                <label>Confirm new password <span class="req">*</span></label>
                <div class="input-wrap">
                    <span class="input-icon"><AppIcon Name="lock" /></span>
                    <InputText type="@(showConfirmPassword ? "text" : "password")" @bind-Value="resetModel.ConfirmPassword" class="form-control has-icon has-eye" placeholder="Re-enter the new password" />
                    <button type="button" class="eye-btn" @onclick="() => showConfirmPassword = !showConfirmPassword" title="Show/hide password">
                        <AppIcon Name="@(showConfirmPassword ? "eye-slash" : "eye")" />
                    </button>
                </div>
                <ValidationMessage For="@(() => resetModel.ConfirmPassword)" class="field-error" />
            </div>

            <div class="otp-foot">
                <span class="resend-hint">Didn't receive the code?</span>
                @if (resendCountdown > 0)
                {
                    <span class="resend-wait">Resend in @(resendCountdown)s</span>
                }
                else
                {
                    <button type="button" class="resend-link" @onclick="HandleSendCode" disabled="@isLoading">
                        Resend code
                    </button>
                }
            </div>

            <button type="submit" class="btn-auth-primary" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span>Resetting...</span>
                }
                else
                {
                    <span>Reset Password →</span>
                }
            </button>
        </EditForm>
    }

    <div class="reg-footer">
        Remembered it? <a href="login">Back to sign in</a>
    </div>
</div>

@code {
    private ForgotPasswordRequest forgotModel = new();
    private ResetPasswordRequest resetModel = new();
    private EditContext editContext = default!;
    private bool codeSent = false;
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private bool showOtpError = false;
    private bool isLoading = false;
    private string? errorMessage;
    private string? successMessage;
    private string[] otpDigits = new string[6] { "", "", "", "", "", "" };
    private ElementReference[] otpRefs = new ElementReference[6];
    private int resendCountdown = 0;
    private Timer? resendTimer;

    private string CombinedOtp => string.Concat(otpDigits);

    protected override void OnInitialized()
    {
        editContext = new EditContext(resetModel);
    }

    private async Task OnOtpInput(ChangeEventArgs e, int idx)
    {
        var raw = e.Value?.ToString() ?? "";
        var digits = new string(raw.Where(char.IsDigit).ToArray());
        otpDigits[idx] = digits.Length > 0 ? digits[^1].ToString() : "";
        if (!string.IsNullOrEmpty(otpDigits[idx]) && idx < 5)
        {
            await otpRefs[idx + 1].FocusAsync();
        }
    }

    private async Task OnOtpKeyDown(KeyboardEventArgs e, int idx)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(otpDigits[idx]) && idx > 0)
        {
            await otpRefs[idx - 1].FocusAsync();
        }
    }

    private async Task HandleSendCode()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        try
        {
            var email = codeSent ? resetModel.Email : (forgotModel.Email ?? "").Trim();
            if (string.IsNullOrWhiteSpace(email) || !email.Contains("@"))
            {
                errorMessage = "Please enter a valid email address.";
                return;
            }

            var result = await AuthService.ForgotPasswordAsync(email);
            if (result.Success)
            {
                resetModel.Email = email;
                Array.Clear(otpDigits, 0, otpDigits.Length);
                showOtpError = false;
                codeSent = true;
                successMessage = "New verification code sent. It is valid for 5 minutes.";
                StartResendCountdown();
            }
            else
            {
                errorMessage = result.Message ?? "Could not send the code. Please try again.";
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleReset()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        showOtpError = true;
        StateHasChanged();

        try
        {
            resetModel.OtpCode = CombinedOtp;
            if (!editContext.Validate() || CombinedOtp.Length != 6)
            {
                if (CombinedOtp.Length != 6)
                {
                    errorMessage = "Please enter the full 6-digit OTP code.";
                }
                else
                {
                    errorMessage = "Please check the information you entered.";
                }
                return;
            }

            var result = await AuthService.ResetPasswordAsync(resetModel);
            if (result.Success)
            {
                successMessage = (result.Message ?? "Password reset successfully.") + " Redirecting to sign in...";
                StateHasChanged();
                await Task.Delay(1800);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = result.Message ?? "Reset failed. Please check the code and try again.";
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        codeSent = false;
        errorMessage = null;
        successMessage = null;
        showOtpError = false;
        resendTimer?.Stop();
        resendCountdown = 0;
        Array.Clear(otpDigits, 0, otpDigits.Length);
        resetModel = new ResetPasswordRequest();
        editContext = new EditContext(resetModel);
    }

    private void StartResendCountdown()
    {
        resendCountdown = 60;
        resendTimer?.Dispose();
        resendTimer = new Timer(1000);
        resendTimer.Elapsed += (sender, e) =>
        {
            if (resendCountdown > 0)
            {
                resendCountdown--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                resendTimer?.Stop();
            }
        };
        resendTimer.Start();
    }

    public void Dispose()
    {
        resendTimer?.Dispose();
    }
}

@page "/admin/staff"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN")]
@implements IDisposable
@using FitSocial.Client.Models.Common
@using FitSocial.Client.Models.Users
@using FitSocial.Client.Services.Users
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Staff Accounts - FitSocial Admin Console</PageTitle>

<AuthorizeView Roles="ADMIN">
    <Authorized>
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="auth-alert info toast-auto-dismiss" role="alert">
                <AppIcon Name="info" />
                <span class="toast-text">@toastMessage</span>
                <button type="button" class="toast-dismiss-btn" @onclick="DismissToast" title="Dismiss notification" aria-label="Dismiss notification">✕</button>
            </div>
        }

        <h2 class="view-title">Staff Accounts</h2>
        <p class="view-sub">Directory of all staff accounts across the FitSocial platform.</p>

        <div class="cat-tabs mb-3">
            <button type="button" class="cat-tab @(staffStatusFilter == "active" ? "active" : "")" @onclick='() => SetStaffStatusFilterAsync("active")'>
                <span class="status-dot dot-active"></span> Active Accounts
            </button>
            <button type="button" class="cat-tab @(staffStatusFilter == "locked" ? "active" : "")" @onclick='() => SetStaffStatusFilterAsync("locked")'>
                <span class="status-dot dot-locked"></span> Locked Accounts
            </button>
            <button type="button" class="cat-tab @(staffStatusFilter == "all" ? "active" : "")" @onclick='() => SetStaffStatusFilterAsync("all")'>
                All Accounts
            </button>
        </div>

        <div class="toolbar">
            <div class="search-wrap">
                <span class="search-icon"><AppIcon Name="search" /></span>
                <input value="@staffSearch" @oninput="OnStaffSearchInput" @onkeydown="HandleStaffSearchKeyDown" class="toolbar-input" placeholder="Search staff name or email..." />
            </div>
            <button type="button" class="row-btn" @onclick="LoadStaffAsync" disabled="@isLoadingStaff">
                <span class="btn-ic"><AppIcon Name="refresh" /></span> Refresh
            </button>
            <button type="button" class="row-btn add" @onclick="OpenCreateStaffModal" id="btn-create-staff">
                + Create Staff Account
            </button>
        </div>

        @if (isLoadingStaff)
        {
            <div class="py-3 text-center muted">
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Loading staff accounts from database...</span>
            </div>
        }

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th class="text-end" style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in pagedStaff.Items)
                    {
                        <tr>
                            <td><strong>@u.FullName</strong><br /><small class="muted">@(u.PhoneNumber ?? "No phone")</small></td>
                            <td>@u.Email</td>
                            <td><span class="role-badge staff">@u.RoleCode</span></td>
                            <td>
                                @if (u.IsLocked)
                                {
                                    <span class="status-badge locked">Locked</span>
                                }
                                else
                                {
                                    <span class="status-badge active">Active</span>
                                }
                            </td>
                            <td>
                                @(u.CreatedAt?.ToString("MMM dd, yyyy") ?? "-")
                            </td>
                            <td class="text-end" style="white-space: nowrap;">
                                <button type="button" class="row-btn edit" disabled="@isLockingStaff" @onclick="() => OpenEditStaffModal(u)" title="Edit staff account" id="@($"btn-edit-staff-{u.UserId}")">Edit</button>
                                @if (u.IsLocked)
                                {
                                    <button type="button" class="row-btn unlock" disabled="@isLockingStaff" @onclick="() => SetStaffLockStatusAsync(u, false)" title="Unlock staff account" id="@($"btn-unlock-staff-{u.UserId}")">
                                        @if (lockingStaffId == u.UserId)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        }
                                        Unlock
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="row-btn lock" disabled="@isLockingStaff" @onclick="() => SetStaffLockStatusAsync(u, true)" title="Lock staff account" id="@($"btn-lock-staff-{u.UserId}")">
                                        @if (lockingStaffId == u.UserId)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                        }
                                        Lock
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!isLoadingStaff && !pagedStaff.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center muted py-4">No staff accounts match.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-container">
            <div class="pagination-info">
                @if (pagedStaff.TotalCount > 0)
                {
                    var start = (staffCurrentPage - 1) * staffPageSize + 1;
                    var end = Math.Min(staffCurrentPage * staffPageSize, pagedStaff.TotalCount);
                    <span>Showing <strong>@start–@end</strong> of <strong>@pagedStaff.TotalCount</strong> staff accounts</span>
                }
                else
                {
                    <span>0 staff accounts</span>
                }
            </div>
            @if (pagedStaff.TotalPages > 1)
            {
                <div class="pagination-controls">
                    <button type="button" class="page-btn" disabled="@(!pagedStaff.HasPreviousPage)" @onclick="() => GoToStaffPageAsync(staffCurrentPage - 1)">‹ Previous</button>
                    @foreach (var p in GetVisibleStaffPageNumbers())
                    {
                        if (p == -1) { <span class="page-dots">…</span> }
                        else { var pageNum = p; <button type="button" class="page-btn @(pageNum == staffCurrentPage ? "active" : "")" @onclick="() => GoToStaffPageAsync(pageNum)">@pageNum</button> }
                    }
                    <button type="button" class="page-btn" disabled="@(!pagedStaff.HasNextPage)" @onclick="() => GoToStaffPageAsync(staffCurrentPage + 1)">Next ›</button>
                </div>
            }
            <div class="page-size-selector">
                <span>Per page:</span>
                <select value="@staffPageSize" @onchange="OnStaffPageSizeChangedAsync" class="page-size-select">
                    <option value="10">10 / page</option>
                    <option value="20">20 / page</option>
                    <option value="50">50 / page</option>
                </select>
            </div>
        </div>

        @if (showCreateStaffModal)
        {
            <div class="modal-overlay" @onclick="CloseCreateStaffModal">
                <div class="modal-card" style="display: flex; flex-direction: column; max-height: 90vh; overflow: hidden;" @onclick:stopPropagation="true">
                    <div class="modal-header" style="flex-shrink: 0;">
                        <div>
                            <h3>Create Staff Account</h3>
                        </div>
                        <button type="button" class="modal-close-btn" @onclick="CloseCreateStaffModal" title="Close" disabled="@isSubmitting">✕</button>
                    </div>
                    <form class="modal-form" style="display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden;" autocomplete="off" @onsubmit="HandleCreateStaffAsync" @onsubmit:preventDefault>
                        <div class="modal-body" style="flex: 1; min-height: 0; overflow-y: auto;">
                            @if (!string.IsNullOrEmpty(createErrorMessage))
                            {
                                <div class="auth-alert error" role="alert">
                                    <AppIcon Name="warning" />
                                    <span>@createErrorMessage</span>
                                </div>
                            }

                            <div class="form-group">
                                <label class="form-label" for="staff-fullname">Full Name <span class="text-danger">*</span></label>
                                <input id="staff-fullname"
                                       value="@newStaffModel.FullName"
                                       @oninput="OnFullNameInput"
                                       @onblur="OnFullNameBlur"
                                       class="toolbar-input @(nameHasError ? "input-error" : "")"
                                       placeholder="e.g. John Doe"
                                       autocomplete="off"
                                       disabled="@isSubmitting" />
                                @if (!string.IsNullOrEmpty(nameErrorMessage))
                                {
                                    <small class="field-error-text" style="color: #dc2626; font-size: 0.72rem; margin-top: 3px; display: block;">@nameErrorMessage</small>
                                }
                            </div>

                            <div class="form-group">
                                <div class="email-label-row">
                                    <label class="form-label" for="staff-email">Email Address <span class="text-danger">*</span></label>
                                    @if (isCheckingEmail)
                                    {
                                        <span class="email-status-text muted">
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>Checking...
                                        </span>
                                    }
                                    else if (isEmailAvailable == true)
                                    {
                                        <span class="email-status-text success">✓ Email is available</span>
                                    }
                                    else if (isEmailAvailable == false)
                                    {
                                        <span class="email-status-text danger">✕ Email already in use</span>
                                    }
                                </div>
                                <input id="staff-email" type="email" @bind="newStaffModel.Email" @onblur="OnEmailBlurAsync" class="toolbar-input @(isEmailAvailable == false ? "input-error" : isEmailAvailable == true ? "input-success" : "")" placeholder="e.g. staff@gmail.com" autocomplete="off" disabled="@isSubmitting" />
                                <small class="form-hint">Enter the staff member's email address (e.g. staff@gmail.com).</small>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="staff-phone">Phone Number <small class="text-muted">(Optional)</small></label>
                                <input id="staff-phone"
                                       type="tel"
                                       inputmode="numeric"
                                       maxlength="10"
                                       onkeydown="return (event.ctrlKey || event.metaKey || ['Backspace','Delete','ArrowLeft','ArrowRight','Tab','Enter'].includes(event.key) || (event.key >= '0' && event.key <= '9'))"
                                       onpaste="setTimeout(() => { this.value = this.value.replace(/\D/g, '').slice(0, 10); }, 0)"
                                       value="@newStaffModel.PhoneNumber"
                                       @oninput="OnPhoneNumberInput"
                                       @onblur="OnPhoneNumberBlur"
                                       class="toolbar-input @(phoneHasError ? "input-error" : "")"
                                       placeholder="e.g. 0901234567"
                                       autocomplete="off"
                                       disabled="@isSubmitting" />
                                @if (!string.IsNullOrEmpty(phoneErrorMessage))
                                {
                                    <small class="field-error-text" style="color: #dc2626; font-size: 0.72rem; margin-top: 3px; display: block;">@phoneErrorMessage</small>
                                }
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="staff-password">Password <span class="text-danger">*</span></label>
                                <input id="staff-password" type="password" @bind="newStaffModel.Password" class="toolbar-input" placeholder="At least 6 characters" autocomplete="new-password" disabled="@isSubmitting" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="staff-confirm-password">Confirm Password <span class="text-danger">*</span></label>
                                <input id="staff-confirm-password" type="password" @bind="newStaffModel.ConfirmPassword" class="toolbar-input" placeholder="Re-enter password" autocomplete="new-password" disabled="@isSubmitting" />
                            </div>

                        </div>
                        <div class="modal-footer" style="flex-shrink: 0; display: flex; align-items: center; justify-content: flex-end; gap: 12px; padding: 14px 20px; border-top: 1px solid #e2e8f0; background: #f8fafc;">
                            <button type="button" class="btn-modal-cancel" style="display: inline-flex; align-items: center; justify-content: center; height: 38px; min-width: 90px; padding: 0 18px; border-radius: 8px; border: 1.5px solid #cbd5e1; background: #ffffff; color: #475569; font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: all 0.15s ease;" @onclick="CloseCreateStaffModal" disabled="@isSubmitting">Cancel</button>
                            <button type="submit" class="btn-modal-submit" style="display: inline-flex; align-items: center; justify-content: center; height: 38px; min-width: 120px; padding: 0 22px; border-radius: 8px; border: 1.5px solid #ff5722; background: #ff5722; color: #ffffff; font-weight: 600; font-size: 0.85rem; cursor: pointer; box-shadow: 0 2px 4px rgba(255,87,34,0.25); transition: all 0.15s ease;" disabled="@isSubmitting" id="btn-submit-create-staff">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Creating...</span>
                                }
                                else
                                {
                                    <span>Create Staff</span>
                                }
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (showEditStaffModal)
        {
            <div class="modal-overlay" style="z-index: 1100;" @onclick="CloseEditStaffModal">
                <div class="modal-card" style="display: flex; flex-direction: column; max-height: 90vh; overflow: hidden;" @onclick:stopPropagation="true">
                    <div class="modal-header" style="flex-shrink: 0;">
                        <div>
                            <h3>Edit Staff Account</h3>
                            <small class="text-muted">Update staff member information</small>
                        </div>
                        <button type="button" class="modal-close-btn" @onclick="CloseEditStaffModal" title="Close" disabled="@isSubmittingEdit">✕</button>
                    </div>
                    <form class="modal-form" style="display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden;" autocomplete="off" @onsubmit="HandleUpdateStaffAsync" @onsubmit:preventDefault>
                        <div class="modal-body" style="flex: 1; min-height: 0; overflow-y: auto;">
                            @if (!string.IsNullOrEmpty(editErrorMessage))
                            {
                                <div class="auth-alert error" role="alert">
                                    <AppIcon Name="warning" />
                                    <span>@editErrorMessage</span>
                                </div>
                            }

                            <div class="form-group">
                                <label class="form-label" for="edit-staff-fullname">Full Name <span class="text-danger">*</span></label>
                                <input id="edit-staff-fullname"
                                       value="@editStaffModel.FullName"
                                       @oninput="OnEditFullNameInput"
                                       @onblur="OnEditFullNameBlur"
                                       class="toolbar-input @(editNameHasError ? "input-error" : "")"
                                       placeholder="e.g. John Doe"
                                       autocomplete="off"
                                       disabled="@isSubmittingEdit" />
                                @if (!string.IsNullOrEmpty(editNameErrorMessage))
                                {
                                    <small class="field-error-text" style="color: #dc2626; font-size: 0.72rem; margin-top: 3px; display: block;">@editNameErrorMessage</small>
                                }
                            </div>

                            <div class="form-group">
                                <div class="email-label-row">
                                    <label class="form-label" for="edit-staff-email">Email Address <span class="text-danger">*</span></label>
                                    @if (isCheckingEditEmail)
                                    {
                                        <span class="email-status-text muted">
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>Checking...
                                        </span>
                                    }
                                    else if (isEditEmailAvailable == true)
                                    {
                                        <span class="email-status-text success">✓ Email is available</span>
                                    }
                                    else if (isEditEmailAvailable == false)
                                    {
                                        <span class="email-status-text danger">✕ Email already in use</span>
                                    }
                                </div>
                                <input id="edit-staff-email" type="email" @bind="editStaffModel.Email" @onblur="OnEditEmailBlurAsync" class="toolbar-input @(isEditEmailAvailable == false ? "input-error" : isEditEmailAvailable == true ? "input-success" : "")" placeholder="e.g. staff@gmail.com" autocomplete="off" disabled="@isSubmittingEdit" />
                                <small class="form-hint">Enter the staff member's email address.</small>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="edit-staff-phone">Phone Number <small class="text-muted">(Optional)</small></label>
                                <input id="edit-staff-phone"
                                       type="tel"
                                       inputmode="numeric"
                                       maxlength="10"
                                       onkeydown="return (event.ctrlKey || event.metaKey || ['Backspace','Delete','ArrowLeft','ArrowRight','Tab','Enter'].includes(event.key) || (event.key >= '0' && event.key <= '9'))"
                                       onpaste="setTimeout(() => { this.value = this.value.replace(/\D/g, '').slice(0, 10); }, 0)"
                                       value="@editStaffModel.PhoneNumber"
                                       @oninput="OnEditPhoneNumberInput"
                                       @onblur="OnEditPhoneNumberBlur"
                                       class="toolbar-input @(editPhoneHasError ? "input-error" : "")"
                                       placeholder="e.g. 0901234567"
                                       autocomplete="off"
                                       disabled="@isSubmittingEdit" />
                                @if (!string.IsNullOrEmpty(editPhoneErrorMessage))
                                {
                                    <small class="field-error-text" style="color: #dc2626; font-size: 0.72rem; margin-top: 3px; display: block;">@editPhoneErrorMessage</small>
                                }
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="edit-staff-password">New Password <small class="text-muted">(Leave blank to keep unchanged)</small></label>
                                <input id="edit-staff-password" type="password" @bind="editStaffModel.Password" class="toolbar-input" placeholder="Leave blank to keep current password" autocomplete="new-password" disabled="@isSubmittingEdit" />
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="edit-staff-confirm-password">Confirm New Password</label>
                                <input id="edit-staff-confirm-password" type="password" @bind="editStaffModel.ConfirmPassword" class="toolbar-input" placeholder="Re-enter new password" autocomplete="new-password" disabled="@isSubmittingEdit" />
                            </div>

                        </div>
                        <div class="modal-footer" style="flex-shrink: 0; display: flex; align-items: center; justify-content: flex-end; gap: 12px; padding: 14px 20px; border-top: 1px solid #e2e8f0; background: #f8fafc;">
                            <button type="button" class="btn-modal-cancel" style="display: inline-flex; align-items: center; justify-content: center; height: 38px; min-width: 90px; padding: 0 18px; border-radius: 8px; border: 1.5px solid #cbd5e1; background: #ffffff; color: #475569; font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: all 0.15s ease;" @onclick="CloseEditStaffModal" disabled="@isSubmittingEdit">Cancel</button>
                            <button type="submit" class="btn-modal-submit" style="display: inline-flex; align-items: center; justify-content: center; height: 38px; min-width: 120px; padding: 0 22px; border-radius: 8px; border: 1.5px solid #ff5722; background: #ff5722; color: #ffffff; font-weight: 600; font-size: 0.85rem; cursor: pointer; box-shadow: 0 2px 4px rgba(255,87,34,0.25); transition: all 0.15s ease;" disabled="@isSubmittingEdit" id="btn-submit-edit-staff">
                                @if (isSubmittingEdit)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Save Changes</span>
                                }
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (showEmailExistsModal)
        {
            <div class="modal-overlay alert-overlay" style="z-index: 1200;" @onclick="CloseEmailExistsModal">
                <div class="modal-card alert-modal" @onclick:stopPropagation="true" role="alertdialog" aria-modal="true" aria-labelledby="email-alert-title">
                    <div class="modal-header alert-header">
                        <div class="alert-title-wrap">
                            <div>
                                <h3 id="email-alert-title">Email Already In Use</h3>
                                <small>Account Registration Conflict</small>
                            </div>
                        </div>
                        <button type="button" class="modal-close-btn" @onclick="CloseEmailExistsModal" title="Close">✕</button>
                    </div>
                    <div class="modal-body alert-body">
                        <div class="alert-message-box">
                            <p class="alert-message-main">
                                The email address <strong>@conflictEmail</strong> has already been registered and used in the system.
                            </p>
                            <p class="alert-message-sub">
                                Please enter a different email address for this staff account.
                            </p>
                        </div>
                    </div>
                    <div class="modal-footer alert-footer" style="flex-shrink: 0; display: flex; align-items: center; justify-content: flex-end; padding: 12px 20px; border-top: 1px solid #e2e8f0; background: #f8fafc;">
                        <button type="button" class="btn-modal-submit alert-btn" style="display: inline-flex; align-items: center; justify-content: center; height: 38px; min-width: 110px; padding: 0 20px; border-radius: 8px; border: none; background: #ea580c; color: #ffffff; font-weight: 600; font-size: 0.85rem; cursor: pointer;" @onclick="CloseEmailExistsModal" id="btn-close-email-alert">
                            OK, Got it
                        </button>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="auth-alert error" role="alert"><AppIcon Name="warning" /><span>You do not have access to this page.</span></div>
        <button type="button" class="btn-back" @onclick='() => Navigation.NavigateTo("/admin/login")'>Go to portal sign in</button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? _toastMessage;
    private string? toastMessage
    {
        get => _toastMessage;
        set
        {
            _toastMessage = value;
            if (!string.IsNullOrEmpty(value))
            {
                TriggerToastTimer();
            }
            else
            {
                toastCts?.Cancel();
            }
        }
    }
    private CancellationTokenSource? toastCts;
    private string staffSearch = "";
    private string staffStatusFilter = "active";
    private int staffCurrentPage = 1;
    private int staffPageSize = 10;
    private PagedResult<AdminUserDto> pagedStaff = new();
    private System.Timers.Timer? searchDebounceTimer;
    private bool isLoadingStaff = false;
    private bool showCreateStaffModal = false;
    private bool isSubmitting = false;
    private string? createErrorMessage;
    private CreateStaffAccountRequest newStaffModel = new();
    private bool showEmailExistsModal = false;
    private string conflictEmail = "";
    private bool isCheckingEmail = false;
    private bool? isEmailAvailable;
    private bool nameHasError = false;
    private string? nameErrorMessage;
    private bool phoneHasError = false;
    private string? phoneErrorMessage;

    // Edit Staff Modal State (UC_34.2)
    private bool showEditStaffModal = false;
    private bool isSubmittingEdit = false;
    private Guid editingStaffId;
    private UpdateStaffAccountRequest editStaffModel = new();
    private string? editErrorMessage;
    private bool editNameHasError = false;
    private string? editNameErrorMessage;
    private bool editPhoneHasError = false;
    private string? editPhoneErrorMessage;
    private bool isCheckingEditEmail = false;
    private bool? isEditEmailAvailable;
    private string initialEmail = "";

    // Lock Staff Account State (UC_34.3)
    private bool isLockingStaff = false;
    private Guid? lockingStaffId;

    protected override async Task OnInitializedAsync() => await LoadStaffAsync();

    private void OpenCreateStaffModal()
    {
        newStaffModel = new();
        createErrorMessage = null;
        conflictEmail = "";
        showEmailExistsModal = false;
        isEmailAvailable = null;
        isCheckingEmail = false;
        nameHasError = false;
        nameErrorMessage = null;
        phoneHasError = false;
        phoneErrorMessage = null;
        showCreateStaffModal = true;
    }

    private void CloseCreateStaffModal()
    {
        if (isSubmitting) return;
        showCreateStaffModal = false;
        showEmailExistsModal = false;
        createErrorMessage = null;
        conflictEmail = "";
        isEmailAvailable = null;
        isCheckingEmail = false;
        nameHasError = false;
        nameErrorMessage = null;
        phoneHasError = false;
        phoneErrorMessage = null;
    }

    private void OnFullNameInput(ChangeEventArgs e)
    {
        newStaffModel.FullName = e.Value?.ToString() ?? "";
        ValidateFullName();
    }

    private void OnFullNameBlur()
    {
        ValidateFullName();
    }

    private bool ValidateFullName()
    {
        if (string.IsNullOrWhiteSpace(newStaffModel.FullName))
        {
            nameHasError = false;
            nameErrorMessage = null;
            return false;
        }

        var name = newStaffModel.FullName.Trim();
        if (name.Any(char.IsDigit))
        {
            nameHasError = true;
            nameErrorMessage = "Full name cannot contain numbers.";
            return false;
        }

        nameHasError = false;
        nameErrorMessage = null;
        return true;
    }

    private void OnPhoneNumberInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var digitsOnly = new string(raw.Where(char.IsDigit).ToArray());
        if (digitsOnly.Length > 10)
        {
            digitsOnly = digitsOnly.Substring(0, 10);
        }
        newStaffModel.PhoneNumber = digitsOnly;
        ValidatePhoneNumber();
    }

    private void OnPhoneNumberBlur()
    {
        ValidatePhoneNumber();
    }

    private bool ValidatePhoneNumber()
    {
        if (string.IsNullOrWhiteSpace(newStaffModel.PhoneNumber))
        {
            phoneHasError = false;
            phoneErrorMessage = null;
            return true;
        }

        var phone = newStaffModel.PhoneNumber.Trim();
        if (phone.Any(char.IsLetter))
        {
            phoneHasError = true;
            phoneErrorMessage = "Phone number cannot contain letters.";
            return false;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(phone, @"^0\d{9}$"))
        {
            phoneHasError = true;
            phoneErrorMessage = "Phone number must be a valid 10-digit number starting with 0 (e.g. 0901234567).";
            return false;
        }

        phoneHasError = false;
        phoneErrorMessage = null;
        return true;
    }


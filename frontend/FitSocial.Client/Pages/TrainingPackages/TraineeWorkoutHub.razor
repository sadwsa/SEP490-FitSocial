                    <button type="button" @onclick="SubmitProofAsync" disabled="@(isSubmittingProof || isUploadingProof)" class="px-4 py-2 bg-[#FF5500] text-white font-bold rounded-xl text-xs hover:bg-orange-600 transition cursor-pointer flex items-center gap-1.5 disabled:opacity-50">
                        @if (isSubmittingProof)

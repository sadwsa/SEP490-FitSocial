@page "/admin/appeals"
@layout AdminLayout
@attribute [Authorize(Roles = "ADMIN,STAFF")]
@implements IDisposable
@using FitSocial.Client.Models.Common
@using FitSocial.Client.Models.Reports
@using FitSocial.Client.Services.Reports
@inject IReportService ReportService
@inject NavigationManager Navigation

<PageTitle>Appeals - FitConnect Staff Console</PageTitle>

<AuthorizeView Roles="ADMIN,STAFF">
    <Authorized>
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="auth-alert @toastType" role="alert">
                <span class="flex-1">@toastMessage</span>
                <button type="button" @onclick="() => toastMessage = null" style="background:none;border:none;cursor:pointer;font-weight:700;opacity:.7;">✕</button>
            </div>
        }

        <h2 class="view-title">Appeals Management</h2>
        <p class="view-sub">Review user appeals — remove violations or unblock accounts</p>

        <!-- Filter Tabs -->
        <div class="cat-tabs mb-3">
            <button type="button" class="cat-tab @(appealStatusFilter == "PENDING" ? "active" : "")" @onclick='() => SetAppealFilterAsync("PENDING")'>
                Pending
            </button>
            <button type="button" class="cat-tab @(appealStatusFilter == "APPROVED" ? "active" : "")" @onclick='() => SetAppealFilterAsync("APPROVED")'>
                Approved
            </button>
            <button type="button" class="cat-tab @(appealStatusFilter == "REJECTED" ? "active" : "")" @onclick='() => SetAppealFilterAsync("REJECTED")'>
                Rejected
            </button>
            <button type="button" class="cat-tab @(appealStatusFilter == "ALL" ? "active" : "")" @onclick='() => SetAppealFilterAsync("ALL")'>
                All
            </button>
        </div>

        <!-- Toolbar -->
        <div class="toolbar wrap">
            <div class="search-wrap grow">
                <span class="search-icon"><AppIcon Name="search" /></span>
                <input value="@searchTerm"
                       @oninput="OnSearchInput"
                       @onkeydown="HandleSearchKeyDown"
                       class="toolbar-input"
                       placeholder="Search by user or reason..." />
            </div>
            <button type="button" class="row-btn" @onclick="LoadAppealsAsync" disabled="@isLoading">
                <span class="btn-ic"><AppIcon Name="refresh" /></span> Refresh
            </button>
        </div>

        <!-- Loading -->
        @if (isLoading)
        {
            <div style="padding:24px;text-align:center;color:#94a3b8;">
                <span>Loading appeals...</span>
            </div>
        }

        <!-- Table -->
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Report ID</th>
                        <th>Appellant</th>
                        <th>Report Reason</th>
                        <th>Appeal Content</th>
                        <th>Violations</th>
                        <th>Account Status</th>
                        <th>Appeal Status</th>
                        <th>Submitted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in pagedAppeals.Items)
                    {
                        <tr>
                            <td><code>#@ShortId(r.ReportId)</code></td>
                            <td>
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <img src="@GetAvatar(r.ReportedUserAvatarUrl, r.ReportedUserName, r.ReportedUserEmail)"
                                         alt="avatar" class="user-avatar-sm" />
                                    <div>
                                        <strong>@(r.ReportedUserName ?? "Unknown")</strong><br />
                                        <small class="muted">@(r.ReportedUserEmail ?? "")</small><br />
                                        <span class="role-badge @(r.ReportedUserRole?.ToLowerInvariant() ?? "trainee")">@(r.ReportedUserRole ?? "USER")</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="reason-cell" title="@r.Reason">@(Truncate(r.Reason, 50) ?? "—")</div>
                            </td>
                            <td>
                                <div class="reason-cell" title="@r.AppealContent">
                                    @if (!string.IsNullOrWhiteSpace(r.AppealContent))
                                    {
                                        @Truncate(r.AppealContent, 60)
                                    }
                                    else
                                    {
                                        <em class="muted">No content</em>
                                    }
                                </div>
                                @if (r.AppealedAt.HasValue)
                                {
                                    <small class="muted">@r.AppealedAt.Value.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                                }
                            </td>
                            <td>
                                <span class="violation-pill @(r.ReportedUserViolationCount >= 3 ? "high" : r.ReportedUserViolationCount > 0 ? "medium" : "low")">
                                    @r.ReportedUserViolationCount
                                </span>
                            </td>
                            <td>
                                @if (r.ReportedUserIsLocked == true)
                                {
                                    <span class="status-badge locked">Locked</span>
                                }
                                else
                                {
                                    <span class="status-badge active">Active</span>
                                }
                            </td>
                            <td>
                                @{
                                    var ap = r.AppealStatus?.ToUpperInvariant();
                                }
                                @if (ap == "PENDING")
                                {
                                    <span class="status-badge pending">Pending</span>
                                }
                                else if (ap == "APPROVED")
                                {
                                    <span class="status-badge active">Approved</span>
                                }
                                else if (ap == "REJECTED")
                                {
                                    <span class="status-badge locked">Rejected</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>
                                <small class="muted">@(r.CreatedAt?.ToLocalTime().ToString("MMM dd, yyyy") ?? "N/A")</small>
                            </td>
                            <td class="text-end whitespace-nowrap">
                                <button type="button" class="row-btn view" @onclick="() => OpenAppealModal(r)">
                                    <span class="btn-ic"><AppIcon Name="eye" /></span> Review
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!isLoading && !pagedAppeals.Items.Any())
                    {
                        <tr>
                            <td colspan="9" style="text-align:center;padding:40px;color:#94a3b8;">
                                <p style="font-weight:600;color:#374151;">No appeals found</p>
                                <p style="font-size:.75rem;margin-top:4px;">
                                    @(appealStatusFilter == "PENDING" ? "There are no pending appeals awaiting review." : "No appeals match the current filter.")
                                </p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="pagination-container">
            <div class="pagination-info">
                @if (pagedAppeals.TotalCount > 0)
                {
                    var start = (currentPage - 1) * pageSize + 1;
                    var end = Math.Min(currentPage * pageSize, pagedAppeals.TotalCount);
                    <span>Showing <strong>@start–@end</strong> of <strong>@pagedAppeals.TotalCount</strong> appeals</span>
                }
                else
                {
                    <span>0 appeals</span>
                }
            </div>
            @if (pagedAppeals.TotalPages > 1)
            {
                <div class="pagination-controls">
                    <button type="button" class="page-btn" disabled="@(!pagedAppeals.HasPreviousPage)" @onclick="() => GoToPageAsync(currentPage - 1)">‹ Prev</button>
                    @foreach (var p in GetVisiblePageNumbers())
                    {
                        if (p == -1) { <span class="page-dots">…</span> }
                        else { var pn = p; <button type="button" class="page-btn @(pn == currentPage ? "active" : "")" @onclick="() => GoToPageAsync(pn)">@pn</button> }
                    }
                    <button type="button" class="page-btn" disabled="@(!pagedAppeals.HasNextPage)" @onclick="() => GoToPageAsync(currentPage + 1)">Next ›</button>
                </div>
            }
            <div class="page-size-selector">
                <span>Per page:</span>
                <select value="@pageSize" @onchange="OnPageSizeChangedAsync" class="page-size-select">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>

        <!-- ======= REVIEW MODAL ======= -->
        @if (showReviewModal && selectedAppeal != null)
        {
            <div class="modal-overlay" @onclick="CloseReviewModal">
                <div class="modal-card" style="max-width:660px;" @onclick:stopPropagation="true">

                    <div class="modal-header">
                        <div>
                            <h3>Review Appeal</h3>
                            <small>Report: #@ShortId(selectedAppeal.ReportId)</small>
                        </div>
                        <button type="button" class="modal-close-btn" @onclick="CloseReviewModal" disabled="@isProcessing">✕</button>
                    </div>

                    <div class="modal-body">

                        <!-- Appellant -->
                        <div class="info-card">
                            <div class="info-card-title"><AppIcon Name="person" /><span>Appellant (User Being Appealed)</span></div>
                            <div style="display:flex;align-items:center;gap:12px;">
                                <img src="@GetAvatar(selectedAppeal.ReportedUserAvatarUrl, selectedAppeal.ReportedUserName, selectedAppeal.ReportedUserEmail)"
                                     alt="avatar" class="user-avatar-md" />
                                <div>
                                    <div style="font-weight:700;color:#1e293b;">@(selectedAppeal.ReportedUserName ?? "Unknown")</div>
                                    <div style="font-size:.72rem;color:#64748b;">@(selectedAppeal.ReportedUserEmail ?? "No email")</div>
                                    <div style="display:flex;gap:6px;margin-top:4px;flex-wrap:wrap;">
                                        <span class="role-badge @(selectedAppeal.ReportedUserRole?.ToLowerInvariant() ?? "trainee")">@(selectedAppeal.ReportedUserRole ?? "USER")</span>
                                        <span class="violation-pill @(selectedAppeal.ReportedUserViolationCount >= 3 ? "high" : selectedAppeal.ReportedUserViolationCount > 0 ? "medium" : "low")">
                                            @selectedAppeal.ReportedUserViolationCount violation(s)
                                        </span>
                                        @if (selectedAppeal.ReportedUserIsLocked == true)
                                        {
                                            <span class="status-badge locked">Account Locked</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Original Report -->
                        <div class="info-card">
                            <div class="info-card-title"><AppIcon Name="flag" /><span>Original Report</span></div>
                            <div style="font-size:.78rem;display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                                <div>
                                    <span style="color:#64748b;display:block;margin-bottom:2px;">Status:</span>
                                    <span class="status-badge @(string.Equals(selectedAppeal.Status,"RESOLVED",StringComparison.OrdinalIgnoreCase)?"active":"locked")">
                                        @(selectedAppeal.Status ?? "Unknown")
                                    </span>
                                </div>
                                <div>
                                    <span style="color:#64748b;display:block;margin-bottom:2px;">Submitted:</span>
                                    <strong>@(selectedAppeal.CreatedAt?.ToLocalTime().ToString("f") ?? "N/A")</strong>
                                </div>
                                <div style="grid-column:span 2;">
                                    <span style="color:#64748b;display:block;margin-bottom:2px;">Report Reason:</span>
                                    <div style="background:#fff;border:1px solid #e2e8f0;border-radius:6px;padding:8px 12px;font-weight:600;color:#1e293b;">
                                        @(selectedAppeal.Reason ?? "No reason provided")
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Appeal Content -->
                        <div class="info-card" style="background:#f0f9ff;border-color:#bae6fd;">
                            <div class="info-card-title" style="color:#0369a1;">
                                <AppIcon Name="doc" /><span>Appeal Statement</span>
                                @if (selectedAppeal.AppealedAt.HasValue)
                                {
                                    <small style="margin-left:auto;color:#94a3b8;font-size:.68rem;">
                                        @selectedAppeal.AppealedAt.Value.ToLocalTime().ToString("f")
                                    </small>
                                }
                            </div>
                            <div style="background:#fff;border:1px solid #bae6fd;border-radius:8px;padding:10px 14px;font-size:.82rem;color:#1e3a5f;line-height:1.6;white-space:pre-wrap;word-break:break-word;">
                                @(string.IsNullOrWhiteSpace(selectedAppeal.AppealContent) ? "No appeal content provided." : selectedAppeal.AppealContent)
                            </div>
                        </div>

                        <!-- Already reviewed -->
                        @if (!string.Equals(selectedAppeal.AppealStatus, "PENDING", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="info-card" style="background:#f0fdf4;border-color:#bbf7d0;">
                                <div class="info-card-title" style="color:#15803d;"><AppIcon Name="info" /><span>Appeal Already Reviewed</span></div>
                                <div style="font-size:.78rem;color:#374151;">
                                    <div>Decision:
                                        @if (string.Equals(selectedAppeal.AppealStatus, "APPROVED", StringComparison.OrdinalIgnoreCase))
                                        { <span class="status-badge active">Approved</span> }
                                        else
                                        { <span class="status-badge locked">Rejected</span> }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(selectedAppeal.AppealReviewNote))
                                    {
                                        <div style="margin-top:4px;">Note: @selectedAppeal.AppealReviewNote</div>
                                    }
                                    @if (selectedAppeal.AppealReviewedAt.HasValue)
                                    {
                                        <div style="margin-top:4px;color:#64748b;">Reviewed: @selectedAppeal.AppealReviewedAt.Value.ToLocalTime().ToString("f")</div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Staff Action Area -->
                            <div class="modal-actions-box">
                                <div style="display:flex;align-items:center;gap:6px;margin-bottom:10px;">
                                    <AppIcon Name="shield" />
                                    <strong style="font-size:.85rem;color:#1e293b;">Staff Actions</strong>
                                </div>

                                <!-- Review Note -->
                                <div style="margin-bottom:12px;">
                                    <label style="font-size:.75rem;font-weight:600;color:#374151;display:block;margin-bottom:4px;">Review Note (optional):</label>
                                    <textarea @bind="reviewNote"
                                              style="width:100%;font-size:.78rem;padding:8px;border:1px solid #d1d5db;border-radius:8px;resize:vertical;"
                                              rows="2"
                                              placeholder="Explain your decision..."></textarea>
                                </div>

                                <!-- Approve buttons -->
                                <p style="font-size:.75rem;font-weight:700;color:#15803d;margin-bottom:8px;">Approve Appeal — choose action:</p>
                                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:12px;">
                                    <button type="button" class="btn-appeal-approve"
                                            @onclick='() => SubmitReviewAsync("APPROVED", true, false)'
                                            disabled="@isProcessing">
                                        <span>Approve &amp; Remove Violation</span>
                                        <small>Reduces violation count by 1</small>
                                    </button>
                                    <button type="button" class="btn-appeal-unblock"
                                            @onclick='() => SubmitReviewAsync("APPROVED", false, true)'
                                            disabled="@isProcessing">
                                        <span>Approve &amp; Unblock Account</span>
                                        <small>Restores account access</small>
                                    </button>
                                    <button type="button" class="btn-appeal-both"
                                            @onclick='() => SubmitReviewAsync("APPROVED", true, true)'
                                            disabled="@isProcessing">
                                        <span>Approve &amp; Do Both</span>
                                        <small>Remove violation + unblock</small>
                                    </button>
                                </div>

                                <div style="border-top:1px solid #e2e8f0;padding-top:10px;">
                                    <button type="button" class="btn-appeal-reject"
                                            style="width:100%;"
                                            @onclick='() => SubmitReviewAsync("REJECTED", false, false)'
                                            disabled="@isProcessing">
                                        @(isProcessing ? "Processing..." : "Reject Appeal")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn-modal-cancel" @onclick="CloseReviewModal" disabled="@isProcessing">Close</button>
                    </div>
                </div>
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="auth-alert error" role="alert">
            <AppIcon Name="warning" />
            <span>You do not have permission to access the Appeals console.</span>
        </div>
        <button type="button" class="btn-back" @onclick='() => Navigation.NavigateTo("/admin/login")'>
            Go to portal sign in
        </button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? toastMessage;
    private string toastType = "info";
    private string searchTerm = "";
    private string appealStatusFilter = "PENDING";
    private int currentPage = 1;
    private int pageSize = 10;
    private PagedResult<ReportListItemDto> pagedAppeals = new();
    private System.Timers.Timer? searchDebounceTimer;
    private bool isLoading = false;

    private bool showReviewModal = false;
    private ReportListItemDto? selectedAppeal;
    private string reviewNote = "";
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppealsAsync();
    }

    private async Task LoadAppealsAsync()
    {
        isLoading = true;
        try
        {
            var res = await ReportService.GetAppealsAsync(
                appealStatus: appealStatusFilter,
                searchTerm: searchTerm,
                pageNumber: currentPage,
                pageSize: pageSize);

            if (res.Success && res.Data != null)
            {
                pagedAppeals = res.Data;
                if (pagedAppeals.TotalPages > 0 && currentPage > pagedAppeals.TotalPages)
                {
                    currentPage = pagedAppeals.TotalPages;
                    await LoadAppealsAsync();
                    return;
                }
            }
            else if (!string.IsNullOrEmpty(res.Message))
            {
                toastMessage = res.Message;
                toastType = "error";
            }
        }
        catch (Exception ex)
        {
            toastMessage = $"Unable to load appeals: {ex.Message}";
            toastType = "error";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetAppealFilterAsync(string filter)
    {
        if (appealStatusFilter == filter) return;
        appealStatusFilter = filter;
        currentPage = 1;
        await LoadAppealsAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        searchDebounceTimer?.Stop();
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Timers.Timer(400) { AutoReset = false };
        searchDebounceTimer.Elapsed += async (_, _) =>
        {
            currentPage = 1;
            await InvokeAsync(LoadAppealsAsync);
            await InvokeAsync(StateHasChanged);
        };
        searchDebounceTimer.Start();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            searchDebounceTimer?.Stop();
            currentPage = 1;
            await LoadAppealsAsync();
        }
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || (pagedAppeals.TotalPages > 0 && page > pagedAppeals.TotalPages) || page == currentPage) return;
        currentPage = page;
        await LoadAppealsAsync();
    }

    private async Task OnPageSizeChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var s) && s > 0)
        {
            pageSize = s;
            currentPage = 1;
            await LoadAppealsAsync();
        }
    }

    private IEnumerable<int> GetVisiblePageNumbers()
    {
        var total = pagedAppeals.TotalPages;
        if (total <= 1) yield break;
        var d = 2;
        var l = Math.Max(1, currentPage - d);
        var r = Math.Min(total, currentPage + d);
        if (l > 1) { yield return 1; if (l > 2) yield return -1; }
        for (var i = l; i <= r; i++) yield return i;
        if (r < total) { if (r < total - 1) yield return -1; yield return total; }
    }

    private async Task OpenAppealModal(ReportListItemDto appeal)
    {
        selectedAppeal = appeal;
        reviewNote = "";
        showReviewModal = true;
        try
        {
            var res = await ReportService.GetReportByIdAsync(appeal.ReportId);
            if (res.Success && res.Data != null) selectedAppeal = res.Data;
        }
        catch { }
    }

    private void CloseReviewModal()
    {
        if (isProcessing) return;
        showReviewModal = false;
        selectedAppeal = null;
        reviewNote = "";
    }

    private async Task SubmitReviewAsync(string decision, bool removeViolation, bool unblockAccount)
    {
        if (selectedAppeal == null || isProcessing) return;
        isProcessing = true;
        try
        {
            var request = new ReviewAppealRequest
            {
                AppealStatus = decision,
                AppealReviewNote = string.IsNullOrWhiteSpace(reviewNote) ? null : reviewNote.Trim(),
                RemoveViolation = removeViolation,
                UnblockAccount = unblockAccount
            };

            var res = await ReportService.ReviewAppealAsync(selectedAppeal.ReportId, request);
            if (res.Success && res.Data != null)
            {
                selectedAppeal = res.Data;
                var desc = decision == "APPROVED"
                    ? removeViolation && unblockAccount ? "approved (violation removed + unblocked)"
                    : removeViolation ? "approved (violation removed)"
                    : "approved (account unblocked)"
                    : "rejected";
                toastMessage = $"Appeal #{ShortId(selectedAppeal.ReportId)} has been {desc}.";
                toastType = "info";
                showReviewModal = false;
                await LoadAppealsAsync();
            }
            else
            {
                toastMessage = res.Message ?? "Failed to review appeal.";
                toastType = "error";
            }
        }
        catch (Exception ex)
        {
            toastMessage = $"Error: {ex.Message}";
            toastType = "error";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private static string ShortId(Guid? id)
    {
        if (!id.HasValue || id == Guid.Empty) return "N/A";
        var s = id.Value.ToString();
        return s.Length > 8 ? s[..8] : s;
    }

    private static string? Truncate(string? v, int max)
    {
        if (string.IsNullOrEmpty(v)) return v;
        return v.Length <= max ? v : v[..max] + "…";
    }

    private static string GetAvatar(string? url, string? name, string? email)
    {
        if (!string.IsNullOrWhiteSpace(url) && (url.StartsWith("http://") || url.StartsWith("https://"))) return url;
        var label = !string.IsNullOrWhiteSpace(name) ? name : (!string.IsNullOrWhiteSpace(email) ? email : "User");
        return $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(label)}&background=FF8C00&color=fff";
    }

    public void Dispose()
    {
        searchDebounceTimer?.Stop();
        searchDebounceTimer?.Dispose();
    }
}

                                                            </label>
                                                            <select @bind="selectedSportId"
                                                                    class="w-full text-sm bg-gray-50 border @(hasAttemptedSubmit && selectedSportId == Guid.Empty ? "border-red-500 ring-2 ring-red-200 bg-red-50/20 text-red-900" : "border-gray-200 text-gray-800") rounded-xl p-2.5 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] transition">
                                                                <option value="@Guid.Empty">-- Select Sport --</option>
                                                                @foreach (var s in availableSports)
                                                                {
                                                                    <option value="@s.SportId">@s.SportName</option>
                                                                }
                                                            </select>
                                                            @if (hasAttemptedSubmit && selectedSportId == Guid.Empty)
                                                            {
                                                                <p
                                                                    class="text-[11px] text-red-600 font-semibold mt-1 flex items-center gap-1 animate-in fade-in">
                                                                    <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                        <path fill-rule="evenodd"
                                                                              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                                                              clip-rule="evenodd"></path>
                                                                    </svg>
                                                                    Sport is required. Please select one.
                                                                </p>
                                                            }
                                                        </div>

                                                        <div>
                                                            <label
                                                                class="block text-xs font-bold uppercase tracking-wider @(hasAttemptedSubmit && selectedLocationId == Guid.Empty ? "text-red-700" : "text-gray-600") mb-1.5 flex items-center gap-1.5">
                                                                <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                                                    </path>
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                                </svg>
                                                                Gym / Location <span class="text-red-500">*</span>
                                                            </label>
                                                            <select @bind="selectedLocationId"
                                                                    class="w-full text-sm bg-gray-50 border @(hasAttemptedSubmit && selectedLocationId == Guid.Empty ? "border-red-500 ring-2 ring-red-200 bg-red-50/20 text-red-900" : "border-gray-200 text-gray-800") rounded-xl p-2.5 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] transition">
                                                                <option value="@Guid.Empty">-- Select Location --</option>
                                                                @foreach (var l in availableLocations)
                                                                {
                                                                    <option value="@l.LocationId">@l.LocationName</option>
                                                                }
                                                            </select>
                                                            @if (hasAttemptedSubmit && selectedLocationId == Guid.Empty)
                                                            {
                                                                <p
                                                                    class="text-[11px] text-red-600 font-semibold mt-1 flex items-center gap-1 animate-in fade-in">
                                                                    <svg class="w-3.5 h-3.5 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                        <path fill-rule="evenodd"
                                                                              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                                                              clip-rule="evenodd"></path>
                                                                    </svg>
                                                                    Location is required. Please select one.
                                                                </p>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- Media Upload Section -->
                                                    <div
                                                        class="border border-dashed border-gray-300 hover:border-orange-300 rounded-2xl p-4 bg-gray-50/50 transition">
                                                        <div class="flex items-center justify-between mb-2">
                                                            <span
                                                                class="text-xs font-bold uppercase tracking-wider text-gray-700 flex items-center gap-1.5">
                                                                <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                                                    </path>
                                                                </svg>
                                                                Attach Media (Photos / Videos, max 10)
                                                            </span>
                                                            <label for="createPostFileInput"
                                                                   class="text-xs text-[#FF5500] font-bold hover:underline cursor-pointer flex items-center gap-1">
                                                                <span>+ Choose Files</span>
                                                            </label>
                                                        </div>

                                                        <InputFile id="createPostFileInput" OnChange="HandleFileSelected" multiple accept="image/*,video/*"
                                                                   class="hidden" />

                                                        @if (selectedFiles.Any())
                                                        {
                                                            <div class="grid grid-cols-3 sm:grid-cols-4 gap-2.5 mt-2">
                                                                @for (int i = 0; i < selectedFiles.Count; i++)
                                                                {
                                                                    var index = i;
                                                                    var file = selectedFiles[index];
                                                                    var preview = index < previewUrls.Count ? previewUrls[index] : string.Empty;
                                                                    <div
                                                                        class="relative group rounded-xl overflow-hidden border border-gray-200 bg-gray-100 aspect-square flex items-center justify-center shadow-xs">
                                                                        @if (!string.IsNullOrWhiteSpace(preview))
                                                                        {
                                                                            <img src="@preview" alt="Preview" class="w-full h-full object-cover" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="p-2 text-center text-xs text-gray-600 truncate">
                                                                                <span class="text-2xl">🎬</span>
                                                                                <p class="truncate text-[10px] mt-1 font-medium">@file.Name</p>
                                                                            </div>
                                                                        }
                                                                        <button type="button" @onclick="() => RemoveSelectedFile(index)"
                                                                                class="absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-black/75 hover:bg-red-600 text-white flex items-center justify-center text-xs font-bold transition shadow-sm">
                                                                            &times;
                                                                        </button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <label for="createPostFileInput"
                                                                   class="cursor-pointer py-5 flex flex-col items-center justify-center text-gray-400 hover:text-gray-600 transition rounded-xl hover:bg-orange-50/30">
                                                                <div
                                                                    class="w-10 h-10 rounded-full bg-orange-50 text-[#FF5500] flex items-center justify-center mb-1.5">
                                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                                                        </path>
                                                                    </svg>
                                                                </div>
                                                                <span class="text-xs font-semibold text-gray-700">Click to upload photos or videos</span>
                                                                <span class="text-[11px] text-gray-400 mt-0.5">PNG, JPG, MP4 up to 10MB each</span>
                                                            </label>
                                                        }
                                                    </div>

                                                    <!-- Backend API Error Message (if API returns error) -->
                                                    @if (!string.IsNullOrWhiteSpace(createPostErrorMessage))
                                                    {
                                                        <div class="p-3.5 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700 flex items-center gap-2.5 animate-in fade-in shadow-xs"
                                                             role="alert">
                                                            <svg class="w-4 h-4 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                                                <path fill-rule="evenodd"
                                                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                                                      clip-rule="evenodd"></path>
                                                            </svg>
                                                            <span>@createPostErrorMessage</span>
                                                        </div>
                                                    }

                                                </div>

                                                <!-- Modal Footer -->
                                                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-100 bg-gray-50/80">
                                                    <button type="button" @onclick="CloseCreatePostModal"
                                                            class="px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-gray-600 hover:bg-gray-200/60 rounded-xl transition">
                                                        Cancel
                                                    </button>
                                                    <button type="button" @onclick="HandleSubmitCreatePost"
                                                            disabled="@(isSubmittingPost || isUploadingMedia)"
                                                            class="px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#FF8C00] via-[#FF5500] to-[#FF3B00] rounded-xl shadow-md hover:shadow-lg hover:opacity-95 disabled:opacity-50 transition flex items-center gap-2 cursor-pointer">
                                                        @if (isUploadingMedia)
                                                        {
                                                            <span
                                                            class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                                            <span>Uploading media...</span>
                                                        }
                                                        else if (isSubmittingPost)
                                                        {
                                                            <span
                                                            class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                                            <span>Publishing...</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Post</span>
                                                        }
                                                    </button>
                                                </div>

                                            </div>
                                        </div>
                                    }
                                </div>

@code {
    private List<PostDto>? posts;
    private bool isLoading = true;
    private bool isSubmittingPost = false;
    private bool isUploadingMedia = false;
    private bool showProfileMenu = false;
    private bool showFilterDropdown = false;
    private bool showCreatePostModal = false;

    // Create post form state
    private string createPostContent = string.Empty;
    private string createPostType = string.Empty;
    private Guid selectedSportId = Guid.Empty;
    private Guid selectedLocationId = Guid.Empty;
    private bool hasAttemptedSubmit = false;
    private List<IBrowserFile> selectedFiles = new();
    private List<string> previewUrls = new();
    private string? createPostErrorMessage;
    private string? toastSuccessMessage;
    private CancellationTokenSource? toastCts;

    // Dropdowns data
    private List<SportDto> availableSports = new();
    private List<LocationDto> availableLocations = new();

    // Query & User State
    private string searchTerm = string.Empty;
    private string? selectedPostType;

    private bool isCoach = false;
    private string userName = "Me";
    private string userInitials = "Me";
    private string userRole = "Athlete";

    private GetPostsQuery currentQuery = new()
    {
        PageNumber = 1,
        PageSize = 15
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfoAsync();
        await Task.WhenAll(LoadPostsAsync(), LoadSportsAndLocationsAsync());
    }

    private async Task LoadUserInfoAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                userName = user.Identity.Name ?? "Athlete";
                isCoach = user.IsInRole(AppRoles.Coach) ||
                          user.IsInRole("COACH") ||
                          string.Equals(user.FindFirst(ClaimTypes.Role)?.Value, AppRoles.Coach, StringComparison.OrdinalIgnoreCase);
                userRole = isCoach ? "Coach" : "Trainee";

                var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 0)
                {
                    userInitials = parts.Length > 1
                        ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
                        : parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
                }
            }
        }
        catch
        {
            userInitials = "Me";
        }
    }

    private async Task LoadSportsAndLocationsAsync()
    {
        try
        {
            var sportsTask = SportService.GetSportsAsync();
            var locationsTask = LocationService.GetLocationsAsync();
            await Task.WhenAll(sportsTask, locationsTask);

            var sportsResponse = await sportsTask;
            var locationsResponse = await locationsTask;

            if (sportsResponse.Success && sportsResponse.Data != null)
            {
                availableSports = sportsResponse.Data;
            }

            if (locationsResponse.Success && locationsResponse.Data != null)
            {
                availableLocations = locationsResponse.Data;
            }
        }
        catch
        {
            // Graceful fallback
        }
    }

    private async Task LoadPostsAsync()
    {
        isLoading = true;
        currentQuery.SearchTerm = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm.Trim();
        currentQuery.PostType = string.IsNullOrWhiteSpace(selectedPostType) ? null : selectedPostType;

        var response = await PostService.GetPostsAsync(currentQuery);
        if (response.Success && response.Data != null)
        {
            posts = response.Data.Items ?? new List<PostDto>();
        }
        else
        {
            posts = new List<PostDto>();
        }
        isLoading = false;
    }

    private void OpenCreatePostModal(string? trigger = null, string? postType = null)
    {
        hasAttemptedSubmit = false;
        createPostErrorMessage = null;

        if (!string.IsNullOrWhiteSpace(postType))
        {
            if (postType == "Find Trainee" && !isCoach)
            {
                createPostType = "Normal";
            }
            else
            {
                createPostType = postType;
            }
        }
        else
        {
            createPostType = string.Empty;
        }

        selectedSportId = Guid.Empty;
        selectedLocationId = Guid.Empty;
        showCreatePostModal = true;
    }

    private void SelectPostType(string type)
    {
        if (type == "Find Trainee" && !isCoach) return;
        createPostType = type;
    }

    private string GetPostPlaceholder() => createPostType switch
    {
        "Find Coach" => "Describe your fitness goals, preferred sport/routine, budget, or schedule to find the ideal coach...",
        "Find Trainee" => "Describe your coaching programs, specialties, open slots, or fitness plans for prospective students...",
        _ => "What's on your mind about today's workout? Share your achievements, tips, or routine..."
    };

    private void CloseCreatePostModal()
    {
        showCreatePostModal = false;
        createPostContent = string.Empty;
        createPostType = string.Empty;
        selectedSportId = Guid.Empty;
        selectedLocationId = Guid.Empty;
        selectedFiles.Clear();
        previewUrls.Clear();
        createPostErrorMessage = null;
        hasAttemptedSubmit = false;
        isSubmittingPost = false;
        isUploadingMedia = false;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(10);
        foreach (var file in files)
        {
            if (selectedFiles.Count >= 10) break;
            selectedFiles.Add(file);

            if (file.ContentType.StartsWith("image/"))
            {
                try
                {
                    var resized = await file.RequestImageFileAsync(file.ContentType, 600, 600);
                    using var stream = resized.OpenReadStream(10 * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    previewUrls.Add($"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}");
                }
                catch
                {
                    previewUrls.Add(string.Empty);
                }
            }
            else
            {
                previewUrls.Add(string.Empty);
            }
        }
    }

    private void RemoveSelectedFile(int index)
    {
        if (index >= 0 && index < selectedFiles.Count)
        {
            selectedFiles.RemoveAt(index);
            if (index < previewUrls.Count)
            {
                previewUrls.RemoveAt(index);
            }
        }
    }

    private async Task HandleSubmitCreatePost()
    {
        hasAttemptedSubmit = true;
        createPostErrorMessage = null;

        var contentTrimmed = createPostContent?.Trim() ?? string.Empty;
        bool isContentMissing = string.IsNullOrWhiteSpace(contentTrimmed) && !selectedFiles.Any();
        bool isPostTypeMissing = string.IsNullOrWhiteSpace(createPostType);
        bool isSportMissing = selectedSportId == Guid.Empty;
        bool isLocationMissing = selectedLocationId == Guid.Empty;

        // Chỉ hiển thị cảnh báo lỗi trực tiếp ngay tại các trường bị thiếu, không dùng alert trên cùng
        if (isContentMissing || isPostTypeMissing || isSportMissing || isLocationMissing)
        {
            return;
        }

        isSubmittingPost = true;
        try
        {
            var uploadedMedia = new List<CreatePostMediaItemDto>();

            // 1. Upload files if attached
            if (selectedFiles.Any())
            {
                isUploadingMedia = true;
                StateHasChanged();

                var uploadRes = await FileUploadService.UploadPostMediaAsync(selectedFiles);
                isUploadingMedia = false;

                if (!uploadRes.Success || uploadRes.Data == null)
                {
                    createPostErrorMessage = uploadRes.Message ?? "Failed to upload attachments.";
                    isSubmittingPost = false;
                    return;
                }

                uploadedMedia = uploadRes.Data;
            }

            // 2. Submit create post to backend
            var request = new CreatePostRequest
            {
                Content = contentTrimmed,
                PostType = createPostType,
                SportId = selectedSportId,
                LocationId = selectedLocationId,
                Media = uploadedMedia
            };

            var postRes = await PostService.CreatePostAsync(request);
            if (postRes.Success && postRes.Data != null)
            {
                posts?.Insert(0, postRes.Data);
                CloseCreatePostModal();
                ShowSuccessToast("Post published successfully!");
            }
            else
            {
                createPostErrorMessage = postRes.Message ?? "Failed to create post. Please try again.";
            }
        }
        catch (Exception ex)
        {
            createPostErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmittingPost = false;
            isUploadingMedia = false;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteSearch();
        }
    }

    private async Task ExecuteSearch()
    {
        currentQuery.PageNumber = 1;
        await LoadPostsAsync();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        currentQuery.PageNumber = 1;
        await LoadPostsAsync();
    }

    private async Task FilterByPostType(string? postType)
    {
        selectedPostType = postType;
        showFilterDropdown = false;
        currentQuery.PageNumber = 1;
        await LoadPostsAsync();
    }

    private async Task ResetFilters()
    {
        searchTerm = string.Empty;
        selectedPostType = null;
        showFilterDropdown = false;
        currentQuery.PageNumber = 1;
        await LoadPostsAsync();
    }

    private void ToggleLike(PostDto post)
    {
        post.IsLikedByCurrentUser = !post.IsLikedByCurrentUser;
        post.LikeCount += post.IsLikedByCurrentUser ? 1 : -1;
        if (post.LikeCount < 0) post.LikeCount = 0;

        _ = PostService.ToggleLikeAsync(post.Id);
    }

    private void ToggleProfileMenu()
    {
        showProfileMenu = !showProfileMenu;
    }

    private void ToggleFilterDropdown()
    {
        showFilterDropdown = !showFilterDropdown;
    }

    private async Task HandleLogout()
    {
        showProfileMenu = false;
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }

    private static string GetTimeAgo(DateTime? date)
    {
        if (!date.HasValue) return "Just now";

        var timeSpan = DateTime.UtcNow - date.Value;
        if (timeSpan.TotalMinutes < 1) return "Just now";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays}d ago";

        return date.Value.ToLocalTime().ToString("MMM dd, yyyy");
    }

    private void ShowSuccessToast(string message)
    {
        toastCts?.Cancel();
        toastCts?.Dispose();
        toastCts = new CancellationTokenSource();
        toastSuccessMessage = message;
        StateHasChanged();

        var token = toastCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(3500, token);
                if (!token.IsCancellationRequested)
                {
                    toastSuccessMessage = null;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (TaskCanceledException)
            {
                // Ignored
            }
        });
    }

    private void DismissToast()
    {
        toastCts?.Cancel();
        toastSuccessMessage = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        toastCts?.Cancel();
        toastCts?.Dispose();
    }
}

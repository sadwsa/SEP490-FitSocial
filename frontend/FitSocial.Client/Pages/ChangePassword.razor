@page "/change-password"
@attribute [Authorize]
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Change Password - FitSocial</PageTitle>

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="fit-card p-4">
            <div class="text-center mb-4">
                <span class="fs-1">🔑</span>
                <h4 class="fw-bold mt-2">Change Password</h4>
                <p class="text-muted small">All other sessions will be signed out for your security</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 small" role="alert">
                    @errorMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success py-2 small" role="alert">
                    @successMessage
                </div>
            }

            <EditForm Model="@changeModel" OnValidSubmit="HandleChange">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Current password</label>
                    <InputText type="@(showCurrent ? "text" : "password")" @bind-Value="changeModel.CurrentPassword" class="form-control" placeholder="Enter your current password" />
                    <ValidationMessage For="@(() => changeModel.CurrentPassword)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">New password</label>
                    <InputText type="@(showNew ? "text" : "password")" @bind-Value="changeModel.NewPassword" class="form-control" placeholder="Minimum 6 characters, different from current" />
                    <ValidationMessage For="@(() => changeModel.NewPassword)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Confirm new password</label>
                    <InputText type="@(showConfirm ? "text" : "password")" @bind-Value="changeModel.ConfirmPassword" class="form-control" placeholder="Re-enter the new password" />
                    <ValidationMessage For="@(() => changeModel.ConfirmPassword)" class="text-danger small" />
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="showPw" @bind="showPasswords" />
                    <label class="form-check-label small" for="showPw">Show passwords</label>
                </div>

                <button type="submit" class="btn-fit-primary w-100 justify-content-center py-2 mt-2" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Updating...</span>
                    }
                    else
                    {
                        <span>Update Password</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ChangePasswordRequest changeModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = false;
    private bool showPasswords = false;

    private bool showCurrent => showPasswords;
    private bool showNew => showPasswords;
    private bool showConfirm => showPasswords;

    private async Task HandleChange()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        var result = await AuthService.ChangePasswordAsync(changeModel);
        if (result.Success)
        {
            successMessage = (result.Message ?? "Password changed successfully.") + " Signing you out...";
            StateHasChanged();
            await Task.Delay(1500);
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login");
        }
        else
        {
            errorMessage = result.Message ?? "Could not change the password. Please try again.";
        }

        isLoading = false;
    }
}

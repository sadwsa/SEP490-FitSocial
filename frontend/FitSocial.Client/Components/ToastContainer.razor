@using FitSocial.Client.Models.Toast
@using FitSocial.Client.Services.Toast
@implements IDisposable
@inject IToastService ToastService

@if (ToastService.Toasts.Any())
{
    <div class="toast-portal-container" aria-live="polite" aria-label="Notifications">
        @foreach (var toast in ToastService.Toasts)
        {
            <div @key="toast.Id"
                 class="toast-card toast-@toast.Type.ToString().ToLowerInvariant() @(toast.IsClosing ? "toast-closing" : "")"
                 role="alert">
                <div class="toast-accent-line"></div>
                
                <div class="toast-content-wrapper">
                    <!-- Icon badge theo loại thông báo -->
                    <div class="toast-icon-badge">
                        @switch (toast.Type)
                        {
                            case ToastType.Success:
                                <!-- Success: Dấu tích tròn ✓ -->
                                <svg class="toast-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                </svg>
                                break;

                            case ToastType.Error:
                                <!-- Error: Dấu X tròn ✕ -->
                                <svg class="toast-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                                </svg>
                                break;

                            case ToastType.Warning:
                                <!-- Warning: Tam giác cảnh báo ⚠ -->
                                <svg class="toast-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                                </svg>
                                break;

                            case ToastType.Info:
                            default:
                                <!-- Info: Chữ i thông tin ℹ -->
                                <svg class="toast-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
                                </svg>
                                break;
                        }
                    </div>

                    <!-- Tiêu đề và nội dung -->
                    <div class="toast-text-block">
                        <div class="toast-title">@toast.Title</div>
                        <div class="toast-message">@toast.Message</div>
                    </div>

                    <!-- Nút đóng -->
                    <button type="button"
                            class="toast-close-btn"
                            @onclick="() => DismissToast(toast.Id)"
                            aria-label="Close notification"
                            title="Close">
                        <svg class="close-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                        </svg>
                    </button>
                </div>

                <!-- Thanh đếm thời gian (Progress Countdown) -->
                @if (toast.DurationMs > 0)
                {
                    <div class="toast-progress-track">
                        <div class="toast-progress-bar"
                             style="animation-duration: @(toast.DurationMs)ms;"></div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += HandleToastChanged;
    }

    private void HandleToastChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void DismissToast(Guid id)
    {
        ToastService.Dismiss(id);
    }

    public void Dispose()
    {
        ToastService.OnChange -= HandleToastChanged;
    }
}

@namespace FitSocial.Client.Components.Posts
@inject IPostService PostService

@if (IsVisible && Post != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs transition-all animate-in fade-in"
         @onclick="CloseModal">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 border border-gray-100 animate-in zoom-in-95 duration-150"
             @onclick:stopPropagation="true">
            <div class="flex items-center gap-3.5 mb-4">
                <div class="w-11 h-11 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="font-bold text-gray-900 text-base">Delete Post?</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Are you sure you want to delete this post? This action cannot be undone.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(deleteErrorMessage))
            {
                <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700 flex items-center gap-2">
                    <svg class="w-4 h-4 flex-shrink-0 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                    </svg>
                    <span>@deleteErrorMessage</span>
                </div>
            }

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" @onclick="CloseModal" disabled="@isDeletingPost"
                        class="px-4 py-2 text-xs font-bold uppercase tracking-wider text-gray-600 hover:bg-gray-100 rounded-xl transition disabled:opacity-50 cursor-pointer">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmDeletePostAsync" disabled="@isDeletingPost"
                        class="px-5 py-2 text-xs font-bold uppercase tracking-wider text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-xs hover:shadow transition disabled:opacity-50 flex items-center gap-2 cursor-pointer">
                    @if (isDeletingPost)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span>Delete</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public PostDto? Post { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<Guid> OnPostDeleted { get; set; }

    private bool isDeletingPost = false;
    private string? deleteErrorMessage;

    protected override void OnParametersSet()
    {
        if (!IsVisible)
        {
            deleteErrorMessage = null;
            isDeletingPost = false;
        }
    }

    private async Task CloseModal()
    {
        if (isDeletingPost) return;
        deleteErrorMessage = null;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task ConfirmDeletePostAsync()
    {
        if (Post == null || isDeletingPost) return;

        isDeletingPost = true;
        deleteErrorMessage = null;

        try
        {
            var targetPostId = Post.Id;
            var res = await PostService.DeletePostAsync(targetPostId);
            if (res.Success)
            {
                isDeletingPost = false;
                deleteErrorMessage = null;
                if (OnPostDeleted.HasDelegate)
                {
                    await OnPostDeleted.InvokeAsync(targetPostId);
                }
            }
            else
            {
                deleteErrorMessage = res.Message ?? "Unable to delete this post. Please try again.";
            }
        }
        catch (Exception ex)
        {
            deleteErrorMessage = "Unable to delete this post. Please try again.";
            Console.WriteLine($"[DeletePost] Error: {ex.Message}");
        }
        finally
        {
            isDeletingPost = false;
        }
    }
}

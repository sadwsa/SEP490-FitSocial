    private async Task HandleUpdateStaffAsync()
    {
        editErrorMessage = null;

        if (string.IsNullOrWhiteSpace(editStaffModel.FullName) || editStaffModel.FullName.Trim().Length < 2)
        {
            editNameHasError = true;
            editNameErrorMessage = "Please enter a valid full name (at least 2 characters).";
            editErrorMessage = editNameErrorMessage;
            return;
        }

        if (editStaffModel.FullName.Any(char.IsDigit))
        {
            editNameHasError = true;
            editNameErrorMessage = "Full name cannot contain numbers.";
            editErrorMessage = editNameErrorMessage;
            return;
        }

        if (string.IsNullOrWhiteSpace(editStaffModel.Email))
        {
            editErrorMessage = "Email address is required.";
            return;
        }

        if (!editStaffModel.Email.Contains('@') || !editStaffModel.Email.Contains('.'))
        {
            editErrorMessage = "Please enter a valid email address.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(editStaffModel.PhoneNumber))
        {
            var phone = editStaffModel.PhoneNumber.Trim();
            if (phone.Any(char.IsLetter))
            {
                editPhoneHasError = true;
                editPhoneErrorMessage = "Phone number cannot contain letters.";
                editErrorMessage = editPhoneErrorMessage;
                return;
            }

            if (!System.Text.RegularExpressions.Regex.IsMatch(phone, @"^0\d{9}$"))
            {
                editPhoneHasError = true;
                editPhoneErrorMessage = "Phone number must be a valid 10-digit number starting with 0 (e.g. 0901234567).";
                editErrorMessage = editPhoneErrorMessage;
                return;
            }
        }

        if (!string.IsNullOrWhiteSpace(editStaffModel.Password))
        {
            if (editStaffModel.Password.Length < 6)
            {
                editErrorMessage = "Password must be at least 6 characters long.";
                return;
            }

            if (editStaffModel.Password != editStaffModel.ConfirmPassword)
            {
                editErrorMessage = "Passwords do not match.";
                return;
            }
        }

        // Check email availability if changed
        if (!string.Equals(editStaffModel.Email.Trim(), initialEmail, StringComparison.OrdinalIgnoreCase))
        {
            var emailAvailable = await CheckEditEmailAvailabilityAsync(showPopupOnConflict: true);
            if (!emailAvailable && isEditEmailAvailable == false)
            {
                return;
            }
        }

        isSubmittingEdit = true;
        try
        {
            var res = await UserService.UpdateStaffAccountAsync(editingStaffId, editStaffModel);
            if (res.Success)
            {
                showEditStaffModal = false;
                editStaffModel = new();
                isEditEmailAvailable = null;
                toastMessage = res.Message ?? "Staff account updated successfully!";
                await LoadStaffAsync();

@page "/training-packages/{Id:guid}"
@layout EmptyLayout
@inject ITrainingPackageService PackageService
@inject ICartService CartService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject FitSocial.Client.Services.Auth.IAuthService AuthService
@using FitSocial.Client.Layout
@using FitSocial.Client.Models.Cart
@using System.Security.Claims

<PageTitle>Package Details - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <!-- Floating Success Toast Notification -->
    @if (!string.IsNullOrWhiteSpace(toastSuccessMessage))
    {
        <div class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-emerald-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-emerald-500/50 backdrop-blur transition-all duration-300 animate-in fade-in slide-in-from-top-4">
            <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <span>@toastSuccessMessage</span>
            <button type="button" @onclick="DismissToast"
                    class="ml-2 text-white/80 hover:text-white text-lg font-bold transition cursor-pointer"
                    title="Close">&times;</button>
        </div>
    }

    <!-- Floating Error Toast Notification -->
    @if (!string.IsNullOrWhiteSpace(toastErrorMessage))
    {
        <div class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-red-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-red-500/50 backdrop-blur transition-all duration-300 animate-in fade-in slide-in-from-top-4">
            <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <span>@toastErrorMessage</span>
            <button type="button" @onclick="DismissToast"
                    class="ml-2 text-white/80 hover:text-white text-lg font-bold transition cursor-pointer"
                    title="Close">&times;</button>
        </div>
    }

    <AppHeader SearchTerm="@headerSearchTerm"
               OnSearchInput="HandleHeaderSearchInput"
               OnSearchKeyUp="HandleHeaderSearchKeyUp"
               OnSearch="ExecuteHeaderSearch"
               OnClearSearch="ClearHeaderSearch"
               UserName="@userName"
               UserInitials="@userInitials"
               UserRole="@userRole"
               CartCount="@cartCount"
               OnLogout="HandleLogout" />

    <style>
        @@media (min-width: 1024px) {
            .home-3col-layout {
                display: grid !important;
                grid-template-columns: minmax(18rem, 1fr) minmax(0, 42rem) minmax(18rem, 1fr) !important;
                align-items: start !important;
            }
            .home-left-sidebar { justify-self: start !important; }
            .home-center-feed { justify-self: center !important; width: 100% !important; max-width: 42rem !important; min-width: 0 !important; }
            .home-right-sidebar { justify-self: center !important; }
        }
    </style>

    <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">
        <!-- Left Sidebar -->
        <AppSidebar ActiveItem="@(isOwnPackage ? "my-packages" : "package-list")" />

        <!-- Center Column -->
        <section class="home-center-feed w-full max-w-2xl flex flex-col gap-4 min-w-0 pb-10">
            @if (isLoading)
            {
                <div class="flex flex-col items-center justify-center py-20">
                    <div class="w-10 h-10 border-4 border-[#FF5500] border-t-transparent rounded-full animate-spin mb-4"></div>
                    <p class="text-gray-500 font-medium">Loading package details...</p>
                </div>
            }
            else if (package == null)
            {
                <div class="bg-red-50 border border-red-100 rounded-xl p-8 text-center shadow-sm">
                    <svg class="w-16 h-16 text-red-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    <h3 class="text-lg font-bold text-gray-800 mb-2">Oops!</h3>
                    <p class="text-gray-600 mb-6">@errorMessage</p>
                    <a href="/training-packages" class="inline-flex items-center gap-2 bg-gray-800 text-white px-6 py-2 rounded-lg font-semibold hover:bg-gray-700 transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        Back to Packages
                    </a>
                </div>
            }
            else
            {
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <!-- Image Gallery / Hero -->
                    @if (package.ImageUrls != null && package.ImageUrls.Any())
                    {
                        <div class="relative bg-gray-950 overflow-hidden">
                            <!-- Main Large Image -->
                            <div class="w-full h-72 sm:h-96 relative flex items-center justify-center bg-black/40">
                                <img src="@selectedImageUrl" alt="@package.Title" class="w-full h-full object-cover transition-all duration-300" />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                                <div class="absolute bottom-4 left-6 right-6 text-white">
                                    <h1 class="text-2xl sm:text-3xl font-extrabold mb-1 drop-shadow-md">@package.Title</h1>
                                    <p class="text-orange-200 font-medium text-sm sm:text-base">
                                        Coach: <span class="font-bold underline decoration-orange-400">@package.CoachName</span>
                                    </p>
                                </div>
                            </div>

                            <!-- Thumbnails Strip (if > 1 image) -->
                            @if (package.ImageUrls.Count > 1)
                            {
                                <div class="flex items-center gap-2 p-3 bg-gray-900/90 overflow-x-auto">
                                    @foreach (var img in package.ImageUrls)
                                    {
                                        var isSelected = (img == selectedImageUrl);
                                        <button type="button" @onclick="() => selectedImageUrl = img"
                                                class="w-14 h-14 rounded-lg overflow-hidden border-2 flex-shrink-0 transition cursor-pointer @(isSelected ? "border-[#FF5500] scale-105" : "border-transparent opacity-60 hover:opacity-100")">
                                            <img src="@img" alt="Thumbnail" class="w-full h-full object-cover" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="bg-gradient-to-br from-[#FF8C00] to-[#FF5500] p-10 text-center relative overflow-hidden">
                            <div class="absolute -right-10 -top-10 opacity-10">
                                <svg class="w-40 h-40" fill="currentColor" viewBox="0 0 20 20"><path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path></svg>
                            </div>
                            <h1 class="text-3xl font-extrabold text-white mb-2 relative z-10">@package.Title</h1>
                            <p class="text-orange-50 font-medium text-lg relative z-10">Coach: <span class="font-bold underline decoration-orange-300">@package.CoachName</span></p>
                        </div>
                    }
                    
                    <div class="p-6 sm:p-8">
                        @if (!string.IsNullOrWhiteSpace(package.Description))
                        {
                            <div class="mb-6 bg-gray-50 p-5 rounded-2xl border border-gray-100">
                                <h4 class="text-xs uppercase font-bold tracking-wider text-gray-400 mb-2">Program Curriculum & Overview</h4>
                                <p class="text-gray-700 text-sm leading-relaxed whitespace-pre-line">
                                    @package.Description
                                </p>
                            </div>
                        }

                        <!-- Info Matrix: Duration, Price, Sessions, MinAge, TargetAudience -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
                            <div class="bg-orange-50/60 p-4 rounded-xl border border-orange-100 text-center">
                                <h6 class="text-[11px] uppercase tracking-wider text-orange-600 font-bold mb-1">Duration</h6>
                                <p class="text-2xl font-black text-gray-800">@package.DurationDays</p>
                                <span class="text-xs text-gray-500 font-medium">Days</span>
                            </div>

                            <div class="bg-orange-50/60 p-4 rounded-xl border border-orange-100 text-center">
                                <h6 class="text-[11px] uppercase tracking-wider text-orange-600 font-bold mb-1">Sessions</h6>
                                <p class="text-2xl font-black text-gray-800">@(package.SessionCount.HasValue ? package.SessionCount.Value.ToString() : "--")</p>
                                <span class="text-xs text-gray-500 font-medium">Sessions</span>
                            </div>

                            <div class="bg-orange-50/60 p-4 rounded-xl border border-orange-100 text-center">
                                <h6 class="text-[11px] uppercase tracking-wider text-orange-600 font-bold mb-1">Min Age</h6>
                                <p class="text-2xl font-black text-gray-800">@(package.MinAge.HasValue ? $"{package.MinAge.Value}+" : "All Ages")</p>
                                <span class="text-xs text-gray-500 font-medium">Years</span>
                            </div>

                            <div class="bg-orange-500/10 p-4 rounded-xl border border-orange-200 text-center">
                                <h6 class="text-[11px] uppercase tracking-wider text-[#FF5500] font-bold mb-1">Investment</h6>
                                <p class="text-xl sm:text-2xl font-black text-[#FF5500]">@package.Price.ToString("N0")</p>
                                <span class="text-xs text-gray-500 font-medium">VND</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(package.TargetAudience))
                        {
                            <div class="mb-6 flex items-center gap-3 p-3.5 bg-blue-50/60 rounded-xl border border-blue-100 text-blue-900 text-sm">
                                <span class="font-bold flex-shrink-0 text-blue-600">🎯 Target Audience:</span>
                                <span>@package.TargetAudience</span>
                            </div>
                        }

                        @if (isOwnPackage)
                        {
                            <!-- Coach is owner: cannot buy own package -->
                            <div class="mb-6 p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div class="flex items-center gap-2.5">
                                    <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                                    </svg>
                                    <span class="font-medium">You created this training package. Coaches cannot purchase their own packages.</span>
                                </div>
                                <a href="/training-packages/edit/@package.PackageId" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-xl font-bold text-xs transition shadow-xs text-center flex-shrink-0">
                                    Edit Package
                                </a>
                            </div>

                            <div class="flex flex-col sm:flex-row gap-3">
                                <a href="/training-packages/edit/@package.PackageId" class="flex-1 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white py-3.5 rounded-xl font-bold text-base hover:shadow-lg text-center transition flex items-center justify-center gap-2">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    <span>Edit Training Package</span>
                                </a>
                                <a href="/training-packages" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 py-3.5 rounded-xl font-semibold text-center transition">
                                    Manage My Packages
                                </a>
                            </div>
                        }
                        else
                        {
                            <!-- Single Trainee Enrollment Policy (1 Package Max 1) -->
                            <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gray-50/70 p-4 rounded-xl border border-gray-100">
                                <div>
                                    <h6 class="text-xs uppercase tracking-wider text-gray-500 font-bold mb-0.5">Quantity</h6>
                                    <p class="text-xs text-gray-400">1-on-1 coaching package applies to a single trainee</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="inline-flex items-center gap-2 bg-white border border-gray-200 px-3.5 py-2 rounded-xl shadow-xs">
                                        <svg class="w-3.5 h-3.5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                                        </svg>
                                        <span class="text-xs font-bold text-gray-800">1 Package (Max 1)</span>
                                    </div>
                                    <span class="text-xs text-gray-500">
                                        Total: <span class="font-bold text-[#FF5500]">@(package.Price.ToString("N0")) VND</span>
                                    </span>
                                </div>
                            </div>

                            <div class="flex flex-col gap-3">
                                <div class="flex flex-col sm:flex-row gap-3">
                                    @if (inCart)
                                    {
                                        <!-- In Cart State -->
                                        <a href="cart"
                                           class="flex-1 bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-100 py-3.5 rounded-xl font-bold text-base transition-all duration-200 flex items-center justify-center gap-2">
                                            <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                            <span>Already in Cart (View Cart)</span>
                                        </a>

                                        <button type="button"
                                                @onclick="HandleBuyNow"
                                                class="flex-1 bg-gray-900 hover:bg-black text-white py-3.5 rounded-xl font-bold text-base hover:shadow-lg transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer">
                                            <span>Proceed to Checkout</span>
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <!-- Add to Cart Button -->
                                        <button type="button"
                                                id="btn-add-to-cart"
                                                @onclick="HandleAddToCart"
                                                disabled="@isAddingToCart"
                                                class="flex-1 bg-gradient-to-r from-[#FF8C00] to-[#FF5500] text-white py-3.5 rounded-xl font-bold text-base hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 flex items-center justify-center gap-2 disabled:opacity-60 cursor-pointer">
                                            @if (isAddingToCart)
                                            {
                                                <div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                                <span>Adding to Cart...</span>
                                            }
                                            else
                                            {
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                                                </svg>
                                                <span>Add to Cart</span>
                                            }
                                        </button>

                                        <button type="button"
                                                @onclick="HandleBuyNow"
                                                disabled="@isAddingToCart"
                                                class="flex-1 bg-gray-900 hover:bg-black text-white py-3.5 rounded-xl font-bold text-base hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-70">
                                            <span>Buy Now</span>
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                            </svg>
                                        </button>
                                    }
                                </div>

                                <a href="packages" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 py-3 rounded-xl font-semibold text-center transition-colors">
                                    Browse All Packages
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>

        <!-- Right Sidebar (Empty) -->
        <aside class="home-right-sidebar hidden lg:flex w-72 flex-shrink-0 flex-col gap-4 sticky top-24"></aside>
    </div>

    <!-- Package Already In Cart Modal Notification -->
    <PackageAlreadyInCartModal IsOpen="@showAlreadyInCartModal"
                               PackageTitle="@package?.Title"
                               OnClose="() => showAlreadyInCartModal = false"
                               OnViewCart="NavigateToCart" />
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }
    
    private TrainingPackageResponseDto? package;
    private string? selectedImageUrl;
    private bool isLoading = true;
    private string errorMessage = "Package not found.";

    // Ownership & Cart state
    private Guid? currentUserId;
    private bool isOwnPackage => currentUserId.HasValue && package != null && package.CoachId == currentUserId.Value;
    private bool inCart = false;
    private const int quantity = 1; // Strict single quantity rule
    private bool isAddingToCart = false;
    private int cartCount = 0;
    private bool isAuthenticated = false;
    private bool showAlreadyInCartModal = false;

    // Toast state
    private string? toastSuccessMessage;
    private string? toastErrorMessage;
    private System.Threading.CancellationTokenSource? toastCts;
    
    // Header state
    private string? headerSearchTerm = "";
    private string userName = "User";
    private string userInitials = "U";
    private string userRole = "Trainee";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfoAsync();
        var response = await PackageService.GetPackageByIdAsync(Id);
        if (response.Success)
        {
            package = response.Data;
            selectedImageUrl = package?.ImageUrls?.FirstOrDefault();
            await CheckCartStatusAsync();
        }
        else
        {
            errorMessage = response.Message ?? errorMessage;
        }
        isLoading = false;
    }

    private async Task LoadUserInfoAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                isAuthenticated = true;
                userName = user.Identity.Name ?? "User";
                var isCoach = user.IsInRole("COACH") || user.IsInRole("Coach") || user.IsInRole("coach");
                userRole = isCoach ? "Coach" : "Trainee";

                var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 0)
                {
                    userInitials = parts.Length > 1 
                        ? $"{parts[0][0]}{parts[^1][0]}".ToUpper() 
                        : parts[0].Length >= 2 ? parts[0].Substring(0, 2).ToUpper() : parts[0].ToUpper();
                }

                var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                    ?? user.FindFirst("sub")?.Value
                    ?? user.FindFirst("userId")?.Value;

                if (Guid.TryParse(idClaim, out var uId))
                {
                    currentUserId = uId;
                }

                try
                {
                    var countResponse = await CartService.GetCartCountAsync();
                    if (countResponse.Success)
                    {
                        cartCount = countResponse.Data;
                    }
                }
                catch { }
            }
            else
            {
                isAuthenticated = false;
            }
        }
        catch
        {
            userInitials = "U";
            isAuthenticated = false;
        }
    }

    private async Task CheckCartStatusAsync()
    {
        if (!isAuthenticated || package == null) return;
        try
        {
            var cartRes = await CartService.GetCartAsync();
            if (cartRes.Success && cartRes.Data != null)
            {
                inCart = cartRes.Data.Items.Any(i => i.PackageId == package.PackageId);
            }
        }
        catch { }
    }

    private async Task HandleAddToCart()
    {
        if (!isAuthenticated)
        {
            Navigation.NavigateTo($"login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
            return;
        }

        if (package == null)
        {
            ShowErrorToast("Cannot add an invalid package.");
            return;
        }

        if (isOwnPackage)
        {
            ShowErrorToast("You cannot add your own training package to the cart.");
            return;
        }

        if (inCart)
        {
            ShowErrorToast("This package is already in your cart. You cannot purchase multiple quantities.");
            return;
        }

        isAddingToCart = true;
        try
        {
            var dto = new AddToCartDto
            {
                PackageId = package.PackageId,
                Quantity = 1
            };

            var response = await CartService.AddToCartAsync(dto);
            if (response.Success)
            {
                inCart = true;
                var countRes = await CartService.GetCartCountAsync();
                if (countRes.Success)
                {
                    cartCount = countRes.Data;
                }
                else
                {
                    cartCount++;
                }
                ShowSuccessToast(response.Message ?? "Added to cart successfully!");
            }
            else
            {
                if (FitSocial.Client.Services.Cart.CartService.IsAlreadyInCartError(response.Message))
                {
                    showAlreadyInCartModal = true;
                }
                else
                {
                    ShowErrorToast(response.Message ?? "Failed to add product to cart.");
                }
            }
        }
        catch (Exception ex)
        {
            ShowErrorToast($"An error occurred: {ex.Message}");
        }
        finally
        {
            isAddingToCart = false;
        }
    }

    private void ShowSuccessToast(string message)
    {
        toastErrorMessage = null;
        toastSuccessMessage = message;
        ScheduleToastDismiss();
    }

    private void ShowErrorToast(string message)
    {
        toastSuccessMessage = null;
        toastErrorMessage = message;
        ScheduleToastDismiss();
    }

    private void ScheduleToastDismiss()
    {
        toastCts?.Cancel();
        toastCts?.Dispose();
        toastCts = new System.Threading.CancellationTokenSource();
        var token = toastCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(4000, token);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        toastSuccessMessage = null;
                        toastErrorMessage = null;
                        StateHasChanged();
                    });
                }
            }
            catch { }
        }, token);
    }

    private void DismissToast()
    {
        toastSuccessMessage = null;
        toastErrorMessage = null;
        toastCts?.Cancel();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }

    private void HandleHeaderSearchInput(ChangeEventArgs e)
    {
        headerSearchTerm = e.Value?.ToString();
    }

    private void HandleHeaderSearchKeyUp(KeyboardEventArgs e) { }
    private void ExecuteHeaderSearch() { }
    private void ClearHeaderSearch() { headerSearchTerm = string.Empty; }

    private async Task HandleBuyNow()
    {
        if (!isAuthenticated)
        {
            Navigation.NavigateTo($"login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
            return;
        }

        if (package == null) return;

        if (isOwnPackage)
        {
            ShowErrorToast("You cannot purchase your own training package.");
            return;
        }

        if (inCart)
        {
            Navigation.NavigateTo($"checkout?packageId={package.PackageId}");
            return;
        }

        isAddingToCart = true;
        try
        {
            var dto = new AddToCartDto
            {
                PackageId = package.PackageId,
                Quantity = 1
            };

            var response = await CartService.AddToCartAsync(dto);
            if (response.Success)
            {
                inCart = true;
                cartCount += 1;
                Navigation.NavigateTo($"checkout?packageId={package.PackageId}");
            }
            else
            {
                if (FitSocial.Client.Services.Cart.CartService.IsAlreadyInCartError(response.Message))
                {
                    showAlreadyInCartModal = true;
                }
                else
                {
                    ShowErrorToast(response.Message ?? "Failed to proceed to checkout.");
                }
            }
        }
        catch (Exception ex)
        {
            ShowErrorToast($"An error occurred: {ex.Message}");
        }
        finally
        {
            isAddingToCart = false;
        }
    }

    private void NavigateToCart()
    {
        showAlreadyInCartModal = false;
        Navigation.NavigateTo("cart");
    }
}

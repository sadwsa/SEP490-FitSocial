# ==========================================
#  FitSocial - .gitignore
# .NET 8 (Clean Architecture Web API & Blazor WASM Frontend)
# ==========================================

# ------------------------------------------
# 1. .NET Build & Compilation Outputs
# ------------------------------------------
**/[Bb]in/
**/[Oo]bj/
**/[Aa]pp_data/
**/[Aa]rtifacts/
**/[Pp]ublish/
**/[Dd]ist/

# ------------------------------------------
# 2. Visual Studio & IDE Specifics
# ------------------------------------------
**/.vs/
**/.dotnet/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# Rider
**/.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------
# 3. Environment, Secrets & Local Configs
# ------------------------------------------
# Bỏ qua các file cấu hình chứa Secret cá nhân / Môi trường
**/*appsettings.Development.json
**/*appsettings.*.Development.json
**/*appsettings.Production.json
**/*appsettings.Staging.json
**/*appsettings.local.json
**/*appsettings.*.local.json
**/secrets.json

# Nếu team quyết định KHÔNG PUSH file appsettings.json chính chủ:
**/appsettings.json

# Environment variables
.env
.env.*
.env*.local

# Certificates & Private Keys
*.pfx
*.pem
*.key
*.cer
*.crt
*.p12

# ------------------------------------------
# 4. Local Database Files & Backups
# ------------------------------------------
*.db
*.db-shm
*.db-wal
*.mdf
*.ldf
*.bak
*.sql.bak

# ------------------------------------------
# 5. OS & System Files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------
# 6. Node / Web & Temporary Files
# ------------------------------------------
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.zip
*.rar
*.7z
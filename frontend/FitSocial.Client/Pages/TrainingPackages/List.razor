@page "/training-packages"
@inject ITrainingPackageService PackageService
@inject NavigationManager Navigation

<style>
    /* Instagram-like Orange Theme for Packages */
    .insta-container {
        background-color: #fafafa;
        min-height: 100vh;
        padding-top: 40px;
        padding-bottom: 50px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .insta-header {
        font-weight: 700;
        font-size: 1.5rem;
        color: #262626;
    }

    .insta-card {
        background-color: #fff;
        border: 1px solid #dbdbdb;
        border-radius: 8px;
        overflow: hidden;
    }

    /* Nút Tạo mới màu Cam Gradient */
    .insta-btn-primary {
        background: linear-gradient(135deg, #FF9800, #FF5722);
        color: #fff;
        font-weight: 600;
        border-radius: 25px;
        padding: 8px 20px;
        border: none;
        font-size: 0.95rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 4px 12px rgba(255, 87, 34, 0.25);
        text-decoration: none;
        display: inline-block;
    }

        .insta-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(255, 87, 34, 0.4);
            color: #fff;
        }

    /* Nút Xem chi tiết (Tối giản) */
    .insta-btn-outline {
        background-color: transparent;
        color: #262626;
        font-weight: 600;
        border-radius: 8px;
        padding: 7px 16px;
        border: 1px solid #dbdbdb;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        width: 100%;
    }

        .insta-btn-outline:hover {
            background-color: #FAFAFA;
            border-color: #c7c7c7;
        }

    /* Badges Trạng thái */
    .insta-badge-active {
        background-color: rgba(255, 122, 0, 0.1);
        color: #FF7A00;
    }

    .insta-badge-inactive {
        background-color: #efefef;
        color: #8e8e8e;
    }

    /* Khung chứa Chỉ số (Ngày / Giá tiền) */
    .insta-stats {
        display: flex;
        justify-content: center;
        gap: 30px;
        border-top: 1px solid #efefef;
        padding-top: 15px;
        margin-top: 15px;
        margin-bottom: 15px;
    }

    .insta-stat-item {
        text-align: center;
    }

    .insta-stat-val {
        font-weight: 700;
        color: #262626;
        display: block;
        font-size: 1.1rem;
    }

    .insta-stat-label {
        font-size: 0.8rem;
        color: #8e8e8e;
    }
</style>

<div class="insta-container">
    <div class="container" style="max-width: 935px;">
        <!-- Header -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5">
            <h1 class="insta-header mb-3 mb-md-0">My Training Packages</h1>

            <AuthorizeView Roles="COACH">
                <Authorized>
                    <a href="/training-packages/create" class="insta-btn-primary">
                        <i class="bi bi-plus-lg me-2"></i> Create New
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border" style="color: #FF7A00;" role="status"></div>
                <p class="mt-3 text-muted">Loading your packages...</p>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="alert alert-danger text-center shadow-sm border-0">@errorMessage</div>
        }
        else if (!packages.Any())
        {
            <!-- Trạng thái trống (Empty State) xịn xò -->
            <div class="text-center py-5 bg-white rounded-4 border" style="border-color: #dbdbdb !important;">
                <i class="bi bi-box-seam fs-1 d-block mb-3" style="color: #dbdbdb;"></i>
                <h4 class="fw-bold text-dark">No packages yet</h4>
                <p class="text-muted mb-4">Create your first training package to start getting clients.</p>
                <AuthorizeView Roles="COACH">
                    <Authorized>
                        <a href="/training-packages/create" class="insta-btn-primary">Create Package</a>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var pkg in packages)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="insta-card h-100 p-4 d-flex flex-column text-center hover-lift">

                            <!-- Status Badge -->
                            <div class="d-flex justify-content-center mb-3">
                                @if (pkg.IsActive)
                                {
                                    <span class="badge insta-badge-active px-3 py-2 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge insta-badge-inactive px-3 py-2 rounded-pill"><i class="bi bi-pause-circle-fill me-1"></i> Inactive</span>
                                }
                            </div>

                            <!-- Title -->
                            <h4 class="card-title fw-bold text-dark mb-1">@pkg.Title</h4>
                            <p class="text-muted small mb-3">By @pkg.CoachName</p>

                            <!-- Stats (Days & Price) -->
                            <div class="insta-stats mt-auto">
                                <div class="insta-stat-item">
                                    <span class="insta-stat-val">@pkg.DurationDays</span>
                                    <span class="insta-stat-label">Days</span>
                                </div>
                                <div class="insta-stat-item">
                                    <!-- Giá tiền nổi bật với màu Cam -->
                                    <span class="insta-stat-val" style="color: #FF7A00;">@pkg.Price.ToString("N0")đ</span>
                                    <span class="insta-stat-label">Price</span>
                                </div>
                            </div>

                            <!-- Action -->
                            <button @onclick="() => ViewDetails(pkg.PackageId)" class="insta-btn-outline mt-2">
                                View Details
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private IEnumerable<TrainingPackageResponseDto> packages = new List<TrainingPackageResponseDto>();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var response = await PackageService.GetMyPackagesAsync();
        if (response.Success && response.Data != null)
        {
            packages = response.Data;
        }
        else
        {
            errorMessage = response.Message ?? "Failed to load packages.";
        }
        isLoading = false;
    }

    private void ViewDetails(Guid id)
    {
        Navigation.NavigateTo($"/training-packages/{id}");
    }
}

@page "/home"
@namespace FitSocial.Client.Pages
@layout EmptyLayout
@attribute [Authorize(Roles = "TRAINEE,COACH")]
@implements IDisposable
@inject IPostService PostService
@inject ICoachService CoachService
@inject ILocationService LocationService
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.Security.Claims
@using FitSocial.Client.Components.Posts

<PageTitle>Home Feed - FitSocial</PageTitle>

<div class="min-h-screen bg-gray-100 text-gray-800">
    <!-- Floating Success Toast Notification -->
    @if (!string.IsNullOrWhiteSpace(toastSuccessMessage))
    {
        <div
            class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-emerald-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-emerald-500/50 backdrop-blur transition-all duration-300 animate-in fade-in slide-in-from-top-4">
            <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <span>@toastSuccessMessage</span>
            <button type="button" @onclick="DismissToast"
                    class="ml-2 text-white/80 hover:text-white text-lg font-bold transition cursor-pointer"
                    title="Close">&times;</button>
        </div>
    }

    <!-- Floating Warning Toast Notification -->
    @if (!string.IsNullOrWhiteSpace(toastWarningMessage))
    {
        <div
            class="fixed top-5 left-1/2 transform -translate-x-1/2 z-[100] flex items-center gap-3 px-5 py-3 bg-amber-600 text-white font-medium text-sm rounded-2xl shadow-xl border border-amber-500/50 backdrop-blur transition-all duration-300 animate-in fade-in slide-in-from-top-4">
            <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <span>@toastWarningMessage</span>
            <button type="button" @onclick="DismissWarningToast"
                    class="ml-2 text-white/80 hover:text-white text-lg font-bold transition cursor-pointer"
                    title="Close">&times;</button>
        </div>
    }

    <!-- 1. Header / Navigation Bar -->
    <AppHeader SearchTerm="@searchTerm"
               OnSearchInput="HandleSearchInput"
               OnSearchKeyUp="HandleSearchKeyUp"
               OnSearch="ExecuteSearch"
               OnClearSearch="ClearSearch"
               UserName="@userName"
               UserInitials="@userInitials"
               UserRole="@userRole"
               UserAvatarUrl="@currentUserAvatarUrl"
               OnLogout="HandleLogout" />

            <style>
                    @@media (min-width: 1024px) {
                        .home-3col-layout {
                            display: grid !important;
                            grid-template-columns: minmax(18rem, 1fr) minmax(0, 42rem) minmax(18rem, 1fr) !important;
                            align-items: start !important;
                        }

                        .home-left-sidebar {
                            justify-self: start !important;
                        }

                        .home-center-feed {
                            justify-self: end !important;
                            width: 100% !important;
                            max-width: 42rem !important;
                            min-width: 0 !important;
                        }

                        .home-right-sidebar {
                            justify-self: center !important;
                        }
                    }

                    .post-content-text {
                        word-break: break-word;
                        overflow-wrap: anywhere;
                        word-wrap: break-word;
                        white-space: pre-line;
                    }
            </style>

            <!-- Main Content Layout (3-Column Horizontal Row) -->
            <div class="home-3col-layout w-full pt-6 px-4 lg:px-6 flex flex-col items-start">

                <!-- Left Sidebar: Menu Navigation -->
                <AppSidebar ActiveItem="home" />

                <!-- Center Column: Main Feed -->
                <section class="home-center-feed w-full max-w-2xl flex flex-col gap-4 min-w-0">

                    <!-- Create Post Box -->
                    <CreatePostBox UserInitials="@userInitials" UserAvatarUrl="@currentUserAvatarUrl" IsCoach="@isCoach" OnOpen="HandleCreatePostBoxOpen" />

                    <!-- Filter Bar -->
                    <PostFilterBar TotalCount="@totalCount" SearchTerm="@searchTerm" SelectedPostType="@selectedPostType"
                                   SelectedLocationId="@selectedFilterLocationId"
                                   AvailableLocations="@availableLocations"
                                   OnApplyFilters="HandleApplyFilters" OnClearSearch="ClearSearch" OnResetAll="ResetAllSearchAndFilters" />

                    <!-- Feed Posts Stream -->
                    @if (isLoading)
                    {
                        <div class="flex flex-col gap-4">
                            @for (int i = 0; i < 2; i++)
                            {
                                <div class="bg-white rounded-xl shadow-sm p-4 animate-pulse">
                                    <div class="flex items-center gap-3 mb-4">
                                        <div class="w-10 h-10 rounded-full bg-gray-200"></div>
                                        <div class="flex-1 space-y-2">
                                            <div class="h-3.5 bg-gray-200 rounded w-1/4"></div>
                                            <div class="h-2.5 bg-gray-200 rounded w-1/3"></div>
                                        </div>
                                    </div>
                                    <div class="space-y-2 mb-4">
                                        <div class="h-3 bg-gray-200 rounded"></div>
                                        <div class="h-3 bg-gray-200 rounded w-5/6"></div>
                                    </div>
                                    <div class="h-48 bg-gray-100 rounded-lg mb-3"></div>
                                </div>
                            }
                        </div>
                    }
                    else if (posts == null || !posts.Any())
                    {
                        <div class="bg-white rounded-xl shadow-sm p-10 text-center text-gray-500">
                            <div class="w-16 h-16 mx-auto mb-3 text-orange-400">
                                <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                          d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z">
                                    </path>
                                </svg>
                            </div>
                            <h3 class="text-base font-bold text-gray-800 mb-1">No posts found</h3>
                            <p class="text-xs text-gray-400 mb-4">
                                @(HasActiveFilters || !string.IsNullOrWhiteSpace(searchTerm)
                                    ? "No posts match your search query or filter criteria. Try adjusting your search or filters."
                                    : "Be the first to share your workout journey today!")
                            </p>
                            @if (!string.IsNullOrWhiteSpace(searchTerm) || HasActiveFilters)
                            {
                                <button @onclick="ResetAllSearchAndFilters"
                                        class="inline-flex items-center gap-1.5 px-4 py-2 bg-orange-50 text-[#FF5500] hover:bg-orange-100 rounded-xl text-xs font-semibold transition cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                                        </path>
                                    </svg>
                                    Reset Search & Filters
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var post in posts)
                        {
                            <PostCard @key="post.Id" Post="post" CurrentUserId="currentUserId" OnLike="ToggleLike"
                                      OnEdit="OpenEditPostModal" OnDelete="OpenDeletePostModal" OnReport="HandleReportPost" />
                        }
                    }

                    <!-- Load More / Pagination -->
                    @if (hasNextPage)
                    {
                        <div class="flex justify-center pt-2 pb-4">
                            <button type="button" @onclick="LoadMorePostsAsync" disabled="@isLoadingMore"
                                    class="px-6 py-2.5 bg-white hover:bg-orange-50 text-gray-700 hover:text-[#FF5500] border border-gray-200 hover:border-orange-200 rounded-xl shadow-xs hover:shadow-sm font-semibold text-xs transition-all duration-150 flex items-center gap-2 cursor-pointer disabled:opacity-60">
                                @if (isLoadingMore)
                                {
                                    <span
                                    class="w-4 h-4 border-2 border-[#FF5500] border-t-transparent rounded-full animate-spin"></span>
                                    <span>Loading more posts...</span>
                                }
                                else
                                {
                                    <svg class="w-4 h-4 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                    <span>Load More Posts</span>
                                }
                            </button>
                        </div>
                    }

                </section>

                <!-- Right Sidebar: Widgets & Shortcuts -->
                <aside class="home-right-sidebar hidden lg:flex w-72 flex-shrink-0 flex-col gap-4 sticky top-24">

                    <!-- Top 5 Coaches Box -->
                    <div class="bg-white rounded-xl shadow-sm p-4">
                        <h3 class="font-bold text-gray-800 mb-3 text-sm flex items-center gap-2">
                            <svg class="w-5 h-5 text-[#FF8C00]" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z">
                                </path>
                            </svg>
                            Top 5 Coaches
                        </h3>
                        @if (isLoadingTopCoaches)
                        {
                            <div class="flex flex-col gap-3">
                                @for (int i = 0; i < 3; i++)
                                {
                                    <div class="flex items-center justify-between animate-pulse">
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 rounded-full bg-gray-200"></div>
                                            <div class="space-y-1">
                                                <div class="h-3 bg-gray-200 rounded w-20"></div>
                                                <div class="h-2.5 bg-gray-200 rounded w-12"></div>
                                            </div>
                                        </div>
                                        <div class="h-6 w-12 bg-gray-200 rounded-lg"></div>
                                    </div>
                                }
                            </div>
                        }
                        else if (topCoaches == null || !topCoaches.Any())
                        {
                            <p class="text-xs text-gray-400 py-2 text-center">No coaches found</p>
                        }
                        else
                        {
                            <div class="flex flex-col gap-3.5">
                                @foreach (var coach in topCoaches)
                                {
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2.5 min-w-0">
                                            <div class="w-8 h-8 rounded-full flex-shrink-0 relative overflow-hidden shadow-xs border border-gray-100">
                                                @if (AvatarHelper.HasValidAvatarUrl(coach.AvatarUrl))
                                                {
                                                    <img src="@coach.AvatarUrl" alt="@coach.FullName"
                                                         class="w-full h-full object-cover"
                                                         referrerpolicy="no-referrer" loading="lazy"
                                                         onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                                    <div class="w-full h-full rounded-full bg-gradient-to-r from-orange-400 to-amber-500 text-white items-center justify-center font-bold text-xs"
                                                         style="display: none;">
                                                        @AvatarHelper.GetInitial(coach.FullName)
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="w-full h-full rounded-full bg-gradient-to-r from-orange-400 to-amber-500 flex items-center justify-center text-white font-bold text-xs">
                                                        @AvatarHelper.GetInitial(coach.FullName)
                                                    </div>
                                                }
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <h4 class="text-sm font-semibold text-gray-900 truncate" title="@coach.FullName">@coach.FullName</h4>
                                                <div class="flex items-center gap-1 text-xs text-[#FF8C00]">
                                                    <svg class="w-3.5 h-3.5 flex-shrink-0 fill-current" viewBox="0 0 20 20">
                                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                    </svg>
                                                    <span class="font-medium">@(coach.Rating > 0 ? coach.Rating.ToString("0.0") : "5.0")</span>
                                                    @if (coach.TotalReviews > 0)
                                                    {
                                                        <span class="text-gray-400 text-[10px]">(@coach.TotalReviews)</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <a href="coaches"
                                           class="text-xs text-[#FF5500] font-semibold hover:bg-orange-50 px-2.5 py-1 rounded-lg border border-transparent hover:border-orange-200 transition flex-shrink-0">View</a>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Latest Workout Packages Box -->
                                <div class="bg-white rounded-xl shadow-sm p-4">
                                    <h3 class="font-bold text-gray-800 mb-3 text-sm flex items-center gap-2">
                                        <svg class="w-5 h-5 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                        </svg>
                                        Latest Workout Packages
                                    </h3>
                                    <div class="flex flex-col gap-3">
                                        <a href="workouts" class="group cursor-pointer block">
                                            <h4 class="text-sm font-semibold text-gray-900 group-hover:text-[#FF5500] transition-colors">
                                                30-Day Full Body Fat Loss</h4>
                                                <p class="text-xs text-gray-500">By Coach Dat &bull; $20.00</p>
                                            </a>
                                            <hr class="border-gray-100">
                                            <a href="workouts" class="group cursor-pointer block">
                                                <h4 class="text-sm font-semibold text-gray-900 group-hover:text-[#FF5500] transition-colors">
                                                    High-Intensity Hypertrophy</h4>
                                                    <p class="text-xs text-gray-500">By Coach Tuan &bull; $32.00</p>
                                                </a>
                                                <hr class="border-gray-100">
                                                <a href="workouts" class="group cursor-pointer block">
                                                    <h4 class="text-sm font-semibold text-gray-900 group-hover:text-[#FF5500] transition-colors">
                                                        Core & Functional Mobility</h4>
                                                        <p class="text-xs text-gray-500">By Coach Alex &bull; $25.00</p>
                                                    </a>
                                                </div>
                                                <a href="workouts"
                                                   class="block w-full mt-3 text-xs font-semibold text-[#FF5500] hover:underline text-center">
                                                    View All Packages
                                                </a>
                                            </div>

                                        </aside>
                                    </div>

                                     <!-- Create Post Modal Dialog -->
                                     <CreatePostModal IsVisible="@showCreatePostModal" InitialPostType="@createPostInitialType" IsCoach="@isCoach"
                                                      UserName="@userName" UserInitials="@userInitials" UserAvatarUrl="@currentUserAvatarUrl"
                                                      AvailableLocations="@availableLocations" OnClose="CloseCreatePostModal" OnPostCreated="OnPostCreated" />

                                    <!-- Edit Post Modal Dialog -->
                                    <EditPostModal IsVisible="@showEditPostModal" Post="@editingPost" IsCoach="@isCoach"
                                                   AvailableLocations="@availableLocations" OnClose="CloseEditPostModal"
                                                   OnPostUpdated="OnPostUpdated" />

                                    <!-- Delete Confirmation Modal Dialog -->
                                    <DeletePostModal IsVisible="@showDeleteModal" Post="@postToDelete" OnClose="CloseDeleteModal"
                                                     OnPostDeleted="OnPostDeleted" />

                                    <!-- Report Post Modal Dialog -->
                                    <ReportPostModal IsVisible="@showReportModal" PostId="@reportPostId" OnClose="CloseReportModal"
                                                     OnReportSubmitted="OnPostReported" />
                                </div>

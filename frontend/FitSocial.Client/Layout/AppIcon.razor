@* Icon SVG nội bộ (thay cho bootstrap-icons / emoji để luôn căn giữa, không phụ thuộc CDN) *@
<svg class="app-icon @Class" viewBox="0 0 16 16" fill="none" stroke="currentColor"
     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "person":
            <circle cx="8" cy="5" r="2.5" />
            <path d="M2.5 14c.8-2.8 2.9-4 5.5-4s4.7 1.2 5.5 4" />
            break;
        case "envelope":
            <rect x="1.5" y="3.5" width="13" height="9" rx="1.5" />
            <path d="M2.5 5.2 8 9l5.5-3.8" />
            break;
        case "lock":
            <rect x="3.5" y="7" width="9" height="6.5" rx="1.5" />
            <path d="M5.5 7V5.5a2.5 2.5 0 0 1 5 0V7" />
            break;
        case "eye":
            <path d="M1.5 8S4 4.5 8 4.5 14.5 8 14.5 8 12 11.5 8 11.5 1.5 8 1.5 8Z" />
            <circle cx="8" cy="8" r="2" />
            break;
        case "eye-slash":
            <path d="M1.5 8S4 4.5 8 4.5c1.4 0 2.7.5 3.7 1.2M14.5 8S12 11.5 8 11.5c-1.4 0-2.7-.5-3.7-1.2" />
            <path d="M2.5 2.5l11 11" />
            break;
        case "briefcase":
            <rect x="2" y="6" width="12" height="7" rx="1.5" />
            <path d="M6 6V4.5A1.5 1.5 0 0 1 7.5 3h1A1.5 1.5 0 0 1 10 4.5V6" />
            <path d="M2 9.5h12" />
            break;
        case "dumbbell":
            <path d="M3.5 5.5v5M5.8 3.8v8.4M10.2 3.8v8.4M12.5 5.5v5M5.8 8h4.4" />
            break;
        case "fire":
            <path d="M8 1.8s3.8 3.3 3.8 6.7a3.8 3.8 0 0 1-7.6 0c0-1.4.8-2.6 1.6-3.5.2 1 .9 1.6 1.2 1.9.5-1.8 1-3.4 1-5.1Z" />
            break;
        case "trophy":
            <path d="M5.5 2.5h5V6a2.5 2.5 0 0 1-5 0Z" />
            <path d="M5.5 3.5H3v1a2.5 2.5 0 0 0 2.6 2.5M10.5 3.5H13v1a2.5 2.5 0 0 1-2.6 2.5" />
            <path d="M8 8.5v2M6 13.5h4M5.5 11.5h5" />
            break;
        case "activity":
            <path d="M1.5 8h3l1.5-4 3 8 1.5-4h4" />
            break;
        case "ball":
            <circle cx="8" cy="8" r="6" />
            <path d="M8 2v12M2.5 5.5l11 5M13.5 5.5l-11 5" />
            break;
        case "waves":
            <path d="M1.5 6c1.6-1.6 3.2-1.6 4.8 0s3.2 1.6 4.8 0 3-1.6 3.4-1" />
            <path d="M1.5 10.5c1.6-1.6 3.2-1.6 4.8 0s3.2 1.6 4.8 0 3-1.6 3.4-1" />
            break;
        case "shield":
            <path d="M8 1.5 13 3.5v4c0 3.5-2.5 5.7-5 7-2.5-1.3-5-3.5-5-7v-4Z" />
            <path d="m6 8 1.5 1.5L10.5 6.5" />
            break;
        case "refresh":
            <path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9" />
            <path d="M13.5 1.8v3h-3" />
            break;
        case "warning":
            <path d="M8 2 14.8 13.5H1.2Z" />
            <path d="M8 6.2v3.3" />
            <path d="M8 11.7h.01" />
            break;
        case "info":
            <circle cx="8" cy="8" r="6.3" />
            <path d="M8 7.3v3.5" />
            <path d="M8 5h.01" />
            break;
        case "check":
            <circle cx="8" cy="8" r="6.3" />
            <path d="m5.4 8.3 1.9 1.9 3.3-3.9" />
            break;
        case "google":
            <g stroke="none" transform="scale(0.3333)">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
            </g>
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
}

    private async Task<bool> CheckEmailAvailabilityAsync(bool showPopupOnConflict = true)
    {
        var email = newStaffModel.Email?.Trim();
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@') || !email.Contains('.'))
        {
            isEmailAvailable = null;
            return false;
        }

        isCheckingEmail = true;
        try
        {
            var res = await UserService.CheckEmailExistsAsync(email);
            if (res.Success)
            {
                var isAlreadyUsed = res.Data;
                isEmailAvailable = !isAlreadyUsed;

                if (isAlreadyUsed)
                {
                    conflictEmail = email;
                    if (showPopupOnConflict)
                    {
                        showEmailExistsModal = true;
                    }
                    return false;
                }

                return true;
            }
            else
            {
                isEmailAvailable = null;
                return true;
            }
        }
        catch
        {
            isEmailAvailable = null;
            return true;
        }
        finally
        {
            isCheckingEmail = false;
            StateHasChanged();
        }
    }

    private async Task HandleCreateStaffAsync()
    {
        createErrorMessage = null;

        if (string.IsNullOrWhiteSpace(newStaffModel.FullName) || newStaffModel.FullName.Trim().Length < 2)
        {
            nameHasError = true;
            nameErrorMessage = "Please enter a valid full name (at least 2 characters).";
            createErrorMessage = nameErrorMessage;
            return;
        }

        if (newStaffModel.FullName.Any(char.IsDigit))
        {
            nameHasError = true;
            nameErrorMessage = "Full name cannot contain numbers.";
            createErrorMessage = nameErrorMessage;
            return;
        }

        if (string.IsNullOrWhiteSpace(newStaffModel.Email))
        {
            createErrorMessage = "Email address is required.";
            return;
        }

        if (!newStaffModel.Email.Contains('@') || !newStaffModel.Email.Contains('.'))
        {
            createErrorMessage = "Please enter a valid email address.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(newStaffModel.PhoneNumber))
        {
            var phone = newStaffModel.PhoneNumber.Trim();
            if (phone.Any(char.IsLetter))
            {
                phoneHasError = true;
                phoneErrorMessage = "Phone number cannot contain letters.";
                createErrorMessage = phoneErrorMessage;
                return;
            }

            if (!System.Text.RegularExpressions.Regex.IsMatch(phone, @"^0\d{9}$"))
            {
                phoneHasError = true;
                phoneErrorMessage = "Phone number must be a valid 10-digit number starting with 0 (e.g. 0901234567).";
                createErrorMessage = phoneErrorMessage;
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(newStaffModel.Password) || newStaffModel.Password.Length < 6)
        {
            createErrorMessage = "Password must be at least 6 characters long.";
            return;
        }

        if (newStaffModel.Password != newStaffModel.ConfirmPassword)
        {
            createErrorMessage = "Passwords do not match.";
            return;
        }

        // Check email availability before creating
        var emailAvailable = await CheckEmailAvailabilityAsync(showPopupOnConflict: true);
        if (!emailAvailable && isEmailAvailable == false)
        {
            return;
        }

        isSubmitting = true;
        try
        {
            var res = await UserService.CreateStaffAccountAsync(newStaffModel);
            if (res.Success)
            {
                showCreateStaffModal = false;
                newStaffModel = new();
                isEmailAvailable = null;
                toastMessage = res.Message ?? "Staff account created successfully!";
                staffCurrentPage = 1;
                await LoadStaffAsync();
            }
            else
            {
                if (res.Message != null && (
                    res.Message.Contains("already registered", StringComparison.OrdinalIgnoreCase) ||
                    res.Message.Contains("already in use", StringComparison.OrdinalIgnoreCase) ||
                    res.Message.Contains("Email is already", StringComparison.OrdinalIgnoreCase)))
                {
                    isEmailAvailable = false;
                    conflictEmail = newStaffModel.Email;
                    showEmailExistsModal = true;
                }
                else
                {
                    createErrorMessage = res.Message ?? "Failed to create staff account.";
                }
            }
        }
        catch (Exception ex)
        {
            createErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }


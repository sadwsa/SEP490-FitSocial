@namespace FitSocial.Client.Layout
@inject ICoachService CoachService
@inject ITrainingPackageService TrainingPackageService

@* Nội dung mặc định của cột phải, hiển thị trên MỌI trang
   (trừ khi page tự khai báo RightSidebar riêng qua AppShellContext).
   Tất cả widget nằm chung trong MỘT khung trắng liền mạch. *@

<div class="app-shell-card bg-white rounded-2xl shadow-sm border border-gray-100 p-4 flex flex-col gap-5">

    @* ---------------- Top 5 Coaches ---------------- *@
    @* Không đặt icon trước tiêu đề: khi phóng to (zoom trình duyệt) icon + chữ bị vỡ hàng. *@
    <div>
        <h3 class="font-bold text-gray-800 mb-3 text-[11px] uppercase tracking-wide">
            Top 5 Coaches
        </h3>

        @if (isLoadingCoaches)
        {
            <div class="flex flex-col gap-2.5">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="flex items-center justify-between bg-gray-50 rounded-xl px-3 py-2.5 animate-pulse">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-full bg-gray-200"></div>
                            <div class="space-y-1">
                                <div class="h-3 bg-gray-200 rounded w-20"></div>
                                <div class="h-2.5 bg-gray-200 rounded w-12"></div>
                            </div>
                        </div>
                        <div class="h-6 w-12 bg-gray-200 rounded-lg"></div>
                    </div>
                }
            </div>
        }
        else if (topCoaches.Count == 0)
        {
            <p class="text-xs text-gray-400 py-2 text-center">No coaches found</p>
        }
        else
        {
            <div class="flex flex-col gap-2.5">
                @foreach (var coach in topCoaches)
                {
                    <div class="flex items-center justify-between gap-2 bg-gray-50 rounded-xl px-3 py-2.5 hover:bg-orange-50/60 transition">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <a href="/profile/@coach.CoachId"
                               class="w-8 h-8 rounded-full flex-shrink-0 relative overflow-hidden shadow-xs border border-gray-100 block hover:opacity-90 transition">
                                @if (AvatarHelper.HasValidAvatarUrl(coach.AvatarUrl))
                                {
                                    <img src="@coach.AvatarUrl" alt="@coach.FullName"
                                         class="w-full h-full object-cover"
                                         referrerpolicy="no-referrer" loading="lazy"
                                         onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                    <div class="w-full h-full rounded-full bg-gradient-to-r from-orange-400 to-amber-500 text-white items-center justify-center font-bold text-xs"
                                         style="display: none;">
                                        @AvatarHelper.GetInitial(coach.FullName)
                                    </div>
                                }
                                else
                                {
                                    <div class="w-full h-full rounded-full bg-gradient-to-r from-orange-400 to-amber-500 flex items-center justify-center text-white font-bold text-xs">
                                        @AvatarHelper.GetInitial(coach.FullName)
                                    </div>
                                }
                            </a>
                            <div class="min-w-0 flex-1">
                                <a href="/profile/@coach.CoachId"
                                   class="text-sm font-semibold text-gray-900 truncate block hover:text-[#FF5500] transition"
                                   title="@coach.FullName">@coach.FullName</a>
                                <div class="flex items-center gap-1 text-xs text-[#FF8C00]">
                                    <AppIcon Name="star" Size="13" Filled Class="flex-shrink-0" />
                                    <span class="font-medium">@(coach.Rating > 0 ? coach.Rating.ToString("0.0") : "5.0")</span>
                                    @if (coach.TotalReviews > 0)
                                    {
                                        <span class="text-gray-400 text-[10px]">(@coach.TotalReviews)</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <a href="/profile/@coach.CoachId"
                           class="text-[10px] uppercase font-bold text-[#FF5500] hover:bg-white px-2.5 py-1.5 rounded-lg border border-transparent hover:border-orange-200 transition flex-shrink-0">View</a>
                    </div>
                }
            </div>
        }
    </div>

    @* ---------------- Latest Workout Packages ---------------- *@
    <div>
        <h3 class="font-bold text-gray-800 mb-3 text-[11px] uppercase tracking-wide">
            Latest Workout Packages
        </h3>

        @if (isLoadingPackages)
        {
            <div class="flex flex-col gap-2.5">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="space-y-1.5 bg-gray-50 rounded-xl px-3 py-2.5 animate-pulse">
                        <div class="h-3.5 bg-gray-200 rounded w-3/4"></div>
                        <div class="h-2.5 bg-gray-200 rounded w-1/2"></div>
                    </div>
                }
            </div>
        }
        else if (latestPackages.Count == 0)
        {
            <p class="text-xs text-gray-400 py-2 text-center">No packages available yet</p>
        }
        else
        {
            <div class="flex flex-col gap-2.5">
                @foreach (var package in latestPackages)
                {
                    <a href="/training-packages/@package.PackageId"
                       class="group cursor-pointer block bg-gray-50 hover:bg-orange-50/60 rounded-xl px-3 py-2.5 transition">
                        <h4 class="text-xs font-bold text-gray-900 uppercase group-hover:text-[#FF5500] transition-colors">
                            @(string.IsNullOrWhiteSpace(package.Title) ? "Workout Package" : package.Title)
                        </h4>
                        <p class="text-xs text-gray-500 mt-0.5">
                            @(string.IsNullOrWhiteSpace(package.CoachName) ? "FitConnect Coach" : $"By Coach {package.CoachName}")
                            &bull; <span class="font-semibold text-[#FF5500]">@package.Price.ToString("N2")</span>
                        </p>
                    </a>
                }
            </div>

            <a href="/packages"
               class="block w-full mt-3 text-[11px] uppercase font-bold text-[#FF5500] bg-gray-50 hover:bg-orange-50 rounded-xl py-2.5 text-center transition">
                View All Packages
            </a>
        }
    </div>
</div>

@code {
    private const int MaxLatestPackages = 3;

    private List<TopCoachDto> topCoaches = new();
    private bool isLoadingCoaches = true;
    private List<TrainingPackageResponseDto> latestPackages = new();
    private bool isLoadingPackages = true;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadTopCoachesAsync(), LoadLatestPackagesAsync());
    }

    private async Task LoadTopCoachesAsync()
    {
        try
        {
            var response = await CoachService.GetTopCoachesAsync(5);
            if (response.Success && response.Data != null)
            {
                topCoaches = response.Data.Take(5).ToList();
            }
        }
        catch { }
        finally
        {
            isLoadingCoaches = false;
        }
    }

    private async Task LoadLatestPackagesAsync()
    {
        try
        {
            var response = await TrainingPackageService.GetAllPackagesAsync();
            if (response.Success && response.Data != null)
            {
                latestPackages = response.Data
                    .Where(p => p.IsActive)
                    .OrderByDescending(p => p.CreatedAt)
                    .Take(MaxLatestPackages)
                    .ToList();
            }
        }
        catch { }
        finally
        {
            isLoadingPackages = false;
        }
    }
}
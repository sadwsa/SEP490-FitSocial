@namespace FitSocial.Client.Components.Posts
@using FitSocial.Client.Models.Posts
@using FitSocial.Client.Models.Common

<div class="comment-item-node relative text-xs @GetIndentClass()" @key="Comment.Id">
    <!-- Comment Main Row -->
    <div class="flex gap-2.5 items-start group">
        <!-- Author Avatar -->
        <button type="button" @onclick="HandleAuthorClick"
                class="@GetAvatarSizeClass() rounded-full flex-shrink-0 mt-0.5 cursor-pointer p-0 bg-transparent border-0 hover:opacity-90 transition-opacity focus:outline-none focus:ring-2 focus:ring-[#FF5500]"
                title="@(Comment.AuthorName)">
            @if (HasValidAvatarUrl(Comment.AuthorAvatarUrl))
            {
                <img src="@Comment.AuthorAvatarUrl" alt=""
                     class="@GetAvatarSizeClass() rounded-full object-cover border border-gray-100 flex-shrink-0"
                     referrerpolicy="no-referrer" loading="lazy"
                     onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                <div class="@GetAvatarSizeClass() rounded-full bg-gradient-to-r from-orange-400 to-amber-500 items-center justify-center text-white font-bold @GetAvatarTextSizeClass() flex-shrink-0 select-none shadow-xs"
                     style="display: none;">
                    @GetAuthorInitial(Comment.AuthorName)
                </div>
            }
            else
            {
                <div class="@GetAvatarSizeClass() rounded-full bg-gradient-to-r from-orange-400 to-amber-500 flex items-center justify-center text-white font-bold @GetAvatarTextSizeClass() flex-shrink-0 select-none shadow-xs">
                    @GetAuthorInitial(Comment.AuthorName)
                </div>
            }
        </button>

        <!-- Comment Content Body -->
        <div class="flex-1 min-w-0">
            <div class="@GetBubbleClass()">
                <div class="flex items-center gap-1.5 flex-wrap">
                    <button type="button" @onclick="HandleAuthorClick"
                            class="font-semibold text-gray-900 text-xs hover:text-[#FF5500] hover:underline p-0 bg-transparent border-0 cursor-pointer inline text-left">
                        @Comment.AuthorName
                    </button>
                </div>

                <p class="text-xs text-gray-800 break-words whitespace-pre-wrap mt-0.5 leading-relaxed">
                    @if (!string.IsNullOrWhiteSpace(Comment.ReplyToAuthorName) && Depth > 0)
                    {
                        <span class="inline-flex items-center font-semibold text-[#FF5500] bg-orange-50/90 hover:bg-orange-100/90 px-1.5 py-0.5 rounded text-[11px] mr-1 select-none transition-colors">
                            @@@Comment.ReplyToAuthorName
                        </span>
                    }
                    @Comment.Content
                </p>
            </div>

            <!-- Action Bar: Time, Reply, Toggle Replies -->
            <div class="flex items-center gap-3 text-[11px] text-gray-400 font-medium mt-1 ml-2 flex-wrap">
                <span>@GetTimeAgo(Comment.CreatedAt)</span>

                @if (CurrentUserId.HasValue && CurrentUserId.Value != Guid.Empty)
                {
                    <button type="button" @onclick="HandleReplyClick"
                            class="font-semibold text-gray-500 hover:text-[#FF5500] hover:underline transition cursor-pointer p-0 bg-transparent border-0">
                        Reply
                    </button>
                }

                @if (Comment.Replies.Count > 0)
                {
                    <button type="button" @onclick="HandleToggleCollapse"
                            class="font-medium text-[#FF5500] hover:underline flex items-center gap-1 cursor-pointer p-0 bg-transparent border-0">
                        @if (CollapsedCommentIds.Contains(Comment.Id))
                        {
                            <svg class="w-3 h-3 rotate-[-90deg] transition-transform text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                            <span>View @Comment.Replies.Count @(Comment.Replies.Count == 1 ? "reply" : "replies")</span>
                        }
                        else
                        {
                            <svg class="w-3 h-3 transition-transform text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                            <span>Hide @(Comment.Replies.Count == 1 ? "reply" : "replies")</span>
                        }
                    </button>
                }
            </div>

            <!-- Inline Reply Input Box (Appears directly below the comment being replied to) -->
            @if (ActiveReplyTargetId == Comment.Id)
            {
                <div class="mt-2.5 bg-orange-50/40 border border-orange-200/80 rounded-2xl p-2.5 shadow-xs animate-in fade-in duration-150">
                    <div class="flex items-center justify-between text-[11px] text-gray-500 font-medium mb-1.5 px-1">
                        <span class="flex items-center gap-1">
                            <svg class="w-3 h-3 text-[#FF5500]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
                            </svg>
                            <span>Replying to <strong class="text-gray-800">@@@Comment.AuthorName</strong></span>
                        </span>
                        <button type="button" @onclick="HandleCancelReply"
                                class="text-gray-400 hover:text-gray-600 transition cursor-pointer p-0.5 rounded">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>

                    <div class="flex gap-2 items-start">
                        <div class="w-6 h-6 rounded-full flex-shrink-0 relative mt-0.5">
                            @if (HasValidAvatarUrl(CurrentUserAvatarUrl))
                            {
                                <img src="@CurrentUserAvatarUrl" alt=""
                                     class="w-6 h-6 rounded-full object-cover border border-gray-100 flex-shrink-0"
                                     referrerpolicy="no-referrer" loading="lazy"
                                     onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                <div class="w-6 h-6 rounded-full bg-gradient-to-r from-orange-400 to-amber-500 items-center justify-center text-white font-bold text-[10px] flex-shrink-0 select-none shadow-xs"
                                     style="display: none;">
                                    @GetAuthorInitial(CurrentUserName)
                                </div>
                            }
                            else
                            {
                                <div class="w-6 h-6 rounded-full bg-gradient-to-r from-orange-400 to-amber-500 flex items-center justify-center text-white font-bold text-[10px] flex-shrink-0 select-none shadow-xs">
                                    @GetAuthorInitial(CurrentUserName)
                                </div>
                            }
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="relative flex items-center">
                                <input type="text"
                                       value="@ReplyText"
                                       @oninput="HandleInput"
                                       @onkeydown="HandleKeyDown"
                                       placeholder="@($"Reply to {Comment.AuthorName}...")"
                                       disabled="@IsSubmittingReply"
                                       maxlength="500"
                                       class="w-full text-xs bg-white border border-gray-200 rounded-full py-1.5 pl-3 pr-20 text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#FF5500] focus:border-[#FF5500] transition disabled:opacity-60" />

                                <div class="absolute right-1 flex items-center gap-1">
                                    <button type="button"
                                            @onclick="HandleCancelReply"
                                            class="px-1.5 py-0.5 text-[10px] text-gray-400 hover:text-gray-600 rounded cursor-pointer">
                                        Cancel
                                    </button>
                                    <button type="button"
                                            @onclick="HandleSubmit"
                                            disabled="@(IsSubmittingReply || string.IsNullOrWhiteSpace(ReplyText))"
                                            class="px-2.5 py-0.5 text-[11px] font-semibold bg-[#FF5500] hover:bg-[#e04b00] text-white rounded-full disabled:opacity-40 transition cursor-pointer flex items-center gap-1">
                                        @if (IsSubmittingReply)
                                        {
                                            <span class="w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin inline-block"></span>
                                        }
                                        else
                                        {
                                            <span>Reply</span>
                                        }
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(ReplyErrorMessage))
                            {
                                <p class="text-[11px] text-red-600 mt-1 pl-1">@ReplyErrorMessage</p>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Nested Child Replies (Recursive) -->
            @if (Comment.Replies.Count > 0 && !CollapsedCommentIds.Contains(Comment.Id))
            {
                <div class="space-y-2.5 mt-2.5">
                    @foreach (var child in Comment.Replies)
                    {
                        <CommentItem @key="child.Id"
                                     Comment="child"
                                     Depth="Depth + 1"
                                     CurrentUserId="CurrentUserId"
                                     CurrentUserName="CurrentUserName"
                                     CurrentUserAvatarUrl="CurrentUserAvatarUrl"
                                     ActiveReplyTargetId="ActiveReplyTargetId"
                                     ReplyText="@ReplyText"
                                     IsSubmittingReply="IsSubmittingReply"
                                     ReplyErrorMessage="@ReplyErrorMessage"
                                     CollapsedCommentIds="CollapsedCommentIds"
                                     OnStartReply="OnStartReply"
                                     OnCancelReply="OnCancelReply"
                                     OnReplyTextChanged="OnReplyTextChanged"
                                     OnSubmitReply="OnSubmitReply"
                                     OnToggleCollapse="OnToggleCollapse"
                                     OnNavigateToAuthor="OnNavigateToAuthor" />
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CommentDto Comment { get; set; } = default!;

    [Parameter]
    public int Depth { get; set; } = 0;

    [Parameter]
    public Guid? CurrentUserId { get; set; }

    [Parameter]
    public string? CurrentUserName { get; set; }

    [Parameter]
    public string? CurrentUserAvatarUrl { get; set; }

    [Parameter]
    public Guid? ActiveReplyTargetId { get; set; }

    [Parameter]
    public string ReplyText { get; set; } = string.Empty;

    [Parameter]
    public bool IsSubmittingReply { get; set; }

    [Parameter]
    public string? ReplyErrorMessage { get; set; }

    [Parameter]
    public HashSet<Guid> CollapsedCommentIds { get; set; } = new();

    [Parameter]
    public EventCallback<CommentDto> OnStartReply { get; set; }

    [Parameter]
    public EventCallback OnCancelReply { get; set; }

    [Parameter]
    public EventCallback<string> OnReplyTextChanged { get; set; }

    [Parameter]
    public EventCallback<CommentDto> OnSubmitReply { get; set; }

    [Parameter]
    public EventCallback<Guid> OnToggleCollapse { get; set; }

    [Parameter]
    public EventCallback<Guid> OnNavigateToAuthor { get; set; }

    private async Task HandleAuthorClick()
    {
        if (Comment.AuthorId != Guid.Empty && OnNavigateToAuthor.HasDelegate)
        {
            await OnNavigateToAuthor.InvokeAsync(Comment.AuthorId);
        }
    }

    private async Task HandleReplyClick()
    {
        if (OnStartReply.HasDelegate)
        {
            await OnStartReply.InvokeAsync(Comment);
        }
    }

    private async Task HandleCancelReply()
    {
        if (OnCancelReply.HasDelegate)
        {
            await OnCancelReply.InvokeAsync();
        }
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        if (OnReplyTextChanged.HasDelegate)
        {
            await OnReplyTextChanged.InvokeAsync(text);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await HandleSubmit();
        }
    }

    private async Task HandleSubmit()
    {
        if (OnSubmitReply.HasDelegate && !IsSubmittingReply && !string.IsNullOrWhiteSpace(ReplyText))
        {
            await OnSubmitReply.InvokeAsync(Comment);
        }
    }

    private async Task HandleToggleCollapse()
    {
        if (OnToggleCollapse.HasDelegate)
        {
            await OnToggleCollapse.InvokeAsync(Comment.Id);
        }
    }

    private string GetIndentClass()
    {
        if (Depth == 0) return string.Empty;

        // Progressive responsive indentation:
        // Indent levels 1 and 2 normally with visible vertical thread line.
        // Cap the indentation at depth >= 3 so mobile screens do not get compressed.
        return Depth switch
        {
            1 => "ml-2 sm:ml-3 pl-2.5 sm:pl-3 border-l-2 border-orange-100 hover:border-orange-200 transition-colors",
            2 => "ml-2 sm:ml-2.5 pl-2 sm:pl-2.5 border-l-2 border-orange-100 hover:border-orange-200 transition-colors",
            _ => "ml-1.5 pl-2 border-l-2 border-orange-100/70 hover:border-orange-200 transition-colors"
        };
    }

    private string GetAvatarSizeClass()
    {
        return Depth == 0 ? "w-8 h-8" : "w-6 h-6";
    }

    private string GetAvatarTextSizeClass()
    {
        return Depth == 0 ? "text-xs" : "text-[10px]";
    }

    private string GetBubbleClass()
    {
        return Depth == 0
            ? "bg-gray-50 border border-gray-100 rounded-2xl px-3.5 py-2 inline-block max-w-full"
            : "bg-gray-50/90 border border-gray-100/90 rounded-2xl px-3 py-1.5 inline-block max-w-full";
    }

    private static string GetTimeAgo(DateTime? date)
    {
        if (!date.HasValue) return "Just now";

        var timeSpan = DateTime.UtcNow - date.Value;
        if (timeSpan.TotalMinutes < 1) return "Just now";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays}d ago";

        return date.Value.ToLocalTime().ToString("MMM dd, yyyy");
    }

    private static string GetAuthorInitial(string? name) => AvatarHelper.GetInitial(name);
    private static bool HasValidAvatarUrl(string? url) => AvatarHelper.HasValidAvatarUrl(url);
}

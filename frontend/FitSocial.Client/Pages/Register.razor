@page "/register"
@layout AuthLayout
@using System.Timers
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Tham gia cộng đồng FitSocial</PageTitle>

<div class="reg-hero">
    <img src="Logo_FitSocial.jpg" alt="FitSocial" class="hero-logo" />
    <div class="hero-text">
        <h1 class="hero-title">Tham Gia Cộng Đồng <span>FitSocial</span></h1>
        <p class="hero-sub">Kích hoạt tiềm năng thể chất vô hạn, đồng bộ quá trình tập luyện thông minh và kết nối cùng hàng ngàn vận động viên, huấn luyện viên hàng đầu.</p>
    </div>
</div>

<div class="reg-card">
    <!-- Chọn vai trò -->
    <div class="role-tabs">
        <button type="button" class="role-tab @(selectedRole == "TRAINEE" ? "active" : "")" @onclick='() => SelectRole("TRAINEE")'>
            <span class="role-icon"><AppIcon Name="person" /></span>
            <span>Trainee</span>
        </button>
        <button type="button" class="role-tab @(selectedRole == "COACH" ? "active" : "")" @onclick='() => SelectRole("COACH")'>
            <span class="role-icon"><AppIcon Name="briefcase" /></span>
            <span>Coach</span>
        </button>
    </div>

    <!-- Google -->
    <button type="button" class="btn-google" @onclick="HandleGoogleRegister">
        <AppIcon Name="google" /> Đăng ký nhanh bằng Google
    </button>

    <div class="divider"><span>HOẶC ĐĂNG KÝ BẰNG EMAIL</span></div>

    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <div class="auth-alert info" role="alert"><AppIcon Name="info" /><span>@infoMessage</span></div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="auth-alert error" role="alert"><AppIcon Name="warning" /><span>@errorMessage</span></div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="auth-alert success" role="alert"><AppIcon Name="check" /><span>@successMessage</span></div>
    }

    <EditForm EditContext="@editContext" OnSubmit="HandleCompleteRegister">
        <DataAnnotationsValidator />

        <div class="field">
            <label>Họ và tên <span class="req">*</span></label>
            <div class="input-wrap">
                <span class="input-icon"><AppIcon Name="person" /></span>
                <InputText @bind-Value="registerModel.FullName" class="form-control has-icon" placeholder="Ví dụ: Hoàng Minh Long" />
            </div>
            <ValidationMessage For="@(() => registerModel.FullName)" class="field-error" />
        </div>

        <div class="field">
            <label>Địa chỉ Email <span class="req">*</span></label>
            <div class="input-wrap">
                <span class="input-icon"><AppIcon Name="envelope" /></span>
                <InputText @bind-Value="registerModel.Email" class="form-control has-icon" placeholder="athlete@fitsocial.vn" />
            </div>
            <ValidationMessage For="@(() => registerModel.Email)" class="field-error" />
        </div>

        <div class="field">
            <label>Mật khẩu bảo mật <span class="req">*</span></label>
            <div class="input-wrap">
                <span class="input-icon"><AppIcon Name="lock" /></span>
                <InputText type="@(showPassword ? "text" : "password")" @bind-Value="registerModel.Password" class="form-control has-icon has-eye" placeholder="Tối thiểu 8 ký tự" />
                <button type="button" class="eye-btn" @onclick="() => showPassword = !showPassword" title="Hiện/ẩn mật khẩu">
                    <AppIcon Name="@(showPassword ? "eye-slash" : "eye")" />
                </button>
            </div>
            <ValidationMessage For="@(() => registerModel.Password)" class="field-error" />
        </div>

        <div class="field">
            <label>Xác nhận mật khẩu <span class="req">*</span></label>
            <div class="input-wrap">
                <span class="input-icon"><AppIcon Name="lock" /></span>
                <InputText type="@(showConfirmPassword ? "text" : "password")" @bind-Value="registerModel.ConfirmPassword" class="form-control has-icon has-eye" placeholder="Nhập lại mật khẩu" />
                <button type="button" class="eye-btn" @onclick="() => showConfirmPassword = !showConfirmPassword" title="Hiện/ẩn mật khẩu">
                    <AppIcon Name="@(showConfirmPassword ? "eye-slash" : "eye")" />
                </button>
            </div>
            <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="field-error" />
        </div>

        <!-- Mục tiêu thể thao (lựa chọn hiển thị, không gửi lên API) -->
        <div class="field">
            <label>Mục tiêu thể thao chính</label>
            <div class="goal-grid">
                @foreach (var g in goals)
                {
                    <button type="button" class="goal-card @(selectedGoal == g.Value ? "active" : "")" @onclick="() => selectedGoal = g.Value">
                        <span class="goal-icon"><AppIcon Name="@g.Icon" /></span>
                        <span class="goal-label">@g.Label</span>
                    </button>
                }
            </div>
        </div>

        <!-- OTP -->
        <div class="otp-panel">
            <div class="otp-head">
                <span class="otp-icon"><AppIcon Name="envelope" /></span>
                <div>
                    <strong>Xác thực mã OTP bảo mật</strong>
                    <p>Mã xác thực OTP (6 chữ số) sẽ được gửi đến email của bạn để kích hoạt tài khoản ngay sau khi xác nhận.</p>
                </div>
            </div>

            <div class="otp-boxes">
                @for (int i = 0; i < 6; i++)
                {
                    int idx = i;
                    <input maxlength="1"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           class="otp-box"
                           value="@otpDigits[idx]"
                           @oninput="(e) => OnOtpInput(e, idx)"
                           @onkeydown="(e) => OnOtpKeyDown(e, idx)"
                           @ref="otpRefs[idx]" />
                }
            </div>
            @if (showOtpError && CombinedOtp.Length != 6)
            {
                <div class="field-error text-center">Vui lòng nhập đầy đủ mã OTP 6 chữ số.</div>
            }
            <div class="otp-foot">
                <span class="resend-hint">Chưa nhận được mã?</span>
                @if (!otpSent)
                {
                    <button type="button" class="resend-link" @onclick="HandleSendOtp" disabled="@isSendingOtp">
                        <AppIcon Name="refresh" /> Gửi mã OTP@(isSendingOtp ? "..." : "")
                    </button>
                }
                else if (countdown > 0)
                {
                    <span class="resend-wait"><AppIcon Name="refresh" /> Gửi lại mã OTP (@(countdown)s)</span>
                }
                else
                {
                    <button type="button" class="resend-link" @onclick="HandleSendOtp" disabled="@isSendingOtp">
                        <AppIcon Name="refresh" /> Gửi lại mã OTP@(isSendingOtp ? "..." : "")
                    </button>
                }
            </div>
        </div>

        <!-- Điều khoản -->
        <label class="terms">
            <input type="checkbox" @bind="agreedTerms" />
            <span>Tôi đồng ý với <a href="" @onclick:preventDefault>Điều khoản dịch vụ</a> và <a href="" @onclick:preventDefault>Chính sách bảo mật</a> của nền tảng thể thao FitSocial.</span>
        </label>
        @if (showTermsError && !agreedTerms)
        {
            <div class="field-error">Vui lòng đồng ý với điều khoản dịch vụ để tiếp tục.</div>
        }

        <button type="submit" class="btn-auth-primary" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Đang tạo tài khoản...</span>
            }
            else
            {
                <span>Tạo Tài Khoản Học Viên Ngay →</span>
            }
        </button>
    </EditForm>
</div>

<div class="reg-footer">
    Đã có tài khoản? <a href="login">Đăng nhập ngay</a>
</div>

@code {
    private RegisterRequest registerModel = new();
    private EditContext editContext = default!;

    private string selectedRole = "TRAINEE";
    private string selectedGoal = "TANG_CO";
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private bool agreedTerms = false;
    private bool showTermsError = false;
    private bool showOtpError = false;

    private string? infoMessage;
    private string? errorMessage;
    private string? successMessage;

    private bool otpSent = false;
    private bool isSendingOtp = false;
    private bool isLoading = false;
    private string[] otpDigits = new string[6] { "", "", "", "", "", "" };
    private ElementReference[] otpRefs = new ElementReference[6];

    private int countdown = 60;
    private Timer? timer;

    private record GoalOption(string Value, string Label, string Icon);
    private readonly List<GoalOption> goals = new()
    {
        new("TANG_CO", "Tăng Cơ", "dumbbell"),
        new("GIAM_MO", "Giảm Mỡ", "fire"),
        new("POWER", "Powerlifting", "trophy"),
        new("THE_LUC", "Thể Lực", "activity"),
    };

    private string CombinedOtp => string.Concat(otpDigits);

    protected override void OnInitialized()
    {
        editContext = new EditContext(registerModel);
    }

    private void SelectRole(string role)
    {
        if (role == "COACH")
        {
            infoMessage = "Hiện chỉ hỗ trợ đăng ký tài khoản Học viên (Trainee).";
            return;
        }
        selectedRole = role;
        infoMessage = null;
    }

    private void HandleGoogleRegister()
    {
        infoMessage = "Đăng ký bằng Google hiện chưa được hỗ trợ. Vui lòng đăng ký bằng email.";
    }

    private async Task HandleSendOtp()
    {
        errorMessage = null;
        successMessage = null;
        infoMessage = null;

        if (string.IsNullOrWhiteSpace(registerModel.Email) || !registerModel.Email.Contains("@"))
        {
            errorMessage = "Vui lòng nhập địa chỉ email hợp lệ trước khi yêu cầu mã OTP.";
            return;
        }

        isSendingOtp = true;
        var result = await AuthService.SendOtpAsync(new SendOtpRequest
        {
            Email = registerModel.Email.Trim(),
            Purpose = "REGISTER_TRAINEE"
        });

        if (result.Success)
        {
            otpSent = true;
            Array.Clear(otpDigits, 0, otpDigits.Length);
            StartCountdown();
            successMessage = "Mã OTP đã được gửi đến email của bạn (hiệu lực 5 phút).";
            if (otpRefs[0].Context != null)
            {
                await otpRefs[0].FocusAsync();
            }
        }
        else
        {
            errorMessage = result.Message ?? "Gửi mã OTP thất bại. Vui lòng thử lại.";
        }

        isSendingOtp = false;
    }

    private async Task OnOtpInput(ChangeEventArgs e, int idx)
    {
        var raw = e.Value?.ToString() ?? "";
        var digits = new string(raw.Where(char.IsDigit).ToArray());
        otpDigits[idx] = digits.Length > 0 ? digits[^1].ToString() : "";
        if (!string.IsNullOrEmpty(otpDigits[idx]) && idx < 5)
        {
            await otpRefs[idx + 1].FocusAsync();
        }
    }

    private async Task OnOtpKeyDown(KeyboardEventArgs e, int idx)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(otpDigits[idx]) && idx > 0)
        {
            await otpRefs[idx - 1].FocusAsync();
        }
    }

    private async Task HandleCompleteRegister()
    {
        errorMessage = null;
        successMessage = null;
        showTermsError = true;
        showOtpError = true;

        registerModel.OtpCode = CombinedOtp;
        bool formValid = editContext.Validate();
        bool otpOk = otpSent && CombinedOtp.Length == 6;

        if (!otpSent)
        {
            errorMessage = "Vui lòng bấm \"Gửi mã OTP về email\" để nhận mã xác thực trước.";
            return;
        }
        if (!otpOk)
        {
            errorMessage = "Vui lòng nhập đầy đủ mã OTP 6 chữ số.";
            return;
        }
        if (!agreedTerms)
        {
            errorMessage = "Vui lòng đồng ý với điều khoản dịch vụ để tiếp tục.";
            return;
        }
        if (!formValid)
        {
            errorMessage = "Vui lòng kiểm tra lại các thông tin đã nhập.";
            return;
        }

        isLoading = true;

        // Trang này không thu thập SĐT / giới tính / ngày sinh (backend cho phép null)
        registerModel.PhoneNumber = null;
        registerModel.Gender = null;
        registerModel.DateOfBirth = null;

        var result = await AuthService.RegisterAsync(registerModel);
        if (result.Success)
        {
            successMessage = "Tạo tài khoản thành công! Đang chuyển hướng vào hệ thống...";
            await Task.Delay(1500);
            Navigation.NavigateTo("/");
        }
        else
        {
            errorMessage = result.Message ?? "Đăng ký thất bại. Mã OTP không đúng hoặc đã hết hạn.";
        }

        isLoading = false;
    }

    private void StartCountdown()
    {
        countdown = 60;
        timer?.Dispose();
        timer = new Timer(1000);
        timer.Elapsed += (sender, e) =>
        {
            if (countdown > 0)
            {
                countdown--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                timer?.Stop();
            }
        };
        timer.Start();
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}

                                                <button type="button"
                                                        @onclick="() => OpenSubmitProofModal(ex)"
                                                        class="px-3.5 py-2 rounded-xl text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1.5 hover:bg-amber-100 transition cursor-pointer"
                                                        title="Click to view or update your proof">
                                                    <span>⏳ Needs Review</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="px-3.5 py-2 rounded-xl text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1.5 select-none"
                                                      title="Submitted proof is waiting for coach review">
                                                    <span>⏳ Pending Review</span>
                                                </span>
                                            }
                                        }
                                        else if (!(CurrentDay?.IsToday ?? false))
                                        {
                                            @* Past or future day: the Complete action is not available. *@
                                            @if (string.Equals(ex.Status, "UNCOMPLETE", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="px-4 py-2 rounded-xl text-xs font-bold border flex items-center gap-1.5 select-none bg-rose-50 text-rose-700 border-rose-200">
                                                    Rejected
                                                </span>
